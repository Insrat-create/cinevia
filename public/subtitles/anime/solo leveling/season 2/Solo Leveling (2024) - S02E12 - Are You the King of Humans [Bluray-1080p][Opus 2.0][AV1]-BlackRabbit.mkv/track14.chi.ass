Dialogue: 0,0:00:09.15,0:00:10.03,Default,,0000,0000,0000,,Cái gì...
Dialogue: 0,0:00:11.84,0:00:13.78,Default,,0000,0000,0000,,Đám binh sĩ màu đen này là sao!?
Dialogue: 0,0:00:38.43,0:00:40.28,Default,,0000,0000,0000,,Cái đám này rốt cuộc là gì...?
Dialogue: 0,0:00:46.94,0:00:49.24,Default,,0000,0000,0000,,K-Không lẽ...
Dialogue: 0,0:00:50.50,0:00:51.32,Default,,0000,0000,0000,,Tại sao...
Dialogue: 0,0:00:51.32,0:00:53.09,Default,,0000,0000,0000,,Tại sao lại ở đây?
Dialogue: 0,0:01:03.31,0:01:04.52,Default,,0000,0000,0000,,Bác Song...
Dialogue: 0,0:01:05.24,0:01:08.74,Default,,0000,0000,0000,,Như này là phát sóng bị gián đoạn nhỉ?
Dialogue: 0,0:01:11.40,0:01:14.13,Default,,0000,0000,0000,,Rốt cuộc đã xảy ra chuyện gì vậy?
Dialogue: 0,0:01:17.69,0:01:18.54,Default,,0000,0000,0000,,Không ổn rồi.
Dialogue: 0,0:01:18.55,0:01:20.16,Default,,0000,0000,0000,,Hiện trường cũng đang hỗn loạn...
Dialogue: 0,0:01:20.77,0:01:23.10,Default,,0000,0000,0000,,Tối ưu tiên an nguy của các Hunter!
Dialogue: 0,0:01:23.60,0:01:25.17,Default,,0000,0000,0000,,Tiếp đến là thu thập thông tin.
Dialogue: 0,0:01:25.45,0:01:26.06,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:01:28.34,0:01:29.20,Default,,0000,0000,0000,,Giám đốc!
Dialogue: 0,0:01:29.56,0:01:32.92,Default,,0000,0000,0000,,Đường dây liên lạc đang ngập tràn\Ncuộc gọi truy vấn của khán giả!
Dialogue: 0,0:01:33.06,0:01:35.48,Default,,0000,0000,0000,,Hãy mau phát sóng lại đi ạ!
Dialogue: 0,0:01:35.60,0:01:37.31,Default,,0000,0000,0000,,Nếu có thể thì tôi đã làm rồi!
Dialogue: 0,0:01:37.32,0:01:40.60,Default,,0000,0000,0000,,Đừng nói tới hình ảnh\Ncòn chẳng có liên lạc từ hiện trường cơ!
Dialogue: 0,0:01:42.02,0:01:42.96,Default,,0000,0000,0000,,Ngộ nhỡ...
Dialogue: 0,0:01:43.00,0:01:45.97,Default,,0000,0000,0000,,Toàn bộ Hunter cấp S bị giết\Nthì phải làm thế nào đây!
Dialogue: 0,0:01:48.77,0:01:50.23,Default,,0000,0000,0000,,Này! Hãy trả lời đi!
Dialogue: 0,0:01:50.39,0:01:51.81,Default,,0000,0000,0000,,Ở đó đang thế nào rồi?
Dialogue: 0,0:01:53.59,0:01:54.54,Default,,0000,0000,0000,,Chết tiệt!
Dialogue: 0,0:01:54.54,0:01:55.94,Default,,0000,0000,0000,,Máy quay đang...
Dialogue: 0,0:01:56.27,0:01:57.58,Default,,0000,0000,0000,,Sao lại đúng vào lúc này...
Dialogue: 0,0:01:58.63,0:01:59.33,Default,,0000,0000,0000,,Iron!
Dialogue: 0,0:02:07.98,0:02:08.70,Default,,0000,0000,0000,,Lên đi.
Dialogue: 0,0:02:19.97,0:02:22.07,Default,,0000,0000,0000,,Tôi cũng không hiểu chuyện này là thế nào...
Dialogue: 0,0:02:22.49,0:02:24.57,Default,,0000,0000,0000,,Cái đám này là thế nào vậy?
Dialogue: 0,0:02:24.77,0:02:28.19,Default,,0000,0000,0000,,Tại sao Hunter Sung lại ở đây?
Dialogue: 0,0:02:31.24,0:02:33.88,Default,,0000,0000,0000,,Hunter Sung, cậu lên đảo khi nào thế?
Dialogue: 0,0:02:34.13,0:02:35.84,Default,,0000,0000,0000,,Chưa kể bằng cách nào vậy?
Dialogue: 0,0:02:35.85,0:02:36.96,Default,,0000,0000,0000,,Tôi sẽ giải thích sau.
Dialogue: 0,0:02:37.53,0:02:39.62,Default,,0000,0000,0000,,Trước tiên, tôi sẽ chữa thương cho mọi người.
Dialogue: 0,0:02:40.27,0:02:41.05,Default,,0000,0000,0000,,Hãy uống thứ này.
Dialogue: 0,0:02:43.25,0:02:44.00,Default,,0000,0000,0000,,Phải rồi...
Dialogue: 0,0:02:44.35,0:02:45.93,Default,,0000,0000,0000,,Không thể chuyển giao.
Dialogue: 0,0:02:47.78,0:02:48.67,Default,,0000,0000,0000,,Thuốc uống sao?
Dialogue: 0,0:02:49.10,0:02:50.27,Default,,0000,0000,0000,,Ma pháp không gian phụ sao?
Dialogue: 0,0:02:50.81,0:02:51.50,Default,,0000,0000,0000,,Sư phụ Ma.
Dialogue: 0,0:02:51.53,0:02:52.02,Default,,0000,0000,0000,,Hở?
Dialogue: 0,0:02:53.43,0:02:54.70,Default,,0000,0000,0000,,Xin hãy mở miệng ra.
Dialogue: 0,0:02:59.56,0:03:00.68,Default,,0000,0000,0000,,Như này là...
Dialogue: 0,0:03:05.32,0:03:06.27,Default,,0000,0000,0000,,Vết thương...
Dialogue: 0,0:03:06.99,0:03:07.77,Default,,0000,0000,0000,,Lành lại rồi...
Dialogue: 0,0:03:16.56,0:03:17.80,Default,,0000,0000,0000,,Cô ấy không bình phục sao?
Dialogue: 0,0:03:18.34,0:03:19.67,Default,,0000,0000,0000,,Tại sao lại không có tác dụng?
Dialogue: 0,0:03:19.85,0:03:22.20,Default,,0000,0000,0000,,HP CỦA ĐỐI TƯỢNG QUÁ THẤP\NNÊN THUỐC KHÔNG CÓ TÁC DỤNG
Dialogue: 0,0:03:22.22,0:03:23.67,Default,,0000,0000,0000,,Giống với khi đó sao...
Dialogue: 0,0:03:25.17,0:03:25.91,Default,,0000,0000,0000,,Nguy rồi.
Dialogue: 0,0:03:25.96,0:03:27.52,Default,,0000,0000,0000,,Khí tức của cô ấy đang yếu dần.
Dialogue: 0,0:03:28.81,0:03:30.92,Default,,0000,0000,0000,,Vết thương nặng như này\Ntôi không chữa nổi.
Dialogue: 0,0:03:31.58,0:03:32.82,Default,,0000,0000,0000,,Phải mau chóng rời khỏi đây.
Dialogue: 0,0:03:33.05,0:03:34.53,Default,,0000,0000,0000,,Tôi sẽ mở đường.
Dialogue: 0,0:03:34.55,0:03:35.10,Default,,0000,0000,0000,,Hiểu rồi.
Dialogue: 0,0:03:35.10,0:03:35.59,Default,,0000,0000,0000,,Đợi đã!
Dialogue: 0,0:03:35.60,0:03:36.08,Default,,0000,0000,0000,,Hả?
Dialogue: 0,0:03:41.06,0:03:43.40,Default,,0000,0000,0000,,Hết đợt này tới đợt khác,\Nchúng liên tục kéo tới...
Dialogue: 0,0:03:43.43,0:03:45.34,Default,,0000,0000,0000,,Công nhận là quá đông rồi!
Dialogue: 0,0:03:46.88,0:03:47.62,Default,,0000,0000,0000,,Chậc...
Dialogue: 0,0:03:50.01,0:03:50.83,Default,,0000,0000,0000,,Hội trưởng!
Dialogue: 0,0:03:51.30,0:03:52.81,Default,,0000,0000,0000,,Tình hình đội tấn công sao rồi?
Dialogue: 0,0:03:53.09,0:03:54.07,Default,,0000,0000,0000,,Vẫn chưa có tin gì...
Dialogue: 0,0:03:54.26,0:03:57.47,Default,,0000,0000,0000,,Có vẻ do toàn bộ đảo đang xảy ra\Nhiện tượng gián đoạn tín hiệu.
Dialogue: 0,0:03:58.40,0:04:01.59,Default,,0000,0000,0000,,Chúng tôi cũng thử liên lạc với\Nphía Nhật Bản nhưng không thể kết nối.
Dialogue: 0,0:04:02.00,0:04:06.28,Default,,0000,0000,0000,,Phía truyền thông dân sự cũng\Nmất hình ảnh từ lúc con kiến đen xuất hiện.
Dialogue: 0,0:04:07.00,0:04:09.09,Default,,0000,0000,0000,,Khẩn trương khôi phục\Ntín hiệu bị gián đoạn.
Dialogue: 0,0:04:09.76,0:04:12.85,Default,,0000,0000,0000,,Thông báo cho đội y tế\Nvà đội thu hồi hành động ngay!
Dialogue: 0,0:04:13.04,0:04:13.66,Default,,0000,0000,0000,,Vâng!
Dialogue: 0,0:04:17.86,0:04:18.86,Default,,0000,0000,0000,,Ngay lúc này...
Dialogue: 0,0:04:20.29,0:04:23.83,Default,,0000,0000,0000,,Mình chưa bao giờ hận cơ thể\Nvà trái tim này như vậy.
Dialogue: 0,0:04:25.43,0:04:29.12,Default,,0000,0000,0000,,Giá như có thể giúp được gì đó,\Ngiá như có thể cùng chiến đấu...
Dialogue: 0,0:04:30.42,0:04:31.39,Default,,0000,0000,0000,,Hội trưởng...
Dialogue: 0,0:04:32.19,0:04:33.03,Default,,0000,0000,0000,,Xin ông trời...
Dialogue: 0,0:04:33.81,0:04:35.77,Default,,0000,0000,0000,,Xin ông trời hãy để họ bình an...
Dialogue: 0,0:04:39.13,0:04:41.64,Default,,0000,0000,0000,,Thật tình! Làm sao thế nhỉ!
Dialogue: 0,0:04:42.08,0:04:46.38,Default,,0000,0000,0000,,Vừa cho rằng buổi tường thuật bị hủy\Nthì tới lượt cái tivi cũng hỏng luôn!
Dialogue: 0,0:04:46.38,0:04:47.64,Default,,0000,0000,0000,,Thật không thể tin được!
Dialogue: 0,0:04:47.64,0:04:49.72,Default,,0000,0000,0000,,Con có làm thế cũng không sửa được đâu.
Dialogue: 0,0:04:50.20,0:04:52.54,Default,,0000,0000,0000,,Con về phòng xem tạm đây.
Dialogue: 0,0:04:53.71,0:04:56.39,Default,,0000,0000,0000,,Biết đâu dùng điện thoại\Nsẽ có thông tin gì đó!
Dialogue: 0,0:04:59.95,0:05:01.45,Default,,0000,0000,0000,,Con bé gấp thật đấy...
Dialogue: 0,0:05:02.91,0:05:03.91,Default,,0000,0000,0000,,Chuyện này là thế nào?
Dialogue: 0,0:05:04.15,0:05:05.06,Default,,0000,0000,0000,,Hãy giải thích đi.
Dialogue: 0,0:05:05.73,0:05:07.99,Default,,0000,0000,0000,,Tín hiệu sự sống của anh Goto\Nđã bị gián đoạn.
Dialogue: 0,0:05:09.34,0:05:11.46,Default,,0000,0000,0000,,Theo thông tin gửi về\Ntrước khi bị gián đoạn
Dialogue: 0,0:05:11.46,0:05:14.18,Default,,0000,0000,0000,,thì bất ngờ xuất hiện\Ntín hiệu của cường địch,
Dialogue: 0,0:05:14.18,0:05:15.82,Default,,0000,0000,0000,,nên nghĩa là anh ấy đã bị giết.
Dialogue: 0,0:05:16.79,0:05:17.91,Default,,0000,0000,0000,,Còn những người khác?
Dialogue: 0,0:05:18.05,0:05:19.56,Default,,0000,0000,0000,,Vẫn đang xác thực ạ.
Dialogue: 0,0:05:20.03,0:05:21.61,Default,,0000,0000,0000,,Mau xác thực cho tôi!
Dialogue: 0,0:05:21.65,0:05:24.36,Default,,0000,0000,0000,,Nếu thiệt hại còn hơn thế\Nsẽ ảnh hưởng tới bước tiếp theo.
Dialogue: 0,0:05:25.83,0:05:26.48,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:05:32.07,0:05:33.83,Default,,0000,0000,0000,,Goto đã bị giết sao?
Dialogue: 0,0:05:34.44,0:05:35.44,Default,,0000,0000,0000,,Thật vô dụng!
Dialogue: 0,0:05:36.85,0:05:39.18,Default,,0000,0000,0000,,Hiện tại, đang có chuyện gì\Ntrên hòn đảo đó vậy?
Dialogue: 0,0:05:48.18,0:05:50.83,Default,,0000,0000,0000,,Đẳng cấp của Igris và Iron cao hơn...
Dialogue: 0,0:05:51.68,0:05:53.94,Default,,0000,0000,0000,,Đám bộ binh thì khá yếu thế...
Dialogue: 0,0:05:54.96,0:05:57.12,Default,,0000,0000,0000,,Mình đang muốn gia tăng chiến lực...
Dialogue: 0,0:05:57.98,0:06:00.30,Default,,0000,0000,0000,,Nhưng đang ở trước mặt nhiều người...
Dialogue: 0,0:06:01.31,0:06:02.16,Default,,0000,0000,0000,,Không.
Dialogue: 0,0:06:02.76,0:06:03.41,Default,,0000,0000,0000,,Mọi người.
Dialogue: 0,0:06:04.66,0:06:06.53,Default,,0000,0000,0000,,Cứ như này tình hình sẽ ngày càng tồi tệ.
Dialogue: 0,0:06:06.55,0:06:08.78,Default,,0000,0000,0000,,Tôi sẽ dùng vũ lực để mở đường.
Dialogue: 0,0:06:09.27,0:06:10.14,Default,,0000,0000,0000,,Mọi người...
Dialogue: 0,0:06:11.48,0:06:13.49,Default,,0000,0000,0000,,Hãy theo sau cái tên này.
Dialogue: 0,0:06:14.09,0:06:16.54,Default,,0000,0000,0000,,Đám màu đen còn lại sẽ khống chế lũ kiến.
Dialogue: 0,0:06:17.66,0:06:21.71,Default,,0000,0000,0000,,Nếu có con nào lọt lưới lao tới tấn công\Nthì nhờ mọi người xử lý.
Dialogue: 0,0:06:22.05,0:06:23.24,Default,,0000,0000,0000,,Hiểu rồi.
Dialogue: 0,0:06:23.34,0:06:25.31,Default,,0000,0000,0000,,Nhiêu đó cứ để chúng tôi lo.
Dialogue: 0,0:06:25.35,0:06:25.97,Default,,0000,0000,0000,,Được.
Dialogue: 0,0:06:26.76,0:06:27.62,Default,,0000,0000,0000,,Còn nữa...
Dialogue: 0,0:06:28.14,0:06:31.24,Default,,0000,0000,0000,,Xin mọi người đừng tiết lộ\Nnhững chuyện sắp được chứng kiến.
Dialogue: 0,0:06:33.00,0:06:33.79,Default,,0000,0000,0000,,Không lẽ...
Dialogue: 0,0:06:55.87,0:06:57.51,Default,,0000,0000,0000,,Nó đã quay lại sao...?
Dialogue: 0,0:06:58.06,0:06:59.72,Default,,0000,0000,0000,,Chẳng lẽ như vậy có nghĩa là...
Dialogue: 0,0:07:00.23,0:07:01.76,Default,,0000,0000,0000,,Goto đã bị giết sao!?
Dialogue: 0,0:07:19.87,0:07:22.36,Default,,0000,0000,0000,,Bên ngoài không có vua.
Dialogue: 0,0:07:23.11,0:07:24.88,Default,,0000,0000,0000,,Có đang ở đây không?
Dialogue: 0,0:07:25.73,0:07:28.00,Default,,0000,0000,0000,,Kẻ có thể gọi là vua ấy.
Dialogue: 0,0:07:29.90,0:07:32.54,Default,,0000,0000,0000,,Tín hiệu của binh sĩ\Ntrong bóng của Goto biến mất...
Dialogue: 0,0:07:33.09,0:07:34.29,Default,,0000,0000,0000,,Là do nó sao...
Dialogue: 0,0:07:35.14,0:07:35.69,Default,,0000,0000,0000,,Ơ!?
Dialogue: 0,0:07:35.69,0:07:36.80,Default,,0000,0000,0000,,N-Này!
Dialogue: 0,0:07:56.78,0:07:57.94,Default,,0000,0000,0000,,Nhà ngươi...
Dialogue: 0,0:07:59.01,0:08:00.95,Default,,0000,0000,0000,,Có phải vua của con người không?
Dialogue: 0,0:08:03.71,0:08:04.42,Default,,0000,0000,0000,,Ồ...
Dialogue: 0,0:08:05.29,0:08:07.20,Default,,0000,0000,0000,,Một con côn trùng mà lại biết nói cơ à?
Dialogue: 0,0:08:08.43,0:08:09.81,Default,,0000,0000,0000,,Con người...
Dialogue: 0,0:08:12.27,0:08:14.20,Default,,0000,0000,0000,,Khí tức sắc bén đấy...
Dialogue: 0,0:08:21.12,0:08:23.88,Default,,0000,0000,0000,,Quả nhiên côn trùng vẫn chỉ là côn trùng.
Dialogue: 0,0:08:25.00,0:08:26.95,Default,,0000,0000,0000,,Dù Hunter Sung có mạnh thế nào...
Dialogue: 0,0:08:26.95,0:08:28.57,Default,,0000,0000,0000,,Nhưng nếu đấu với thứ đó...
Dialogue: 0,0:08:34.11,0:08:36.22,Default,,0000,0000,0000,,Giám đốc ơi!\NCó lại hình ảnh rồi!
Dialogue: 0,0:08:37.07,0:08:37.51,Default,,0000,0000,0000,,Ơ!?
Dialogue: 0,0:08:37.88,0:08:39.05,Default,,0000,0000,0000,,Chuyện này...
Dialogue: 0,0:08:39.81,0:08:41.13,Default,,0000,0000,0000,,Phát sóng trở lại đi!
Dialogue: 0,0:08:41.14,0:08:41.74,Default,,0000,0000,0000,,Mau lên!
Dialogue: 0,0:08:41.74,0:08:42.58,Default,,0000,0000,0000,,Ể!?
Dialogue: 0,0:08:42.58,0:08:45.88,Default,,0000,0000,0000,,Nếu bắt đầu ngay lúc này\Nsẽ biến thành tường thuật trực tiếp đó!
Dialogue: 0,0:08:46.02,0:08:48.59,Default,,0000,0000,0000,,Nhỡ có biến thì không thể ứng phó đâu!
Dialogue: 0,0:08:48.81,0:08:50.97,Default,,0000,0000,0000,,Đã bị gián đoạn một lần rồi...
Dialogue: 0,0:08:50.99,0:08:52.42,Default,,0000,0000,0000,,Không thể tệ hơn nữa đâu!
Dialogue: 0,0:08:52.51,0:08:52.99,Default,,0000,0000,0000,,Làm đi!
Dialogue: 0,0:08:53.20,0:08:54.20,Default,,0000,0000,0000,,V-Vâng!
Dialogue: 0,0:08:55.03,0:08:56.06,Default,,0000,0000,0000,,Chúng ta...
Dialogue: 0,0:08:56.37,0:09:00.94,Default,,0000,0000,0000,,Không, vận mệnh của trận chiến này\Nđang được phó mặc cho người đó!
Dialogue: 0,0:09:02.11,0:09:03.57,Default,,0000,0000,0000,,B-Bác Song!
Dialogue: 0,0:09:03.65,0:09:04.52,Default,,0000,0000,0000,,Không phải chứ...
Dialogue: 0,0:09:05.51,0:09:06.58,Default,,0000,0000,0000,,Đây là...
Dialogue: 0,0:09:12.79,0:09:13.66,Default,,0000,0000,0000,,Đùa sao...
Dialogue: 0,0:09:13.98,0:09:15.36,Default,,0000,0000,0000,,Tại sao...
Dialogue: 0,0:09:16.23,0:09:17.66,Default,,0000,0000,0000,,Anh hai!?
Dialogue: 0,0:09:18.02,0:09:19.99,Default,,0000,0000,0000,,Miệng thì bảo ra ngoài một lát...
Dialogue: 0,0:09:20.02,0:09:21.07,Default,,0000,0000,0000,,Ể!?
Dialogue: 0,0:09:21.12,0:09:22.65,Default,,0000,0000,0000,,Lại nữa!?
Dialogue: 0,0:09:25.16,0:09:28.01,Default,,0000,0000,0000,,Cậu ấy đã tới sao, Hunter Sung!?
Dialogue: 0,0:09:29.42,0:09:32.30,Default,,0000,0000,0000,,Nhưng cậu ta lên đảo kiểu gì nhỉ...
Dialogue: 0,0:09:32.32,0:09:34.76,Default,,0000,0000,0000,,Chuyện đó thì cứ kệ đi cũng được!
Dialogue: 0,0:09:35.33,0:09:36.79,Default,,0000,0000,0000,,Hiện giờ cứ tin vào cậu ấy đi!
Dialogue: 0,0:09:50.39,0:09:53.08,Default,,0000,0000,0000,,Hệ pháp sư mà lại tới gần như vậy sao!?
Dialogue: 0,0:09:53.17,0:09:55.06,Default,,0000,0000,0000,,Như thể coi thường con kiến đó...
Dialogue: 0,0:09:55.56,0:09:57.46,Default,,0000,0000,0000,,Ăn một đòn trực diện mất rồi.
Dialogue: 0,0:09:58.44,0:09:59.30,Default,,0000,0000,0000,,Yếu đuối...
Dialogue: 0,0:09:59.96,0:10:01.58,Default,,0000,0000,0000,,Quả nhiên ngươi không phải vua...
Dialogue: 0,0:10:25.30,0:10:27.46,Default,,0000,0000,0000,,Sư phụ Baek, sư phụ Choi...
Dialogue: 0,0:10:28.34,0:10:30.59,Default,,0000,0000,0000,,Cậu ấy có thật là hệ pháp sư không?
Dialogue: 0,0:10:30.96,0:10:33.37,Default,,0000,0000,0000,,Bản thân tôi cũng không rõ nữa.
Dialogue: 0,0:10:33.89,0:10:35.61,Default,,0000,0000,0000,,Không ngờ lại mạnh tới mức này...
Dialogue: 0,0:10:37.14,0:10:38.73,Default,,0000,0000,0000,,Ngươi cũng khá cứng nhỉ.
Dialogue: 0,0:10:39.18,0:10:40.46,Default,,0000,0000,0000,,Chắc là do lớp vỏ chăng.
Dialogue: 0,0:10:58.50,0:11:00.27,Default,,0000,0000,0000,,Trận chiến mới kinh khủng làm sao...
Dialogue: 0,0:11:00.40,0:11:03.49,Default,,0000,0000,0000,,Mình là cấp A vậy mà\Nkhó khăn lắm mới đứng vững...
Dialogue: 0,0:11:05.15,0:11:08.63,Default,,0000,0000,0000,,Chỉ là dòng chảy ma lực\Ncũng đủ khiến người ta bất tỉnh...
Dialogue: 0,0:11:13.62,0:11:14.84,Default,,0000,0000,0000,,Ta...
Dialogue: 0,0:11:14.84,0:11:16.76,Default,,0000,0000,0000,,Đang bị dồn ép sao...
Dialogue: 0,0:11:28.32,0:11:29.61,Default,,0000,0000,0000,,Tại sao...
Dialogue: 0,0:11:31.14,0:11:32.73,Default,,0000,0000,0000,,Con người này...
Dialogue: 0,0:11:33.44,0:11:36.31,Default,,0000,0000,0000,,Rốt cuộc là ai?
Dialogue: 0,0:12:02.32,0:12:03.46,Default,,0000,0000,0000,,Đây là...
Dialogue: 0,0:12:04.23,0:12:10.36,Default,,0000,0000,0000,,Kịch độc được tạo ra từ ma lực và\Nđộc tố hấp thụ từ sinh vật biển quanh đây.
Dialogue: 0,0:12:10.69,0:12:12.98,Default,,0000,0000,0000,,Ngươi sẽ sớm không thể cử động nữa.
Dialogue: 0,0:12:15.18,0:12:18.13,Default,,0000,0000,0000,,Vậy là ngươi sẽ xong đời...
Dialogue: 0,0:12:20.62,0:12:21.81,Default,,0000,0000,0000,,Con người kia...
Dialogue: 0,0:12:22.38,0:12:23.46,Default,,0000,0000,0000,,Chết đi!
Dialogue: 0,0:12:28.02,0:12:30.15,Default,,0000,0000,0000,,Bảy trong số mười người đã chết sao?
Dialogue: 0,0:12:30.20,0:12:31.80,Default,,0000,0000,0000,,Cậu đùa cái kiểu gì vậy?
Dialogue: 0,0:12:32.40,0:12:34.15,Default,,0000,0000,0000,,Dạ không, là thật ạ.
Dialogue: 0,0:12:34.75,0:12:38.18,Default,,0000,0000,0000,,Chúng tôi đã liên lạc được\Nvới các Hunter sống sót và xác thực.
Dialogue: 0,0:12:40.78,0:12:42.74,Default,,0000,0000,0000,,Vậy là quá nửa rồi còn gì!
Dialogue: 0,0:12:42.82,0:12:44.65,Default,,0000,0000,0000,,Sao lại bung bét như này!
Dialogue: 0,0:12:45.32,0:12:49.63,Default,,0000,0000,0000,,Sau đó, tín hiệu mạnh đó\Nđã xuất hiện lại ở gần miệng núi lửa.
Dialogue: 0,0:12:50.22,0:12:52.68,Default,,0000,0000,0000,,Có lẽ chính là cá thể đã giết anh Goto.
Dialogue: 0,0:12:53.12,0:12:55.45,Default,,0000,0000,0000,,Tại sao nó đánh với Goto\Nmà vẫn còn sống hả!?
Dialogue: 0,0:12:55.67,0:12:58.03,Default,,0000,0000,0000,,Chưa kể còn quay về tổ?\NLý do là gì chứ?
Dialogue: 0,0:12:58.30,0:12:59.11,Default,,0000,0000,0000,,Chưa biết ạ.
Dialogue: 0,0:12:59.74,0:13:01.39,Default,,0000,0000,0000,,Có thể nó có mục đích gì đó...
Dialogue: 0,0:13:01.79,0:13:03.54,Default,,0000,0000,0000,,Hoặc là bị thương nên trở về tổ.
Dialogue: 0,0:13:05.77,0:13:08.39,Default,,0000,0000,0000,,Vẫn chưa xác định được\NHunter bên đó còn sống hay không.
Dialogue: 0,0:13:08.58,0:13:10.60,Default,,0000,0000,0000,,Nhưng dù còn sống\Ncũng sẽ gặp phải thứ đó.
Dialogue: 0,0:13:10.77,0:13:12.83,Default,,0000,0000,0000,,Nó thậm chí có thể giết chết Goto.
Dialogue: 0,0:13:12.87,0:13:15.04,Default,,0000,0000,0000,,Đám người đã hao tổn đó\Nkhông thể đánh lại!
Dialogue: 0,0:13:15.30,0:13:17.78,Default,,0000,0000,0000,,Lũ kiến sau nhiều trận liên tục\Ncũng sẽ suy yếu.
Dialogue: 0,0:13:18.76,0:13:20.74,Default,,0000,0000,0000,,Nếu bên ta tiêu diệt được thứ đó
Dialogue: 0,0:13:20.74,0:13:23.27,Default,,0000,0000,0000,,thì việc còn lại chỉ là\Ndiệt sạch lũ nhãi nhép.
Dialogue: 0,0:13:24.78,0:13:26.31,Default,,0000,0000,0000,,Vẫn còn cơ hội thắng!
Dialogue: 0,0:13:27.21,0:13:29.88,Default,,0000,0000,0000,,Mau đưa ba người còn sống trở về!
Dialogue: 0,0:13:30.29,0:13:34.54,Default,,0000,0000,0000,,Sau khi hội họp với\Nđội tấn công thứ hai thì xuất kích!
Dialogue: 0,0:13:35.76,0:13:36.99,Default,,0000,0000,0000,,Tình hình là như vậy.
Dialogue: 0,0:13:36.99,0:13:38.99,Default,,0000,0000,0000,,Trực thăng sẽ sớm tới đón mọi người.
Dialogue: 0,0:13:40.04,0:13:40.80,Default,,0000,0000,0000,,Tuân lệnh.
Dialogue: 0,0:13:43.29,0:13:45.04,Default,,0000,0000,0000,,Kế hoạch sẽ chuyển sang phương án 9.
Dialogue: 0,0:13:45.37,0:13:46.21,Default,,0000,0000,0000,,Đi thôi.
Dialogue: 0,0:13:46.79,0:13:47.69,Default,,0000,0000,0000,,Không được đâu...
Dialogue: 0,0:13:48.75,0:13:50.75,Default,,0000,0000,0000,,Đó là... quái vật...
Dialogue: 0,0:13:51.31,0:13:54.19,Default,,0000,0000,0000,,Chúng ta... đánh không lại đâu...
Dialogue: 0,0:13:54.88,0:13:56.14,Default,,0000,0000,0000,,Nghiêm chỉnh đi!
Dialogue: 0,0:13:56.23,0:13:57.54,Default,,0000,0000,0000,,Đừng có hèn như thế!
Dialogue: 0,0:13:57.95,0:14:00.09,Default,,0000,0000,0000,,Không thể thắng nổi thứ đó đâu!
Dialogue: 0,0:14:00.35,0:14:01.22,Default,,0000,0000,0000,,Phải chạy thôi...
Dialogue: 0,0:14:01.22,0:14:03.29,Default,,0000,0000,0000,,Không chạy thì sẽ bị giết mất!
Dialogue: 0,0:14:05.14,0:14:06.30,Default,,0000,0000,0000,,Thảm hại.
Dialogue: 0,0:14:06.91,0:14:08.18,Default,,0000,0000,0000,,Phải làm thôi.
Dialogue: 0,0:14:08.98,0:14:09.74,Default,,0000,0000,0000,,Chúng ta ấy.
Dialogue: 0,0:14:31.36,0:14:33.23,Default,,0000,0000,0000,,Không phải đã bị trúng độc sao?
Dialogue: 0,0:14:33.34,0:14:35.10,Default,,0000,0000,0000,,Cậu ấy không làm sao hết à?
Dialogue: 0,0:14:36.34,0:14:39.32,Default,,0000,0000,0000,,Giờ có xảy ra thêm chuyện gì\Ntôi cũng chẳng thấy quái lạ nữa.
Dialogue: 0,0:14:40.42,0:14:42.08,Default,,0000,0000,0000,,Ngươi cũng biết giấu bài nhỉ.
Dialogue: 0,0:14:43.56,0:14:46.51,Default,,0000,0000,0000,,Quả thật mình đã nghĩ\Ncon kiến đó đang thong thả.
Dialogue: 0,0:14:46.62,0:14:47.16,Default,,0000,0000,0000,,PHÁT HIỆN CHẤT ĐỘC
Dialogue: 0,0:14:47.16,0:14:48.58,Default,,0000,0000,0000,,GIẢI ĐỘC HOÀN THÀNH
Dialogue: 0,0:14:49.41,0:14:52.46,Default,,0000,0000,0000,,Nhưng nhờ chỉ số Cảm Giác tăng lên.
Dialogue: 0,0:14:52.89,0:14:54.60,Default,,0000,0000,0000,,Mình có thể đọc cảm xúc của nó.
Dialogue: 0,0:14:55.69,0:14:57.08,Default,,0000,0000,0000,,Có sự nôn nóng.
Dialogue: 0,0:14:58.36,0:14:59.94,Default,,0000,0000,0000,,Về khoản đó thì bên mình cũng vậy.
Dialogue: 0,0:15:02.12,0:15:03.26,Default,,0000,0000,0000,,Phải cố hết sức...
Dialogue: 0,0:15:04.12,0:15:05.44,Default,,0000,0000,0000,,Kết thúc thật nhanh!
Dialogue: 0,0:15:10.67,0:15:11.55,Default,,0000,0000,0000,,Chậc!
Dialogue: 0,0:15:16.70,0:15:18.22,Default,,0000,0000,0000,,Độc vô dụng.
Dialogue: 0,0:15:18.27,0:15:20.22,Default,,0000,0000,0000,,Đọ sức thì vô nghĩa...
Dialogue: 0,0:15:21.01,0:15:21.95,Default,,0000,0000,0000,,Đã vậy thì...
Dialogue: 0,0:15:43.51,0:15:44.43,Default,,0000,0000,0000,,DAO GĂM CỦA CHÚA QUỶ MONARCH
Dialogue: 0,0:16:36.18,0:16:39.09,Default,,0000,0000,0000,,Tốc độ ta không thể theo kịp.
Dialogue: 0,0:16:39.90,0:16:42.19,Default,,0000,0000,0000,,Chưa kể vẫn ngày một nhanh hơn.
Dialogue: 0,0:16:43.52,0:16:45.58,Default,,0000,0000,0000,,Sao có thể như này...
Dialogue: 0,0:17:43.75,0:17:44.13,Default,,0000,0000,0000,,KỸ NĂNG: ĐÒN CHÍ MẠNG ĐƯỢC NÂNG CẤP\NTHÀNH BẢN TỐI THƯỢNG KỸ NĂNG: LOẠN ĐAO
Dialogue: 0,0:17:44.13,0:17:44.51,Default,,0000,0000,0000,,KỸ NĂNG: ĐÒN CHÍ MẠNG => KỸ NĂNG: LOẠN ĐAO
Dialogue: 0,0:17:45.25,0:17:46.74,Default,,0000,0000,0000,,Nâng cấp...
Dialogue: 0,0:17:47.41,0:17:48.38,Default,,0000,0000,0000,,Loạn Đao?
Dialogue: 0,0:17:53.31,0:17:54.96,Default,,0000,0000,0000,,C-Cái gì?
Dialogue: 0,0:17:59.82,0:18:00.99,Default,,0000,0000,0000,,Nguy rồi...
Dialogue: 0,0:18:04.94,0:18:06.56,Default,,0000,0000,0000,,Năng lực trị thương à.
Dialogue: 0,0:18:07.49,0:18:08.94,Default,,0000,0000,0000,,Chuyện gì vậy...
Dialogue: 0,0:18:11.85,0:18:14.03,Default,,0000,0000,0000,,Đang xảy ra chuyện gì vậy...
Dialogue: 0,0:18:38.54,0:18:40.18,Default,,0000,0000,0000,,Chuyện gì thế này...
Dialogue: 0,0:18:40.18,0:18:41.83,Default,,0000,0000,0000,,Con người đó...
Dialogue: 0,0:18:42.40,0:18:46.06,Default,,0000,0000,0000,,Con người đó!!!
Dialogue: 0,0:18:50.18,0:18:50.94,Default,,0000,0000,0000,,Lên đi.
Dialogue: 0,0:19:15.63,0:19:16.79,Default,,0000,0000,0000,,Tại sao...
Dialogue: 0,0:19:17.69,0:19:21.13,Default,,0000,0000,0000,,Ta đã được sinh ra\Nđể làm kẻ mạnh nhất kia mà...
Dialogue: 0,0:19:22.23,0:19:24.50,Default,,0000,0000,0000,,Ta đã ăn mọi thứ,
Dialogue: 0,0:19:24.50,0:19:28.42,Default,,0000,0000,0000,,không ngừng phát triển\Nđể hướng tới đỉnh cao kia mà...
Dialogue: 0,0:19:28.76,0:19:30.72,Default,,0000,0000,0000,,Ta là vua kia mà.
Dialogue: 0,0:19:30.72,0:19:32.39,Default,,0000,0000,0000,,Tại sao lại như này...
Dialogue: 0,0:19:34.93,0:19:36.50,Default,,0000,0000,0000,,Chạy...
Dialogue: 0,0:19:37.42,0:19:39.18,Default,,0000,0000,0000,,Phải chạy trốn...
Dialogue: 0,0:19:39.54,0:19:41.02,Default,,0000,0000,0000,,Để sống sót...
Dialogue: 0,0:19:41.56,0:19:43.52,Default,,0000,0000,0000,,Phải chạy trốn thôi!
Dialogue: 0,0:19:47.39,0:19:49.09,Default,,0000,0000,0000,,Xa hết sức có thể...
Dialogue: 0,0:20:07.93,0:20:09.74,Default,,0000,0000,0000,,Nhanh lên, nhanh lên nào!
Dialogue: 0,0:20:10.33,0:20:12.18,Default,,0000,0000,0000,,Mau trốn đi xa!
Dialogue: 0,0:20:16.74,0:20:17.95,Default,,0000,0000,0000,,LOẠN ĐAO
Dialogue: 0,0:20:30.84,0:20:32.80,Default,,0000,0000,0000,,BẠN ĐÃ TIÊU DIỆT KẺ ĐỊCH\NBẠN ĐÃ THĂNG CẤP
Dialogue: 0,0:20:45.58,0:20:46.72,Default,,0000,0000,0000,,Lũ kiến...
Dialogue: 0,0:20:47.13,0:20:48.54,Default,,0000,0000,0000,,Chạy trốn cả rồi...
Dialogue: 0,0:20:48.75,0:20:49.88,Default,,0000,0000,0000,,Thắng rồi sao?
Dialogue: 0,0:20:53.53,0:20:54.63,Default,,0000,0000,0000,,Hunter Sung!
Dialogue: 0,0:21:01.37,0:21:02.71,Default,,0000,0000,0000,,Khí tức của cô ấy...
Dialogue: 0,0:21:02.71,0:21:04.40,Default,,0000,0000,0000,,Không thể chậm trễ thêm nữa...
Dialogue: 0,0:21:04.99,0:21:06.48,Default,,0000,0000,0000,,Mau rời khỏi đây thôi!
Dialogue: 0,0:21:06.50,0:21:08.91,Default,,0000,0000,0000,,Trực thăng để trở về đang đợi bên ngoài.
Dialogue: 0,0:21:08.95,0:21:09.95,Default,,0000,0000,0000,,Chỉ cần lên đó...
Dialogue: 0,0:21:09.95,0:21:12.19,Default,,0000,0000,0000,,Không, e là không trụ được tới lúc đó...
Dialogue: 0,0:21:12.51,0:21:13.74,Default,,0000,0000,0000,,Vậy phải làm thế nào đây?
Dialogue: 0,0:21:17.86,0:21:19.71,Default,,0000,0000,0000,,Thuốc đó không có tác dụng mà...
Dialogue: 0,0:21:19.77,0:21:21.20,Default,,0000,0000,0000,,Tôi vẫn chưa thử loại này.
Dialogue: 0,0:21:26.41,0:21:29.32,Default,,0000,0000,0000,,Thần Dược Sự Sống có thể chữa\Nbệnh Giấc Ngủ Vĩnh Hằng cho mẹ...
Dialogue: 0,0:21:30.02,0:21:30.74,Default,,0000,0000,0000,,Đây là...
Dialogue: 0,0:21:31.55,0:21:33.08,Default,,0000,0000,0000,,Hy vọng cuối cùng!
Dialogue: 0,0:21:36.19,0:21:38.62,Default,,0000,0000,0000,,"Không phải đối tượng khả dụng" sao...
Dialogue: 0,0:21:41.84,0:21:43.05,Default,,0000,0000,0000,,Không có tác dụng sao?
Dialogue: 0,0:21:44.18,0:21:46.50,Default,,0000,0000,0000,,Rời khỏi đây theo\Ncách bình thường sẽ không kịp...
Dialogue: 0,0:21:46.52,0:21:47.51,Default,,0000,0000,0000,,Thuốc thì không có tác dụng...
Dialogue: 0,0:21:48.10,0:21:50.90,Default,,0000,0000,0000,,Hoán Đổi Bóng thì tốn thời gian đợi\Nđể sử dụng lại...
Dialogue: 0,0:21:52.33,0:21:53.11,Default,,0000,0000,0000,,Có cách nào...
Dialogue: 0,0:21:53.94,0:21:55.75,Default,,0000,0000,0000,,Liệu có còn cách nào khác không?
Dialogue: 0,0:22:44.88,0:22:48.39,Default,,0000,0000,0000,,TẬP 24: NGƯƠI CÓ PHẢI VUA CỦA CON NGƯỜI
Dialogue: 0,0:23:37.94,0:23:41.27,Default,,0000,0000,0000,,TẬP 25: HƯỚNG TỚI MỤC TIÊU TIẾP THEO
