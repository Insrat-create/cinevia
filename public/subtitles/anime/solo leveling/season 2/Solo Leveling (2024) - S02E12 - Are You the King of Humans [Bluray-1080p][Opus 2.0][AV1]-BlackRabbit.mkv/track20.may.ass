Dialogue: 0,0:00:09.25,0:00:10.25,Default,,0000,0000,0000,,Apa yang berlaku?
Dialogue: 0,0:00:11.97,0:00:13.81,Default,,0000,0000,0000,,Semua askar hitam ini...
Dialogue: 0,0:00:38.47,0:00:39.93,Default,,0000,0000,0000,,Mereka...
Dialogue: 0,0:00:47.23,0:00:49.27,Default,,0000,0000,0000,,Jangan-jangan...
Dialogue: 0,0:00:50.65,0:00:51.55,Default,,0000,0000,0000,,Kenapa?
Dialogue: 0,0:00:51.55,0:00:52.99,Default,,0000,0000,0000,,Kenapa dia berada di sini?
Dialogue: 0,0:01:02.21,0:01:03.51,Default,,0000,0000,0000,,TIADA ISYARAT
Dialogue: 0,0:01:03.51,0:01:04.66,Default,,0000,0000,0000,,Encik Song.
Dialogue: 0,0:01:05.21,0:01:08.71,Default,,0000,0000,0000,,Ini bermakna siaran terganggu, betul?
Dialogue: 0,0:01:11.19,0:01:14.19,Default,,0000,0000,0000,,Apa yang berlaku sebenarnya?
Dialogue: 0,0:01:17.69,0:01:18.63,Default,,0000,0000,0000,,Panggilan tak dapat dibuat.
Dialogue: 0,0:01:18.63,0:01:20.19,Default,,0000,0000,0000,,Rasanya keadaan di sana pun huru-hara.
Dialogue: 0,0:01:20.81,0:01:23.13,Default,,0000,0000,0000,,Keutamaan kita adalah\Nmengenal pasti keselamatan pemburu,
Dialogue: 0,0:01:23.67,0:01:25.23,Default,,0000,0000,0000,,kemudian barulah mengumpul maklumat.
Dialogue: 0,0:01:25.53,0:01:26.21,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:01:28.31,0:01:29.23,Default,,0000,0000,0000,,Pengarah.
Dialogue: 0,0:01:29.49,0:01:32.87,Default,,0000,0000,0000,,Penonton menelefon tanpa henti
Dialogue: 0,0:01:33.23,0:01:35.53,Default,,0000,0000,0000,,untuk minta kita mainkan rakaman.
Dialogue: 0,0:01:35.53,0:01:37.29,Default,,0000,0000,0000,,Saya akan lakukannya jika dapat!
Dialogue: 0,0:01:37.29,0:01:39.27,Default,,0000,0000,0000,,Bukan saja tiada rakaman,
Dialogue: 0,0:01:39.27,0:01:40.65,Default,,0000,0000,0000,,malah mereka tak dapat dihubungi sekarang.
Dialogue: 0,0:01:41.99,0:01:45.83,Default,,0000,0000,0000,,Macam mana jika semua\Npemburu tahap S dibunuh?
Dialogue: 0,0:01:48.75,0:01:50.27,Default,,0000,0000,0000,,Hei, cepat jawab!
Dialogue: 0,0:01:50.27,0:01:51.73,Default,,0000,0000,0000,,Apa yang berlaku di sana?
Dialogue: 0,0:01:51.87,0:01:53.65,Default,,0000,0000,0000,,TIADA ISYARAT
Dialogue: 0,0:01:53.65,0:01:54.37,Default,,0000,0000,0000,,Tak guna.
Dialogue: 0,0:01:54.59,0:01:55.89,Default,,0000,0000,0000,,Kamera telah rosak.
Dialogue: 0,0:01:56.47,0:01:57.59,Default,,0000,0000,0000,,Pada saat genting ini...
Dialogue: 0,0:01:58.63,0:01:59.51,Default,,0000,0000,0000,,Iron.
Dialogue: 0,0:02:08.03,0:02:08.77,Default,,0000,0000,0000,,Ayuh.
Dialogue: 0,0:02:20.19,0:02:21.95,Default,,0000,0000,0000,,Saya sudah keliru.
Dialogue: 0,0:02:22.69,0:02:24.31,Default,,0000,0000,0000,,Apakah makhluk ini?
Dialogue: 0,0:02:24.87,0:02:26.21,Default,,0000,0000,0000,,Pemburu Sung.
Dialogue: 0,0:02:26.67,0:02:28.07,Default,,0000,0000,0000,,Kenapa dia akan muncul di sini?
Dialogue: 0,0:02:31.27,0:02:32.35,Default,,0000,0000,0000,,Pemburu Sung.
Dialogue: 0,0:02:32.63,0:02:33.84,Default,,0000,0000,0000,,Bilakah awak datang ke pulau ini?
Dialogue: 0,0:02:34.19,0:02:35.83,Default,,0000,0000,0000,,Selain itu, bagaimana awak datang?
Dialogue: 0,0:02:35.83,0:02:36.97,Default,,0000,0000,0000,,Saya akan jelaskan nanti.
Dialogue: 0,0:02:37.55,0:02:39.53,Default,,0000,0000,0000,,Biar saya merawat kecederaan kamu dulu.
Dialogue: 0,0:02:40.25,0:02:41.09,Default,,0000,0000,0000,,Sila minum ini.
Dialogue: 0,0:02:43.09,0:02:44.07,Default,,0000,0000,0000,,Oh ya.
Dialogue: 0,0:02:44.39,0:02:46.03,Default,,0000,0000,0000,,Benda ini tak dapat dipindahkan.
Dialogue: 0,0:02:47.69,0:02:48.73,Default,,0000,0000,0000,,Ubat oral?
Dialogue: 0,0:02:49.17,0:02:50.47,Default,,0000,0000,0000,,Adakah itu sihir ruang?
Dialogue: 0,0:02:50.81,0:02:51.51,Default,,0000,0000,0000,,Tuan Ma.
Dialogue: 0,0:02:53.39,0:02:54.69,Default,,0000,0000,0000,,Tolong buka mulut awak.
Dialogue: 0,0:02:59.47,0:03:00.65,Default,,0000,0000,0000,,Ini...
Dialogue: 0,0:03:05.41,0:03:06.29,Default,,0000,0000,0000,,Luka
Dialogue: 0,0:03:06.97,0:03:07.89,Default,,0000,0000,0000,,telah sembuh.
Dialogue: 0,0:03:16.49,0:03:17.73,Default,,0000,0000,0000,,Dia tidak pulih.
Dialogue: 0,0:03:18.43,0:03:19.57,Default,,0000,0000,0000,,Kenapa ia tak berkesan padanya?
Dialogue: 0,0:03:20.01,0:03:21.55,Default,,0000,0000,0000,,HP PENGGUNA TERLALU RENDAH,\NTAK DAPAT DIPULIHKAN MELALUI POSYEN
Dialogue: 0,0:03:22.23,0:03:23.87,Default,,0000,0000,0000,,Sama seperti masa itu?
Dialogue: 0,0:03:25.15,0:03:27.61,Default,,0000,0000,0000,,Habislah, nafasnya semakin lemah.
Dialogue: 0,0:03:28.73,0:03:30.91,Default,,0000,0000,0000,,Saya tak dapat merawat\Nkecederaan yang begitu serius.
Dialogue: 0,0:03:31.45,0:03:32.75,Default,,0000,0000,0000,,Cepat pergi dari sini.
Dialogue: 0,0:03:33.03,0:03:34.51,Default,,0000,0000,0000,,Saya akan membuka laluan.
Dialogue: 0,0:03:34.51,0:03:35.67,Default,,0000,0000,0000,,- Baiklah.\N- Tunggu.
Dialogue: 0,0:03:41.07,0:03:43.33,Default,,0000,0000,0000,,Makhluk itu datang tanpa henti.
Dialogue: 0,0:03:43.33,0:03:45.55,Default,,0000,0000,0000,,Jumlahnya terlalu banyak.
Dialogue: 0,0:03:50.01,0:03:50.85,Default,,0000,0000,0000,,Tuan.
Dialogue: 0,0:03:51.23,0:03:52.73,Default,,0000,0000,0000,,Bagaimana keadaan pasukan penyerang?
Dialogue: 0,0:03:53.03,0:03:54.25,Default,,0000,0000,0000,,Masih tak diketahui sekarang.
Dialogue: 0,0:03:54.25,0:03:57.39,Default,,0000,0000,0000,,Nampaknya terdapat gangguan isyarat\Nsementara di seluruh pulau.
Dialogue: 0,0:03:58.39,0:04:00.69,Default,,0000,0000,0000,,Kami telah cuba menghubungi pihak Jepun,
Dialogue: 0,0:04:00.69,0:04:01.91,Default,,0000,0000,0000,,tapi telah gagal juga.
Dialogue: 0,0:04:02.09,0:04:03.43,Default,,0000,0000,0000,,Begitu juga dengan media swasta.
Dialogue: 0,0:04:03.43,0:04:06.35,Default,,0000,0000,0000,,Gambaran terganggu\Nselepas semut hitam muncul.
Dialogue: 0,0:04:07.07,0:04:09.21,Default,,0000,0000,0000,,Cepat pulihkan komunikasi.
Dialogue: 0,0:04:09.83,0:04:13.03,Default,,0000,0000,0000,,Minta pasukan perubatan\Ndan pemulihan untuk bersedia.
Dialogue: 0,0:04:13.03,0:04:13.93,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:04:17.79,0:04:19.23,Default,,0000,0000,0000,,Saya tak pernah
Dialogue: 0,0:04:20.27,0:04:23.81,Default,,0000,0000,0000,,membenci tubuh\Ndan jantung sendiri seperti ini.
Dialogue: 0,0:04:25.37,0:04:27.17,Default,,0000,0000,0000,,Biarpun tak dapat bantu,
Dialogue: 0,0:04:27.51,0:04:29.27,Default,,0000,0000,0000,,saya juga nak berjuang bersama mereka.
Dialogue: 0,0:04:30.41,0:04:31.43,Default,,0000,0000,0000,,Tuan.
Dialogue: 0,0:04:32.13,0:04:32.97,Default,,0000,0000,0000,,Tolonglah.
Dialogue: 0,0:04:33.77,0:04:35.73,Default,,0000,0000,0000,,Kamu mesti selamat.
Dialogue: 0,0:04:39.15,0:04:41.63,Default,,0000,0000,0000,,Aduhai, apa yang berlaku?
Dialogue: 0,0:04:41.99,0:04:46.31,Default,,0000,0000,0000,,Saya ingat gambaran terganggu,\Ntapi televisyen pun telah rosak.
Dialogue: 0,0:04:46.31,0:04:47.55,Default,,0000,0000,0000,,Biar betul?
Dialogue: 0,0:04:47.55,0:04:49.69,Default,,0000,0000,0000,,Tiada guna awak memukulnya.
Dialogue: 0,0:04:50.09,0:04:52.53,Default,,0000,0000,0000,,Saya balik ke bilik sebentar.
Dialogue: 0,0:04:53.65,0:04:56.37,Default,,0000,0000,0000,,Mungkin saya dapat cari\Nsesuatu maklumat dalam telefon.
Dialogue: 0,0:04:59.93,0:05:01.49,Default,,0000,0000,0000,,Budak yang tidak sabar.
Dialogue: 0,0:05:02.89,0:05:05.19,Default,,0000,0000,0000,,Apa yang berlaku? Tolong jelaskan.
Dialogue: 0,0:05:05.65,0:05:08.15,Default,,0000,0000,0000,,Isyarat kemandirian\NEncik Goto telah terganggu.
Dialogue: 0,0:05:09.37,0:05:11.27,Default,,0000,0000,0000,,Berdasarkan komunikasi\Nsebelum gangguan isyarat
Dialogue: 0,0:05:11.65,0:05:15.77,Default,,0000,0000,0000,,dan juga reaksi musuh yang muncul\Npada masa itu, dia sepatutnya sudah mati.
Dialogue: 0,0:05:16.81,0:05:17.85,Default,,0000,0000,0000,,Apa lagi?
Dialogue: 0,0:05:18.07,0:05:19.55,Default,,0000,0000,0000,,Kami sedang kenal pasti sekarang.
Dialogue: 0,0:05:20.11,0:05:21.43,Default,,0000,0000,0000,,Cepat.
Dialogue: 0,0:05:21.81,0:05:24.21,Default,,0000,0000,0000,,Jika teruskan macam ini,\Nrancangan akan terjejas.
Dialogue: 0,0:05:25.85,0:05:26.65,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:05:31.91,0:05:33.89,Default,,0000,0000,0000,,Tak sangka Goto telah dibunuh.
Dialogue: 0,0:05:34.41,0:05:35.44,Default,,0000,0000,0000,,Tak berguna.
Dialogue: 0,0:05:36.75,0:05:38.99,Default,,0000,0000,0000,,Apa sebenarnya yang berlaku\Ndi pulau itu sekarang?
Dialogue: 0,0:05:48.35,0:05:50.87,Default,,0000,0000,0000,,Igris dan Iron mampu\Nmenangani keadaan ini.
Dialogue: 0,0:05:51.91,0:05:53.81,Default,,0000,0000,0000,,Namun, pasukan infantri\Nmelawan dengan susah.
Dialogue: 0,0:05:54.93,0:05:57.13,Default,,0000,0000,0000,,Saya ingin meningkatkan kuasa tempur,
Dialogue: 0,0:05:57.95,0:06:00.23,Default,,0000,0000,0000,,tapi ada ramai orang di sini.
Dialogue: 0,0:06:01.45,0:06:02.19,Default,,0000,0000,0000,,Tak.
Dialogue: 0,0:06:02.75,0:06:03.59,Default,,0000,0000,0000,,Semua.
Dialogue: 0,0:06:04.71,0:06:06.17,Default,,0000,0000,0000,,Jika berterusan, kita akan mati.
Dialogue: 0,0:06:06.51,0:06:08.75,Default,,0000,0000,0000,,Saya akan membuka laluan.
Dialogue: 0,0:06:09.25,0:06:10.09,Default,,0000,0000,0000,,Semua.
Dialogue: 0,0:06:11.43,0:06:13.39,Default,,0000,0000,0000,,Tolong ikut di belakangnya.
Dialogue: 0,0:06:14.03,0:06:16.73,Default,,0000,0000,0000,,Makhluk hitam yang lain\Nakan menghalang semut.
Dialogue: 0,0:06:17.75,0:06:20.05,Default,,0000,0000,0000,,Jika ada semut yang menyerang kamu,
Dialogue: 0,0:06:20.45,0:06:21.69,Default,,0000,0000,0000,,tolong menanganinya sendiri.
Dialogue: 0,0:06:22.11,0:06:23.15,Default,,0000,0000,0000,,Baiklah.
Dialogue: 0,0:06:23.37,0:06:25.29,Default,,0000,0000,0000,,Kami dapat lakukan itu.
Dialogue: 0,0:06:25.29,0:06:26.13,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:06:26.67,0:06:27.71,Default,,0000,0000,0000,,Selain itu,
Dialogue: 0,0:06:28.19,0:06:31.05,Default,,0000,0000,0000,,tolong jangan sebarkan\Napa-apa yang kamu lihat nanti.
Dialogue: 0,0:06:32.81,0:06:33.58,Default,,0000,0000,0000,,Jangan-jangan...
Dialogue: 0,0:06:55.85,0:06:57.47,Default,,0000,0000,0000,,Ia telah kembali.
Dialogue: 0,0:06:58.05,0:06:59.67,Default,,0000,0000,0000,,Adakah itu bermakna
Dialogue: 0,0:07:00.29,0:07:01.87,Default,,0000,0000,0000,,Goto telah dibunuh olehnya?
Dialogue: 0,0:07:19.97,0:07:22.37,Default,,0000,0000,0000,,Tiada raja di luar.
Dialogue: 0,0:07:23.21,0:07:24.81,Default,,0000,0000,0000,,Ada tak di sini?
Dialogue: 0,0:07:25.69,0:07:28.03,Default,,0000,0000,0000,,Orang yang digelar sebagai raja.
Dialogue: 0,0:07:29.87,0:07:32.57,Default,,0000,0000,0000,,Adakah bayangan pada tubuh Goto terputus
Dialogue: 0,0:07:32.95,0:07:34.29,Default,,0000,0000,0000,,kerana makhluk itu?
Dialogue: 0,0:07:35.13,0:07:35.77,Default,,0000,0000,0000,,Eh.
Dialogue: 0,0:07:35.77,0:07:36.89,Default,,0000,0000,0000,,Hei.
Dialogue: 0,0:07:56.96,0:08:01.24,Default,,0000,0000,0000,,Awaklah raja manusia?
Dialogue: 0,0:08:03.88,0:08:04.70,Default,,0000,0000,0000,,Oh.
Dialogue: 0,0:08:05.38,0:08:07.40,Default,,0000,0000,0000,,Serangga yang pandai bercakap.
Dialogue: 0,0:08:08.54,0:08:09.80,Default,,0000,0000,0000,,Manusia.
Dialogue: 0,0:08:12.44,0:08:14.50,Default,,0000,0000,0000,,Aura yang amat kuat.
Dialogue: 0,0:08:21.30,0:08:22.12,Default,,0000,0000,0000,,Memang begitu.
Dialogue: 0,0:08:22.50,0:08:24.04,Default,,0000,0000,0000,,Serangga cuma serangga.
Dialogue: 0,0:08:25.04,0:08:26.90,Default,,0000,0000,0000,,Bahkan Pemburu Sung...
Dialogue: 0,0:08:27.14,0:08:28.66,Default,,0000,0000,0000,,Untuk menghadapinya seorang diri...
Dialogue: 0,0:08:28.86,0:08:30.24,Default,,0000,0000,0000,,TIADA ISYARAT
Dialogue: 0,0:08:30.24,0:08:30.83,Default,,0000,0000,0000,,HELO
Dialogue: 0,0:08:34.18,0:08:36.36,Default,,0000,0000,0000,,Pengarah, gambaran telah pulih.
Dialogue: 0,0:08:37.22,0:08:38.00,Default,,0000,0000,0000,,Eh.
Dialogue: 0,0:08:38.00,0:08:39.16,Default,,0000,0000,0000,,Ini ialah...
Dialogue: 0,0:08:39.88,0:08:41.90,Default,,0000,0000,0000,,Mulakan siaran, cepat!
Dialogue: 0,0:08:41.90,0:08:42.76,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:08:42.76,0:08:45.92,Default,,0000,0000,0000,,Jika kita mulakan siaran,\Nia akan disiarkan secara langsung.
Dialogue: 0,0:08:46.20,0:08:48.94,Default,,0000,0000,0000,,Jika sesuatu berlaku,\Nkita tak sempat menanganinya.
Dialogue: 0,0:08:48.94,0:08:51.08,Default,,0000,0000,0000,,Kita sudah terputus sekali,
Dialogue: 0,0:08:51.08,0:08:52.66,Default,,0000,0000,0000,,tiada keadaan yang lebih teruk lagi.
Dialogue: 0,0:08:52.66,0:08:53.30,Default,,0000,0000,0000,,Siarkannya.
Dialogue: 0,0:08:53.30,0:08:54.39,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:08:55.08,0:08:56.12,Default,,0000,0000,0000,,Kita...
Dialogue: 0,0:08:56.52,0:08:57.20,Default,,0000,0000,0000,,Tak.
Dialogue: 0,0:08:57.46,0:08:59.10,Default,,0000,0000,0000,,Nasib pertempuran ini
Dialogue: 0,0:08:59.46,0:09:01.16,Default,,0000,0000,0000,,bergantung pada orang ini.
Dialogue: 0,0:09:02.32,0:09:03.78,Default,,0000,0000,0000,,Encik Song.
Dialogue: 0,0:09:03.78,0:09:04.76,Default,,0000,0000,0000,,Jangan-jangan...
Dialogue: 0,0:09:05.62,0:09:06.74,Default,,0000,0000,0000,,Ini ialah...
Dialogue: 0,0:09:12.86,0:09:13.86,Default,,0000,0000,0000,,Biar betul?
Dialogue: 0,0:09:14.18,0:09:15.30,Default,,0000,0000,0000,,Kenapa?
Dialogue: 0,0:09:16.30,0:09:17.68,Default,,0000,0000,0000,,Abang?
Dialogue: 0,0:09:18.06,0:09:20.10,Default,,0000,0000,0000,,Dia kata "keluar sebentar"...
Dialogue: 0,0:09:20.10,0:09:21.22,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:09:21.22,0:09:22.90,Default,,0000,0000,0000,,Dia masuk campur lagi?
Dialogue: 0,0:09:25.28,0:09:28.24,Default,,0000,0000,0000,,Awak telah datang, Pemburu Sung?
Dialogue: 0,0:09:29.56,0:09:30.70,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:09:31.08,0:09:32.26,Default,,0000,0000,0000,,bagaimana dia dapat pergi ke pulau itu?
Dialogue: 0,0:09:32.64,0:09:34.90,Default,,0000,0000,0000,,Hal itu tak penting sekarang.
Dialogue: 0,0:09:35.46,0:09:37.12,Default,,0000,0000,0000,,Mari kita mempercayainya.
Dialogue: 0,0:09:50.58,0:09:53.34,Default,,0000,0000,0000,,Kenapa penyihir hendak mendekati musuh?
Dialogue: 0,0:09:53.34,0:09:55.16,Default,,0000,0000,0000,,Dia terlalu memandang rendah semut.
Dialogue: 0,0:09:55.70,0:09:57.58,Default,,0000,0000,0000,,Dia kena pukulan terus.
Dialogue: 0,0:09:58.50,0:09:59.52,Default,,0000,0000,0000,,Lemahnya.
Dialogue: 0,0:10:00.14,0:10:01.66,Default,,0000,0000,0000,,Awak memang bukan...
Dialogue: 0,0:10:25.42,0:10:26.34,Default,,0000,0000,0000,,Tuan Baek.
Dialogue: 0,0:10:26.68,0:10:27.66,Default,,0000,0000,0000,,Tuan Choi.
Dialogue: 0,0:10:28.58,0:10:30.86,Default,,0000,0000,0000,,Benarkah dia pemburu jenis penyihir?
Dialogue: 0,0:10:31.14,0:10:33.54,Default,,0000,0000,0000,,Saya pun sudah tidak pasti.
Dialogue: 0,0:10:34.00,0:10:35.92,Default,,0000,0000,0000,,Tak sangka dia begitu kuat.
Dialogue: 0,0:10:37.32,0:10:38.84,Default,,0000,0000,0000,,Dia sangat keras.
Dialogue: 0,0:10:39.40,0:10:40.45,Default,,0000,0000,0000,,Adakah sebab dia ada cangkerang?
Dialogue: 0,0:10:58.98,0:11:00.42,Default,,0000,0000,0000,,Kenapa ada pertempuran yang begitu sengit?
Dialogue: 0,0:11:00.86,0:11:03.66,Default,,0000,0000,0000,,Sebagai tahap A, saya sudah\Nkehabisan tenaga hanya dengan berdiri.
Dialogue: 0,0:11:05.38,0:11:06.92,Default,,0000,0000,0000,,Sekadar impak kuasa sihir
Dialogue: 0,0:11:07.20,0:11:08.52,Default,,0000,0000,0000,,sudah hampir\Nmembuat saya hilang kesedaran.
Dialogue: 0,0:11:13.68,0:11:14.92,Default,,0000,0000,0000,,Tak sangka
Dialogue: 0,0:11:15.18,0:11:16.94,Default,,0000,0000,0000,,saya akan kalah.
Dialogue: 0,0:11:28.42,0:11:29.92,Default,,0000,0000,0000,,Kenapa?
Dialogue: 0,0:11:31.32,0:11:32.82,Default,,0000,0000,0000,,Siapakah sebenarnya
Dialogue: 0,0:11:33.68,0:11:36.60,Default,,0000,0000,0000,,manusia ini?
Dialogue: 0,0:12:02.42,0:12:03.56,Default,,0000,0000,0000,,Ini ialah...
Dialogue: 0,0:12:04.42,0:12:10.60,Default,,0000,0000,0000,,Ini racun yang saya ekstrak daripada toksin\Nhidupan laut di sekitar dengan kuasa sihir.
Dialogue: 0,0:12:10.80,0:12:13.10,Default,,0000,0000,0000,,Awak sudah tak dapat gerak.
Dialogue: 0,0:12:15.24,0:12:18.26,Default,,0000,0000,0000,,Habislah awak sekarang.
Dialogue: 0,0:12:20.68,0:12:21.86,Default,,0000,0000,0000,,Manusia.
Dialogue: 0,0:12:22.50,0:12:23.66,Default,,0000,0000,0000,,Matilah!
Dialogue: 0,0:12:28.14,0:12:30.36,Default,,0000,0000,0000,,Tujuh daripada sepuluh orang mati.
Dialogue: 0,0:12:30.36,0:12:32.04,Default,,0000,0000,0000,,Adakah ini gurauan?
Dialogue: 0,0:12:32.54,0:12:34.28,Default,,0000,0000,0000,,Tak, ini kebenaran.
Dialogue: 0,0:12:34.76,0:12:37.04,Default,,0000,0000,0000,,Kami telah menghubungi\Npemburu yang tinggal
Dialogue: 0,0:12:37.04,0:12:38.42,Default,,0000,0000,0000,,dan membuat pengesahan.
Dialogue: 0,0:12:40.84,0:12:42.90,Default,,0000,0000,0000,,Lebih daripada separuh telah mati?
Dialogue: 0,0:12:42.90,0:12:44.70,Default,,0000,0000,0000,,Kenapa kamu begitu lemah?
Dialogue: 0,0:12:45.40,0:12:46.56,Default,,0000,0000,0000,,Selain itu,
Dialogue: 0,0:12:46.56,0:12:49.79,Default,,0000,0000,0000,,reaksi yang kuat muncul\Ndi sekitar kawah lagi.
Dialogue: 0,0:12:50.26,0:12:52.75,Default,,0000,0000,0000,,Ia sepatutnya individu\Nyang membunuh Encik Goto.
Dialogue: 0,0:12:53.10,0:12:55.68,Default,,0000,0000,0000,,Bagaimana ia masih dapat hidup\Njika melawan Goto?
Dialogue: 0,0:12:55.68,0:12:57.44,Default,,0000,0000,0000,,Awak kata ia menuju ke sarang?
Dialogue: 0,0:12:57.44,0:12:58.40,Default,,0000,0000,0000,,Kenapa?
Dialogue: 0,0:12:58.40,0:12:59.42,Default,,0000,0000,0000,,Saya tak pasti.
Dialogue: 0,0:12:59.80,0:13:01.47,Default,,0000,0000,0000,,Mungkin ia ada motif tertentu.
Dialogue: 0,0:13:01.90,0:13:03.68,Default,,0000,0000,0000,,Mungkin ia pulang\Nke sarang sebab tercedera.
Dialogue: 0,0:13:05.84,0:13:08.44,Default,,0000,0000,0000,,Keadaan pemburu masih belum diketahui.
Dialogue: 0,0:13:08.76,0:13:10.58,Default,,0000,0000,0000,,Namun, mereka akan\Nmenemuinya jika masih hidup.
Dialogue: 0,0:13:10.90,0:13:12.78,Default,,0000,0000,0000,,Bahkan Goto pun tak dapat mengalahkannya,
Dialogue: 0,0:13:13.10,0:13:15.12,Default,,0000,0000,0000,,mereka yang kelelahan\Ntakkan mampu melawannya.
Dialogue: 0,0:13:15.52,0:13:17.90,Default,,0000,0000,0000,,Semut sepatutnya juga habiskan banyak\Ntenaga untuk pertempuran yang berterusan.
Dialogue: 0,0:13:18.82,0:13:20.84,Default,,0000,0000,0000,,Selagi kita dapat membunuhnya,
Dialogue: 0,0:13:21.32,0:13:23.36,Default,,0000,0000,0000,,semut yang lain cumalah masalah remeh.
Dialogue: 0,0:13:24.94,0:13:26.52,Default,,0000,0000,0000,,Masih ada peluang.
Dialogue: 0,0:13:27.18,0:13:29.83,Default,,0000,0000,0000,,Segera hubungi tiga pemburu\Nyang masih hidup.
Dialogue: 0,0:13:30.46,0:13:33.48,Default,,0000,0000,0000,,Selepas bertemu dengan\Npasukan penyerang kedua di laut,
Dialogue: 0,0:13:33.48,0:13:34.80,Default,,0000,0000,0000,,segera lakukan serangan lagi.
Dialogue: 0,0:13:35.78,0:13:37.00,Default,,0000,0000,0000,,Inilah arahannya.
Dialogue: 0,0:13:37.24,0:13:39.26,Default,,0000,0000,0000,,Ada helikopter yang akan\Nmenjemput kamu sekarang.
Dialogue: 0,0:13:40.20,0:13:41.18,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:13:43.54,0:13:45.08,Default,,0000,0000,0000,,Rancangan nombor sembilan\Nakan dilaksanakan.
Dialogue: 0,0:13:45.56,0:13:46.52,Default,,0000,0000,0000,,Ayuh.
Dialogue: 0,0:13:47.00,0:13:47.96,Default,,0000,0000,0000,,Tak boleh.
Dialogue: 0,0:13:48.96,0:13:50.96,Default,,0000,0000,0000,,Itu raksasa.
Dialogue: 0,0:13:51.60,0:13:54.04,Default,,0000,0000,0000,,Kita tak mampu mengalahkannya.
Dialogue: 0,0:13:55.04,0:13:56.18,Default,,0000,0000,0000,,Kuatkan semangat!
Dialogue: 0,0:13:56.40,0:13:57.76,Default,,0000,0000,0000,,Tunjukkan keberanian awak!
Dialogue: 0,0:13:58.16,0:14:00.20,Default,,0000,0000,0000,,Mustahil kita dapat\Nmengalahkan makhluk seperti itu.
Dialogue: 0,0:14:00.64,0:14:01.36,Default,,0000,0000,0000,,Kita harus larikan diri.
Dialogue: 0,0:14:01.64,0:14:03.40,Default,,0000,0000,0000,,Jika tak, kita akan dibunuh!
Dialogue: 0,0:14:05.22,0:14:06.44,Default,,0000,0000,0000,,Memalukan.
Dialogue: 0,0:14:07.02,0:14:08.24,Default,,0000,0000,0000,,Sekarang,
Dialogue: 0,0:14:09.06,0:14:10.06,Default,,0000,0000,0000,,kita terpaksa maju.
Dialogue: 0,0:14:31.58,0:14:33.46,Default,,0000,0000,0000,,Bukankah dia kena racun?
Dialogue: 0,0:14:33.46,0:14:35.26,Default,,0000,0000,0000,,Dia tidak tercedera?
Dialogue: 0,0:14:36.52,0:14:39.26,Default,,0000,0000,0000,,Saya takkan hairan\Ndengan apa-apa yang berlaku lagi.
Dialogue: 0,0:14:40.54,0:14:42.44,Default,,0000,0000,0000,,Jadi, awak ada senjata rahsia?
Dialogue: 0,0:14:43.82,0:14:46.40,Default,,0000,0000,0000,,Patutlah awak nampak yakin.
Dialogue: 0,0:14:46.62,0:14:47.37,Default,,0000,0000,0000,,AKTIFKAN: KESIHATAN DAN KELANJUTAN USIA
Dialogue: 0,0:14:47.37,0:14:48.58,Default,,0000,0000,0000,,NYAHTOKSIN SELESAI\NAKTIFKAN: KESIHATAN DAN KELANJUTAN USIA
Dialogue: 0,0:14:49.52,0:14:50.24,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:14:50.58,0:14:52.64,Default,,0000,0000,0000,,entah sebab daya persepsi saya meningkat,
Dialogue: 0,0:14:53.16,0:14:54.96,Default,,0000,0000,0000,,saya dapat merasakan emosinya
Dialogue: 0,0:14:55.98,0:14:57.20,Default,,0000,0000,0000,,dan juga kecemasannya.
Dialogue: 0,0:14:58.40,0:15:00.00,Default,,0000,0000,0000,,Saya pun sama sebenarnya.
Dialogue: 0,0:15:02.26,0:15:03.48,Default,,0000,0000,0000,,Setiap saat penting sekarang.
Dialogue: 0,0:15:04.32,0:15:05.58,Default,,0000,0000,0000,,Saya harus menamatkan\Npertempuran ini secepat mungkin.
Dialogue: 0,0:15:16.86,0:15:18.38,Default,,0000,0000,0000,,Racun tidak berkesan terhadapnya.
Dialogue: 0,0:15:18.38,0:15:20.40,Default,,0000,0000,0000,,Persaingan kekuatan adalah tak bermakna.
Dialogue: 0,0:15:21.22,0:15:22.02,Default,,0000,0000,0000,,Jika begitu...
Dialogue: 0,0:15:43.59,0:15:44.42,Default,,0000,0000,0000,,ITEM: BELATI RAJA IBLIS\NADA KESAN SET APABILA DUA BILAH DIGUNAKAN
Dialogue: 0,0:16:36.46,0:16:38.98,Default,,0000,0000,0000,,Kelajuannya setanding dengan saya,
Dialogue: 0,0:16:40.00,0:16:42.52,Default,,0000,0000,0000,,malah semakin cepat.
Dialogue: 0,0:16:43.62,0:16:45.64,Default,,0000,0000,0000,,Kenapa ada perkara sebegini?
Dialogue: 0,0:17:43.79,0:17:44.13,Default,,0000,0000,0000,,KEMAHIRAN "SERANGAN TITIK MAUT" TELAH\NDITINGKATKAN KE VERSI MUKTAMAD, "MUTILASI"
Dialogue: 0,0:17:44.17,0:17:44.50,Default,,0000,0000,0000,,SERANGAN TITIK MAUT\NDITINGKATKAN MENJADI MUTILASI
Dialogue: 0,0:17:45.50,0:17:46.86,Default,,0000,0000,0000,,Peningkatan.
Dialogue: 0,0:17:47.62,0:17:48.52,Default,,0000,0000,0000,,Mutilasi?
Dialogue: 0,0:17:53.56,0:17:55.01,Default,,0000,0000,0000,,Apa yang berlaku?
Dialogue: 0,0:18:00.04,0:18:01.10,Default,,0000,0000,0000,,Habislah.
Dialogue: 0,0:18:05.24,0:18:06.50,Default,,0000,0000,0000,,Keupayaan penyembuhan?
Dialogue: 0,0:18:07.76,0:18:09.18,Default,,0000,0000,0000,,Apa yang berlaku?
Dialogue: 0,0:18:12.10,0:18:14.16,Default,,0000,0000,0000,,Apa sebenarnya yang berlaku tadi?
Dialogue: 0,0:18:38.68,0:18:42.02,Default,,0000,0000,0000,,Siapakah manusia itu?
Dialogue: 0,0:18:42.54,0:18:46.32,Default,,0000,0000,0000,,Manusia itu...
Dialogue: 0,0:18:50.44,0:18:51.40,Default,,0000,0000,0000,,Maju.
Dialogue: 0,0:19:15.78,0:19:16.84,Default,,0000,0000,0000,,Kenapa?
Dialogue: 0,0:19:17.80,0:19:21.46,Default,,0000,0000,0000,,Saya sepatutnya\Nberada di atas sesiapa saja.
Dialogue: 0,0:19:22.56,0:19:24.58,Default,,0000,0000,0000,,Saya sepatutnya menelan segalanya,
Dialogue: 0,0:19:24.58,0:19:28.60,Default,,0000,0000,0000,,terus tumbuh dan menuju puncak.
Dialogue: 0,0:19:28.86,0:19:30.84,Default,,0000,0000,0000,,Saya sepatutnya raja,
Dialogue: 0,0:19:30.84,0:19:32.54,Default,,0000,0000,0000,,tapi sekarang...
Dialogue: 0,0:19:35.22,0:19:36.52,Default,,0000,0000,0000,,Lari.
Dialogue: 0,0:19:37.46,0:19:39.16,Default,,0000,0000,0000,,Saya harus segera lari.
Dialogue: 0,0:19:39.74,0:19:40.96,Default,,0000,0000,0000,,Untuk kekal hidup,
Dialogue: 0,0:19:41.62,0:19:43.78,Default,,0000,0000,0000,,saya harus segera lari.
Dialogue: 0,0:19:47.42,0:19:49.40,Default,,0000,0000,0000,,Lari sejauh mungkin.
Dialogue: 0,0:20:08.18,0:20:09.96,Default,,0000,0000,0000,,Cepat.
Dialogue: 0,0:20:10.44,0:20:12.42,Default,,0000,0000,0000,,Cepat lari ke tempat jauh.
Dialogue: 0,0:20:16.74,0:20:17.95,Default,,0000,0000,0000,,GUNA KEMAHIRAN "MUTILASI"
Dialogue: 0,0:20:30.84,0:20:31.25,Default,,0000,0000,0000,,ANDA TELAH MEMBUNUH MUSUH
Dialogue: 0,0:20:31.25,0:20:32.80,Default,,0000,0000,0000,,NAIK TAHAP
Dialogue: 0,0:20:45.76,0:20:46.82,Default,,0000,0000,0000,,Semua semut itu...
Dialogue: 0,0:20:47.18,0:20:48.60,Default,,0000,0000,0000,,Sudah lari.
Dialogue: 0,0:20:48.84,0:20:50.06,Default,,0000,0000,0000,,Adakah kita menang?
Dialogue: 0,0:20:53.76,0:20:54.80,Default,,0000,0000,0000,,Pemburu Sung.
Dialogue: 0,0:21:01.72,0:21:02.72,Default,,0000,0000,0000,,Nafasnya sudah...
Dialogue: 0,0:21:03.12,0:21:04.64,Default,,0000,0000,0000,,Setiap saat penting sekarang.
Dialogue: 0,0:21:05.16,0:21:06.66,Default,,0000,0000,0000,,Kita segera pergi dari sini.
Dialogue: 0,0:21:06.66,0:21:09.12,Default,,0000,0000,0000,,Helikopter pemindahan\Nada di luar sekarang.
Dialogue: 0,0:21:09.12,0:21:10.00,Default,,0000,0000,0000,,Selagi kita menaikinya...
Dialogue: 0,0:21:10.00,0:21:10.72,Default,,0000,0000,0000,,Tak.
Dialogue: 0,0:21:10.94,0:21:12.32,Default,,0000,0000,0000,,Saya tak pasti dia dapat tahan atau tidak.
Dialogue: 0,0:21:12.60,0:21:14.00,Default,,0000,0000,0000,,Jika begitu, apa yang patut...
Dialogue: 0,0:21:17.94,0:21:19.98,Default,,0000,0000,0000,,Bukankah ubat itu tak berkesan?
Dialogue: 0,0:21:19.98,0:21:21.44,Default,,0000,0000,0000,,Ini belum dicuba.
Dialogue: 0,0:21:26.60,0:21:29.54,Default,,0000,0000,0000,,Eliksir Kehidupan\Nyang menyembuhkan narkolepsi ibu.
Dialogue: 0,0:21:30.12,0:21:31.02,Default,,0000,0000,0000,,Inilah
Dialogue: 0,0:21:31.66,0:21:33.20,Default,,0000,0000,0000,,cara terakhir.
Dialogue: 0,0:21:34.86,0:21:36.16,Default,,0000,0000,0000,,KEADAAN PENGGUNA DI LUAR LINGKUNGAN\NRAWATAN UBAT INI, JADI IA TIDAK BERKESAN
Dialogue: 0,0:21:36.16,0:21:38.74,Default,,0000,0000,0000,,"Di luar lingkungan rawatan".
Dialogue: 0,0:21:42.00,0:21:43.26,Default,,0000,0000,0000,,Tidak berguna?
Dialogue: 0,0:21:44.40,0:21:46.38,Default,,0000,0000,0000,,Kita takkan sempat jika keluar sekarang.
Dialogue: 0,0:21:46.64,0:21:47.80,Default,,0000,0000,0000,,Posyen pun tak berguna.
Dialogue: 0,0:21:48.28,0:21:51.12,Default,,0000,0000,0000,,"Pertukaran Bayangan" juga perlu masa\Nsebelum dapat digunakan lagi.
Dialogue: 0,0:21:52.42,0:21:53.32,Default,,0000,0000,0000,,Sudah tiada
Dialogue: 0,0:21:54.16,0:21:55.90,Default,,0000,0000,0000,,cara lain yang dapat digunakan?
Dialogue: 0,0:22:42.21,0:22:44.88,Default,,0000,0000,0000,,(Solo Leveling)
Dialogue: 0,0:22:44.88,0:22:48.39,Default,,0000,0000,0000,,(Episod 24: Adakah Awak Raja Manusia?)
Dialogue: 0,0:23:39.10,0:23:41.15,Default,,0000,0000,0000,,(Episod 25: Menuju Sasaran Seterusnya)
