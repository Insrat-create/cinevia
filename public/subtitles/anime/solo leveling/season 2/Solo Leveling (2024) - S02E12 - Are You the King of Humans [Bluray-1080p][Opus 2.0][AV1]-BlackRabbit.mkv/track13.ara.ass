Dialogue: 0,0:00:08.84,0:00:10.04,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫من هؤلاء...
Dialogue: 0,0:00:11.45,0:00:13.91,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫الجنود السود؟!
Dialogue: 0,0:00:37.81,0:00:39.70,Default,Baek Yoonho,0000,0000,0000,,‫من أين أتوا؟
Dialogue: 0,0:00:46.87,0:00:49.00,Default,Choi Jong-in,0000,0000,0000,,‫مـ-مستحيل...
Dialogue: 0,0:00:50.15,0:00:51.15,Default,Choi Jong-in,0000,0000,0000,,‫كيف؟
Dialogue: 0,0:00:51.15,0:00:53.07,Default,Lim Tae-gyu,0000,0000,0000,,‫ما الذي يفعله هنا؟
Dialogue: 0,0:01:03.12,0:01:08.58,Default,Lee Joohee,0000,0000,0000,,‫سونغ-سان، هذا يعني أنّ البث توقّف، أليس كذلك؟
Dialogue: 0,0:01:10.80,0:01:14.06,Default,Song Chiyul,0000,0000,0000,,‫ما الذي يحدث هناك بالضبط؟
Dialogue: 0,0:01:17.27,0:01:20.06,Default,Woo Jinchul,0000,0000,0000,,‫لا فائدة. هناك الكثير من الفوضى في الموقع.
Dialogue: 0,0:01:20.43,0:01:22.98,Default,Go Gunhee,0000,0000,0000,,‫نحتاج للتأكّد من حالة صيادينا.
Dialogue: 0,0:01:23.25,0:01:25.02,Default,Go Gunhee,0000,0000,0000,,‫اجمعوا كل المعلومات الممكنة.
Dialogue: 0,0:01:25.02,0:01:25.97,Default,Woo Jinchul,0000,0000,0000,,‫حاضر.
Dialogue: 0,0:01:27.91,0:01:29.00,Default,Staff,0000,0000,0000,,‫أيها المدير!
Dialogue: 0,0:01:29.00,0:01:32.84,Default,Staff,0000,0000,0000,,‫الاتصالات تنهال بسرعة لدرجة أن \N‫نظام الهاتف يتعطل!
Dialogue: 0,0:01:32.84,0:01:35.21,Default,Staff,0000,0000,0000,,‫يطالبون بإعادة البث!
Dialogue: 0,0:01:35.21,0:01:37.03,Default,Director,0000,0000,0000,,‫كنا لنفعل لو أمكننا ذلك!
Dialogue: 0,0:01:37.03,0:01:40.45,Default,Director,0000,0000,0000,,‫لكننا لا نتلقى أي أخبار من \N‫الموقع، فضلًا عن أي فيديو!
Dialogue: 0,0:01:41.59,0:01:45.87,DefaultItalics,Director,0000,0000,0000,,‫وأيضًا... ماذا سنفعل إن كان\N‫كل صيادي الدرجة س قد ماتوا؟!
Dialogue: 0,0:01:48.23,0:01:51.63,Default,Director,0000,0000,0000,,‫أجبني! ما الذي يجري هناك؟!
Dialogue: 0,0:01:53.25,0:01:55.76,Default,Cameraman,0000,0000,0000,,‫اللعنة! الكاميرا لا تعمل...
Dialogue: 0,0:01:55.76,0:01:57.36,Default,Cameraman,0000,0000,0000,,‫الآن من بين كل الأوقات!
Dialogue: 0,0:01:58.22,0:01:59.03,Default,Sung Jinwoo,0000,0000,0000,,‫أيرن!
Dialogue: 0,0:02:07.60,0:02:08.54,Default,Sung Jinwoo,0000,0000,0000,,‫انطلقوا.
Dialogue: 0,0:02:19.89,0:02:21.79,Default,Ma Dongwook,0000,0000,0000,,‫لا أفهم أي شيء من هذا.
Dialogue: 0,0:02:22.38,0:02:24.42,Default,Ma Dongwook,0000,0000,0000,,‫من هم هؤلاء الظلال؟
Dialogue: 0,0:02:24.42,0:02:28.14,Default,Ma Dongwook,0000,0000,0000,,‫وكيف للصياد سون أن يكون هنا أساسًا؟
Dialogue: 0,0:02:30.94,0:02:33.61,Default,Baek Yoonho,0000,0000,0000,,‫أيها الصياد سون! متى وصلت إلى الجزيرة؟
Dialogue: 0,0:02:33.95,0:02:35.53,Default,Baek Yoonho,0000,0000,0000,,‫وكيف؟
Dialogue: 0,0:02:35.53,0:02:36.82,Default,Sung Jinwoo,0000,0000,0000,,‫يمكنني الشرح لاحقًا.
Dialogue: 0,0:02:37.18,0:02:39.57,Default,Sung Jinwoo,0000,0000,0000,,‫دعوني أعالج جراحكم أوّلًا.
Dialogue: 0,0:02:39.57,0:02:40.94,Default,Sung Jinwoo,0000,0000,0000,,‫اشرب هذا.
Dialogue: 0,0:02:42.77,0:02:46.08,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫هذا صحيح، لا يمكنني نقل هذه...
Dialogue: 0,0:02:47.36,0:02:50.40,Default,Ma Dongwook,0000,0000,0000,,‫هل هو دواء ما؟ من سحر الاستدعاء؟
Dialogue: 0,0:02:50.40,0:02:51.54,Default,Sung Jinwoo,0000,0000,0000,,‫سيد ما.
Dialogue: 0,0:02:53.03,0:02:54.75,Default,Sung Jinwoo,0000,0000,0000,,‫افتح فمك رجاءً.
Dialogue: 0,0:02:59.16,0:03:00.54,Default,Ma Dongwook,0000,0000,0000,,‫ما هذا...
Dialogue: 0,0:03:04.93,0:03:07.66,Default,Baek Yoonho,0000,0000,0000,,‫جراحي... شُفيت.
Dialogue: 0,0:03:16.11,0:03:17.61,Default,Baek Yoonho,0000,0000,0000,,‫إنّها لا تتعافى.
Dialogue: 0,0:03:18.02,0:03:19.40,Default,Baek Yoonho,0000,0000,0000,,‫لماذا لا يعمل؟
Dialogue: 0,0:03:21.91,0:03:23.58,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫هذا تمامًا كما حدث سابقًا.
Dialogue: 0,0:03:24.81,0:03:27.34,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫هذا سيّئ. هالتها تضعف أكثر فأكثر.
Dialogue: 0,0:03:28.32,0:03:31.01,Default,Sung Jinwoo,0000,0000,0000,,‫إصابته شديدة لدرجة أني لا أستطيع شفاءها.
Dialogue: 0,0:03:31.01,0:03:33.97,Default,Sung Jinwoo,0000,0000,0000,,‫علينا الخروج من هنا بسرعة. سأفتح لنا طريقًا.
Dialogue: 0,0:03:33.97,0:03:34.71,Default,Ma Dongwook,0000,0000,0000,,‫حسنًا.
Dialogue: 0,0:03:34.71,0:03:35.74,Default,Baek Yoonho,0000,0000,0000,,‫مهلًا!
Dialogue: 0,0:03:40.75,0:03:43.00,Default,Lim Tae-gyu,0000,0000,0000,,‫إنها تحتشد مثل الحشرات أيضًا.
Dialogue: 0,0:03:43.00,0:03:45.39,Default,Baek Yoonho,0000,0000,0000,,‫عددها كبير جدًّا!
Dialogue: 0,0:03:49.66,0:03:50.85,Default,Associates,0000,0000,0000,,‫أيها الرئيس!
Dialogue: 0,0:03:50.85,0:03:52.68,Default,Go Gunhee,0000,0000,0000,,‫ما حالة فريق الهجوم؟
Dialogue: 0,0:03:52.68,0:03:53.99,Default,BG Associate A,0000,0000,0000,,‫ما زلنا لا نعلم.
Dialogue: 0,0:03:53.99,0:03:57.61,Default,BG Associate A,0000,0000,0000,,‫شيء ما أوقف الاتصالات مؤقتًا من الجزيرة.
Dialogue: 0,0:03:58.05,0:04:01.73,Default,BG Associate B,0000,0000,0000,,‫نحاول التواصل مع  القيادة اليابانية،\N‫لكن لا نستطيع الاتصال بهم..
Dialogue: 0,0:04:01.73,0:04:06.17,Default,BG Associate C,0000,0000,0000,,‫وسائل الإعلام المدنية لم ترَ شيئًا \N‫منذ ظهور النملة السوداء أيضًا.
Dialogue: 0,0:04:06.70,0:04:08.97,Default,Go Gunhee,0000,0000,0000,,‫علينا أن نستعيد الإشارة بأسرع وقت ممكن!
Dialogue: 0,0:04:09.44,0:04:12.63,Default,Go Gunhee,0000,0000,0000,,‫تأكدّوا من استعداد فرق الإسعاف\N‫والإنقاذ للتحرك فورًا!
Dialogue: 0,0:04:12.63,0:04:13.71,Default,Associates,0000,0000,0000,,‫حاضر!
Dialogue: 0,0:04:17.39,0:04:18.83,Default,Go Gunhee,0000,0000,0000,,‫لم أشعر يومًا...
Dialogue: 0,0:04:19.86,0:04:23.71,Default,Go Gunhee,0000,0000,0000,,‫بهذا القدر من الحقد تجاه \N‫جسدي وقلبي المتقدمين في السن.
Dialogue: 0,0:04:24.76,0:04:29.09,Default,Go Gunhee,0000,0000,0000,,‫حتى لو لم أتمكن من المساعدة، \N‫أتمنى لو أمكنني القتال إلى جانبهم.
Dialogue: 0,0:04:30.01,0:04:31.31,Default,Woo Jinchul,0000,0000,0000,,‫سيدي الرئيس...
Dialogue: 0,0:04:31.73,0:04:35.47,Default,Go Gunhee,0000,0000,0000,,‫أرجو... أرجو أن يكون الجميع بخير.
Dialogue: 0,0:04:38.84,0:04:41.32,Default,Sung Jinah,0000,0000,0000,,‫تبًّا! ما هذا؟!
Dialogue: 0,0:04:41.66,0:04:47.20,Default,Sung Jinah,0000,0000,0000,,‫انقطع البث أوّلًا، والآن تعطّل التلفاز؟! غير معقول!
Dialogue: 0,0:04:47.20,0:04:49.75,Default,Park Kyunghye,0000,0000,0000,,‫لا أظنّ أنّ هذا يساعد.
Dialogue: 0,0:04:49.75,0:04:52.31,Default,Sung Jinah,0000,0000,0000,,‫سأشاهد في غرفتي.
Dialogue: 0,0:04:53.23,0:04:56.13,Default,Sung Jinah,0000,0000,0000,,‫قد أجد بعض التحديثات على هاتفي.
Dialogue: 0,0:04:59.50,0:05:01.34,Default,Park Kyunghye,0000,0000,0000,,‫فتاة لا تهدأ.
Dialogue: 0,0:05:02.47,0:05:05.16,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫ما الذي يحدث؟ فسّر لي.
Dialogue: 0,0:05:05.16,0:05:07.97,Default,Sugimoto Reiji,0000,0000,0000,,‫توقفت إشارات غوتو الحيوية.
Dialogue: 0,0:05:08.95,0:05:11.27,Default,Sugimoto Reiji,0000,0000,0000,,‫مما استطعنا معرفته قبل انقطاع الإشارة،
Dialogue: 0,0:05:11.27,0:05:14.09,Default,Sugimoto Reiji,0000,0000,0000,,‫فقد ظهر عدو قوي.
Dialogue: 0,0:05:14.09,0:05:15.84,Default,Sugimoto Reiji,0000,0000,0000,,‫من المحتمل أنه قُتل.
Dialogue: 0,0:05:16.51,0:05:17.68,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫والبقية؟
Dialogue: 0,0:05:17.68,0:05:19.68,Default,Sugimoto Reiji,0000,0000,0000,,‫نقوم بالتحقق الآن.
Dialogue: 0,0:05:19.68,0:05:21.35,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫حسنًا، أسرعوا!
Dialogue: 0,0:05:21.35,0:05:24.03,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫أي خسائر إضافية ستؤثر علينا \N‫في المرحلة القادمة.
Dialogue: 0,0:05:25.35,0:05:26.41,DefaultItalics,Sugimoto Reiji,0000,0000,0000,,‫نعم.
Dialogue: 0,0:05:31.58,0:05:35.19,Default,Matsumoto Shigeo,0000,0000,0000,,‫غوتو قُتل؟ ذلك الأحمق عديم الفائدة!
Dialogue: 0,0:05:36.34,0:05:38.90,Default,Matsumoto Shigeo,0000,0000,0000,,‫ما الذي يحدث في تلك الجزيرة بالضبط؟
Dialogue: 0,0:05:47.98,0:05:50.68,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫النخبة مثل إيغريس وأيرن يبلون حسنًا،
Dialogue: 0,0:05:51.33,0:05:53.76,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لكن الجنود العاديين في موقف ضعيف قليلًا.
Dialogue: 0,0:05:54.60,0:06:00.07,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫جزء مني يريد زيادة أعدادهم، \N‫لكن مع هذا العدد من الناس يراقبون؟
Dialogue: 0,0:06:01.04,0:06:02.26,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لا.
Dialogue: 0,0:06:02.26,0:06:03.45,Default,Sung Jinwoo,0000,0000,0000,,‫رفاق.
Dialogue: 0,0:06:04.35,0:06:06.10,Default,Sung Jinwoo,0000,0000,0000,,‫هذا لن يُجدي نفعًا.
Dialogue: 0,0:06:06.10,0:06:08.83,Default,Sung Jinwoo,0000,0000,0000,,‫سأصبح أكثر عدوانية قليلًا في فتح طريق لنا.
Dialogue: 0,0:06:08.83,0:06:10.00,Default,Sung Jinwoo,0000,0000,0000,,‫وأنتم...
Dialogue: 0,0:06:11.01,0:06:13.28,Default,Sung Jinwoo,0000,0000,0000,,‫ابقوا خلفه رجاءً.
Dialogue: 0,0:06:13.66,0:06:16.34,Default,Sung Jinwoo,0000,0000,0000,,‫ستقاتل الظلال الأخرى النمل.
Dialogue: 0,0:06:17.39,0:06:21.46,Default,Sung Jinwoo,0000,0000,0000,,‫إن عبرت أيّ منها، فتعاملوا معها رجاءً.
Dialogue: 0,0:06:21.80,0:06:24.87,Default,Choi Jong-in,0000,0000,0000,,‫مفهوم. يمكننا فعل ذلك على الأقل.
Dialogue: 0,0:06:24.87,0:06:25.92,Default,Lim Tae-gyu,0000,0000,0000,,‫نعم!
Dialogue: 0,0:06:26.39,0:06:30.96,Default,Sung Jinwoo,0000,0000,0000,,‫سأطلب منكم أيضًا أن تبقوا ما سترونه لأنفسكم.
Dialogue: 0,0:06:32.40,0:06:33.35,Default,Choi Jong-in,0000,0000,0000,,‫هل يعقل...
Dialogue: 0,0:06:55.44,0:06:57.67,Default,Baek Yoonho,0000,0000,0000,,‫لقد عاد.
Dialogue: 0,0:06:57.67,0:06:59.37,Default,Baek Yoonho,0000,0000,0000,,‫هل هذا يعني...
Dialogue: 0,0:06:59.89,0:07:01.58,Default,Baek Yoonho,0000,0000,0000,,‫أن غوتو خسر؟!
Dialogue: 0,0:07:19.62,0:07:22.25,Default,Ant King,0000,0000,0000,,‫لم يكن هناك ملك في الخارج.
Dialogue: 0,0:07:22.82,0:07:24.48,Default,Ant King,0000,0000,0000,,‫هل هو هنا؟
Dialogue: 0,0:07:25.37,0:07:27.75,Default,Ant King,0000,0000,0000,,‫من الذي تدعونه بالملك؟
Dialogue: 0,0:07:29.43,0:07:34.12,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫هو سبب عدم شعوري بالظل الذي أرسلته مع غوتو.
Dialogue: 0,0:07:34.79,0:07:35.78,Default,Lim Tae-gyu,0000,0000,0000,,‫مـ—
Dialogue: 0,0:07:35.78,0:07:36.91,Default,Ma Dongwook,0000,0000,0000,,‫مـ-مهلًا!
Dialogue: 0,0:07:56.52,0:07:58.10,Default,Ant King,0000,0000,0000,,‫هل هو أنت؟
Dialogue: 0,0:07:58.60,0:08:01.09,Default,Ant King,0000,0000,0000,,‫هل أنت ملك البشر؟
Dialogue: 0,0:08:03.32,0:08:04.59,Default,Sung Jinwoo,0000,0000,0000,,‫عجبًا...
Dialogue: 0,0:08:04.97,0:08:07.26,Default,Sung Jinwoo,0000,0000,0000,,‫حشرة ناطقة.
Dialogue: 0,0:08:08.17,0:08:09.57,Default,Ant King,0000,0000,0000,,‫أيها البشري.
Dialogue: 0,0:08:12.02,0:08:14.24,Default,Ant King,0000,0000,0000,,‫يا لها من هالة قوية.
Dialogue: 0,0:08:20.78,0:08:23.84,Default,Sung Jinwoo,0000,0000,0000,,‫لكنك لا تزال مجرد حشرة.
Dialogue: 0,0:08:24.46,0:08:26.67,Default,Choi Jong-in,0000,0000,0000,,‫حتى بالنسبة للصياد سون...
Dialogue: 0,0:08:26.67,0:08:28.61,Default,Baek Yoonho,0000,0000,0000,,‫قد يكون هذا كثيرًا جدًا!
Dialogue: 0,0:08:33.72,0:08:36.01,Default,Staff,0000,0000,0000,,‫أيها المدير! استعدنا البث!
Dialogue: 0,0:08:37.47,0:08:38.97,Default,Director,0000,0000,0000,,‫ما الذي...
Dialogue: 0,0:08:39.50,0:08:41.94,Default,Director,0000,0000,0000,,‫استأنفوا البث! افعلوا ذلك الآن!
Dialogue: 0,0:08:42.45,0:08:45.72,Default,Staff,0000,0000,0000,,‫لكن إن فعلنا، سنبث مباشرة\N‫بدون تأخير!
Dialogue: 0,0:08:45.72,0:08:48.59,Default,Staff,0000,0000,0000,,‫إن حدث شيء ما، فلن نتمكن من منع بثه!
Dialogue: 0,0:08:48.59,0:08:52.25,Default,Director,0000,0000,0000,,‫لقد قطعنا البث مرة بالفعل. \N‫لا أرى كيف يمكن أن يسوء الأمر أكثر!
Dialogue: 0,0:08:52.25,0:08:53.08,Default,Director,0000,0000,0000,,‫قم بذلك!
Dialogue: 0,0:08:53.08,0:08:54.14,Default,Staff B,0000,0000,0000,,‫حـ-حسنًا!
Dialogue: 0,0:08:54.75,0:08:59.02,DefaultItalics,Staff B,0000,0000,0000,,‫مصيرنا—لا، نتيجة هذه المعركة—
Dialogue: 0,0:08:59.02,0:09:01.06,DefaultItalics,Staff B,0000,0000,0000,,‫تعتمد على هذا الرجل!
Dialogue: 0,0:09:01.96,0:09:03.31,Default,Lee Joohee,0000,0000,0000,,‫سـ-سونغ-سان!
Dialogue: 0,0:09:03.31,0:09:04.54,Default,Song Chiyul,0000,0000,0000,,‫لا أصدق ذلك...
Dialogue: 0,0:09:05.19,0:09:06.49,Default,Lee Joohee,0000,0000,0000,,‫أليس هذا...
Dialogue: 0,0:09:12.57,0:09:15.28,Default,Sung Jinah,0000,0000,0000,,‫مستحيل! كيف؟!
Dialogue: 0,0:09:16.05,0:09:17.76,Default,Sung Jinah,0000,0000,0000,,‫أخي؟!
Dialogue: 0,0:09:17.76,0:09:19.92,Default,Sung Jinah,0000,0000,0000,,‫قال أنّه سيخرج قليلًا فقط!
Dialogue: 0,0:09:20.85,0:09:22.73,Default,Sung Jinah,0000,0000,0000,,‫مرة أخرى؟!
Dialogue: 0,0:09:24.93,0:09:27.94,Default,Go Gunhee,0000,0000,0000,,‫لقد وصل الصياد سون!
Dialogue: 0,0:09:29.24,0:09:32.15,Default,Woo Jinchul,0000,0000,0000,,‫لكن كيف وصل إلى الجزيرة؟
Dialogue: 0,0:09:32.15,0:09:34.43,Default,Go Gunhee,0000,0000,0000,,‫ما كنت لأقلق بشأن ذلك!
Dialogue: 0,0:09:35.01,0:09:37.00,Default,Go Gunhee,0000,0000,0000,,‫لنثق به.
Dialogue: 0,0:09:50.34,0:09:52.92,Default,Choi Jong-in,0000,0000,0000,,‫إن كان من نوع السحرة، \N‫فلماذا يقترب إلى هذا الحد؟!
Dialogue: 0,0:09:52.92,0:09:54.99,Default,Baek Yoonho,0000,0000,0000,,‫لقد استهان بالنملة...
Dialogue: 0,0:09:54.99,0:09:57.51,Default,Baek Yoonho,0000,0000,0000,,‫وتلقى الضربة بسبب ذلك
Dialogue: 0,0:09:58.10,0:09:59.65,Default,Ant King,0000,0000,0000,,‫ضعيف.
Dialogue: 0,0:09:59.65,0:10:01.33,Default,Ant King,0000,0000,0000,,‫لا بد أنك لست الملك إذًا.
Dialogue: 0,0:10:25.03,0:10:27.39,Default,Ma Dongwook,0000,0000,0000,,‫أيها الرئيس بيك. أيها الرئيس تشوي.
Dialogue: 0,0:10:28.19,0:10:30.78,Default,Ma Dongwook,0000,0000,0000,,‫هل هو ساحر حقًا؟
Dialogue: 0,0:10:30.78,0:10:33.17,Default,Baek Yoonho,0000,0000,0000,,‫لم أعد أعلم.
Dialogue: 0,0:10:33.64,0:10:35.79,Default,Baek Yoonho,0000,0000,0000,,‫لم أكن أتوقع هذا بالتأكيد.
Dialogue: 0,0:10:36.95,0:10:40.22,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫إنه متين جدًا. هل السبب الهيكل الخارجي؟
Dialogue: 0,0:10:58.43,0:11:00.53,DefaultItalics,Cameraman,0000,0000,0000,,‫يا لها من معركة مخيفة.
Dialogue: 0,0:11:00.53,0:11:03.16,DefaultItalics,Cameraman,0000,0000,0000,,‫أنا من الدرجة أ وهذا كل ما يمكنني فعله للبقاء واقفًا.
Dialogue: 0,0:11:04.87,0:11:08.29,DefaultItalics,Cameraman,0000,0000,0000,,‫تدفق الطاقة السحرية كافٍ \N‫ليجعلني أغيب عن الوعي.
Dialogue: 0,0:11:13.48,0:11:16.67,DefaultItalics,Ant King,0000,0000,0000,,‫هل... يدفعني للوراء؟
Dialogue: 0,0:11:28.22,0:11:29.60,DefaultItalics,Ant King,0000,0000,0000,,‫كيف؟
Dialogue: 0,0:11:30.81,0:11:32.69,DefaultItalics,Ant King,0000,0000,0000,,‫ما هذا البشري...
Dialogue: 0,0:11:33.27,0:11:36.42,DefaultItalics,Ant King,0000,0000,0000,,‫بالضبط؟!
Dialogue: 0,0:12:02.06,0:12:03.32,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ما هذا؟
Dialogue: 0,0:12:04.05,0:12:07.28,Default,Ant King,0000,0000,0000,,‫خليط من السموم البحرية \N‫في هذه المنطقة،
Dialogue: 0,0:12:07.28,0:12:10.49,Default,Ant King,0000,0000,0000,,‫مع تعزيز قوتي السحرية للزيادة من تأثيرها.
Dialogue: 0,0:12:10.49,0:12:12.94,Default,Ant King,0000,0000,0000,,‫لا ينبغي أن تكون قادرًا على الحركة بعد الآن.
Dialogue: 0,0:12:14.87,0:12:18.14,Default,Ant King,0000,0000,0000,,‫هذه نهايتك.
Dialogue: 0,0:12:20.26,0:12:23.74,Default,Ant King,0000,0000,0000,,‫مُت أيها البشري!
Dialogue: 0,0:12:27.71,0:12:32.07,Default,Matsumoto Shigeo,0000,0000,0000,,‫سبعة قتلى في فريق مكون من عشرة؟ \N‫هل هذه مزحة ما؟
Dialogue: 0,0:12:32.07,0:12:34.04,DefaultItalics,Sugimoto Reiji,0000,0000,0000,,‫لا، إنّها الحقيقة.
Dialogue: 0,0:12:34.04,0:12:38.20,DefaultItalics,Sugimoto Reiji,0000,0000,0000,,‫استطعنا التواصل مع \N‫الصيادين الناجين للتأكيد.
Dialogue: 0,0:12:40.36,0:12:44.60,Default,Matsumoto Shigeo,0000,0000,0000,,‫فقدنا أكثر من نصف صيادينا؟!\N‫هذا إخفاق تام!
Dialogue: 0,0:12:45.01,0:12:49.54,Default,Sugimoto Reiji,0000,0000,0000,,‫رصدنا أيضًا قراءة قوية بالقرب\N‫من فوهة الجزيرة البركانية.
Dialogue: 0,0:12:49.54,0:12:52.52,Default,Sugimoto Reiji,0000,0000,0000,,‫من المرجح أن يكون الوحش\N‫الذي هزم غوتو.
Dialogue: 0,0:12:52.52,0:12:55.30,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫كيف لا يزال حيًا بعد قتاله؟!
Dialogue: 0,0:12:55.30,0:12:57.97,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫ويتجه نحو العش؟ لماذا؟
Dialogue: 0,0:12:57.97,0:13:01.22,Default,Sugimoto Reiji,0000,0000,0000,,‫لا نعلم. قد يكون له هدف ما،
Dialogue: 0,0:13:01.22,0:13:03.53,DefaultItalics,Sugimoto Reiji,0000,0000,0000,,‫أو ربما أصيب بما يكفي ليرغب في العودة لمنزله.
Dialogue: 0,0:13:05.46,0:13:08.41,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫لم نتمكن من تأكيد نجاة الصيادين الكوريين.
Dialogue: 0,0:13:08.41,0:13:12.69,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫إذا كانوا لا يزالون أحياء، فسوف يواجهون \N‫ذلك الشيء الذي استطاع قتل غوتو.
Dialogue: 0,0:13:12.69,0:13:15.08,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫لا يمكنهم الفوز وهم مرهقون بالفعل.
Dialogue: 0,0:13:15.08,0:13:17.92,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫سيكون النمل ضعيفًا من كل القتال الذي خاضه أيضًا.
Dialogue: 0,0:13:18.41,0:13:23.15,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫إن تمكنا من الإطاحة بالنملة القوية،\N‫فسيكون أمر البقية سهلًا.
Dialogue: 0,0:13:24.38,0:13:26.30,DefaultItalics,Matsumoto Shigeo,0000,0000,0000,,‫ما زال بإمكاننا الفوز.
Dialogue: 0,0:13:26.82,0:13:29.58,Default,Matsumoto Shigeo,0000,0000,0000,,‫أسرعوا في إنقاذ الناجين!
Dialogue: 0,0:13:30.02,0:13:34.56,Default,Matsumoto Shigeo,0000,0000,0000,,‫بمجرد أن ينضموا للفريق الثاني \N‫في البحر، أرسلوهم مجددًا إلى الجزيرة!
Dialogue: 0,0:13:35.45,0:13:39.09,DefaultItalics,Sugimoto Reiji,0000,0000,0000,,‫وهذا يغطي كل شيء. ستأتي\N‫مروحية لاصطحابكم قريبًا.
Dialogue: 0,0:13:39.80,0:13:40.96,Default,Tawata Kanae,0000,0000,0000,,‫عُلم.
Dialogue: 0,0:13:43.04,0:13:46.16,Default,Tawata Kanae,0000,0000,0000,,‫سننتقل للخطة 9. لنذهب.
Dialogue: 0,0:13:46.60,0:13:47.65,Default,Hoshino Minoru,0000,0000,0000,,‫لا أمل.
Dialogue: 0,0:13:48.58,0:13:50.81,Default,Hoshino Minoru,0000,0000,0000,,‫ذلك الشيء... وحش.
Dialogue: 0,0:13:51.22,0:13:53.89,Default,Hoshino Minoru,0000,0000,0000,,‫لا نملك... أي فرصة.
Dialogue: 0,0:13:54.65,0:13:57.58,Default,Tawata Kanae,0000,0000,0000,,‫تماسك! ليس لدينا وقت لنوبات الذعر!
Dialogue: 0,0:13:57.58,0:14:00.22,Default,Hoshino Minoru,0000,0000,0000,,‫لا أحد يمكنه هزيمة ذلك الشيء!
Dialogue: 0,0:14:00.22,0:14:03.25,Default,Hoshino Minoru,0000,0000,0000,,‫علينا أن نهرب! سنموت إن لم نفعل!
Dialogue: 0,0:14:04.86,0:14:06.38,Default,Tawata Kanae,0000,0000,0000,,‫مثير للشفقة.
Dialogue: 0,0:14:06.38,0:14:09.94,Default,Tawata Kanae,0000,0000,0000,,‫لا خيار لدينا على أي حال.
Dialogue: 0,0:14:31.27,0:14:34.99,Default,Choi Jong-in,0000,0000,0000,,‫ألم يُسَمَّم؟ هل هو بخير؟
Dialogue: 0,0:14:36.12,0:14:39.08,Default,Baek Yoonho,0000,0000,0000,,‫لم يعد شيء يفاجئني الآن.
Dialogue: 0,0:14:40.15,0:14:42.32,Default,Sung Jinwoo,0000,0000,0000,,‫كان لديك سلاح سري إذًا.
Dialogue: 0,0:14:43.44,0:14:46.38,Default,Sung Jinwoo,0000,0000,0000,,‫لا عجب أنك بدوت مرتاحًا سابقًا.
Dialogue: 0,0:14:49.07,0:14:52.69,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ربما لأن قدراتي الإدراكية\N‫أصبحت مرتفعة جدًا...
Dialogue: 0,0:14:52.69,0:14:54.79,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لكن يمكنني الإحساس بمشاعره—
Dialogue: 0,0:14:55.54,0:14:56.89,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫بقلقه.
Dialogue: 0,0:14:57.95,0:14:59.82,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫أنا كذلك أيضًا.
Dialogue: 0,0:15:01.81,0:15:05.51,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫عليّ إنهاء هذا بأسرع ما يمكن!
Dialogue: 0,0:15:16.52,0:15:20.25,DefaultItalics,Ant King,0000,0000,0000,,‫السم غير فعال. \N‫اختبارات القوة بلا جدوى.
Dialogue: 0,0:15:20.67,0:15:22.07,DefaultItalics,Ant King,0000,0000,0000,,‫في هذه الحالة...
Dialogue: 0,0:16:36.03,0:16:38.83,DefaultItalics,Ant King,0000,0000,0000,,‫سرعة تقارَن بسرعتي.
Dialogue: 0,0:16:39.65,0:16:42.40,DefaultItalics,Ant King,0000,0000,0000,,‫ومع ذلك، يزداد سرعةً أكثر.
Dialogue: 0,0:16:43.12,0:16:45.52,DefaultItalics,Ant King,0000,0000,0000,,‫كيف يُعقَل هذا؟
Dialogue: 0,0:17:45.15,0:17:48.42,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ترقية... التقطيع.
Dialogue: 0,0:17:53.17,0:17:54.78,DefaultItalics,Ant King,0000,0000,0000,,‫مـ-ما هذا؟!
Dialogue: 0,0:17:59.78,0:18:00.83,DefaultItalics,Ant King,0000,0000,0000,,‫كيف؟!
Dialogue: 0,0:18:04.86,0:18:06.40,Default,Sung Jinwoo,0000,0000,0000,,‫تجدد؟
Dialogue: 0,0:18:07.59,0:18:09.08,DefaultItalics,Ant King,0000,0000,0000,,‫ما هذا؟
Dialogue: 0,0:18:11.56,0:18:13.67,DefaultItalics,Ant King,0000,0000,0000,,‫ما كان ذلك بالضبط؟!
Dialogue: 0,0:18:38.37,0:18:41.95,DefaultItalics,Ant King,0000,0000,0000,,‫من يكون... هذا البشري؟
Dialogue: 0,0:18:42.28,0:18:46.08,Default,Ant King,0000,0000,0000,,‫هذا البشري!
Dialogue: 0,0:18:49.93,0:18:50.90,Default,Sung Jinwoo,0000,0000,0000,,‫هيا.
Dialogue: 0,0:19:15.38,0:19:16.61,DefaultItalics,Ant King,0000,0000,0000,,‫كيف يُعقَل هذا؟
Dialogue: 0,0:19:17.41,0:19:21.17,DefaultItalics,Ant King,0000,0000,0000,,‫لقد وُلدت لأكون الأقوى.
Dialogue: 0,0:19:22.17,0:19:28.27,DefaultItalics,Ant King,0000,0000,0000,,‫ألتهم كل شيء، وأزداد قوة دائمًا...
Dialogue: 0,0:19:28.60,0:19:32.43,DefaultItalics,Ant King,0000,0000,0000,,‫يجب أن أكون الملك. ومع ذلك...
Dialogue: 0,0:19:35.09,0:19:36.24,DefaultItalics,Ant King,0000,0000,0000,,‫الهرب...
Dialogue: 0,0:19:37.16,0:19:38.74,DefaultItalics,Ant King,0000,0000,0000,,‫عليّ الهرب!
Dialogue: 0,0:19:39.45,0:19:43.41,DefaultItalics,Ant King,0000,0000,0000,,‫يجب أن أهرب لأعيش!
Dialogue: 0,0:19:47.08,0:19:49.31,DefaultItalics,Ant King,0000,0000,0000,,‫لأبتعد قدر الإمكان!
Dialogue: 0,0:20:07.77,0:20:10.06,DefaultItalics,Ant King,0000,0000,0000,,‫بسرعة! بسرعة!
Dialogue: 0,0:20:10.06,0:20:12.12,DefaultItalics,Ant King,0000,0000,0000,,‫عليّ أن أبتعد بسرعة!
Dialogue: 0,0:20:45.34,0:20:46.82,Default,Choi Jong-in,0000,0000,0000,,‫النمل...
Dialogue: 0,0:20:46.82,0:20:48.45,Default,Baek Yoonho,0000,0000,0000,,‫هل تهرب؟
Dialogue: 0,0:20:48.45,0:20:49.82,Default,Lim Tae-gyu,0000,0000,0000,,‫هل فزنا؟
Dialogue: 0,0:20:53.30,0:20:54.57,Default,Ma Dongwook,0000,0000,0000,,‫أيها الصياد سون!
Dialogue: 0,0:21:01.34,0:21:04.71,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫هالتها تتلاشى... يكاد الوقت ينفد منا.
Dialogue: 0,0:21:04.71,0:21:06.29,Default,Baek Yoonho,0000,0000,0000,,‫لنخرج من هنا بسرعة!
Dialogue: 0,0:21:06.29,0:21:08.79,Default,Choi Jong-in,0000,0000,0000,,‫ينبغي أن تكون مروحية إنقاذ في الانتظار في الخارج!
Dialogue: 0,0:21:08.79,0:21:09.76,Default,Choi Jong-in,0000,0000,0000,,‫إن استطعنا الصعود—
Dialogue: 0,0:21:09.76,0:21:12.29,Default,Sung Jinwoo,0000,0000,0000,,‫لا. لست متأكدًا إن كانت ستصمد لذلك الوقت.
Dialogue: 0,0:21:12.29,0:21:13.79,Default,Lim Tae-gyu,0000,0000,0000,,‫ماذا نفعل إذًا—
Dialogue: 0,0:21:17.55,0:21:19.55,Default,Ma Dongwook,0000,0000,0000,,‫ظننت أن الجرعات لا تعمل.
Dialogue: 0,0:21:19.55,0:21:21.22,Default,Sung Jinwoo,0000,0000,0000,,‫لم أجرب هذه بعد.
Dialogue: 0,0:21:26.16,0:21:29.39,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫إكسير الحياة الذي شفى \N‫أمي من نومها الأبدي...
Dialogue: 0,0:21:29.77,0:21:33.05,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫هذا أملنا الأخير.
Dialogue: 0,0:21:35.83,0:21:38.86,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫غير فعّال؟
Dialogue: 0,0:21:41.55,0:21:43.05,Default,Ma Dongwook,0000,0000,0000,,‫ألم ينجح؟
Dialogue: 0,0:21:44.04,0:21:47.83,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫الخروج من الجزيرة بالطريقة العادية \N‫لن يكون بالسرعة الكافية. الجرعات لا تعمل.
Dialogue: 0,0:21:47.83,0:21:51.01,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫وأحتاج المزيد من الوقت قبل \N‫أن أتمكن من استخدام تبادل الظل مجددًا!
Dialogue: 0,0:21:52.05,0:21:55.70,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫هل هناك... شيء آخر يمكنني فعله؟
