Dialogue: 0,0:00:06.97,0:00:07.83,Default,,0000,0000,0000,,Eh.
Dialogue: 0,0:00:14.39,0:00:15.14,Default,,0000,0000,0000,,Ada sesuatu di sana.
Dialogue: 0,0:00:15.71,0:00:16.67,Default,,0000,0000,0000,,Hati-hati!
Dialogue: 0,0:00:16.67,0:00:17.71,Default,,0000,0000,0000,,Saya tahu.
Dialogue: 0,0:00:19.51,0:00:20.48,Default,,0000,0000,0000,,Orang ini...
Dialogue: 0,0:00:22.27,0:00:23.19,Default,,0000,0000,0000,,Kenzo!
Dialogue: 0,0:00:29.05,0:00:30.07,Default,,0000,0000,0000,,Saya dah tangkap awak.
Dialogue: 0,0:00:51.67,0:00:55.39,Default,,0000,0000,0000,,(Solo Leveling Season 2\N-Arise from the Shadow-)
Dialogue: 0,0:02:20.87,0:02:23.63,Default,,0000,0000,0000,,Semuanya mempunyai kekuatan tahap S.
Dialogue: 0,0:02:24.51,0:02:25.53,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:02:27.51,0:02:29.27,Default,,0000,0000,0000,,mereka cuma haiwan iblis\Nbiarpun hebat sekali.
Dialogue: 0,0:02:29.65,0:02:30.91,Default,,0000,0000,0000,,Gerakan mereka sama.
Dialogue: 0,0:02:31.23,0:02:34.45,Default,,0000,0000,0000,,Mereka bukan lawan pemburu yang mampu
Dialogue: 0,0:02:35.21,0:02:36.49,Default,,0000,0000,0000,,menggunakan pelbagai taktik.
Dialogue: 0,0:02:58.41,0:03:00.51,Default,,0000,0000,0000,,Kulit semut di sini amat keras.
Dialogue: 0,0:03:00.99,0:03:01.71,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:03:02.07,0:03:04.13,Default,,0000,0000,0000,,Nasib baik jumlahnya tak banyak.
Dialogue: 0,0:03:04.39,0:03:06.43,Default,,0000,0000,0000,,Tak perlu risau biarpun ada banyak.
Dialogue: 0,0:03:07.03,0:03:08.97,Default,,0000,0000,0000,,Saya akan membantu kamu dari belakang.
Dialogue: 0,0:03:09.21,0:03:10.41,Default,,0000,0000,0000,,Jangan risau.
Dialogue: 0,0:03:10.99,0:03:14.13,Default,,0000,0000,0000,,Tak sangka orang yang\Ntakut bertarung akan kata begitu.
Dialogue: 0,0:03:14.87,0:03:18.23,Default,,0000,0000,0000,,Abang Yoonho, jangan sindir orang lain.
Dialogue: 0,0:03:18.91,0:03:20.65,Default,,0000,0000,0000,,Adakah ini misi pertama awak?
Dialogue: 0,0:03:20.95,0:03:25.45,Default,,0000,0000,0000,,Jangan lupa mereka masih dapat\Nhidup seketika biarpun kepala diletupkan.
Dialogue: 0,0:03:25.91,0:03:28.59,Default,,0000,0000,0000,,Sekurang-kurangnya awak patut\Nmelumpuhkan anggota badan mereka.
Dialogue: 0,0:03:29.07,0:03:29.55,Default,,0000,0000,0000,,Oh.
Dialogue: 0,0:03:29.91,0:03:30.61,Default,,0000,0000,0000,,Oh.
Dialogue: 0,0:03:32.27,0:03:34.75,Default,,0000,0000,0000,,Semakin dalam, semakin kuat musuh.
Dialogue: 0,0:03:34.75,0:03:37.07,Default,,0000,0000,0000,,Namun, kita masih belum nampak\Nsemut yang berjalan dengan kaki.
Dialogue: 0,0:03:37.51,0:03:39.09,Default,,0000,0000,0000,,Ya, saya rasa mereka
Dialogue: 0,0:03:39.41,0:03:42.39,Default,,0000,0000,0000,,di sekitar ratu semut sebagai pengawal.
Dialogue: 0,0:03:42.79,0:03:45.07,Default,,0000,0000,0000,,Maknanya, perjalanan kita masih jauh.
Dialogue: 0,0:03:45.07,0:03:46.93,Default,,0000,0000,0000,,Benarkah arah ini betul?
Dialogue: 0,0:03:47.29,0:03:48.53,Default,,0000,0000,0000,,Takkan salah.
Dialogue: 0,0:03:48.53,0:03:49.39,Default,,0000,0000,0000,,Sepatutnya begitu.
Dialogue: 0,0:03:49.39,0:03:50.17,Default,,0000,0000,0000,,Hei.
Dialogue: 0,0:03:50.59,0:03:51.67,Default,,0000,0000,0000,,Arah tak salah.
Dialogue: 0,0:03:51.89,0:03:55.80,Default,,0000,0000,0000,,Ada bau haiwan iblis yang kuat\Ndari dalam gua itu.
Dialogue: 0,0:03:56.21,0:03:58.59,Default,,0000,0000,0000,,Dengan jarak ini,
Dialogue: 0,0:03:58.59,0:04:01.11,Default,,0000,0000,0000,,bukankah Presiden Baek dapat lihat\Nmelalui keupayaannya?
Dialogue: 0,0:04:02.41,0:04:03.02,Default,,0000,0000,0000,,Aduhai.
Dialogue: 0,0:04:18.87,0:04:19.81,Default,,0000,0000,0000,,Itu dia?
Dialogue: 0,0:04:24.19,0:04:26.41,Default,,0000,0000,0000,,Ratu semut berada\Ndi tempat paling dalam di depan.
Dialogue: 0,0:04:26.71,0:04:28.79,Default,,0000,0000,0000,,Ada banyak pengawal yang melindunginya.
Dialogue: 0,0:04:29.71,0:04:33.63,Default,,0000,0000,0000,,Pasukan umpan di luar\Njuga mempunyai batasnya.
Dialogue: 0,0:04:34.35,0:04:38.03,Default,,0000,0000,0000,,Selain itu, ada banyak\Npengawal tahap S di depan.
Dialogue: 0,0:04:38.35,0:04:39.97,Default,,0000,0000,0000,,Kekuatan ratu semut pun tak diketahui.
Dialogue: 0,0:04:40.31,0:04:41.95,Default,,0000,0000,0000,,Ini pertarungan yang susah.
Dialogue: 0,0:04:42.31,0:04:45.23,Default,,0000,0000,0000,,Namun, pasukan kita pasti dapat menang.
Dialogue: 0,0:04:46.97,0:04:47.81,Default,,0000,0000,0000,,Majulah.
Dialogue: 0,0:04:48.51,0:04:49.35,Default,,0000,0000,0000,,- Baik.\N- Baik.
Dialogue: 0,0:04:55.59,0:04:56.77,Default,,0000,0000,0000,,Inilah kawasannya?
Dialogue: 0,0:04:56.99,0:04:59.81,Default,,0000,0000,0000,,Saya datang untuk melihat\Nkerana kehilangan kontak dengan Charlie.
Dialogue: 0,0:05:00.31,0:05:02.29,Default,,0000,0000,0000,,Mereka telah pergi ke mana?
Dialogue: 0,0:05:03.67,0:05:06.23,Default,,0000,0000,0000,,Mereka memang pernah bunuh semut di sini.
Dialogue: 0,0:05:08.09,0:05:08.71,Default,,0000,0000,0000,,Hm?
Dialogue: 0,0:05:09.33,0:05:10.81,Default,,0000,0000,0000,,Ini cermin mata Fujishima.
Dialogue: 0,0:05:12.03,0:05:13.87,Default,,0000,0000,0000,,Jangan-jangan...
Dialogue: 0,0:05:17.95,0:05:18.91,Default,,0000,0000,0000,,Apa dah berlaku?
Dialogue: 0,0:05:19.83,0:05:20.95,Default,,0000,0000,0000,,Apa yang berlaku?
Dialogue: 0,0:05:20.95,0:05:22.69,Default,,0000,0000,0000,,Apa bau yang menusuk hidung ini?
Dialogue: 0,0:05:23.51,0:05:27.11,Default,,0000,0000,0000,,Saya tak pernah menghidu bau sebegini.
Dialogue: 0,0:05:43.89,0:05:45.65,Default,,0000,0000,0000,,Awak sudah menghubungi Charlie?
Dialogue: 0,0:05:46.17,0:05:47.43,Default,,0000,0000,0000,,Belum lagi.
Dialogue: 0,0:05:47.73,0:05:49.19,Default,,0000,0000,0000,,Adakah sesuatu berlaku?
Dialogue: 0,0:05:49.19,0:05:51.25,Default,,0000,0000,0000,,Tiada masa untuk risau\Ntentang orang lain sekarang.
Dialogue: 0,0:05:54.17,0:05:55.95,Default,,0000,0000,0000,,Awak harus bertarung\Ndengan serius kali ini.
Dialogue: 0,0:05:56.25,0:05:57.79,Default,,0000,0000,0000,,Baiklah.
Dialogue: 0,0:06:05.07,0:06:08.15,Default,,0000,0000,0000,,Sambutan yang sungguh meriah.
Dialogue: 0,0:06:10.05,0:06:14.05,Default,,0000,0000,0000,,Jika begitu, kita perlu\Nmenunjukkan adab yang bersesuaian juga.
Dialogue: 0,0:06:22.19,0:06:23.59,Default,,0000,0000,0000,,Mari kita bertindak mengikut rancangan.
Dialogue: 0,0:06:24.09,0:06:25.79,Default,,0000,0000,0000,,Saya akan harapkan awak.
Dialogue: 0,0:06:25.79,0:06:27.37,Default,,0000,0000,0000,,Encik Senjata Terakhir Manusia.
Dialogue: 0,0:06:27.75,0:06:29.04,Default,,0000,0000,0000,,Saya faham.
Dialogue: 0,0:06:29.99,0:06:32.29,Default,,0000,0000,0000,,Lawan kamu ada di sini.
Dialogue: 0,0:06:40.95,0:06:44.01,Default,,0000,0000,0000,,Biasanya saya takkan\Nguna kekuatan sebesar ini.
Dialogue: 0,0:06:45.01,0:06:47.97,Default,,0000,0000,0000,,Namun, nampaknya saya\Nperlu lakukan yang terbaik hari ini.
Dialogue: 0,0:06:58.25,0:06:59.03,Default,,0000,0000,0000,,Betul.
Dialogue: 0,0:06:59.29,0:07:01.37,Default,,0000,0000,0000,,Tak perlu menyimpan kekuatan.
Dialogue: 0,0:07:01.75,0:07:04.28,Default,,0000,0000,0000,,Biarpun saya harus berubah\Nmenjadi bentuk hodoh sebegini,
Dialogue: 0,0:07:05.01,0:07:09.19,Default,,0000,0000,0000,,saya pun akan membunuh semua serangga ini.
Dialogue: 0,0:07:20.81,0:07:21.89,Default,,0000,0000,0000,,Itulah...
Dialogue: 0,0:07:23.29,0:07:25.27,Default,,0000,0000,0000,,Presiden Baek dalam bentuk haiwan iblis.
Dialogue: 0,0:07:28.17,0:07:29.39,Default,,0000,0000,0000,,Pertarungan sudah bermula.
Dialogue: 0,0:07:30.25,0:07:32.59,Default,,0000,0000,0000,,Penarafan telah melebihi 80 peratus.
Dialogue: 0,0:07:32.59,0:07:34.53,Default,,0000,0000,0000,,Berdiri ke depan sikit,\Nrakam dengan jelas.
Dialogue: 0,0:07:34.91,0:07:36.95,Default,,0000,0000,0000,,Penarafan 80 peratus?
Dialogue: 0,0:07:37.53,0:07:38.99,Default,,0000,0000,0000,,Saya harus memenuhi harapan semua orang.
Dialogue: 0,0:07:41.21,0:07:43.83,Default,,0000,0000,0000,,Tempat ini bilik bos\Npenjara bawah tanah tahap S.
Dialogue: 0,0:07:43.83,0:07:45.21,Default,,0000,0000,0000,,Awak nak mati?
Dialogue: 0,0:07:45.21,0:07:47.29,Default,,0000,0000,0000,,Tak, mana mungkin?
Dialogue: 0,0:07:47.61,0:07:49.29,Default,,0000,0000,0000,,Berdirilah di belakang saya.
Dialogue: 0,0:07:49.75,0:07:51.59,Default,,0000,0000,0000,,Pertarungan akan menjadi lebih sengit.
Dialogue: 0,0:07:53.85,0:07:55.08,Default,,0000,0000,0000,,Semua, lihatlah.
Dialogue: 0,0:07:55.37,0:07:58.65,Default,,0000,0000,0000,,Pemburu tahap S akhirnya\Ntelah tiba di depan ratu semut.
Dialogue: 0,0:07:58.65,0:07:58.87,Default,,0000,0000,0000,,Sekarang ialah masa
Dialogue: 0,0:07:58.87,0:08:00.83,Default,,0000,0000,0000,,MISI SERANGAN PULAU JEJU KEEMPAT\Nuntuk merealisasikan hasrat.
Dialogue: 0,0:08:00.83,0:08:03.37,Default,,0000,0000,0000,,SELEPAS PEMBURU TAHAP S MELAWAN RATU SEMUT\NPertarungan sengit terbentang di depan kamu.
Dialogue: 0,0:08:03.83,0:08:06.99,Default,,0000,0000,0000,,Pemburu tahap S yang biasanya\Ntak bertarung bersama
Dialogue: 0,0:08:06.99,0:08:10.35,Default,,0000,0000,0000,,sedang menunjukkan kerjasama sempurna\Ndan serangan bersama yang hebat.
Dialogue: 0,0:09:14.83,0:09:18.17,Default,,0000,0000,0000,,Serangan Pemburu Cha\Ntelah menembusi semut.
Dialogue: 0,0:09:19.93,0:09:21.07,Default,,0000,0000,0000,,Ia telah dikalahkan.
Dialogue: 0,0:09:22.09,0:09:24.07,Default,,0000,0000,0000,,Semut pengawal terakhir telah dibunuh.
Dialogue: 0,0:09:34.65,0:09:37.09,Default,,0000,0000,0000,,Inilah masanya, serang!
Dialogue: 0,0:09:39.99,0:09:41.99,Default,,0000,0000,0000,,Rasakan!
Dialogue: 0,0:09:49.55,0:09:51.28,Default,,0000,0000,0000,,Ratu semut yang kehilangan pengawal
Dialogue: 0,0:09:51.71,0:09:53.35,Default,,0000,0000,0000,,adalah tak berdaya.
Dialogue: 0,0:10:10.19,0:10:12.37,Default,,0000,0000,0000,,Selagi saya ada di sini,\Nsaya akan membuat kamu semua
Dialogue: 0,0:10:12.37,0:10:14.10,Default,,0000,0000,0000,,bangkit semula berulang-ulang.
Dialogue: 0,0:10:20.11,0:10:22.94,Default,,0000,0000,0000,,Saya takkan biar awak mendekati penyembuh.
Dialogue: 0,0:10:23.47,0:10:25.40,Default,,0000,0000,0000,,Tolong tahannya macam itu.
Dialogue: 0,0:10:43.63,0:10:46.13,Default,,0000,0000,0000,,Ia mempunyai kekuatan yang begitu besar?
Dialogue: 0,0:10:49.55,0:10:50.55,Default,,0000,0000,0000,,Adakah itu jeritan sebelum mati?
Dialogue: 0,0:10:50.55,0:10:52.22,Default,,0000,0000,0000,,Tak, itu berbeza.
Dialogue: 0,0:10:53.89,0:10:55.01,Default,,0000,0000,0000,,- Jangan harap nak lari.\N- Awak tak dapat lari.
Dialogue: 0,0:11:02.49,0:11:03.40,Default,,0000,0000,0000,,- Pemburu Cha!\N- Cik Cha!
Dialogue: 0,0:11:03.55,0:11:04.47,Default,,0000,0000,0000,,Saya akan serang.
Dialogue: 0,0:11:06.77,0:11:07.57,Default,,0000,0000,0000,,Satu lagi serangan.
Dialogue: 0,0:12:01.31,0:12:02.29,Default,,0000,0000,0000,,Dah berjaya.
Dialogue: 0,0:12:06.07,0:12:06.91,Default,,0000,0000,0000,,Tuan.
Dialogue: 0,0:12:10.11,0:12:12.45,Default,,0000,0000,0000,,Adakah kita sudah berjaya?
Dialogue: 0,0:12:13.69,0:12:15.77,Default,,0000,0000,0000,,Sudah tamat, betul?
Dialogue: 0,0:12:16.29,0:12:17.37,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:12:17.71,0:12:21.47,Default,,0000,0000,0000,,Selepas ratu semut mati, semut yang lain\Nakan pupus sendiri dalam masa setahun.
Dialogue: 0,0:12:21.69,0:12:24.43,Default,,0000,0000,0000,,Kemudian, tempat ini akan kembali\Nmenjadi tempat tinggal manusia.
Dialogue: 0,0:12:24.77,0:12:27.07,Default,,0000,0000,0000,,Namun, jeritan terakhirnya...
Dialogue: 0,0:12:27.51,0:12:29.35,Default,,0000,0000,0000,,Apa yang awak cakap?
Dialogue: 0,0:12:29.73,0:12:32.17,Default,,0000,0000,0000,,Kita telah bunuh ratu semut itu.
Dialogue: 0,0:12:32.53,0:12:35.09,Default,,0000,0000,0000,,Kita telah balas dendam\Nuntuk Abang Eunseok.
Dialogue: 0,0:12:44.07,0:12:45.13,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:12:49.97,0:12:50.81,Default,,0000,0000,0000,,Habislah.
Dialogue: 0,0:12:51.07,0:12:52.97,Default,,0000,0000,0000,,Semua semut itu menuju ke arah sarang.
Dialogue: 0,0:12:53.23,0:12:54.03,Default,,0000,0000,0000,,Apa?
Dialogue: 0,0:12:54.37,0:12:55.95,Default,,0000,0000,0000,,Gelombang gangguan tak berkesan.
Dialogue: 0,0:12:57.21,0:12:58.33,Default,,0000,0000,0000,,Apa dah berlaku?
Dialogue: 0,0:12:59.27,0:13:01.07,Default,,0000,0000,0000,,Kumpulkan maklumat dan lapor kepada saya.
Dialogue: 0,0:13:09.17,0:13:10.75,Default,,0000,0000,0000,,Penjara api.
Dialogue: 0,0:13:11.17,0:13:12.21,Default,,0000,0000,0000,,telah dihancurkan.
Dialogue: 0,0:13:14.05,0:13:15.31,Default,,0000,0000,0000,,Apa yang berlaku?
Dialogue: 0,0:13:15.31,0:13:17.23,Default,,0000,0000,0000,,Ia jauh lebih pantas\Ndaripada masa yang dijadualkan.
Dialogue: 0,0:13:17.59,0:13:19.71,Default,,0000,0000,0000,,Jeritan ratu semut tadi.
Dialogue: 0,0:13:19.71,0:13:20.47,Default,,0000,0000,0000,,Jangan-jangan...
Dialogue: 0,0:13:20.47,0:13:21.93,Default,,0000,0000,0000,,Ia memanggil rakan pasukannya?
Dialogue: 0,0:13:21.93,0:13:23.47,Default,,0000,0000,0000,,Tak, biarpun begitu,
Dialogue: 0,0:13:23.47,0:13:26.17,Default,,0000,0000,0000,,semut di luar takkan dapat\Nmengatasi tekniknya.
Dialogue: 0,0:13:26.39,0:13:27.15,Default,,0000,0000,0000,,Jika begitu...
Dialogue: 0,0:13:27.43,0:13:28.21,Default,,0000,0000,0000,,Ada sesuatu sedang mendekati.
Dialogue: 0,0:13:50.37,0:13:51.47,Default,,0000,0000,0000,,Semut
Dialogue: 0,0:13:51.47,0:13:52.21,Default,,0000,0000,0000,,berwarna hitam.
Dialogue: 0,0:14:00.47,0:14:03.11,Default,,0000,0000,0000,,Aura yang meremangkan bulu roma.
Dialogue: 0,0:14:03.11,0:14:04.39,Default,,0000,0000,0000,,Selain itu, bau ini...
Dialogue: 0,0:14:04.91,0:14:05.85,Default,,0000,0000,0000,,Apa yang berlaku?
Dialogue: 0,0:14:06.37,0:14:07.29,Default,,0000,0000,0000,,Itu
Dialogue: 0,0:14:07.51,0:14:09.05,Default,,0000,0000,0000,,bukan haiwan iblis yang biasa.
Dialogue: 0,0:14:09.43,0:14:11.15,Default,,0000,0000,0000,,Sudah tiada masa untuk teragak-agak.
Dialogue: 0,0:14:11.55,0:14:12.77,Default,,0000,0000,0000,,Jika tak membunuhnya...
Dialogue: 0,0:14:18.79,0:14:20.69,Default,,0000,0000,0000,,Ia melalui begitu saja.
Dialogue: 0,0:14:58.69,0:14:59.49,Default,,0000,0000,0000,,Cik Cha.
Dialogue: 0,0:15:02.75,0:15:04.07,Default,,0000,0000,0000,,Jangan pandang rendah saya!
Dialogue: 0,0:15:30.57,0:15:31.91,Default,,0000,0000,0000,,Rasakan!
Dialogue: 0,0:15:34.57,0:15:35.69,Default,,0000,0000,0000,,Ia telah menangkapnya.
Dialogue: 0,0:15:45.17,0:15:46.27,Default,,0000,0000,0000,,Rasalah terkejut.
Dialogue: 0,0:15:46.47,0:15:48.55,Default,,0000,0000,0000,,Kita ada rakan yang handal.
Dialogue: 0,0:15:49.35,0:15:52.25,Default,,0000,0000,0000,,Kemahiran untuk melindungi\Ndiri sendiri, "penyamaran".
Dialogue: 0,0:15:52.69,0:15:55.61,Default,,0000,0000,0000,,Selepas guna teknik ini,\Nsaya dapat jadi halimunan.
Dialogue: 0,0:15:55.95,0:15:57.89,Default,,0000,0000,0000,,Walaupun ada kelemahan\Ntak dapat gerak semasa digunakan,
Dialogue: 0,0:15:58.15,0:16:00.23,Default,,0000,0000,0000,,ini sudah memadai untuk penyembuh.
Dialogue: 0,0:16:00.23,0:16:01.65,Default,,0000,0000,0000,,Selagi saya ada di sini,
Dialogue: 0,0:16:01.65,0:16:03.25,Default,,0000,0000,0000,,pasukan kita takkan kalah.
Dialogue: 0,0:16:17.13,0:16:19.11,Default,,0000,0000,0000,,Saya telah gunakan penyamaran.
Dialogue: 0,0:16:19.63,0:16:20.87,Default,,0000,0000,0000,,Jangan-jangan...
Dialogue: 0,0:16:22.85,0:16:23.69,Default,,0000,0000,0000,,Byung-gu!
Dialogue: 0,0:16:34.29,0:16:35.95,Default,,0000,0000,0000,,Byung-gu!
Dialogue: 0,0:16:37.23,0:16:38.41,Default,,0000,0000,0000,,Abang Yoonho.
Dialogue: 0,0:16:39.11,0:16:40.15,Default,,0000,0000,0000,,Cepat lari.
Dialogue: 0,0:17:05.49,0:17:08.07,Default,,0000,0000,0000,,Abang Yoonho.
Dialogue: 0,0:17:09.87,0:17:11.83,Default,,0000,0000,0000,,Cepat lari.
Dialogue: 0,0:17:14.73,0:17:18.33,Default,,0000,0000,0000,,Abang Yoonho.
Dialogue: 0,0:17:19.97,0:17:21.37,Default,,0000,0000,0000,,Cepat lari.
Dialogue: 0,0:17:22.47,0:17:24.07,Default,,0000,0000,0000,,Tak guna.
Dialogue: 0,0:17:25.53,0:17:27.93,Default,,0000,0000,0000,,Kamu
Dialogue: 0,0:17:27.93,0:17:28.92,Default,,0000,0000,0000,,terlalu lemah.
Dialogue: 0,0:17:29.79,0:17:31.63,Default,,0000,0000,0000,,Ratu semut kami
Dialogue: 0,0:17:32.13,0:17:35.09,Default,,0000,0000,0000,,telah mati.
Dialogue: 0,0:17:35.51,0:17:37.91,Default,,0000,0000,0000,,Hanya membunuh askar
Dialogue: 0,0:17:38.17,0:17:40.25,Default,,0000,0000,0000,,adalah tidak berbaloi.
Dialogue: 0,0:17:40.89,0:17:42.59,Default,,0000,0000,0000,,Raja
Dialogue: 0,0:17:42.93,0:17:44.11,Default,,0000,0000,0000,,kamu
Dialogue: 0,0:17:44.31,0:17:45.49,Default,,0000,0000,0000,,berada di mana?
Dialogue: 0,0:17:46.25,0:17:47.21,Default,,0000,0000,0000,,Raja...
Dialogue: 0,0:17:50.81,0:17:53.09,Default,,0000,0000,0000,,Ada seorang yang kuat
Dialogue: 0,0:17:53.53,0:17:54.95,Default,,0000,0000,0000,,di luar sana.
Dialogue: 0,0:18:03.19,0:18:04.37,Default,,0000,0000,0000,,Di luar sana...
Dialogue: 0,0:18:04.37,0:18:05.91,Default,,0000,0000,0000,,Adakah ia merujuk Goto?
Dialogue: 0,0:18:06.35,0:18:08.67,Default,,0000,0000,0000,,Tak, tiada masa untuk fikir sekarang.
Dialogue: 0,0:18:08.97,0:18:11.29,Default,,0000,0000,0000,,Kita harus segera pergi dari sini.
Dialogue: 0,0:18:13.91,0:18:14.77,Default,,0000,0000,0000,,Tak guna.
Dialogue: 0,0:18:14.77,0:18:16.57,Default,,0000,0000,0000,,Semut lain sudah kembali juga?
Dialogue: 0,0:18:19.37,0:18:20.63,Default,,0000,0000,0000,,Keadaan tidak kena.
Dialogue: 0,0:18:21.09,0:18:22.67,Default,,0000,0000,0000,,Bukan saja Charlie,
Dialogue: 0,0:18:22.67,0:18:24.99,Default,,0000,0000,0000,,malah Delta juga kehilangan kontak.
Dialogue: 0,0:18:25.35,0:18:27.11,Default,,0000,0000,0000,,Mungkin isyarat tidak baik,
Dialogue: 0,0:18:27.67,0:18:30.39,Default,,0000,0000,0000,,tapi mereka sepatutnya\Nberada dalam lingkungan komunikasi.
Dialogue: 0,0:18:31.13,0:18:32.77,Default,,0000,0000,0000,,Bravo, sila jawab.
Dialogue: 0,0:18:33.17,0:18:34.23,Default,,0000,0000,0000,,Ini Bravo.
Dialogue: 0,0:18:34.75,0:18:36.95,Default,,0000,0000,0000,,Adakah kamu dapat menghubungi\NCharlie dan Delta?
Dialogue: 0,0:18:37.61,0:18:40.55,Default,,0000,0000,0000,,Tak, kami juga kehilangan kontak\Ndengan mereka sejak tadi.
Dialogue: 0,0:18:41.23,0:18:42.79,Default,,0000,0000,0000,,Awak nak kami pergi lihat?
Dialogue: 0,0:18:43.39,0:18:45.17,Default,,0000,0000,0000,,Kami sedang dalam perjalanan.
Dialogue: 0,0:18:46.01,0:18:48.97,Default,,0000,0000,0000,,Selepas kamu selesai,\Ntunggu saya di tempat pertemuan.
Dialogue: 0,0:18:49.33,0:18:50.39,Default,,0000,0000,0000,,Baiklah.
Dialogue: 0,0:18:55.45,0:18:56.68,Default,,0000,0000,0000,,Kenapa begitu?
Dialogue: 0,0:18:59.19,0:19:00.14,Default,,0000,0000,0000,,Ini saya.
Dialogue: 0,0:19:00.85,0:19:03.37,Default,,0000,0000,0000,,Saya tak terima\Npanggilan tetap daripada awak.
Dialogue: 0,0:19:04.03,0:19:05.37,Default,,0000,0000,0000,,Ada mangsa di sini.
Dialogue: 0,0:19:05.83,0:19:06.75,Default,,0000,0000,0000,,Oh.
Dialogue: 0,0:19:07.25,0:19:08.99,Default,,0000,0000,0000,,Perkembangan ini tak terduga.
Dialogue: 0,0:19:09.53,0:19:10.83,Default,,0000,0000,0000,,Bukankah awak hanya minta mereka
Dialogue: 0,0:19:11.07,0:19:13.49,Default,,0000,0000,0000,,membunuh haiwan iblis yang bermutasi\Nuntuk mengelakkan risiko?
Dialogue: 0,0:19:14.11,0:19:16.29,Default,,0000,0000,0000,,Sebab mereka terlalu lemah.
Dialogue: 0,0:19:16.69,0:19:18.33,Default,,0000,0000,0000,,Percakapan ini memang gaya awak.
Dialogue: 0,0:19:18.73,0:19:19.51,Default,,0000,0000,0000,,Biarlah.
Dialogue: 0,0:19:19.83,0:19:22.83,Default,,0000,0000,0000,,Selagi ada awak, kehilangan\Nbeberapa orang pun tak jadi masalah, kan?
Dialogue: 0,0:19:23.81,0:19:26.99,Default,,0000,0000,0000,,Oh ya, adakah pasukan di sana\Nsekarang berdekatan ratu semut?
Dialogue: 0,0:19:26.99,0:19:27.71,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:19:28.05,0:19:29.47,Default,,0000,0000,0000,,Namun sebentar tadi,
Dialogue: 0,0:19:29.67,0:19:31.53,Default,,0000,0000,0000,,kesan gelombang gangguan telah hilang.
Dialogue: 0,0:19:31.79,0:19:34.80,Default,,0000,0000,0000,,Semua semut di luar\Ntelah kembali ke sarang.
Dialogue: 0,0:19:35.33,0:19:36.29,Default,,0000,0000,0000,,Hm.
Dialogue: 0,0:19:36.55,0:19:39.73,Default,,0000,0000,0000,,Awak rasa mereka\Nberpeluang hidup atau tidak?
Dialogue: 0,0:19:40.17,0:19:41.69,Default,,0000,0000,0000,,Dengan kekuatan tempur mereka,
Dialogue: 0,0:19:42.43,0:19:44.01,Default,,0000,0000,0000,,tiada peluang.
Dialogue: 0,0:19:44.95,0:19:46.17,Default,,0000,0000,0000,,Bagus.
Dialogue: 0,0:19:46.81,0:19:51.71,Default,,0000,0000,0000,,Jepun telah berusaha membantu\Ntapi pasukan bersekutu telah dimusnahkan,
Dialogue: 0,0:19:51.71,0:19:53.77,Default,,0000,0000,0000,,jadi kita terpaksa undur buat masa ini.
Dialogue: 0,0:19:54.01,0:19:55.53,Default,,0000,0000,0000,,Kita telah mewarisi semangat juang mereka
Dialogue: 0,0:19:55.53,0:19:59.91,Default,,0000,0000,0000,,dan terus mara ke arah Pulau Jeju\Ndengan pasukan penyerang kedua di laut.
Dialogue: 0,0:20:00.35,0:20:02.59,Default,,0000,0000,0000,,Melemahkan kekuatan tempur\Nnegara jiran secara perlahan
Dialogue: 0,0:20:02.85,0:20:06.01,Default,,0000,0000,0000,,agar pihak kita menjadi\Nnegara penakluk portal tahap S.
Dialogue: 0,0:20:06.75,0:20:07.79,Default,,0000,0000,0000,,Sudah tiba masanya.
Dialogue: 0,0:20:08.07,0:20:09.63,Default,,0000,0000,0000,,Semua orang undur.
Dialogue: 0,0:20:09.63,0:20:12.35,Default,,0000,0000,0000,,Bertemu dengan\Npasukan penyerang kedua di laut.
Dialogue: 0,0:20:13.75,0:20:14.73,Default,,0000,0000,0000,,Biarlah.
Dialogue: 0,0:20:15.85,0:20:17.81,Default,,0000,0000,0000,,Encik Matsumoto telah berikan arahan.
Dialogue: 0,0:20:18.03,0:20:18.91,Default,,0000,0000,0000,,Kita undur.
Dialogue: 0,0:20:19.55,0:20:21.44,Default,,0000,0000,0000,,Kita akan kembali\Nuntuk ambil mayat nanti...
Dialogue: 0,0:20:26.27,0:20:27.37,Default,,0000,0000,0000,,Ishida!
Dialogue: 0,0:20:27.37,0:20:28.29,Default,,0000,0000,0000,,Cepat pergi.
Dialogue: 0,0:20:29.23,0:20:31.65,Default,,0000,0000,0000,,Bertemu dengan pasukan laut bersama Bravo,
Dialogue: 0,0:20:31.93,0:20:33.15,Default,,0000,0000,0000,,bersedia untuk serangan berikutnya.
Dialogue: 0,0:20:33.53,0:20:34.57,Default,,0000,0000,0000,,Namun...
Dialogue: 0,0:20:34.57,0:20:36.71,Default,,0000,0000,0000,,Awak cuma akan mengganggu di sini.
Dialogue: 0,0:20:38.33,0:20:39.09,Default,,0000,0000,0000,,Pergilah.
Dialogue: 0,0:20:39.09,0:20:39.99,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:20:43.67,0:20:45.71,Default,,0000,0000,0000,,Aura yang amat mengagumkan.
Dialogue: 0,0:20:46.71,0:20:48.96,Default,,0000,0000,0000,,Awaklah raja?
Dialogue: 0,0:20:50.01,0:20:51.03,Default,,0000,0000,0000,,Menarik.
Dialogue: 0,0:20:51.43,0:20:52.87,Default,,0000,0000,0000,,Semut pandai bercakap.
Dialogue: 0,0:20:55.03,0:20:55.87,Default,,0000,0000,0000,,Raja.
Dialogue: 0,0:20:56.27,0:20:57.15,Default,,0000,0000,0000,,Betul.
Dialogue: 0,0:20:57.47,0:20:58.75,Default,,0000,0000,0000,,Sayalah raja.
Dialogue: 0,0:21:03.99,0:21:05.55,Default,,0000,0000,0000,,Kenapa dengan kuasa sihir ini?
Dialogue: 0,0:21:06.33,0:21:07.51,Default,,0000,0000,0000,,Perasaan ini...
Dialogue: 0,0:21:08.01,0:21:10.13,Default,,0000,0000,0000,,Saya pernah merasakannya.
Dialogue: 0,0:21:11.57,0:21:12.55,Default,,0000,0000,0000,,Itu...
Dialogue: 0,0:21:22.35,0:21:23.31,Default,,0000,0000,0000,,Choi Jong-in.
Dialogue: 0,0:21:23.31,0:21:25.15,Default,,0000,0000,0000,,Tingkatkan kekuatan awak.
Dialogue: 0,0:21:25.15,0:21:27.19,Default,,0000,0000,0000,,Jangan paksa saya.
Dialogue: 0,0:21:27.19,0:21:28.62,Default,,0000,0000,0000,,Saya sudah mencapai batas.
Dialogue: 0,0:21:29.09,0:21:31.39,Default,,0000,0000,0000,,Semua orang tercedera parah,
Dialogue: 0,0:21:31.75,0:21:34.50,Default,,0000,0000,0000,,sudah tiada kekuatan untuk melawan lagi.
Dialogue: 0,0:21:34.93,0:21:37.46,Default,,0000,0000,0000,,Penyelamat Choi Jong-in pun telah...
Dialogue: 0,0:21:43.79,0:21:45.06,Default,,0000,0000,0000,,Adakah ini pengakhirannya?
Dialogue: 0,0:21:53.81,0:21:54.67,Default,,0000,0000,0000,,Apa yang berlaku?
Dialogue: 0,0:21:55.49,0:21:57.15,Default,,0000,0000,0000,,Semua askar hitam ini...
Dialogue: 0,0:22:03.75,0:22:04.67,Default,,0000,0000,0000,,Pertukaran.
Dialogue: 0,0:22:42.00,0:22:44.66,Default,,0000,0000,0000,,(Solo Leveling)
Dialogue: 0,0:22:44.66,0:22:48.17,Default,,0000,0000,0000,,(Episod 23: Keadaan Menjadi Lebih Sengit)
Dialogue: 0,0:23:38.68,0:23:40.93,Default,,0000,0000,0000,,(Episod 24: Adakah Awak Raja Manusia?)
