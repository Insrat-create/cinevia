Dialogue: 0,0:00:07.78,0:00:09.03,Default,Sung Jinwoo,0000,0000,0000,,‫انهض.
Dialogue: 0,0:00:23.24,0:00:24.40,Default,Sung Jinwoo,0000,0000,0000,,‫جيد.
Dialogue: 0,0:01:56.14,0:01:58.06,Default,Baek Yoonho,0000,0000,0000,,‫كم مضى من الوقت؟
Dialogue: 0,0:01:58.06,0:01:59.81,Default,Ahn Sangmin,0000,0000,0000,,‫ثلاث ساعات تقريبًا.
Dialogue: 0,0:02:00.27,0:02:03.52,Default,Ahn Sangmin,0000,0000,0000,,‫هذا يعادل ثلاثة أيام تقريبًا في الجانب الآخر، صحيح؟
Dialogue: 0,0:02:03.98,0:02:06.90,Default,Baek Yoonho,0000,0000,0000,,‫يفترض أن يكون الوضع قاسيًا داخل البوابات الحمراء.
Dialogue: 0,0:02:08.32,0:02:12.07,Default,Hwang Dongsoo,0000,0000,0000,,‫إذًا سون جينوو ذاك ميت على الأرجح.
Dialogue: 0,0:02:12.53,0:02:14.10,Default,Hwang Dongsoo,0000,0000,0000,,‫يا لها من مضيعة وقت.
Dialogue: 0,0:02:16.33,0:02:22.04,Default,Hwang Dongsoo,0000,0000,0000,,‫لا... مهلًا. سون جينوو ليس فردًا\N‫في نقابة الببر الأبيض، صحيح؟
Dialogue: 0,0:02:22.54,0:02:27.48,Default,Hwang Dongsoo,0000,0000,0000,,‫فلماذا إذًا هو مع فريقك الضارب؟
Dialogue: 0,0:02:29.96,0:02:32.30,Default,Ahn Sangmin,0000,0000,0000,,‫إنه من معارفي.
Dialogue: 0,0:02:32.30,0:02:35.97,Default,Ahn Sangmin,0000,0000,0000,,‫أراد مشاهدة غارة من الدرجة ج، لذا أحضرته.
Dialogue: 0,0:02:36.68,0:02:39.39,Default,Hwang Dongsoo,0000,0000,0000,,‫أهذا كل شيء؟
Dialogue: 0,0:02:43.48,0:02:45.86,Default,Hwang Dongsoo,0000,0000,0000,,‫هل تظنني ساذجًا إلى تلك الدرجة؟!
Dialogue: 0,0:02:45.86,0:02:48.78,Default,Hwang Dongsoo,0000,0000,0000,,‫ماذا وجدت هذه المرة؟
Dialogue: 0,0:02:48.78,0:02:52.90,Default,Hwang Dongsoo,0000,0000,0000,,‫لطالما كنت تجيد استكشاف أفراد جدد...
Dialogue: 0,0:02:54.49,0:02:55.57,Default,Baek Yoonho,0000,0000,0000,,‫هوانغ دونسو.
Dialogue: 0,0:02:56.71,0:02:58.54,Default,Baek Yoonho,0000,0000,0000,,‫أبعد يدك عنه!
Dialogue: 0,0:02:58.88,0:03:00.91,Default,Hwang Dongsoo,0000,0000,0000,,‫أتريد حقا أن تبدأ بإلقاء الأوامر علي؟
Dialogue: 0,0:03:00.91,0:03:04.54,Default,Hwang Dongsoo,0000,0000,0000,,‫هل تظن أنّك شخص مهم في هذه البلاد الصغيرة؟
Dialogue: 0,0:03:05.16,0:03:06.43,Default,Baek Yoonho,0000,0000,0000,,‫ماذا قلت؟
Dialogue: 0,0:03:09.56,0:03:11.13,DefaultItalics,Ahn Sangmin,0000,0000,0000,,‫هذا سيئ!
Dialogue: 0,0:03:11.13,0:03:15.38,DefaultItalics,Ahn Sangmin,0000,0000,0000,,‫إن لم يتوقفا، فسيكون لدينا معركة من الدرجة س!
Dialogue: 0,0:03:15.72,0:03:17.40,Default,Hwang Dongsoo,0000,0000,0000,,‫هل تريد القتال؟
Dialogue: 0,0:03:33.13,0:03:35.99,Default,Kim Chul,0000,0000,0000,,‫كان الجو باردًا جدًّا... لا...
Dialogue: 0,0:03:36.64,0:03:39.95,Default,Kim Chul,0000,0000,0000,,‫لو كانت عدّتنا معنا، لتمكّنا من الفوز...
Dialogue: 0,0:03:41.95,0:03:44.87,DefaultItalics,Kim Chul,0000,0000,0000,,‫بدا لي عدم خروج أيّ من دببة الجليد غريبًا!
Dialogue: 0,0:03:45.48,0:03:48.08,DefaultItalics,Kim Chul,0000,0000,0000,,‫لا يمكن... هل هذا من فعل مجموعة الدرجة هـ؟!
Dialogue: 0,0:03:48.82,0:03:51.67,DefaultItalics,Kim Chul,0000,0000,0000,,‫مستحيل! لا يمكن أن يكونوا أقوياء ما يكفي لهذا!
Dialogue: 0,0:03:54.13,0:03:56.59,Default,Kim Chul,0000,0000,0000,,‫مهلًا، قتلة الجليد...
Dialogue: 0,0:03:56.59,0:03:57.51,Default,Kim Chul,0000,0000,0000,,‫إنّهم هنا أيضًا!
Dialogue: 0,0:03:57.93,0:03:59.14,Default,Kim Chul,0000,0000,0000,,‫تبا!
Dialogue: 0,0:04:04.64,0:04:06.23,Default,Hwang Dongsoo,0000,0000,0000,,‫لست سيئا.
Dialogue: 0,0:04:08.23,0:04:14.37,Default,Woo Jinchul,0000,0000,0000,,‫ما زالت ذراعاي سليمتان بفضل كبحكما لقوتكما.
Dialogue: 0,0:04:16.92,0:04:20.33,Default,Woo Jinchul,0000,0000,0000,,‫لا أعلم سبب اهتمامك به أيها الصياد هوانغ،
Dialogue: 0,0:04:20.33,0:04:24.91,Default,Woo Jinchul,0000,0000,0000,,‫لكني أعدت تقييمه بنفسي قبل شهرين.
Dialogue: 0,0:04:25.54,0:04:28.88,Default,Woo Jinchul,0000,0000,0000,,‫يمكنني أن أضمن لك أنّ الصياد سون من الدرجة هـ.
Dialogue: 0,0:04:29.23,0:04:33.32,Default,Woo Jinchul,0000,0000,0000,,‫أعلن فريق المراقبة أنّ سبب موت الصياد هوانغ دونسوك
Dialogue: 0,0:04:33.32,0:04:35.37,Default,Woo Jinchul,0000,0000,0000,,‫هو التعرض للقتل في القتال أمام وحش سحري.
Dialogue: 0,0:04:36.38,0:04:39.34,Default,Hwang Dongsoo,0000,0000,0000,,‫لكنها قصة من أجل العامة فقط.
Dialogue: 0,0:04:39.34,0:04:41.68,Default,Hwang Dongsoo,0000,0000,0000,,‫وهي مزيفة أيضًا.
Dialogue: 0,0:04:41.68,0:04:45.80,Default,Hwang Dongsoo,0000,0000,0000,,‫لا بدّ أنّ القاتل الحقيقي هو ذلك\N‫القذر الثري من شركة يوجين للبناء.
Dialogue: 0,0:04:47.19,0:04:50.56,Default,Woo Jinchul,0000,0000,0000,,‫إن كنت تظن ذلك، فلماذا تطارد الصياد سون؟
Dialogue: 0,0:04:51.85,0:04:53.84,Default,Hwang Dongsoo,0000,0000,0000,,‫أليس الأمر واضحًا؟
Dialogue: 0,0:04:53.84,0:04:56.11,Default,Hwang Dongsoo,0000,0000,0000,,‫إنّه مجرد عذر.
Dialogue: 0,0:04:56.57,0:04:58.57,Default,Hwang Dongsoo,0000,0000,0000,,‫عذر لقتله.
Dialogue: 0,0:05:05.52,0:05:07.34,Default,Hwang Dongsoo,0000,0000,0000,,‫إنّه وغد محظوظ.
Dialogue: 0,0:05:10.04,0:05:11.36,Default,Woo Jinchul,0000,0000,0000,,‫أيها الصياد هوانغ!
Dialogue: 0,0:05:11.83,0:05:16.18,DefaultItalics,Ahn Sangmin,0000,0000,0000,,‫لا أحد يفهم قوة الصياد سون مثلي.
Dialogue: 0,0:05:16.87,0:05:19.21,DefaultItalics,Ahn Sangmin,0000,0000,0000,,‫أنا متأكد أنّه سينجو ويعود.
Dialogue: 0,0:05:21.89,0:05:24.89,Default,Go Myunghwan,0000,0000,0000,,‫وبعدها لم يبق لدي مال لشراء العدة!
Dialogue: 0,0:05:25.67,0:05:28.85,Default,Go Myunghwan,0000,0000,0000,,‫قلت لكما! أخطأت بمعامل عشرة!
Dialogue: 0,0:05:28.85,0:05:30.81,DefaultTop,Go Myunghwan,0000,0000,0000,,‫كان باهظًا لتلك الدرجة!
Dialogue: 0,0:05:29.56,0:05:34.04,DefaultItalics,Kim Chul,0000,0000,0000,,‫لمَ لا يزال ضعفاء أمثالكم أحياءً؟!
Dialogue: 0,0:05:30.81,0:05:32.55,DefaultTop,Park Heejin,0000,0000,0000,,‫حقا؟
Dialogue: 0,0:05:34.04,0:05:36.67,DefaultTop,Go Myunghwan,0000,0000,0000,,‫لدرجة أني اضطررت لأخذ كل الأسلحة و...
Dialogue: 0,0:05:34.04,0:05:37.28,DefaultItalics,Kim Chul,0000,0000,0000,,‫لديكم عدة للطقس البارد وملاءات وخيم وحتى طعام!
Dialogue: 0,0:05:38.39,0:05:41.49,DefaultItalics,Kim Chul,0000,0000,0000,,‫أهذا ما حدث؟
Dialogue: 0,0:05:42.31,0:05:43.62,Default,Kim Chul,0000,0000,0000,,‫أنتم!
Dialogue: 0,0:05:44.53,0:05:45.92,Default,Park Heejin,0000,0000,0000,,‫الصياد كيم؟
Dialogue: 0,0:05:45.92,0:05:48.37,Default,Kim Chul,0000,0000,0000,,‫أبيد فريقي بأكمله!
Dialogue: 0,0:05:49.00,0:05:51.46,Default,Kim Chul,0000,0000,0000,,‫لأنّهم لم يملكوا عدّة ومؤن!
Dialogue: 0,0:05:51.46,0:05:52.64,Default,Go Myunghwan,0000,0000,0000,,‫هذا...
Dialogue: 0,0:05:52.64,0:05:54.71,Default,Kim Chul,0000,0000,0000,,‫من خبّأ كلّ هذا؟!
Dialogue: 0,0:05:54.71,0:05:58.59,Default,Kim Chul,0000,0000,0000,,‫من الذي ادّخر كل هذه المعدات\N‫وتسبب في قتل أصدقائي؟!
Dialogue: 0,0:05:59.42,0:06:01.05,DefaultItalics,Kim Chul,0000,0000,0000,,‫فهمت.
Dialogue: 0,0:06:01.05,0:06:02.92,Default,Han Song-yi,0000,0000,0000,,‫هـ-هيجين-سان...
Dialogue: 0,0:06:02.92,0:06:05.51,DefaultItalics,Kim Chul,0000,0000,0000,,‫كنت تعرفين من البداية، أليس كذلك؟
Dialogue: 0,0:06:05.51,0:06:07.47,DefaultItalics,Kim Chul,0000,0000,0000,,‫لذلك السبب ذهبت معهم.
Dialogue: 0,0:06:07.82,0:06:10.67,Default,Kim Chul,0000,0000,0000,,‫أيّ شركاء في هذا سيُعتبرون مذنبين أيضًا!
Dialogue: 0,0:06:11.17,0:06:13.40,Default,Kim Chul,0000,0000,0000,,‫أريد سماع اعتراف بعد العد إلى ثلاثة!
Dialogue: 0,0:06:14.30,0:06:15.86,Default,Kim Chul,0000,0000,0000,,‫واحد!
Dialogue: 0,0:06:16.25,0:06:17.12,Default,Kim Chul,0000,0000,0000,,‫اثنان!
Dialogue: 0,0:06:17.12,0:06:18.82,DefaultItalics,Kim Chul,0000,0000,0000,,‫أعرف من فعل هذا...
Dialogue: 0,0:06:19.73,0:06:20.84,DefaultItalics,Kim Chul,0000,0000,0000,,‫سون جينوو!
Dialogue: 0,0:06:20.84,0:06:22.19,Default,Kim Chul,0000,0000,0000,,‫ثلاثة!
Dialogue: 0,0:06:29.93,0:06:32.61,Default,Sung Jinwoo,0000,0000,0000,,‫من تلومه على موت أصدقائك بالضبط؟
Dialogue: 0,0:06:32.61,0:06:33.62,Default,Han Song-Yi,0000,0000,0000,,‫سيد!
Dialogue: 0,0:06:33.62,0:06:35.02,Default,Go Myunghwan,0000,0000,0000,,‫أيها القائد!
Dialogue: 0,0:06:35.02,0:06:37.57,Default,Sung Jinwoo,0000,0000,0000,,‫كما أنّك جلبت المزيد من المتاعب معك...
Dialogue: 0,0:06:37.95,0:06:42.67,Default,Sung Jinwoo,0000,0000,0000,,‫كفوا عن التسلل. هالتكم أقوى\N‫من ألّا تُلاحَظ على أي حال.
Dialogue: 0,0:06:44.52,0:06:46.93,Default,Park Heejin,0000,0000,0000,,‫هل هم إلف جليد؟!
Dialogue: 0,0:06:46.93,0:06:48.77,Default,Go Myunghwan,0000,0000,0000,,‫وعددهم كبير أيضًا!
Dialogue: 0,0:06:49.70,0:06:50.98,Default,Sung Jinwoo,0000,0000,0000,,‫لا بدّ أنّه الزعيم.
Dialogue: 0,0:06:55.59,0:06:57.48,Default,Barca,0000,0000,0000,,‫تخيل اندهاشي...
Dialogue: 0,0:06:57.83,0:07:00.18,Default,Barca,0000,0000,0000,,‫عندما اكتشفت أنّ بعضًا منكم\N‫أيها الحثالة تعرفون ما تفعلونه.
Dialogue: 0,0:07:00.53,0:07:01.93,Default,Sung Jinwoo,0000,0000,0000,,‫معذرة؟
Dialogue: 0,0:07:01.93,0:07:05.46,Default,Sung Jinwoo,0000,0000,0000,,‫هل تنعتنا بالحثالة بينما...
Dialogue: 0,0:07:10.39,0:07:12.44,Default,Barca,0000,0000,0000,,‫...هل تفهم لغتنا؟
Dialogue: 0,0:07:13.58,0:07:14.78,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لماذا أفهمها؟
Dialogue: 0,0:07:14.78,0:07:18.08,Default,Park Heejin,0000,0000,0000,,‫يمكنك التحدث بلغة الوحوش السحرية؟
Dialogue: 0,0:07:18.54,0:07:20.57,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫أظنّ أنّ هذا بفضل النظام.
Dialogue: 0,0:07:20.92,0:07:23.93,Default,Barca,0000,0000,0000,,‫إن كنت تفهمني، فسأبسّط الأمر.
Dialogue: 0,0:07:23.93,0:07:26.14,Default,Barca,0000,0000,0000,,‫أعلمني صديقي هنا...
Dialogue: 0,0:07:27.10,0:07:30.54,Default,Barca,0000,0000,0000,,‫بأنّ أحد البشر الذين صادفناهم قويّ.
Dialogue: 0,0:07:30.54,0:07:32.93,Default,Barca,0000,0000,0000,,‫يريد أيضًا أن يقاتلك...
Dialogue: 0,0:07:40.19,0:07:41.09,Default,Sung Jinwoo,0000,0000,0000,,‫وبعد؟
Dialogue: 0,0:07:43.79,0:07:45.39,Default,Barca,0000,0000,0000,,‫مثير للاهتمام.
Dialogue: 0,0:07:51.67,0:07:53.91,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لن يُهزَم بسهولة.
Dialogue: 0,0:07:54.95,0:07:57.04,Default,Barca,0000,0000,0000,,‫يستمر الوضع في التحسن.
Dialogue: 0,0:07:57.48,0:08:03.55,Default,Barca,0000,0000,0000,,‫أخبرني، أنت لست بشريًّا، فلماذا تدعي أنك واحد منهم؟
Dialogue: 0,0:08:05.80,0:08:09.47,Default,Barca,0000,0000,0000,,‫أظنّك لا تدرك ذلك؟
Dialogue: 0,0:08:09.47,0:08:14.17,Default,Barca,0000,0000,0000,,‫يمكننا سماع صوت يقول لنا أن نقتل البشر.
Dialogue: 0,0:08:14.17,0:08:17.44,Default,Barca,0000,0000,0000,,‫لكنّنا لا نسمعه حيالك.
Dialogue: 0,0:08:17.82,0:08:19.49,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫صوت...؟
Dialogue: 0,0:08:20.33,0:08:23.19,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫هل يمكن أن يكون شبيهًا بتوجيهات النظام؟
Dialogue: 0,0:08:23.19,0:08:28.45,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫عدم توجيه الصوت ضدّي ربما لأنّي اللاعب.
Dialogue: 0,0:08:28.45,0:08:33.86,Default,Barca,0000,0000,0000,,‫لا داعي لأن نتقاتل. دعنا نعالج الأمر بعقلانية.
Dialogue: 0,0:08:33.86,0:08:38.85,Default,Barca,0000,0000,0000,,‫سلّم لنا البشر الذين خلفك، وسندعك وشأنك.
Dialogue: 0,0:08:38.85,0:08:41.91,Default,Barca,0000,0000,0000,,‫ما رأيك؟ ما ردّك على عرضنا؟
Dialogue: 0,0:08:42.63,0:08:44.71,Default,Sung Jinwoo,0000,0000,0000,,‫من أنتم بالضبط؟
Dialogue: 0,0:08:45.05,0:08:47.25,Default,Sung Jinwoo,0000,0000,0000,,‫لماذا تقاتلون البشر على أي حال؟
Dialogue: 0,0:08:47.72,0:08:49.29,Default,Barca,0000,0000,0000,,‫نحن...
Dialogue: 0,0:08:51.24,0:08:57.48,Default,Barca,0000,0000,0000,,‫سلّم لنا البشر الذين خلفك، وسندعك وشأنك.
Dialogue: 0,0:08:57.99,0:08:59.58,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ما كان هذا للتو؟
Dialogue: 0,0:08:59.58,0:09:02.57,Default,Barca,0000,0000,0000,,‫ما رأيك؟ ما ردّك على عرضنا؟
Dialogue: 0,0:09:02.57,0:09:04.40,Default,Barca,0000,0000,0000,,‫أنا واثق أنّك ستوافق.
Dialogue: 0,0:09:07.36,0:09:08.40,Default,Sung Jinwoo,0000,0000,0000,,‫بل أرفض.
Dialogue: 0,0:09:09.80,0:09:12.91,Default,Barca,0000,0000,0000,,‫أتنوي أن تجعل منا أعداء لك؟
Dialogue: 0,0:09:12.91,0:09:16.15,Default,Barca,0000,0000,0000,,‫فكما ترى، أفضلية العدد لنا.
Dialogue: 0,0:09:17.33,0:09:18.75,Default,Sung Jinwoo,0000,0000,0000,,‫هل أنت متأكد؟
Dialogue: 0,0:09:26.92,0:09:28.55,Default,Han Song-Yi,0000,0000,0000,,‫مـ-ما هذا؟
Dialogue: 0,0:09:28.55,0:09:31.30,Default,Go Myunghwan,0000,0000,0000,,‫و-وحوش! ظهرت عدة وحوش!
Dialogue: 0,0:09:31.30,0:09:34.68,Default,Park Heejin,0000,0000,0000,,‫جنود سود ودببة جليد سوداء؟!
Dialogue: 0,0:09:34.68,0:09:35.79,Default,Park Heejin,0000,0000,0000,,‫أكل هذه...
Dialogue: 0,0:09:35.79,0:09:37.98,Default,Park Heejin,0000,0000,0000,,‫أيها الصياد سون، هل أنت من فعلت هذا؟!
Dialogue: 0,0:09:38.75,0:09:41.25,Default,Barca,0000,0000,0000,,‫يا لها من مضيعة وقت.
Dialogue: 0,0:09:41.25,0:09:44.53,Default,Sung Jinwoo,0000,0000,0000,,‫مضيعة؟ أتظن ذلك حقا؟
Dialogue: 0,0:10:01.53,0:10:05.51,Default,Park Heejin,0000,0000,0000,,‫بسرعة! لن نساعد بشيء في قتال كهذا!
Dialogue: 0,0:10:13.43,0:10:15.41,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫يمكنني أن أرى سبب ثقته.
Dialogue: 0,0:10:15.81,0:10:19.00,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫قد تكون استدعاءاتي خالدة،\N‫لكن تجددها يتطلب قوة سحرية.
Dialogue: 0,0:10:19.98,0:10:22.27,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لدي الكثير، لكنها ستنفد في النّهاية.
Dialogue: 0,0:10:22.77,0:10:24.15,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫وهناك الزعيم.
Dialogue: 0,0:10:24.72,0:10:26.61,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫من الواضح أنّه أقوى مني.
Dialogue: 0,0:10:33.50,0:10:36.33,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫حتى وإن قاتلت إلى جانب إيغريس،\N‫فسيكون الأمر صعبًا على الأرجح.
Dialogue: 0,0:10:37.00,0:10:38.95,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫الجنود العاديون لن يفوا بالغرض.
Dialogue: 0,0:10:39.72,0:10:42.37,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫أحتاج إلى قوة قتالية قوية.
Dialogue: 0,0:10:42.37,0:10:44.33,Default,Barca,0000,0000,0000,,‫اسمي باركا.
Dialogue: 0,0:10:44.81,0:10:46.67,Default,Barca,0000,0000,0000,,‫ما اسمك؟
Dialogue: 0,0:10:48.80,0:10:50.12,Default,Sung Jinwoo,0000,0000,0000,,‫سون جينوو.
Dialogue: 0,0:11:16.31,0:11:19.49,Default,Barca,0000,0000,0000,,‫لم أستمتع بقتال كهذا منذ وقت طويل.
Dialogue: 0,0:11:34.40,0:11:36.43,Default,Kim Chul,0000,0000,0000,,‫ما الذي أصابني...؟
Dialogue: 0,0:11:41.19,0:11:43.43,Default,Kim Chul,0000,0000,0000,,‫سون جينوو!
Dialogue: 0,0:11:46.03,0:11:48.74,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫تمكنت من كسب بعض الوقت بالجنود السحريين.
Dialogue: 0,0:11:49.23,0:11:50.10,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ما يبقي لي...
Dialogue: 0,0:11:50.75,0:11:53.47,Default,Barca,0000,0000,0000,,‫أهذا أفضل ما يمكن لرجالك فعله؟!
Dialogue: 0,0:11:55.11,0:11:57.45,Default,Kim Chul,0000,0000,0000,,‫سون جينوو!
Dialogue: 0,0:11:57.45,0:11:59.08,Default,Kim Chul,0000,0000,0000,,‫فلتمت!
Dialogue: 0,0:11:59.08,0:12:01.39,Default,Barca,0000,0000,0000,,‫تخلى عنك البشر أيضًا!
Dialogue: 0,0:12:07.16,0:12:11.38,Default,Barca,0000,0000,0000,,‫لا جدوى! لن ينقذك الاختباء!
Dialogue: 0,0:12:19.10,0:12:21.39,Default,Kim Chul,0000,0000,0000,,‫سون جينوو!
Dialogue: 0,0:12:21.39,0:12:23.05,Default,Kim Chul,0000,0000,0000,,‫فلتمت!
Dialogue: 0,0:12:23.05,0:12:26.29,Default,Sung Jinwoo,0000,0000,0000,,‫كيم تشول. عرفت أنك ستفعل هذا.
Dialogue: 0,0:12:31.68,0:12:32.69,Default,Barca,0000,0000,0000,,‫لا جدوى!
Dialogue: 0,0:12:37.25,0:12:39.70,Default,Kim Chul,0000,0000,0000,,‫سون جينوو... أيها الوغد!
Dialogue: 0,0:12:40.72,0:12:46.12,Default,Kim Chul,0000,0000,0000,,‫كنت تعرف... أنّ هذا سيحدث...؟
Dialogue: 0,0:12:46.46,0:12:48.15,Default,Kim Chul,0000,0000,0000,,‫تبًّا!
Dialogue: 0,0:12:50.34,0:12:51.09,Default,Sung Jinwoo,0000,0000,0000,,‫انهض.
Dialogue: 0,0:12:54.00,0:12:56.63,Default,Barca,0000,0000,0000,,‫لن ينقذك الاختباء!
Dialogue: 0,0:13:11.25,0:13:12.23,Default,Sung Jinwoo,0000,0000,0000,,‫أيرن.
Dialogue: 0,0:13:12.93,0:13:15.84,Default,Sung Jinwoo,0000,0000,0000,,‫من الآن فصاعدًا اسمك أيرن.
Dialogue: 0,0:13:23.60,0:13:25.95,Default,Barca,0000,0000,0000,,‫أليس هذا مثيرًا للاهتمام؟!
Dialogue: 0,0:13:25.95,0:13:28.23,Default,Barca,0000,0000,0000,,‫سأمزقك إربًا أوّلًا!
Dialogue: 0,0:13:36.23,0:13:39.12,Default,Barca,0000,0000,0000,,‫لست رشيقًا على ما يبدو!
Dialogue: 0,0:13:42.46,0:13:47.87,Default,Han Song-Yi,0000,0000,0000,,‫هيجين-سان، هل تكون معارك الصيادين هكذا دائمًا؟
Dialogue: 0,0:13:48.30,0:13:52.06,Default,Park Heejin,0000,0000,0000,,‫هل تظنين حقًّا أني كنت لأصير صيادة لو كانت كذلك؟
Dialogue: 0,0:13:52.46,0:13:54.50,Default,Park Heejin,0000,0000,0000,,‫لم أر أي شيء كهذا من قبل.
Dialogue: 0,0:13:54.50,0:13:57.23,Default,Go Myunghwan,0000,0000,0000,,‫هذا ليس حلمًا، أليس كذلك...؟
Dialogue: 0,0:14:00.34,0:14:02.91,Default,Barca,0000,0000,0000,,‫هذا ليس مرضيًا كفاية.
Dialogue: 0,0:14:03.28,0:14:08.05,Default,Barca,0000,0000,0000,,‫عليك أن تواجهني أنت والفارس أيضًا!
Dialogue: 0,0:14:08.05,0:14:09.54,Default,Sung Jinwoo,0000,0000,0000,,‫هل هذا صحيح؟
Dialogue: 0,0:14:21.18,0:14:24.68,Default,Barca,0000,0000,0000,,‫أنت ستموت أوّلًا!
Dialogue: 0,0:14:34.40,0:14:36.77,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫تمكن من تجنب ضربة قاتلة وسط كل ذلك؟
Dialogue: 0,0:14:38.39,0:14:41.89,Default,Barca,0000,0000,0000,,‫أنت تستخف بي كثيرًا!
Dialogue: 0,0:14:41.89,0:14:43.82,Default,Sung Jinwoo,0000,0000,0000,,‫أنت قوي حقًّا.
Dialogue: 0,0:14:44.33,0:14:47.37,Default,Sung Jinwoo,0000,0000,0000,,‫لكن ماذا عن جنودك؟
Dialogue: 0,0:14:54.72,0:14:59.34,Default,Barca,0000,0000,0000,,‫لا أظن أنّ هناك فائدة من أوباشك من دونك!
Dialogue: 0,0:15:01.10,0:15:03.73,Default,Barca,0000,0000,0000,,‫ترمي سلاحك؟! أحمق!
Dialogue: 0,0:15:13.14,0:15:13.98,Default,Sung Jinwoo,0000,0000,0000,,‫أيرن!
Dialogue: 0,0:15:33.22,0:15:36.50,Default,Barca,0000,0000,0000,,‫كيف تجرؤ؟!
Dialogue: 0,0:15:37.03,0:15:40.61,Default,Barca,0000,0000,0000,,‫سأقتلكم جميعًا!
Dialogue: 0,0:15:42.26,0:15:44.43,Default,Sung Jinwoo,0000,0000,0000,,‫انتهى الأمر بالفعل.
Dialogue: 0,0:15:44.43,0:15:49.20,Default,Barca,0000,0000,0000,,‫لا تعبث معي! لن ينتهي الأمر حتى أقول أنا ذلك!
Dialogue: 0,0:15:59.53,0:16:00.65,Default,Sung Jinwoo,0000,0000,0000,,‫كما قلت لك...
Dialogue: 0,0:16:03.02,0:16:05.06,Default,Sung Jinwoo,0000,0000,0000,,‫انتهى الأمر بالفعل.
Dialogue: 0,0:16:09.52,0:16:11.42,Default,Sung Jinwoo,0000,0000,0000,,‫يبدو أني تمكّنت من هزيمته.
Dialogue: 0,0:16:16.67,0:16:18.54,Default,Sung Jinwoo,0000,0000,0000,,‫أنت! هذا يكفي!
Dialogue: 0,0:16:20.13,0:16:22.00,Default,Sung Jinwoo,0000,0000,0000,,‫اضبط نفسك.
Dialogue: 0,0:16:23.92,0:16:25.92,Default,Sung Jinwoo,0000,0000,0000,,‫آمل أن لا تصبح هذه مشكلة.
Dialogue: 0,0:16:38.09,0:16:40.87,Default,Park Heejin,0000,0000,0000,,‫هل انتهى الأمر؟
Dialogue: 0,0:16:40.87,0:16:42.02,Default,Sung Jinwoo,0000,0000,0000,,‫نعم.
Dialogue: 0,0:16:44.07,0:16:45.64,Default,Sung Jinwoo,0000,0000,0000,,‫ينبغي أن نذهب الآن.
Dialogue: 0,0:16:49.50,0:16:51.11,Default,Sung Jinwoo,0000,0000,0000,,‫لنخرج من البوابة.
Dialogue: 0,0:16:53.31,0:16:56.91,Default,Go Myunghwan,0000,0000,0000,,‫مرحى! سنعود إلى البيت!
Dialogue: 0,0:16:56.91,0:16:58.73,Default,Unmarked AD,0000,0000,0000,,‫كم هذا مطمئن...
Dialogue: 0,0:16:58.73,0:17:00.01,Default,Unmarked AD,0000,0000,0000,,‫شعرت وكأننا قضينا وقتًا طويلًا هنا!
Dialogue: 0,0:17:00.01,0:17:01.45,Default,Unmarked AD,0000,0000,0000,,‫أخيرًا.
Dialogue: 0,0:17:03.06,0:17:04.53,Default,Sung Jinwoo,0000,0000,0000,,‫لكن أوّلًا...
Dialogue: 0,0:17:08.60,0:17:12.97,Default,Ahn Sangmin,0000,0000,0000,,‫أعتقد أنّ أسبوعًا قد مضى داخل البوابة الآن.
Dialogue: 0,0:17:12.97,0:17:17.37,Default,Ahn Sangmin,0000,0000,0000,,‫يمكن لبقيتنا البقاء متأهبين.\N‫ينبغي أن تعود إلى البيت أيها الرئيس.
Dialogue: 0,0:17:17.93,0:17:21.77,Default,Baek Yoonho,0000,0000,0000,,‫لن أفعل ذلك وهناك أفراد نقابة في الداخل.
Dialogue: 0,0:17:21.77,0:17:23.49,Default,Baek Yoonho,0000,0000,0000,,‫سأنتظر حتى الصباح.
Dialogue: 0,0:17:25.75,0:17:27.90,Default,Ahn Sangmin,0000,0000,0000,,‫هناك أشخاص... إنّهم يخرجون!
Dialogue: 0,0:17:28.97,0:17:30.36,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫الصياد كيم!
Dialogue: 0,0:17:30.74,0:17:33.35,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫علمت أنّك ستفعلها!
Dialogue: 0,0:17:34.83,0:17:35.83,Default,Park Heejin,0000,0000,0000,,‫الرئيس بيك!
Dialogue: 0,0:17:37.29,0:17:42.50,Default,Baek Yoonho,0000,0000,0000,,‫الصيادة بارك... الصياد غو. أنا سعيد لأنكما بخير.
Dialogue: 0,0:17:42.89,0:17:44.44,Default,Baek Yoonho,0000,0000,0000,,‫ماذا عن البقية؟
Dialogue: 0,0:17:53.26,0:17:54.66,Default,Ahn Sangmin,0000,0000,0000,,‫الصياد سون!
Dialogue: 0,0:17:55.48,0:17:57.06,DefaultItalics,Ahn Sangmin,0000,0000,0000,,‫عرفت ذلك!
Dialogue: 0,0:18:02.03,0:18:04.23,Default,Baek Yoonho,0000,0000,0000,,‫أُغلقت... البوابة؟
Dialogue: 0,0:18:04.84,0:18:07.62,Default,Baek Yoonho,0000,0000,0000,,‫أين البقية؟ أين الصياد كيم؟
Dialogue: 0,0:18:08.03,0:18:09.19,Default,Park Heejin,0000,0000,0000,,‫في الحقيقة...
Dialogue: 0,0:18:10.24,0:18:13.17,Default,Baek Yoonho,0000,0000,0000,,‫فقط أصحاب الدرجة المنخفضة عادوا؟
Dialogue: 0,0:18:13.17,0:18:15.62,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫ما الذي حدث في الداخل بالضبط...؟
Dialogue: 0,0:18:15.62,0:18:17.94,Default,Sung Jinwoo,0000,0000,0000,,‫هيا بنا. سأقلّك إلى البيت.
Dialogue: 0,0:18:17.94,0:18:19.66,Default,Han Song-yi,0000,0000,0000,,‫حـ-حسنًا.
Dialogue: 0,0:18:19.66,0:18:20.94,Default,Baek Yoonho,0000,0000,0000,,‫مهلًا لحظة.
Dialogue: 0,0:18:20.94,0:18:23.31,Default,Baek Yoonho,0000,0000,0000,,‫أريد أن أطرح عليك بعض الأسئلة.
Dialogue: 0,0:18:24.19,0:18:26.36,Default,Sung Jinwoo,0000,0000,0000,,‫أنا مرهق.
Dialogue: 0,0:18:26.36,0:18:28.69,Default,Sung Jinwoo,0000,0000,0000,,‫وفر الأسئلة لشخص من نقابتك.
Dialogue: 0,0:18:30.34,0:18:34.49,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫لم يكن ذلك طلبًا لمعروف.\N‫كان أمرًا، أو تهديدًا إن تعذر ذلك.
Dialogue: 0,0:18:35.23,0:18:39.81,Default,Baek Yoonho,0000,0000,0000,,‫اختفى ستة أفراد من نقابتي.
Dialogue: 0,0:18:40.15,0:18:44.48,Default,Baek Yoonho,0000,0000,0000,,‫ومسؤولية معرفة ما حدث لهم تقع علي.
Dialogue: 0,0:18:45.84,0:18:50.83,Default,Sung Jinwoo,0000,0000,0000,,‫قد يكون ذلك صحيحًا، لكني أنقذت الفردين الناجيين.
Dialogue: 0,0:18:50.83,0:18:55.02,Default,Sung Jinwoo,0000,0000,0000,,‫ألا تقع مسؤولية إظهار بعض الامتنان لي أوّلًا عليك؟
Dialogue: 0,0:19:01.05,0:19:04.62,Default,Baek Yoonho,0000,0000,0000,,‫اعذرني. معك حق.
Dialogue: 0,0:19:05.60,0:19:07.45,Default,Baek Yoonho,0000,0000,0000,,‫أعتذر.
Dialogue: 0,0:19:11.24,0:19:12.62,Default,Baek Yoonho,0000,0000,0000,,‫أيتها الصيادة بارك...
Dialogue: 0,0:19:12.62,0:19:13.68,Default,Park Heejin,0000,0000,0000,,‫نعم؟
Dialogue: 0,0:19:13.68,0:19:18.28,Default,Baek Yoonho,0000,0000,0000,,‫من كان ذاك؟ ليس ودودًا تمامًا، أليس كذلك؟
Dialogue: 0,0:19:18.28,0:19:23.60,Default,Park Heejin,0000,0000,0000,,‫في الحقيقة... بعد أن هزم الزعيم تعكّر مزاجه فجأة.
Dialogue: 0,0:19:23.60,0:19:27.36,Default,Ahn Sangmin,0000,0000,0000,,‫من الإرهاق على الأرجح.
Dialogue: 0,0:19:27.36,0:19:29.28,Default,Ahn Sangmin,0000,0000,0000,,‫إنّه ليس شخصًا سيّئًا.
Dialogue: 0,0:19:31.54,0:19:32.82,Default,Baek Yoonho,0000,0000,0000,,‫أيها المدير آن...
Dialogue: 0,0:19:32.82,0:19:36.91,Default,Baek Yoonho,0000,0000,0000,,‫عليك أن تحضره إلى نقابتنا مهما كلّف الأمر.
Dialogue: 0,0:19:36.91,0:19:38.28,Default,Ahn Sangmin,0000,0000,0000,,‫حـ-حاضر!
Dialogue: 0,0:19:40.35,0:19:43.52,DefaultItalics,Ahn Sangmin,0000,0000,0000,,‫يبدو أني كنت محقًّا من البداية.
Dialogue: 0,0:19:46.59,0:19:47.71,Default,Sung Jinwoo,0000,0000,0000,,‫أحسنت عملًا اليوم.
Dialogue: 0,0:19:47.71,0:19:49.09,Default,Han Song-yi,0000,0000,0000,,‫توخّ الحذر.
Dialogue: 0,0:19:51.17,0:19:53.21,Default,Han Song-yi,0000,0000,0000,,‫معذرة يا جينوو-كن.
Dialogue: 0,0:19:54.04,0:19:55.13,Default,Sung Jinwoo,0000,0000,0000,,‫جينوو-كن؟
Dialogue: 0,0:19:55.13,0:19:57.78,Default,Han Song-yi,0000,0000,0000,,‫شكرًا لك على اليوم.
Dialogue: 0,0:19:58.45,0:20:03.10,Default,Han Song-yi,0000,0000,0000,,‫سأعتمد عليك غدًا... أو متى كانت المرة القادمة.
Dialogue: 0,0:20:05.94,0:20:07.23,Default,Song Jinwoo,0000,0000,0000,,‫أكيد...
Dialogue: 0,0:20:09.84,0:20:13.92,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫بالتفكير في الأمر، لم يمض يوم كامل بعد هنا.
Dialogue: 0,0:20:14.88,0:20:18.18,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫كان هذا الشيء القيّم الوحيد\N‫الذي تمكنت من الحصول عليه.
Dialogue: 0,0:20:19.49,0:20:22.48,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لا بدّ أن مستواه كان عاليًا للغاية...
Dialogue: 0,0:20:30.88,0:20:33.59,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لم أتمكن من استخراجه حتّى بعد ثلاث محاولات.
Dialogue: 0,0:20:31.75,0:20:32.83,FlashbackTop,Sung Jinwoo,0000,0000,0000,,‫تبًّا!
Dialogue: 0,0:20:35.43,0:20:37.80,Default,Sung Jinwoo,0000,0000,0000,,‫مجهود كبير من أجل ربح قليل.
Dialogue: 0,0:20:38.75,0:20:40.01,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لكن...
Dialogue: 0,0:20:44.64,0:20:48.65,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫هذه المرة الثالثة.
Dialogue: 0,0:20:52.67,0:20:56.16,Default,Sung Jinah,0000,0000,0000,,‫أخي؟ سآكل من دونك!
Dialogue: 0,0:20:56.16,0:20:57.81,Default,Sung Jinwoo,0000,0000,0000,,‫أنا قادم.
Dialogue: 0,0:20:59.94,0:21:01.74,Default,Yoo Jinho,0000,0000,0000,,‫صباح الخير!
Dialogue: 0,0:21:02.89,0:21:04.91,Default,Sung Jinwoo,0000,0000,0000,,‫سترتدي... ذلك؟
Dialogue: 0,0:21:04.91,0:21:07.45,Default,Yoo Jinho,0000,0000,0000,,‫نعم! هيا بنا.
Dialogue: 0,0:21:08.83,0:21:10.42,Default,Sung Jinwoo,0000,0000,0000,,‫حسنًا إذًا.
Dialogue: 0,0:21:10.42,0:21:12.60,Default,Sung Jinwoo,0000,0000,0000,,‫سنقل معنا شخصًا في طريقنا.
Dialogue: 0,0:21:15.32,0:21:17.47,Default,Han Song-yi,0000,0000,0000,,‫صباح الخير أيها القائد!
Dialogue: 0,0:21:17.47,0:21:20.04,Default,Yoo Jinho,0000,0000,0000,,‫صـ-صباح الخير.
Dialogue: 0,0:21:20.04,0:21:22.82,Default,Han Song-yi,0000,0000,0000,,‫آسفة على جعلك تقلني يا جينوو-كن.
Dialogue: 0,0:21:23.85,0:21:24.85,DefaultItalics,Yoo Jinho,0000,0000,0000,,‫جينوو-كن؟!
Dialogue: 0,0:21:25.45,0:21:27.14,Default,Sung Jinwoo,0000,0000,0000,,‫هل نمت بعد كل ذلك؟
Dialogue: 0,0:21:27.14,0:21:29.09,Default,Han Song-yi,0000,0000,0000,,‫على الإطلاق!
Dialogue: 0,0:21:29.09,0:21:31.69,Default,Sung Jinwoo,0000,0000,0000,,‫بالنظر إلى الوقت المتأخر الذي عدت فيه إلى البيت...
Dialogue: 0,0:21:32.10,0:21:33.52,DefaultItalics,Yoo Jinho,0000,0000,0000,,‫عادت إلى البيت في الصباح...
Dialogue: 0,0:21:32.71,0:21:33.52,DefaultTop,Han Song-yi,0000,0000,0000,,‫معك حق.
Dialogue: 0,0:21:33.52,0:21:35.19,DefaultTop,Han Song-yi,0000,0000,0000,,‫جينوو-كن، هل...
Dialogue: 0,0:21:33.52,0:21:35.19,DefaultItalics,Yoo Jinho,0000,0000,0000,,‫ولم تنم إطلاقًا؟!
Dialogue: 0,0:21:35.19,0:21:38.28,DefaultItalics,Yoo Jinho,0000,0000,0000,,‫أهذا ما يجري هنا؟!
Dialogue: 0,0:21:38.78,0:21:40.77,DefaultTop,Jinwoo,0000,0000,0000,,‫نامي قليلًا الآن. سأعلمك عندما يحين الوقت.
Dialogue: 0,0:21:39.72,0:21:42.31,Default,Yoo Jinho,0000,0000,0000,,‫زعيم...؟
Dialogue: 0,0:21:40.77,0:21:42.31,DefaultTop,Han Song-yi,0000,0000,0000,,‫شكرًا لك.
Dialogue: 0,0:21:43.10,0:21:46.45,Default,Yoo Jinho,0000,0000,0000,,‫أنت تعلم أنّ هان-سان... قاصر، أليس كذلك؟
Dialogue: 0,0:21:47.54,0:21:48.58,Default,Sung Jinwoo,0000,0000,0000,,‫وبعد؟
Dialogue: 0,0:21:53.09,0:21:55.91,Default,Yoo Jinho,0000,0000,0000,,‫لا شيء. انس الأمر.
Dialogue: 0,0:21:58.09,0:21:59.98,Default,Sung Jinwoo,0000,0000,0000,,‫لنبدأ العمل كي ننتهي بسرعة.
Dialogue: 0,0:21:59.98,0:22:01.51,Default,Han Song-yi,0000,0000,0000,,‫حسنًا يا جينوو-كن!
Dialogue: 0,0:22:01.93,0:22:03.26,Default,Yoo Jinho,0000,0000,0000,,‫نعم...
