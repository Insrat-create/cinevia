Dialogue: 0,0:00:07.96,0:00:08.78,Default,,0000,0000,0000,,Bangkitlah.
Dialogue: 0,0:00:23.46,0:00:24.48,Default,,0000,0000,0000,,Bagus.
Dialogue: 0,0:00:33.67,0:00:37.38,Default,,0000,0000,0000,,(Solo Leveling Season 2\N-Arise from the Shadow-)
Dialogue: 0,0:01:56.30,0:01:57.80,Default,,0000,0000,0000,,Sudah berapa lama?
Dialogue: 0,0:01:58.22,0:01:59.82,Default,,0000,0000,0000,,Lebih kurang tiga jam.
Dialogue: 0,0:02:00.44,0:02:03.52,Default,,0000,0000,0000,,Mungkin sudah tiga hari di dalam sana.
Dialogue: 0,0:02:04.02,0:02:06.58,Default,,0000,0000,0000,,Persekitaran di dalam portal merah\Nadalah sangat keras.
Dialogue: 0,0:02:06.58,0:02:08.12,Default,,0000,0000,0000,,Aduhai.
Dialogue: 0,0:02:08.40,0:02:09.48,Default,,0000,0000,0000,,Saya rasa
Dialogue: 0,0:02:09.48,0:02:12.04,Default,,0000,0000,0000,,Sung Jinwoo mungkin sudah mati.
Dialogue: 0,0:02:12.64,0:02:14.00,Default,,0000,0000,0000,,Sia-sia saya datang ke sini.
Dialogue: 0,0:02:16.42,0:02:17.24,Default,,0000,0000,0000,,Tak.
Dialogue: 0,0:02:17.24,0:02:18.34,Default,,0000,0000,0000,,Sekejap.
Dialogue: 0,0:02:18.70,0:02:22.00,Default,,0000,0000,0000,,Sung Jinwoo bukan\Nahli Persatuan Harimau Putih.
Dialogue: 0,0:02:22.60,0:02:23.86,Default,,0000,0000,0000,,Jika begitu,
Dialogue: 0,0:02:23.86,0:02:27.40,Default,,0000,0000,0000,,kenapa dia akan masuk\Nportal bersama pasukan penyerang awak?
Dialogue: 0,0:02:30.04,0:02:32.00,Default,,0000,0000,0000,,Dia kawan saya.
Dialogue: 0,0:02:32.46,0:02:34.74,Default,,0000,0000,0000,,Dia kata hendak melihat misi tahap C.
Dialogue: 0,0:02:34.74,0:02:36.02,Default,,0000,0000,0000,,Sebab itu saya bawa dia ke sini.
Dialogue: 0,0:02:36.80,0:02:37.86,Default,,0000,0000,0000,,Apa?
Dialogue: 0,0:02:37.86,0:02:39.34,Default,,0000,0000,0000,,Begitu rupanya.
Dialogue: 0,0:02:43.58,0:02:45.70,Default,,0000,0000,0000,,Awak ingat saya akan kata begitu?
Dialogue: 0,0:02:46.00,0:02:48.50,Default,,0000,0000,0000,,Apa rancangan awak kali ini?
Dialogue: 0,0:02:48.86,0:02:53.18,Default,,0000,0000,0000,,Awak memang suka\Nmenerokai benda baharu sejak dulu.
Dialogue: 0,0:02:54.42,0:02:55.68,Default,,0000,0000,0000,,Hwang Dongsoo.
Dialogue: 0,0:02:56.72,0:02:58.46,Default,,0000,0000,0000,,Lepaskan tangan awak.
Dialogue: 0,0:02:58.88,0:03:00.78,Default,,0000,0000,0000,,Awak beri saya arahan?
Dialogue: 0,0:03:01.14,0:03:04.45,Default,,0000,0000,0000,,Awak hanya ketua persatuan\Ndari negara kecil ini.
Dialogue: 0,0:03:05.18,0:03:06.28,Default,,0000,0000,0000,,Apa?
Dialogue: 0,0:03:09.54,0:03:11.02,Default,,0000,0000,0000,,Habislah.
Dialogue: 0,0:03:11.24,0:03:12.46,Default,,0000,0000,0000,,Jika tak hentikan mereka,
Dialogue: 0,0:03:12.82,0:03:15.30,Default,,0000,0000,0000,,konflik antara pemburu tahap S\Nakan berlaku.
Dialogue: 0,0:03:15.92,0:03:17.20,Default,,0000,0000,0000,,Awak nak berkelahi?
Dialogue: 0,0:03:33.20,0:03:34.66,Default,,0000,0000,0000,,Sebab terlalu sejuk.
Dialogue: 0,0:03:35.58,0:03:36.32,Default,,0000,0000,0000,,Tak.
Dialogue: 0,0:03:36.70,0:03:38.22,Default,,0000,0000,0000,,Jika ada kelengkapan,
Dialogue: 0,0:03:38.22,0:03:40.08,Default,,0000,0000,0000,,saya takkan kalah.
Dialogue: 0,0:03:42.08,0:03:45.00,Default,,0000,0000,0000,,Patutlah saya tak nampak Beruang Ais.
Dialogue: 0,0:03:45.54,0:03:46.38,Default,,0000,0000,0000,,Jangan-jangan
Dialogue: 0,0:03:46.70,0:03:48.20,Default,,0000,0000,0000,,pemburu tahap E yang...
Dialogue: 0,0:03:48.92,0:03:49.82,Default,,0000,0000,0000,,Mustahil.
Dialogue: 0,0:03:49.82,0:03:51.80,Default,,0000,0000,0000,,Mustahil mereka ada kekuatan sebegini.
Dialogue: 0,0:03:54.26,0:03:55.50,Default,,0000,0000,0000,,Saya dah faham.
Dialogue: 0,0:03:55.50,0:03:56.50,Default,,0000,0000,0000,,Hantu Putih.
Dialogue: 0,0:03:56.80,0:03:57.82,Default,,0000,0000,0000,,Ada Hantu Putih di sini.
Dialogue: 0,0:03:58.08,0:03:59.14,Default,,0000,0000,0000,,Tak guna.
Dialogue: 0,0:04:04.80,0:04:06.02,Default,,0000,0000,0000,,Agak hebat.
Dialogue: 0,0:04:08.20,0:04:12.02,Default,,0000,0000,0000,,Jika kamu tidak menahan diri,
Dialogue: 0,0:04:12.36,0:04:14.38,Default,,0000,0000,0000,,mungkin lengan saya sudah patah.
Dialogue: 0,0:04:17.02,0:04:20.12,Default,,0000,0000,0000,,Pemburu Hwang, saya tak tahu\Napa-apa yang awak curigai,
Dialogue: 0,0:04:20.50,0:04:21.80,Default,,0000,0000,0000,,tapi sekitar dua bulan yang lalu,
Dialogue: 0,0:04:22.16,0:04:24.94,Default,,0000,0000,0000,,saya pernah menguji\Nkuasa sihir Pemburu Sung lagi.
Dialogue: 0,0:04:25.68,0:04:28.58,Default,,0000,0000,0000,,Dia memang pemburu tahap E.
Dialogue: 0,0:04:29.36,0:04:30.94,Default,,0000,0000,0000,,Itu hasil siasatan Jabatan Penyeliaan.
Dialogue: 0,0:04:30.94,0:04:35.20,Default,,0000,0000,0000,,Hwang Dongsuk juga disahkan\Nmati dibunuh oleh haiwan iblis.
Dialogue: 0,0:04:36.44,0:04:39.16,Default,,0000,0000,0000,,Ini yang kamu katakan sendiri.
Dialogue: 0,0:04:39.48,0:04:41.54,Default,,0000,0000,0000,,Jelas bahawa ini tipu.
Dialogue: 0,0:04:41.78,0:04:45.76,Default,,0000,0000,0000,,Saya rasa pembunuhnya ialah\Ntuan muda Syarikat Pembinaan Yoo Jin.
Dialogue: 0,0:04:47.26,0:04:50.48,Default,,0000,0000,0000,,Jadi, kenapa awak nak\Nmembunuh Pemburu Sung?
Dialogue: 0,0:04:51.98,0:04:53.64,Default,,0000,0000,0000,,Sudah tentu
Dialogue: 0,0:04:54.24,0:04:56.02,Default,,0000,0000,0000,,ini alasan saja.
Dialogue: 0,0:04:56.68,0:04:58.74,Default,,0000,0000,0000,,Alasan untuk membunuh.
Dialogue: 0,0:05:05.64,0:05:07.16,Default,,0000,0000,0000,,Dia sangat bertuah.
Dialogue: 0,0:05:10.14,0:05:11.34,Default,,0000,0000,0000,,Pemburu Hwang.
Dialogue: 0,0:05:11.96,0:05:16.22,Default,,0000,0000,0000,,Orang yang paling memahami\Nkekuatan Pemburu Sung ialah saya.
Dialogue: 0,0:05:16.90,0:05:19.20,Default,,0000,0000,0000,,Dia pasti akan keluar hidup-hidup.
Dialogue: 0,0:05:21.90,0:05:25.38,Default,,0000,0000,0000,,Wang saya untuk membeli\Nsenjata akan habis.
Dialogue: 0,0:05:25.82,0:05:27.42,Default,,0000,0000,0000,,Tak, saya serius.
Dialogue: 0,0:05:27.42,0:05:28.76,Default,,0000,0000,0000,,Perbezaannya amat besar.
Dialogue: 0,0:05:29.78,0:05:31.42,Default,,0000,0000,0000,,Kamu yang lemah,
Dialogue: 0,0:05:31.88,0:05:33.82,Default,,0000,0000,0000,,kenapa masih hidup?
Dialogue: 0,0:05:34.10,0:05:35.46,Default,,0000,0000,0000,,Kamu bahkan ada baju hangat, selimut,
Dialogue: 0,0:05:35.46,0:05:37.22,Default,,0000,0000,0000,,khemah dan juga makanan.
Dialogue: 0,0:05:38.40,0:05:39.86,Default,,0000,0000,0000,,Saya dah faham.
Dialogue: 0,0:05:39.86,0:05:41.48,Default,,0000,0000,0000,,Begitu rupanya.
Dialogue: 0,0:05:42.50,0:05:43.64,Default,,0000,0000,0000,,Tak guna!
Dialogue: 0,0:05:44.60,0:05:45.98,Default,,0000,0000,0000,,Pemburu Kim?
Dialogue: 0,0:05:45.98,0:05:48.42,Default,,0000,0000,0000,,Pasukan penyerang kami telah hapus
Dialogue: 0,0:05:49.00,0:05:51.80,Default,,0000,0000,0000,,kerana kekurangan kelengkapan dan makanan.
Dialogue: 0,0:05:51.80,0:05:52.70,Default,,0000,0000,0000,,Itu...
Dialogue: 0,0:05:52.70,0:05:54.46,Default,,0000,0000,0000,,Siapakah yang sembunyikan semua benda ini?
Dialogue: 0,0:05:54.86,0:05:56.80,Default,,0000,0000,0000,,Siapakah yang memonopoli semua kelengkapan
Dialogue: 0,0:05:56.80,0:05:58.94,Default,,0000,0000,0000,,dan menyebabkan rakan pasukan lain mati?
Dialogue: 0,0:05:59.48,0:06:01.42,Default,,0000,0000,0000,,Begitu rupanya, saya dah faham.
Dialogue: 0,0:06:01.42,0:06:02.74,Default,,0000,0000,0000,,Kak Heejin.
Dialogue: 0,0:06:02.98,0:06:05.24,Default,,0000,0000,0000,,Awak sudah tahu sejak awal lagi, betul?
Dialogue: 0,0:06:05.54,0:06:07.30,Default,,0000,0000,0000,,Sebab itu awak tukar ke pasukan ini.
Dialogue: 0,0:06:07.84,0:06:10.38,Default,,0000,0000,0000,,Jika tak mengaku, saya akan\Nanggap kamu semua sebagai rakan subahat!
Dialogue: 0,0:06:11.22,0:06:13.36,Default,,0000,0000,0000,,Saya kira sampai tiga,\Nmengaku kepada saya.
Dialogue: 0,0:06:14.36,0:06:15.44,Default,,0000,0000,0000,,Satu.
Dialogue: 0,0:06:16.54,0:06:19.18,Default,,0000,0000,0000,,- Dua.\N- Pelaku ialah orang itu.
Dialogue: 0,0:06:19.80,0:06:21.00,Default,,0000,0000,0000,,Sung Jinwoo!
Dialogue: 0,0:06:21.00,0:06:22.28,Default,,0000,0000,0000,,Tiga.
Dialogue: 0,0:06:29.88,0:06:32.66,Default,,0000,0000,0000,,Awak yang menyebabkan rakan pasukan mati.
Dialogue: 0,0:06:32.66,0:06:33.74,Default,,0000,0000,0000,,Abang.
Dialogue: 0,0:06:33.74,0:06:34.72,Default,,0000,0000,0000,,Ketua.
Dialogue: 0,0:06:35.12,0:06:37.22,Default,,0000,0000,0000,,Berai awak bawa masalah ke sini.
Dialogue: 0,0:06:38.02,0:06:39.46,Default,,0000,0000,0000,,Muncullah.
Dialogue: 0,0:06:39.66,0:06:42.64,Default,,0000,0000,0000,,Kamu tak dapat\Nsembunyikan aura sekuat ini.
Dialogue: 0,0:06:44.72,0:06:46.50,Default,,0000,0000,0000,,Itu ialah Bunian Ais.
Dialogue: 0,0:06:47.14,0:06:48.80,Default,,0000,0000,0000,,Jumlahnya banyak juga.
Dialogue: 0,0:06:49.86,0:06:50.90,Default,,0000,0000,0000,,Dialah Bos?
Dialogue: 0,0:06:55.76,0:06:57.44,Default,,0000,0000,0000,,Dalam kalangan sampah ini,
Dialogue: 0,0:06:57.90,0:07:00.14,Default,,0000,0000,0000,,tak sangka ada orang yang berguna.
Dialogue: 0,0:07:00.58,0:07:01.66,Default,,0000,0000,0000,,Apa?
Dialogue: 0,0:07:02.13,0:07:05.31,Default,,0000,0000,0000,,Jangan-jangan awak kata kami semua sampah?
Dialogue: 0,0:07:06.00,0:07:08.70,Default,,0000,0000,0000,,Oh, sungguh menakjubkan.
Dialogue: 0,0:07:09.26,0:07:12.62,Default,,0000,0000,0000,,Hei, awak memahami bahasa kami?
Dialogue: 0,0:07:12.62,0:07:13.32,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:07:13.62,0:07:14.74,Default,,0000,0000,0000,,Kenapa saya dapat faham?
Dialogue: 0,0:07:14.74,0:07:17.84,Default,,0000,0000,0000,,Awak dapat faham bahasa haiwan iblis?
Dialogue: 0,0:07:18.70,0:07:20.46,Default,,0000,0000,0000,,Adakah ini juga pengaruh sistem?
Dialogue: 0,0:07:21.10,0:07:23.86,Default,,0000,0000,0000,,Baguslah jika dapat berkomunikasi.
Dialogue: 0,0:07:24.14,0:07:26.32,Default,,0000,0000,0000,,Orang ini beritahu saya
Dialogue: 0,0:07:27.26,0:07:30.14,Default,,0000,0000,0000,,ada seorang yang hebat\Ndalam kalangan manusia.
Dialogue: 0,0:07:30.78,0:07:32.96,Default,,0000,0000,0000,,Dia kata nak berlawan dengan awak.
Dialogue: 0,0:07:40.38,0:07:41.06,Default,,0000,0000,0000,,Kemudian?
Dialogue: 0,0:07:43.94,0:07:45.20,Default,,0000,0000,0000,,Menarik.
Dialogue: 0,0:07:51.80,0:07:53.74,Default,,0000,0000,0000,,Nampaknya saya tak dapat\Nkalahkannya dengan mudah.
Dialogue: 0,0:07:55.06,0:07:56.94,Default,,0000,0000,0000,,Semakin menarik.
Dialogue: 0,0:07:57.58,0:07:58.98,Default,,0000,0000,0000,,Oh ya.
Dialogue: 0,0:07:59.46,0:08:01.38,Default,,0000,0000,0000,,Awak bukan manusia,
Dialogue: 0,0:08:01.38,0:08:03.70,Default,,0000,0000,0000,,kenapa berada dalam kalangan manusia?
Dialogue: 0,0:08:04.00,0:08:04.84,Default,,0000,0000,0000,,Apa?
Dialogue: 0,0:08:05.88,0:08:09.22,Default,,0000,0000,0000,,Nampaknya awak tak tahu identiti sendiri.
Dialogue: 0,0:08:09.68,0:08:11.96,Default,,0000,0000,0000,,Kami sering mendengar satu suara
Dialogue: 0,0:08:12.26,0:08:14.18,Default,,0000,0000,0000,,yang suruh kami membunuh manusia.
Dialogue: 0,0:08:14.18,0:08:17.74,Default,,0000,0000,0000,,Namun, semasa berdepan dengan awak,\Nsaya tak dengar apa-apa.
Dialogue: 0,0:08:18.02,0:08:19.48,Default,,0000,0000,0000,,Mendengar suara?
Dialogue: 0,0:08:20.42,0:08:22.64,Default,,0000,0000,0000,,Adakah itu mirip arahan sistem?
Dialogue: 0,0:08:23.42,0:08:25.76,Default,,0000,0000,0000,,Dia tak dengar suara\Napabila menghadapi saya.
Dialogue: 0,0:08:26.14,0:08:28.26,Default,,0000,0000,0000,,Adakah sebab saya sudah jadi "pemain"?
Dialogue: 0,0:08:28.50,0:08:30.98,Default,,0000,0000,0000,,Kita tak perlu melawan satu sama lain.
Dialogue: 0,0:08:31.20,0:08:33.40,Default,,0000,0000,0000,,Mari kita menyelesaikan masalah\Ndengan cara yang sempurna.
Dialogue: 0,0:08:33.94,0:08:36.36,Default,,0000,0000,0000,,Serahkan manusia di belakang awak.
Dialogue: 0,0:08:36.72,0:08:38.90,Default,,0000,0000,0000,,Dengan itu, kami akan melepaskan awak.
Dialogue: 0,0:08:38.90,0:08:39.68,Default,,0000,0000,0000,,Macam mana?
Dialogue: 0,0:08:39.94,0:08:41.76,Default,,0000,0000,0000,,Apa pendapat awak tentang cadangan ini?
Dialogue: 0,0:08:42.72,0:08:44.58,Default,,0000,0000,0000,,Siapakah kamu sebenarnya?
Dialogue: 0,0:08:45.02,0:08:46.88,Default,,0000,0000,0000,,Kenapa nak bertarung dengan manusia?
Dialogue: 0,0:08:47.72,0:08:49.10,Default,,0000,0000,0000,,Kami ialah...
Dialogue: 0,0:08:51.38,0:08:53.72,Default,,0000,0000,0000,,Serahkan manusia di belakang awak.
Dialogue: 0,0:08:54.06,0:08:57.14,Default,,0000,0000,0000,,Dengan itu, kami akan melepaskan awak.
Dialogue: 0,0:08:58.02,0:08:59.54,Default,,0000,0000,0000,,Apa yang berlaku tadi?
Dialogue: 0,0:08:59.54,0:09:00.40,Default,,0000,0000,0000,,Macam mana?
Dialogue: 0,0:09:00.62,0:09:02.32,Default,,0000,0000,0000,,Apa pendapat awak tentang cadangan ini?
Dialogue: 0,0:09:02.84,0:09:04.35,Default,,0000,0000,0000,,Awak pasti akan menerima, betul?
Dialogue: 0,0:09:07.54,0:09:08.48,Default,,0000,0000,0000,,Saya menolak.
Dialogue: 0,0:09:09.90,0:09:12.38,Default,,0000,0000,0000,,Awak ingin menjadi musuh kami?
Dialogue: 0,0:09:13.18,0:09:15.82,Default,,0000,0000,0000,,Bilangan kami jauh\Nlebih banyak daripada awak.
Dialogue: 0,0:09:17.44,0:09:18.50,Default,,0000,0000,0000,,Awak pasti?
Dialogue: 0,0:09:27.30,0:09:28.50,Default,,0000,0000,0000,,Apa ini?
Dialogue: 0,0:09:28.50,0:09:30.06,Default,,0000,0000,0000,,Raksasa.
Dialogue: 0,0:09:30.06,0:09:31.50,Default,,0000,0000,0000,,Raksasa telah muncul.
Dialogue: 0,0:09:31.50,0:09:34.50,Default,,0000,0000,0000,,Askar hitam dan juga Beruang Ais hitam.
Dialogue: 0,0:09:34.84,0:09:35.94,Default,,0000,0000,0000,,Jangan-jangan ini...
Dialogue: 0,0:09:35.94,0:09:38.06,Default,,0000,0000,0000,,Pemburu Sung, adakah awak\Nyang menyeru semua ini?
Dialogue: 0,0:09:38.92,0:09:40.92,Default,,0000,0000,0000,,Masih enggan mengalah?
Dialogue: 0,0:09:41.36,0:09:42.54,Default,,0000,0000,0000,,Mengalah?
Dialogue: 0,0:09:42.94,0:09:44.42,Default,,0000,0000,0000,,Benarkah begitu?
Dialogue: 0,0:10:01.62,0:10:02.44,Default,,0000,0000,0000,,Cepat pergi.
Dialogue: 0,0:10:02.62,0:10:05.36,Default,,0000,0000,0000,,Kita tak boleh terlibat\Ndalam pertarungan ini.
Dialogue: 0,0:10:13.42,0:10:15.20,Default,,0000,0000,0000,,Dia memang mampu bercakap besar.
Dialogue: 0,0:10:15.88,0:10:18.98,Default,,0000,0000,0000,,Walaupun askar tidak akan hapus,\Nmana diperlukan untuk kelahiran semula.
Dialogue: 0,0:10:20.00,0:10:22.16,Default,,0000,0000,0000,,Mana saya pun tak dapat bertahan lama.
Dialogue: 0,0:10:22.78,0:10:24.04,Default,,0000,0000,0000,,Bos itu
Dialogue: 0,0:10:24.78,0:10:26.58,Default,,0000,0000,0000,,nampak lebih hebat daripada saya.
Dialogue: 0,0:10:33.60,0:10:36.26,Default,,0000,0000,0000,,Rasanya bekerjasama dengan Igris\Npun tak dapat kalahkannya dengan mudah.
Dialogue: 0,0:10:37.10,0:10:38.92,Default,,0000,0000,0000,,Askar biasa takkan mampu melawannya.
Dialogue: 0,0:10:39.70,0:10:41.88,Default,,0000,0000,0000,,Saya perlukan kuasa tempur\Nyang lebih kuat.
Dialogue: 0,0:10:42.50,0:10:43.94,Default,,0000,0000,0000,,Saya Baruka.
Dialogue: 0,0:10:44.92,0:10:46.22,Default,,0000,0000,0000,,Siapakah nama awak?
Dialogue: 0,0:10:48.98,0:10:50.00,Default,,0000,0000,0000,,Sung Jinwoo.
Dialogue: 0,0:11:16.42,0:11:19.52,Default,,0000,0000,0000,,Sudah lama tiada pertarungan\Nyang begitu mengujakan.
Dialogue: 0,0:11:34.28,0:11:36.28,Default,,0000,0000,0000,,Suara terakhir yang saya dengar.
Dialogue: 0,0:11:41.24,0:11:43.78,Default,,0000,0000,0000,,Sung Jinwoo!
Dialogue: 0,0:11:46.08,0:11:48.50,Default,,0000,0000,0000,,Nasib baik ada askar\Nyang bantu saya melengahkan masa.
Dialogue: 0,0:11:49.14,0:11:50.14,Default,,0000,0000,0000,,Seterusnya...
Dialogue: 0,0:11:50.96,0:11:53.52,Default,,0000,0000,0000,,Ini saja kemampuan askar awak?
Dialogue: 0,0:11:55.22,0:11:57.22,Default,,0000,0000,0000,,Sung Jinwoo!
Dialogue: 0,0:11:57.44,0:11:59.10,Default,,0000,0000,0000,,Pergilah mati!
Dialogue: 0,0:11:59.10,0:12:01.40,Default,,0000,0000,0000,,Bahkan manusia pun mengkhianati awak.
Dialogue: 0,0:12:07.62,0:12:08.94,Default,,0000,0000,0000,,Membosankan betul
Dialogue: 0,0:12:09.28,0:12:11.36,Default,,0000,0000,0000,,trik mengelabui mata seperti ini.
Dialogue: 0,0:12:19.20,0:12:21.38,Default,,0000,0000,0000,,Sung Jinwoo!
Dialogue: 0,0:12:21.38,0:12:23.20,Default,,0000,0000,0000,,Pergilah mati!
Dialogue: 0,0:12:23.20,0:12:24.48,Default,,0000,0000,0000,,Kim Chul.
Dialogue: 0,0:12:24.48,0:12:26.22,Default,,0000,0000,0000,,Memang sama seperti yang saya jangkakan.
Dialogue: 0,0:12:31.80,0:12:33.02,Default,,0000,0000,0000,,Membosankan betul.
Dialogue: 0,0:12:37.30,0:12:38.66,Default,,0000,0000,0000,,Sung Jinwoo.
Dialogue: 0,0:12:38.66,0:12:39.78,Default,,0000,0000,0000,,Awak
Dialogue: 0,0:12:40.76,0:12:42.16,Default,,0000,0000,0000,,sudah tahu
Dialogue: 0,0:12:42.88,0:12:46.14,Default,,0000,0000,0000,,saya akan datang sejak awal lagi?
Dialogue: 0,0:12:46.48,0:12:47.98,Default,,0000,0000,0000,,Tak guna.
Dialogue: 0,0:12:50.26,0:12:51.20,Default,,0000,0000,0000,,Bangkitlah.
Dialogue: 0,0:12:54.18,0:12:56.32,Default,,0000,0000,0000,,Trik mengelabui mata seperti ini.
Dialogue: 0,0:13:11.42,0:13:12.30,Default,,0000,0000,0000,,Iron.
Dialogue: 0,0:13:12.98,0:13:14.22,Default,,0000,0000,0000,,Mulai hari ini,
Dialogue: 0,0:13:14.66,0:13:15.64,Default,,0000,0000,0000,,awak bernama Iron.
Dialogue: 0,0:13:23.84,0:13:25.70,Default,,0000,0000,0000,,Menarik betul.
Dialogue: 0,0:13:26.06,0:13:28.38,Default,,0000,0000,0000,,Saya akan mula dengan hapuskan awak dulu.
Dialogue: 0,0:13:36.20,0:13:38.92,Default,,0000,0000,0000,,Gerakan awak terlalu perlahan.
Dialogue: 0,0:13:42.56,0:13:43.58,Default,,0000,0000,0000,,Kak Heejin.
Dialogue: 0,0:13:43.88,0:13:45.94,Default,,0000,0000,0000,,Pertarungan pemburu
Dialogue: 0,0:13:45.94,0:13:47.76,Default,,0000,0000,0000,,memang macam ini?
Dialogue: 0,0:13:48.26,0:13:49.46,Default,,0000,0000,0000,,Jika begitu,
Dialogue: 0,0:13:49.46,0:13:52.06,Default,,0000,0000,0000,,bagaimana saya dapat jadi pemburu?
Dialogue: 0,0:13:52.44,0:13:54.04,Default,,0000,0000,0000,,Saya tak pernah nampak keadaan sebegini.
Dialogue: 0,0:13:54.48,0:13:56.94,Default,,0000,0000,0000,,Adakah kita sedang bermimpi?
Dialogue: 0,0:14:00.30,0:14:02.82,Default,,0000,0000,0000,,Orang ini tak mampu lawan saya.
Dialogue: 0,0:14:03.26,0:14:05.48,Default,,0000,0000,0000,,Awak dan juga kesateria itu,
Dialogue: 0,0:14:05.48,0:14:07.80,Default,,0000,0000,0000,,seranglah bersama-sama.
Dialogue: 0,0:14:08.20,0:14:09.46,Default,,0000,0000,0000,,Yakah?
Dialogue: 0,0:14:21.06,0:14:22.52,Default,,0000,0000,0000,,Pertama sekali,
Dialogue: 0,0:14:23.50,0:14:24.94,Default,,0000,0000,0000,,mula dengan hapuskan awak dulu.
Dialogue: 0,0:14:34.52,0:14:36.88,Default,,0000,0000,0000,,Dia dapat elakkan bahagian vital\Ndalam keadaan ini.
Dialogue: 0,0:14:38.42,0:14:41.92,Default,,0000,0000,0000,,Awak terlalu memandang rendah saya.
Dialogue: 0,0:14:41.92,0:14:43.96,Default,,0000,0000,0000,,Awak memang amat hebat.
Dialogue: 0,0:14:44.30,0:14:45.10,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:14:45.46,0:14:47.34,Default,,0000,0000,0000,,kakitangan awak tak semestinya hebat.
Dialogue: 0,0:14:54.80,0:14:55.72,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:14:55.98,0:14:59.16,Default,,0000,0000,0000,,selagi awak mati,\Nmereka takkan jadi masalah.
Dialogue: 0,0:15:01.30,0:15:03.76,Default,,0000,0000,0000,,Berani awak membuang\Nsenjata awak, bodoh sekali.
Dialogue: 0,0:15:13.08,0:15:14.18,Default,,0000,0000,0000,,Iron!
Dialogue: 0,0:15:33.18,0:15:36.84,Default,,0000,0000,0000,,Kamu agak hebat!
Dialogue: 0,0:15:37.14,0:15:40.38,Default,,0000,0000,0000,,Saya akan membunuh kamu semua!
Dialogue: 0,0:15:42.60,0:15:44.06,Default,,0000,0000,0000,,Hasilnya dah ditentukan.
Dialogue: 0,0:15:44.52,0:15:46.52,Default,,0000,0000,0000,,Biar betul?
Dialogue: 0,0:15:47.00,0:15:49.00,Default,,0000,0000,0000,,Masih belum tamat.
Dialogue: 0,0:15:59.62,0:16:00.80,Default,,0000,0000,0000,,Saya dah kata.
Dialogue: 0,0:16:03.18,0:16:04.80,Default,,0000,0000,0000,,Hasilnya dah ditentukan.
Dialogue: 0,0:16:09.60,0:16:11.32,Default,,0000,0000,0000,,Dia akhirnya telah dikalahkan?
Dialogue: 0,0:16:16.74,0:16:17.64,Default,,0000,0000,0000,,Hei.
Dialogue: 0,0:16:17.64,0:16:18.82,Default,,0000,0000,0000,,Sudahlah.
Dialogue: 0,0:16:20.34,0:16:21.70,Default,,0000,0000,0000,,Awak jangan keterlaluan.
Dialogue: 0,0:16:24.00,0:16:25.62,Default,,0000,0000,0000,,Masa depan awak amat merisaukan.
Dialogue: 0,0:16:38.26,0:16:40.34,Default,,0000,0000,0000,,Sudah tamat?
Dialogue: 0,0:16:41.16,0:16:41.90,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:16:44.18,0:16:45.46,Default,,0000,0000,0000,,Mari kita keluar.
Dialogue: 0,0:16:49.62,0:16:50.90,Default,,0000,0000,0000,,Keluar dari portal.
Dialogue: 0,0:16:53.46,0:16:55.22,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:16:55.44,0:16:56.94,Default,,0000,0000,0000,,Sudah boleh balik.
Dialogue: 0,0:16:56.94,0:16:58.70,Default,,0000,0000,0000,,Akhirnya dapat keluar.
Dialogue: 0,0:16:58.70,0:17:00.08,Default,,0000,0000,0000,,Lamanya.
Dialogue: 0,0:17:00.08,0:17:01.48,Default,,0000,0000,0000,,Sudah boleh balik.
Dialogue: 0,0:17:03.22,0:17:04.32,Default,,0000,0000,0000,,Sebelum itu...
Dialogue: 0,0:17:08.72,0:17:12.74,Default,,0000,0000,0000,,Sudah hampir seminggu di dalam portal.
Dialogue: 0,0:17:13.16,0:17:15.40,Default,,0000,0000,0000,,Kami akan tetap menunggu di sini.
Dialogue: 0,0:17:15.72,0:17:17.36,Default,,0000,0000,0000,,Encik Baek, awak baliklah dulu.
Dialogue: 0,0:17:17.98,0:17:19.66,Default,,0000,0000,0000,,Ahli persatuan saya ditahan di dalam sana,
Dialogue: 0,0:17:19.92,0:17:21.42,Default,,0000,0000,0000,,saya tak boleh balik begitu saja.
Dialogue: 0,0:17:21.92,0:17:23.36,Default,,0000,0000,0000,,Saya akan tunggu di sini hingga subuh.
Dialogue: 0,0:17:25.86,0:17:26.80,Default,,0000,0000,0000,,Ada bayangan.
Dialogue: 0,0:17:26.80,0:17:28.04,Default,,0000,0000,0000,,Ada orang keluar.
Dialogue: 0,0:17:29.02,0:17:30.24,Default,,0000,0000,0000,,Pemburu Kim.
Dialogue: 0,0:17:30.84,0:17:33.22,Default,,0000,0000,0000,,Saya dah tahu awak mampu.
Dialogue: 0,0:17:35.00,0:17:36.40,Default,,0000,0000,0000,,Encik Baek.
Dialogue: 0,0:17:37.46,0:17:38.46,Default,,0000,0000,0000,,Pemburu Park.
Dialogue: 0,0:17:39.04,0:17:40.02,Default,,0000,0000,0000,,Pemburu Go.
Dialogue: 0,0:17:40.58,0:17:42.60,Default,,0000,0000,0000,,Syukurlah kamu baik-baik saja.
Dialogue: 0,0:17:42.90,0:17:44.26,Default,,0000,0000,0000,,Bagaimana dengan pemburu lain?
Dialogue: 0,0:17:53.30,0:17:54.50,Default,,0000,0000,0000,,Pemburu Sung.
Dialogue: 0,0:17:55.60,0:17:57.00,Default,,0000,0000,0000,,Saya dah agak.
Dialogue: 0,0:18:02.22,0:18:04.22,Default,,0000,0000,0000,,Portal telah hilang.
Dialogue: 0,0:18:05.00,0:18:06.08,Default,,0000,0000,0000,,Manakah pemburu lain?
Dialogue: 0,0:18:06.36,0:18:07.54,Default,,0000,0000,0000,,Manakah Pemburu Kim?
Dialogue: 0,0:18:08.16,0:18:09.00,Default,,0000,0000,0000,,Mereka...
Dialogue: 0,0:18:10.38,0:18:12.86,Default,,0000,0000,0000,,Cuma pemburu tahap rendah\Nyang keluar hidup-hidup?
Dialogue: 0,0:18:13.24,0:18:15.66,Default,,0000,0000,0000,,Apa sebenarnya yang berlaku di dalam sana?
Dialogue: 0,0:18:15.90,0:18:16.68,Default,,0000,0000,0000,,Baliklah.
Dialogue: 0,0:18:16.86,0:18:17.66,Default,,0000,0000,0000,,Saya hantar awak balik.
Dialogue: 0,0:18:17.98,0:18:19.20,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:18:19.80,0:18:20.76,Default,,0000,0000,0000,,Tunggu sebentar.
Dialogue: 0,0:18:21.12,0:18:23.16,Default,,0000,0000,0000,,Saya ingin tanya awak sesuatu.
Dialogue: 0,0:18:24.40,0:18:25.86,Default,,0000,0000,0000,,Saya sudah penat.
Dialogue: 0,0:18:26.32,0:18:28.48,Default,,0000,0000,0000,,Jika ada soalan,\Ntanyalah ahli persatuan awak.
Dialogue: 0,0:18:30.42,0:18:31.92,Default,,0000,0000,0000,,Ini bukan permintaan,
Dialogue: 0,0:18:32.16,0:18:34.34,Default,,0000,0000,0000,,tapi arahan, bahkan ugutan.
Dialogue: 0,0:18:35.44,0:18:36.78,Default,,0000,0000,0000,,Kejadian kali ini
Dialogue: 0,0:18:36.98,0:18:39.84,Default,,0000,0000,0000,,membuat enam ahli persatuan saya hilang.
Dialogue: 0,0:18:40.20,0:18:44.30,Default,,0000,0000,0000,,Saya harus bertanggungjawab\Ndan tanya awak beberapa soalan.
Dialogue: 0,0:18:45.98,0:18:47.64,Default,,0000,0000,0000,,Mungkin itu memang benar,
Dialogue: 0,0:18:48.00,0:18:50.50,Default,,0000,0000,0000,,tapi saya juga yang\Nselamatkan dua orang itu.
Dialogue: 0,0:18:50.90,0:18:52.06,Default,,0000,0000,0000,,Bukankah awak
Dialogue: 0,0:18:52.44,0:18:54.88,Default,,0000,0000,0000,,harus ucapkan\Nterima kasih kepada saya dulu?
Dialogue: 0,0:19:01.10,0:19:02.38,Default,,0000,0000,0000,,Maafkan saya.
Dialogue: 0,0:19:02.98,0:19:04.46,Default,,0000,0000,0000,,Kata awak betul.
Dialogue: 0,0:19:05.62,0:19:07.20,Default,,0000,0000,0000,,Maaf sangat.
Dialogue: 0,0:19:11.42,0:19:12.38,Default,,0000,0000,0000,,Pemburu Park.
Dialogue: 0,0:19:12.66,0:19:13.68,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:19:13.98,0:19:15.46,Default,,0000,0000,0000,,Apakah masalah orang itu?
Dialogue: 0,0:19:16.04,0:19:18.18,Default,,0000,0000,0000,,Kenapa sikapnya begitu buruk?
Dialogue: 0,0:19:18.46,0:19:19.46,Default,,0000,0000,0000,,Saya pun tak tahu.
Dialogue: 0,0:19:19.70,0:19:21.24,Default,,0000,0000,0000,,Selepas kalahkan Bos,
Dialogue: 0,0:19:21.24,0:19:23.44,Default,,0000,0000,0000,,anginnya tiba-tiba menjadi buruk.
Dialogue: 0,0:19:23.86,0:19:27.40,Default,,0000,0000,0000,,Saya rasa mungkin dia sungguh penat.
Dialogue: 0,0:19:27.40,0:19:29.26,Default,,0000,0000,0000,,Dia bukan orang jahat.
Dialogue: 0,0:19:31.70,0:19:32.70,Default,,0000,0000,0000,,Ketua Ahn.
Dialogue: 0,0:19:33.02,0:19:36.88,Default,,0000,0000,0000,,Awak mesti bawa dia ke persatuan kita.
Dialogue: 0,0:19:37.54,0:19:38.40,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:19:40.50,0:19:43.44,Default,,0000,0000,0000,,Penilaian saya memang betul.
Dialogue: 0,0:19:46.70,0:19:47.58,Default,,0000,0000,0000,,Terima kasih atas usaha awak.
Dialogue: 0,0:19:47.92,0:19:49.00,Default,,0000,0000,0000,,Hati-hati semasa balik.
Dialogue: 0,0:19:49.32,0:19:50.10,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:19:51.34,0:19:53.14,Default,,0000,0000,0000,,Abang Jinwoo.
Dialogue: 0,0:19:54.24,0:19:55.22,Default,,0000,0000,0000,,Abang Jinwoo?
Dialogue: 0,0:19:55.42,0:19:57.68,Default,,0000,0000,0000,,Terima kasih untuk hari ini.
Dialogue: 0,0:19:58.56,0:19:59.42,Default,,0000,0000,0000,,Esok kita...
Dialogue: 0,0:19:59.76,0:20:00.74,Default,,0000,0000,0000,,Tidak.
Dialogue: 0,0:20:00.96,0:20:02.90,Default,,0000,0000,0000,,Kita jumpa kelak.
Dialogue: 0,0:20:09.92,0:20:11.04,Default,,0000,0000,0000,,Oh ya.
Dialogue: 0,0:20:11.32,0:20:13.84,Default,,0000,0000,0000,,Belum sampai sehari di luar portal.
Dialogue: 0,0:20:14.98,0:20:18.06,Default,,0000,0000,0000,,Rasanya hanya ganjaran ini yang baik.
Dialogue: 0,0:20:19.60,0:20:22.22,Default,,0000,0000,0000,,Adakah jurang\Nnilai keupayaan kami terlalu besar?
Dialogue: 0,0:20:31.14,0:20:33.46,Default,,0000,0000,0000,,Tiga percubaan telah gagal.
Dialogue: 0,0:20:33.46,0:20:35.04,Default,,0000,0000,0000,,GAGAL TIKA KALI, TAK DAPAT TERUSKAN
Dialogue: 0,0:20:35.60,0:20:37.44,Default,,0000,0000,0000,,Sia-sia usaha saya.
Dialogue: 0,0:20:38.84,0:20:39.60,Default,,0000,0000,0000,,Tak.
Dialogue: 0,0:20:44.82,0:20:45.68,Default,,0000,0000,0000,,Dengan itu...
Dialogue: 0,0:20:47.12,0:20:48.32,Default,,0000,0000,0000,,Ini sudah kali ketiga.
Dialogue: 0,0:20:52.72,0:20:54.18,Default,,0000,0000,0000,,Abang.
Dialogue: 0,0:20:54.18,0:20:56.00,Default,,0000,0000,0000,,Saya akan makan sarapan awak.
Dialogue: 0,0:20:56.24,0:20:57.58,Default,,0000,0000,0000,,Saya akan makan.
Dialogue: 0,0:21:00.02,0:21:01.40,Default,,0000,0000,0000,,Selamat pagi.
Dialogue: 0,0:21:02.94,0:21:04.84,Default,,0000,0000,0000,,Awak datang dengan penampilan sebegini?
Dialogue: 0,0:21:05.18,0:21:06.18,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:21:06.18,0:21:07.34,Default,,0000,0000,0000,,Baik, mari kita bertolak.
Dialogue: 0,0:21:08.98,0:21:10.12,Default,,0000,0000,0000,,Biarlah.
Dialogue: 0,0:21:10.54,0:21:12.56,Default,,0000,0000,0000,,Kita pergi jemput seseorang\Ndalam perjalanan.
Dialogue: 0,0:21:12.56,0:21:13.42,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:21:15.44,0:21:17.60,Default,,0000,0000,0000,,Ketua, selamat pagi.
Dialogue: 0,0:21:17.60,0:21:19.10,Default,,0000,0000,0000,,Ah.
Dialogue: 0,0:21:19.10,0:21:20.08,Default,,0000,0000,0000,,Selamat pagi.
Dialogue: 0,0:21:20.08,0:21:21.56,Default,,0000,0000,0000,,Maaf sebab perlukan awak menjemput saya.
Dialogue: 0,0:21:21.94,0:21:22.86,Default,,0000,0000,0000,,Abang Jinwoo.
Dialogue: 0,0:21:24.00,0:21:25.10,Default,,0000,0000,0000,,Abang Jinwoo?
Dialogue: 0,0:21:25.46,0:21:26.84,Default,,0000,0000,0000,,Adakah awak sempat tidur?
Dialogue: 0,0:21:26.84,0:21:28.84,Default,,0000,0000,0000,,Saya tak dapat tidur.
Dialogue: 0,0:21:29.16,0:21:31.72,Default,,0000,0000,0000,,Betul juga, sudah waktu subuh\Napabila awak tiba di rumah.
Dialogue: 0,0:21:32.02,0:21:33.54,Default,,0000,0000,0000,,- Ya.\N- Tiba di rumah pada waktu subuh.
Dialogue: 0,0:21:33.54,0:21:34.56,Default,,0000,0000,0000,,Tak tidur.
Dialogue: 0,0:21:34.56,0:21:35.64,Default,,0000,0000,0000,,Bagaimana dengan Abang Jinwoo?
Dialogue: 0,0:21:35.64,0:21:38.40,Default,,0000,0000,0000,,Ini hubungan kamu berdua?
Dialogue: 0,0:21:38.78,0:21:40.74,Default,,0000,0000,0000,,- Tidurlah, saya akan bangunkan awak.\N- Itu...
Dialogue: 0,0:21:40.74,0:21:42.22,Default,,0000,0000,0000,,- Terima kasih.\N- Abang?
Dialogue: 0,0:21:42.22,0:21:43.08,Default,,0000,0000,0000,,Apa?
Dialogue: 0,0:21:43.08,0:21:44.58,Default,,0000,0000,0000,,Cik Han
Dialogue: 0,0:21:44.98,0:21:46.38,Default,,0000,0000,0000,,masih remaja.
Dialogue: 0,0:21:47.70,0:21:48.53,Default,,0000,0000,0000,,Jadi?
Dialogue: 0,0:21:53.34,0:21:54.14,Default,,0000,0000,0000,,Tak.
Dialogue: 0,0:21:54.50,0:21:55.76,Default,,0000,0000,0000,,Tiada apa-apa.
Dialogue: 0,0:21:58.30,0:22:00.02,Default,,0000,0000,0000,,Cepat bertolak dan selesaikan masalah.
Dialogue: 0,0:22:00.02,0:22:01.40,Default,,0000,0000,0000,,Baik, Abang Jinwoo.
Dialogue: 0,0:22:02.12,0:22:03.04,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:22:42.08,0:22:44.75,Default,,0000,0000,0000,,(Solo Leveling)
Dialogue: 0,0:22:44.75,0:22:48.25,Default,,0000,0000,0000,,(Episod 14: Awak Sepatutnya Tidak Sedar)
Dialogue: 0,0:23:38.76,0:23:41.01,Default,,0000,0000,0000,,(Episod 15: Perjalanan Masih Jauh)
