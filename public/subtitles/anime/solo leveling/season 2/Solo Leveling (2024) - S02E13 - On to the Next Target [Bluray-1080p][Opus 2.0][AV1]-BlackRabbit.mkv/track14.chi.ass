Dialogue: 0,0:00:07.74,0:00:09.26,Default,,0000,0000,0000,,Có thể tắt máy quay được không?
Dialogue: 0,0:00:09.54,0:00:10.13,Default,,0000,0000,0000,,Dạ?
Dialogue: 0,0:00:10.27,0:00:10.91,Default,,0000,0000,0000,,Mau lên!
Dialogue: 0,0:00:11.31,0:00:12.43,Default,,0000,0000,0000,,Nếu không tôi sẽ phá nó.
Dialogue: 0,0:00:12.48,0:00:14.00,Default,,0000,0000,0000,,T-Tôi hiểu rồi.
Dialogue: 0,0:00:30.44,0:00:31.56,Default,,0000,0000,0000,,Hunter Sung.
Dialogue: 0,0:00:31.88,0:00:34.01,Default,,0000,0000,0000,,Cậu định làm gì Byung-gu?
Dialogue: 0,0:00:34.38,0:00:35.34,Default,,0000,0000,0000,,[KỸ NĂNG: TRÍCH XUẤT BÓNG] KHẢ DỤNG
Dialogue: 0,0:00:35.63,0:00:38.04,Default,,0000,0000,0000,,Tôi đang hỏi cậu định làm gì đấy!
Dialogue: 0,0:00:38.04,0:00:39.15,Default,,0000,0000,0000,,Không có thời gian đâu.
Dialogue: 0,0:00:39.43,0:00:40.47,Default,,0000,0000,0000,,Hãy yên lặng giúp tôi.
Dialogue: 0,0:00:44.03,0:00:44.72,Default,,0000,0000,0000,,Trỗi dậy đi.
Dialogue: 0,0:02:33.16,0:02:35.87,Default,,0000,0000,0000,,Hội trưởng đã ra lệnh\Nthực hiện phương án số 9.
Dialogue: 0,0:02:36.24,0:02:36.88,Default,,0000,0000,0000,,Chuẩn bị đi.
Dialogue: 0,0:02:37.16,0:02:38.66,Default,,0000,0000,0000,,Đừng có đùa chứ!
Dialogue: 0,0:02:39.27,0:02:40.94,Default,,0000,0000,0000,,Trên đảo có con quái vật như vậy...
Dialogue: 0,0:02:40.94,0:02:42.77,Default,,0000,0000,0000,,Mà bảo quay lại lần nữa sao?
Dialogue: 0,0:02:42.98,0:02:45.60,Default,,0000,0000,0000,,Mấy người không thấy\Nnên mới có thể nói như thế thôi...
Dialogue: 0,0:02:46.22,0:02:48.35,Default,,0000,0000,0000,,Anh Goto mà lại bị giết\Nnhanh gọn tới vậy...
Dialogue: 0,0:02:49.38,0:02:51.01,Default,,0000,0000,0000,,Con chủng mới đã chết.
Dialogue: 0,0:02:51.97,0:02:53.87,Default,,0000,0000,0000,,Hunter bên kia đã xử nó.
Dialogue: 0,0:02:54.62,0:02:57.02,Default,,0000,0000,0000,,Nó... đã chết...?
Dialogue: 0,0:02:57.95,0:03:00.05,Default,,0000,0000,0000,,Đã như vậy mà cậu vẫn nghĩ là\Nkhông thể sao?
Dialogue: 0,0:03:03.69,0:03:06.64,Default,,0000,0000,0000,,Năng lực lợi dụng\Nsức mạnh của người chết...
Dialogue: 0,0:03:06.69,0:03:09.14,Default,,0000,0000,0000,,Không đơn thuần là ma pháp triệu hồi sao?
Dialogue: 0,0:03:09.76,0:03:10.66,Default,,0000,0000,0000,,Byung-gu...
Dialogue: 0,0:03:14.02,0:03:15.34,Default,,0000,0000,0000,,Tôi nghe thấy một giọng nói.
Dialogue: 0,0:03:17.01,0:03:18.14,Default,,0000,0000,0000,,Hunter Min...
Dialogue: 0,0:03:18.45,0:03:20.63,Default,,0000,0000,0000,,Nói "hãy sử dụng sức mạnh của tôi"...
Dialogue: 0,0:03:34.09,0:03:36.93,Default,,0000,0000,0000,,Dường như tôi đã hiểu được\Nkhi còn sống anh ấy là người thế nào.
Dialogue: 0,0:03:37.66,0:03:40.98,Default,,0000,0000,0000,,Tôi chưa đưa ra chỉ thị gì\Nnhưng anh ấy đã tới chỗ Hunter Cha...
Dialogue: 0,0:03:42.22,0:03:43.70,Default,,0000,0000,0000,,Quả là một người ấm áp.
Dialogue: 0,0:03:45.78,0:03:48.72,Default,,0000,0000,0000,,Quả thật không thể để sức mạnh này\Nxuất hiện trên TV.
Dialogue: 0,0:03:48.87,0:03:52.47,Default,,0000,0000,0000,,Trận chiến càng thảm khốc\Nthì càng có thêm sức mạnh.
Dialogue: 0,0:03:52.86,0:03:54.97,Default,,0000,0000,0000,,Quả là thứ năng lực đáng sợ.
Dialogue: 0,0:03:55.19,0:03:57.08,Default,,0000,0000,0000,,Nhưng cậu Min đã...
Dialogue: 0,0:03:57.76,0:03:58.74,Default,,0000,0000,0000,,Hunter Sung.
Dialogue: 0,0:03:59.42,0:04:02.99,Default,,0000,0000,0000,,Nếu từ nay về sau, cậu tiếp tục\Nchiến đấu trên con đường Hunter
Dialogue: 0,0:04:02.99,0:04:05.45,Default,,0000,0000,0000,,thì sức mạnh của Byung-gu\Nsẽ là chiến lực quan trọng.
Dialogue: 0,0:04:06.10,0:04:06.87,Default,,0000,0000,0000,,Tuy nhiên...
Dialogue: 0,0:04:07.49,0:04:09.14,Default,,0000,0000,0000,,Cậu ấy không muốn chiến đấu.
Dialogue: 0,0:04:12.51,0:04:14.96,Default,,0000,0000,0000,,Mong cậu đừng khiến cậu ấy\Nphải một lần nữa...
Dialogue: 0,0:04:15.56,0:04:16.98,Default,,0000,0000,0000,,bước ra chiến trường.
Dialogue: 0,0:04:17.64,0:04:19.58,Default,,0000,0000,0000,,Giống với hồi ở cổng đỏ nhỉ.
Dialogue: 0,0:04:20.60,0:04:22.88,Default,,0000,0000,0000,,Hunter Baek lại nắm lấy vai tôi.
Dialogue: 0,0:04:23.79,0:04:28.31,Default,,0000,0000,0000,,Nhưng lần này không phải ra lệnh\Nmà là khẩn thiết nhờ cậy.
Dialogue: 0,0:04:29.52,0:04:30.33,Default,,0000,0000,0000,,Yên tâm đi.
Dialogue: 0,0:04:30.60,0:04:32.10,Default,,0000,0000,0000,,Tôi cũng nghĩ giống anh.
Dialogue: 0,0:04:37.53,0:04:38.60,Default,,0000,0000,0000,,Giải trừ trích xuất.
Dialogue: 0,0:05:00.71,0:05:01.63,Default,,0000,0000,0000,,Cảm ơn cậu...
Dialogue: 0,0:05:02.57,0:05:03.37,Default,,0000,0000,0000,,rất nhiều...
Dialogue: 0,0:05:05.16,0:05:06.90,Default,,0000,0000,0000,,Tại sao bọn chúng vẫn còn sống?
Dialogue: 0,0:05:07.43,0:05:10.55,Default,,0000,0000,0000,,Hunter Sung đã hội họp\Nvà tiêu diệt con chủng mới...
Dialogue: 0,0:05:10.55,0:05:12.24,Default,,0000,0000,0000,,Chuyện đó thì nhìn là hiểu rồi!
Dialogue: 0,0:05:12.42,0:05:13.78,Default,,0000,0000,0000,,Tại sao hắn lại ở trên đảo?
Dialogue: 0,0:05:13.78,0:05:16.52,Default,,0000,0000,0000,,Chẳng phải hắn không tham gia\Nchiến dịch liên hợp sao!?
Dialogue: 0,0:05:16.90,0:05:17.76,Default,,0000,0000,0000,,Không rõ ạ.
Dialogue: 0,0:05:18.04,0:05:20.98,Default,,0000,0000,0000,,Theo lịch sử quan sát ma lực\Nthì đột nhiên cậu ta xuất hiện...
Dialogue: 0,0:05:21.40,0:05:22.58,Default,,0000,0000,0000,,Sao có thể như vậy...
Dialogue: 0,0:05:23.03,0:05:26.84,Default,,0000,0000,0000,,Trong khi bên ta đã mất\N7 trong số 10 Hunter cấp S!
Dialogue: 0,0:05:27.57,0:05:30.85,Default,,0000,0000,0000,,Hội trưởng, vẫn tiến hành\Nphương án số 9 chứ ạ?
Dialogue: 0,0:05:31.31,0:05:33.59,Default,,0000,0000,0000,,Ngộ nhỡ có thêm thiệt hại,
Dialogue: 0,0:05:33.59,0:05:36.78,Default,,0000,0000,0000,,thì không chỉ ảnh hưởng tới việc\Nứng phó với các cánh cổng trong nước,
Dialogue: 0,0:05:36.78,0:05:40.09,Default,,0000,0000,0000,,thậm chí sẽ khiến sự cân bằng\Nsức mạnh toàn cầu hiện tại sụp đổ.
Dialogue: 0,0:05:40.45,0:05:41.30,Default,,0000,0000,0000,,Nên làm thế nào ạ?
Dialogue: 0,0:05:42.85,0:05:43.81,Default,,0000,0000,0000,,Rút lui.
Dialogue: 0,0:05:44.43,0:05:46.00,Default,,0000,0000,0000,,Lập tức rút lui.
Dialogue: 0,0:05:46.68,0:05:47.56,Default,,0000,0000,0000,,Tuân lệnh.
Dialogue: 0,0:06:04.10,0:06:05.54,Default,,0000,0000,0000,,Lũ kiến đột nhiên lao tới!
Dialogue: 0,0:06:05.58,0:06:06.38,Default,,0000,0000,0000,,Tại sao vậy!?
Dialogue: 0,0:06:07.23,0:06:08.32,Default,,0000,0000,0000,,Ai mà biết được!
Dialogue: 0,0:06:08.52,0:06:10.12,Default,,0000,0000,0000,,Tiêu diệt kiến chúa rồi mà!?
Dialogue: 0,0:06:10.46,0:06:11.37,Default,,0000,0000,0000,,Lý do là vậy đó!
Dialogue: 0,0:06:12.88,0:06:15.74,Default,,0000,0000,0000,,Mất đi đầu não chỉ huy\Nkhiến bọn chúng trở nên hỗn loạn.
Dialogue: 0,0:06:15.83,0:06:17.85,Default,,0000,0000,0000,,Tuyệt đối không được\Nđể chúng tới đất liền!
Dialogue: 0,0:06:18.73,0:06:19.94,Default,,0000,0000,0000,,Cản chúng lại nào!
Dialogue: 0,0:06:20.11,0:06:22.40,Default,,0000,0000,0000,,Đây chính là lúc Hội Kỵ Sĩ Đoàn thể hiện!
Dialogue: 0,0:06:22.41,0:06:23.87,Default,,0000,0000,0000,,Không hổ là hội trưởng!
Dialogue: 0,0:06:26.44,0:06:27.59,Default,,0000,0000,0000,,Mọi người ơi!
Dialogue: 0,0:06:27.64,0:06:28.87,Default,,0000,0000,0000,,Xin hãy mau lên!
Dialogue: 0,0:06:34.76,0:06:36.41,Default,,0000,0000,0000,,Tình hình không ổn rồi!
Dialogue: 0,0:06:36.70,0:06:38.89,Default,,0000,0000,0000,,Lũ kiến đang cố rời khỏi đảo
Dialogue: 0,0:06:38.89,0:06:41.38,Default,,0000,0000,0000,,có vẻ hướng về phía đất liền\Nvới phạm vi rất rộng.
Dialogue: 0,0:06:41.41,0:06:43.89,Default,,0000,0000,0000,,Nếu không mau rút lui\Nthì đường về sẽ bị bịt kín!
Dialogue: 0,0:06:44.12,0:06:45.60,Default,,0000,0000,0000,,Lập tức khởi hành thôi.
Dialogue: 0,0:06:45.82,0:06:47.02,Default,,0000,0000,0000,,Cứ khởi hành đi!
Dialogue: 0,0:06:47.32,0:06:48.70,Default,,0000,0000,0000,,Còn Hunter Sung thì sao?
Dialogue: 0,0:06:48.72,0:06:52.33,Default,,0000,0000,0000,,Có vẻ cậu ấy ở lại để dọn dẹp\Nlũ tàn dư và đống trứng kiến.
Dialogue: 0,0:06:52.50,0:06:57.32,Default,,0000,0000,0000,,Thật đáng tiếc, chúng ta hiện giờ\Nchỉ cản trở cậu ấy mà thôi.
Dialogue: 0,0:06:57.64,0:07:00.17,Default,,0000,0000,0000,,Hơn nữa, dù có thể nói là\Nđã giữ được mạng
Dialogue: 0,0:07:00.17,0:07:03.47,Default,,0000,0000,0000,,nhưng vẫn phải mau chóng\Nđưa Hunter Cha tới chỗ tổ y tế.
Dialogue: 0,0:07:10.49,0:07:11.45,Default,,0000,0000,0000,,THĂNG CẤP!
Dialogue: 0,0:07:11.69,0:07:16.41,Default,,0000,0000,0000,,Trứng chưa nở mà vẫn có điểm kinh nghiệm\Nđúng là mang về niềm vui bất ngờ.
Dialogue: 0,0:07:33.14,0:07:35.53,Default,,0000,0000,0000,,Cứ để nó phủ bụi đúng là lãng phí.
Dialogue: 0,0:07:35.90,0:07:37.72,Default,,0000,0000,0000,,Không hổ là Trường Kiếm Của Quỷ Vương.
Dialogue: 0,0:07:38.66,0:07:41.24,Default,,0000,0000,0000,,Mà thôi, còn lại giao các ngươi.
Dialogue: 0,0:07:42.50,0:07:43.21,Default,,0000,0000,0000,,THĂNG CẤP!
Dialogue: 0,0:07:44.69,0:07:45.40,Default,,0000,0000,0000,,THĂNG CẤP!
Dialogue: 0,0:07:47.84,0:07:48.04,Default,,0000,0000,0000,,THĂNG CẤP!
Dialogue: 0,0:07:48.21,0:07:54.80,Default,,0000,0000,0000,,TRẠNG THÁI - CẤP 100\NCHỨC NGHIỆP: CHÚA TỂ BÓNG TỐI\NDANH HIỆU: KẺ VƯỢT QUA NGHỊCH CẢNH
Dialogue: 0,0:07:56.49,0:07:58.79,Default,,0000,0000,0000,,Cuối cùng cũng đạt được cấp 100 sao.
Dialogue: 0,0:08:04.42,0:08:07.35,Default,,0000,0000,0000,,Cái con này mặc dù đã chết\Nvẫn tỏa ra khí chất thật kinh khủng.
Dialogue: 0,0:08:07.80,0:08:08.63,Default,,0000,0000,0000,,[KỸ NĂNG: TRÍCH XUẤT BÓNG] KHẢ DỤNG
Dialogue: 0,0:08:09.37,0:08:10.12,Default,,0000,0000,0000,,Trỗi dậy đi.
Dialogue: 0,0:08:18.05,0:08:19.51,Default,,0000,0000,0000,,Bóng tối gì thế này?
Dialogue: 0,0:08:19.96,0:08:21.22,Default,,0000,0000,0000,,Không cảm nhận được gì.
Dialogue: 0,0:08:21.76,0:08:23.54,Default,,0000,0000,0000,,Trong lúc trích xuất đã có biến sao?
Dialogue: 0,0:08:25.72,0:08:26.75,Default,,0000,0000,0000,,Trở lại rồi.
Dialogue: 0,0:08:53.36,0:08:55.27,Default,,0000,0000,0000,,Cứ tưởng là thất bại rồi cơ.
Dialogue: 0,0:09:01.86,0:09:04.74,Default,,0000,0000,0000,,Giờ thì đến lượt lũ kiến khác...
Dialogue: 0,0:09:05.03,0:09:06.46,Default,,0000,0000,0000,,Thưa đức vua...
Dialogue: 0,0:09:09.06,0:09:10.29,Default,,0000,0000,0000,,Ngươi vừa nói sao?
Dialogue: 0,0:09:10.75,0:09:11.72,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:09:12.62,0:09:15.69,Default,,0000,0000,0000,,Những cái bóng khác không thể nói kia mà,\Ntại sao riêng nó lại khác?
Dialogue: 0,0:09:15.87,0:09:16.91,Default,,0000,0000,0000,,Thưa đức vua...
Dialogue: 0,0:09:17.52,0:09:20.26,Default,,0000,0000,0000,,Xin hãy ban tên cho thần.
Dialogue: 0,0:09:20.39,0:09:21.06,Default,,0000,0000,0000,,CẤP TƯỚNG QUÂN
Dialogue: 0,0:09:21.06,0:09:22.46,Default,,0000,0000,0000,,Cấp Tướng Quân.
Dialogue: 0,0:09:22.50,0:09:23.97,Default,,0000,0000,0000,,Lần đầu mình thấy phân cấp này.
Dialogue: 0,0:09:24.50,0:09:26.75,Default,,0000,0000,0000,,Nó biết nói do ở phân cấp khác sao?
Dialogue: 0,0:09:27.32,0:09:28.96,Default,,0000,0000,0000,,Kể cả vậy đi nữa...
Dialogue: 0,0:09:29.88,0:09:31.93,Default,,0000,0000,0000,,Ta chính là người đã giết ngươi.
Dialogue: 0,0:09:32.28,0:09:34.31,Default,,0000,0000,0000,,Dù vậy ngươi vẫn sẽ phục tùng ta sao?
Dialogue: 0,0:09:34.92,0:09:42.11,Default,,0000,0000,0000,,Thần không phải bị giết mà là\Nđược tái sinh bởi sức mạnh của đức vua.
Dialogue: 0,0:09:42.90,0:09:46.40,Default,,0000,0000,0000,,Hiện thần đang cảm thấy vui sướng ạ.
Dialogue: 0,0:09:46.61,0:09:49.92,Default,,0000,0000,0000,,Thần sẽ phụng sự người vĩnh viễn.
Dialogue: 0,0:09:51.01,0:09:54.10,Default,,0000,0000,0000,,Xin người hãy ban tên cho thần.
Dialogue: 0,0:09:57.27,0:09:57.83,Default,,0000,0000,0000,,Beru.
Dialogue: 0,0:09:58.01,0:09:59.30,Default,,0000,0000,0000,,TƯỚNG QUÂN CẤP 1\NBẠN CÓ THỂ ĐẶT TÊN - BERU
Dialogue: 0,0:09:59.38,0:10:00.11,Default,,0000,0000,0000,,BERU CẤP 1\NCẤP TƯỚNG QUÂN
Dialogue: 0,0:10:00.11,0:10:01.87,Default,,0000,0000,0000,,Tên của ngươi là Beru.
Dialogue: 0,0:10:02.80,0:10:05.15,Default,,0000,0000,0000,,Cảm ơn người, thật vinh hạnh cho thần.
Dialogue: 0,0:10:05.58,0:10:07.42,Default,,0000,0000,0000,,Giờ thì lại lần nữa...
Dialogue: 0,0:10:08.34,0:10:09.09,Default,,0000,0000,0000,,Trỗi dậy đi!
Dialogue: 0,0:10:14.12,0:10:16.11,Default,,0000,0000,0000,,Chúng đã vượt qua lực lượng trên biển sao!?
Dialogue: 0,0:10:16.17,0:10:17.83,Default,,0000,0000,0000,,Đây chính là phòng tuyến cuối cùng!
Dialogue: 0,0:10:17.84,0:10:19.78,Default,,0000,0000,0000,,Tuyệt đối không cho chúng\Ntiếp cận thành phố!
Dialogue: 0,0:10:19.79,0:10:21.06,Default,,0000,0000,0000,,Chịu, chịu, chịu, chịu thôi!
Dialogue: 0,0:10:21.10,0:10:22.65,Default,,0000,0000,0000,,Đánh với mấy thứ đó kiểu gì chứ...
Dialogue: 0,0:10:22.65,0:10:23.24,Default,,0000,0000,0000,,Chậc!
Dialogue: 0,0:10:23.24,0:10:24.60,Default,,0000,0000,0000,,Tank lên trước đi!
Dialogue: 0,0:10:24.66,0:10:26.62,Default,,0000,0000,0000,,Hãy liều mạng giữ vững phòng tuyến!
Dialogue: 0,0:10:31.13,0:10:32.67,Default,,0000,0000,0000,,Số lượng kinh thật.
Dialogue: 0,0:10:33.05,0:10:38.70,Default,,0000,0000,0000,,Khoảng 4000 cá thể đã mất thủ lĩnh\Nvà đang chạy loạn khắp nơi ạ.
Dialogue: 0,0:10:38.72,0:10:40.37,Default,,0000,0000,0000,,Vẫn còn đông tới vậy à?
Dialogue: 0,0:10:41.18,0:10:42.88,Default,,0000,0000,0000,,Ngươi có thể xử lý bớt không?
Dialogue: 0,0:10:42.88,0:10:43.81,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:10:43.85,0:10:45.69,Default,,0000,0000,0000,,Nếu đức vua đã có ý như vậy.
Dialogue: 0,0:10:45.69,0:10:47.35,Default,,0000,0000,0000,,Xin người hãy hạ lệnh.
Dialogue: 0,0:10:48.16,0:10:49.07,Default,,0000,0000,0000,,Làm đi.
Dialogue: 0,0:10:58.84,0:11:00.18,Default,,0000,0000,0000,,Được, xong rồi!
Dialogue: 0,0:11:00.43,0:11:03.98,Default,,0000,0000,0000,,Kẻ địch tuy mạnh nhưng\Ncứ chắc chắn triệt hạ từng con một!
Dialogue: 0,0:11:04.22,0:11:06.09,Default,,0000,0000,0000,,Phối hợp chặt chẽ, nắm rõ vị trí...
Dialogue: 0,0:11:06.09,0:11:07.00,Default,,0000,0000,0000,,Bác Song!
Dialogue: 0,0:11:12.69,0:11:13.45,Default,,0000,0000,0000,,Bác Song!
Dialogue: 0,0:11:13.45,0:11:14.50,Default,,0000,0000,0000,,Bác không sao chứ?
Dialogue: 0,0:11:14.79,0:11:16.26,Default,,0000,0000,0000,,Chuyện này rốt cuộc là thế nào...
Dialogue: 0,0:11:21.65,0:11:22.92,Default,,0000,0000,0000,,Ánh sáng gì vậy?
Dialogue: 0,0:11:23.25,0:11:24.16,Default,,0000,0000,0000,,Ta cũng không biết.
Dialogue: 0,0:11:24.50,0:11:27.39,Default,,0000,0000,0000,,Nhưng nó đã cứu mạng ta nhỉ?
Dialogue: 0,0:11:28.82,0:11:29.69,Default,,0000,0000,0000,,Anh Jinwoo?
Dialogue: 0,0:11:32.51,0:11:34.32,Default,,0000,0000,0000,,Nói gì thì nói vẫn quá đông rồi!
Dialogue: 0,0:11:34.33,0:11:35.93,Default,,0000,0000,0000,,Không thể làm gì chúng sao!?
Dialogue: 0,0:11:36.09,0:11:36.97,Default,,0000,0000,0000,,Chịu rồi!
Dialogue: 0,0:11:36.98,0:11:38.22,Default,,0000,0000,0000,,Trực thăng trụ không nổi!
Dialogue: 0,0:11:42.63,0:11:43.82,Default,,0000,0000,0000,,Bực thật...
Dialogue: 0,0:12:04.01,0:12:07.12,Default,,0000,0000,0000,,Sau cùng vẫn là được cậu ấy cứu nhỉ...
Dialogue: 0,0:12:11.82,0:12:13.73,Default,,0000,0000,0000,,Giờ thì họ có thể thoát rồi nhỉ.
Dialogue: 0,0:12:15.95,0:12:19.98,Default,,0000,0000,0000,,Sau đó, phần lớn lũ kiến\Nchạy loạn từ phía đảo
Dialogue: 0,0:12:19.98,0:12:24.72,Default,,0000,0000,0000,,đã bị đông đảo Hunter chung tay chặn đứng.
Dialogue: 0,0:12:25.07,0:12:28.50,Default,,0000,0000,0000,,Nhờ đó mà thiệt hại cho đất liền\Ncũng được giảm thiểu tối đa.
Dialogue: 0,0:12:29.27,0:12:32.26,Default,,0000,0000,0000,,Các Hunter cấp S của đất nước\Nđã bình an trở về.
Dialogue: 0,0:12:32.40,0:12:37.69,Default,,0000,0000,0000,,Hunter Cha cũng được đưa ngay vào viện\Ntrong trạng thái hôn mê.
Dialogue: 0,0:12:38.50,0:12:42.16,Default,,0000,0000,0000,,Mặc dù đây là trận chiến\Ncó nhiều sự hi sinh,
Dialogue: 0,0:12:42.16,0:12:47.82,Default,,0000,0000,0000,,nhưng chúng ta đã thành công\Nngăn chặn hiểm họa lan tràn ra ngoài đảo.
Dialogue: 0,0:12:49.18,0:12:51.75,Default,,0000,0000,0000,,Chiến dịch chinh phạt Đảo Jeju lần thứ tư
Dialogue: 0,0:12:51.75,0:12:54.25,Default,,0000,0000,0000,,đã khép lại với chiến thắng\Nthuộc về chúng ta.
Dialogue: 0,0:12:58.45,0:13:02.50,Default,,0000,0000,0000,,Lũ tàn dư lại đi cả quãng đường dài\Nđể tới đất nước này nữa rồi.
Dialogue: 0,0:13:02.78,0:13:04.70,Default,,0000,0000,0000,,Liên tiếp hai ngày nhỉ.
Dialogue: 0,0:13:05.20,0:13:06.81,Default,,0000,0000,0000,,Chuẩn bị vào tầm bắn ạ!
Dialogue: 0,0:13:07.05,0:13:09.29,Default,,0000,0000,0000,,Truyền đạt cho Hunter hệ pháp sư\Nđang đợi lệnh.
Dialogue: 0,0:13:09.31,0:13:10.35,Default,,0000,0000,0000,,Chuẩn bị đánh chặn!
Dialogue: 0,0:13:10.35,0:13:11.32,Default,,0000,0000,0000,,Không, đợi đã.
Dialogue: 0,0:13:11.86,0:13:14.87,Default,,0000,0000,0000,,Có vẻ anh hùng của đất nước ta\Nđang muốn cho cơ thể vận động.
Dialogue: 0,0:13:16.43,0:13:17.66,Default,,0000,0000,0000,,Tới rồi, tới rồi.
Dialogue: 0,0:13:18.54,0:13:21.06,Default,,0000,0000,0000,,Phải cho tấm thân này\Nvận động một chút thôi.
Dialogue: 0,0:13:21.81,0:13:24.32,Default,,0000,0000,0000,,Ta sẽ cho toàn bộ chúng bây\Nchìm xuống biển!
Dialogue: 0,0:13:41.54,0:13:44.85,Default,,0000,0000,0000,,Nếu không phải lũ tiểu tốt này\Nmà là con kiến đen đó
Dialogue: 0,0:13:44.85,0:13:47.60,Default,,0000,0000,0000,,thì nhất định sẽ vui hơn một chút...
Dialogue: 0,0:13:47.63,0:13:49.02,Default,,0000,0000,0000,,Nhưng tiếc thật đấy.
Dialogue: 0,0:13:50.10,0:13:52.44,Default,,0000,0000,0000,,Vài ngày sau cuộc\Nchinh phạt Đảo Jeju lần thứ tư.
Dialogue: 0,0:13:52.87,0:13:55.98,Default,,0000,0000,0000,,Một đài tưởng niệm những người hi sinh\Nđã được dựng lên tại đây.
Dialogue: 0,0:13:56.02,0:13:58.44,Default,,0000,0000,0000,,Có rất đông người đã tới thăm viếng.
Dialogue: 0,0:14:00.20,0:14:01.52,Default,,0000,0000,0000,,Xin hãy chú ý.
Dialogue: 0,0:14:01.56,0:14:04.73,Default,,0000,0000,0000,,Hunter cấp S, Sung Jinwoo\Nđang tới đặt hoa viếng.
Dialogue: 0,0:14:05.56,0:14:08.61,Default,,0000,0000,0000,,Trong cuộc chinh phạt lần này,\Nanh ấy đã lập đại công.
Dialogue: 0,0:14:08.80,0:14:12.05,Default,,0000,0000,0000,,Có thể nói nếu không có Hunter Sung\Nthì đã không thể thành công.
Dialogue: 0,0:14:12.79,0:14:14.04,Default,,0000,0000,0000,,Một bộ phận đang dùng từ anh hùng...
Dialogue: 0,0:14:14.04,0:14:16.89,Default,,0000,0000,0000,,Mặt khác, hành động của anh ấy\Ncó nhiều điểm kỳ lạ...
Dialogue: 0,0:14:16.89,0:14:20.48,Default,,0000,0000,0000,,"Nếu tham gia từ đầu\Nchẳng phải họ đã không hi sinh sao?"
Dialogue: 0,0:14:20.48,0:14:22.79,Default,,0000,0000,0000,,Những ý kiến phản đối\Nnhư vừa rồi đang xuất hiện.
Dialogue: 0,0:14:28.37,0:14:29.92,Default,,0000,0000,0000,,Hãy ưỡn ngực lên đi.
Dialogue: 0,0:14:30.63,0:14:32.14,Default,,0000,0000,0000,,Dù thế gian có nói gì đi nữa...
Dialogue: 0,0:14:32.37,0:14:36.31,Default,,0000,0000,0000,,Thì cậu vẫn là người\Nđã kết thúc thảm kịch này.
Dialogue: 0,0:14:51.26,0:14:55.64,Default,,0000,0000,0000,,Đầu tiên, về sự giúp đỡ của cậu\Nvới cuộc chinh phạt Đảo Jeju lần thứ tư.
Dialogue: 0,0:14:56.34,0:14:59.18,Default,,0000,0000,0000,,Tôi xin được cảm ơn với tư cách\Nđại diện của Hiệp hội Hunter.
Dialogue: 0,0:15:00.01,0:15:00.67,Default,,0000,0000,0000,,Không.
Dialogue: 0,0:15:00.91,0:15:05.67,Default,,0000,0000,0000,,Nếu tôi tới sớm hơn một chút\Nthì Hunter Min đã không mất mạng.
Dialogue: 0,0:15:06.57,0:15:13.18,Default,,0000,0000,0000,,Nhưng sự thật là cậu đã cứu mạng\Nnăm Hunter và nhiều người dân khác.
Dialogue: 0,0:15:13.60,0:15:15.17,Default,,0000,0000,0000,,Đây là một chiến công vĩ đại.
Dialogue: 0,0:15:15.91,0:15:20.68,Default,,0000,0000,0000,,Tôi xin được đảm bảo Hunter Sung\Nsẽ có phần thưởng đúng như mong muốn.
Dialogue: 0,0:15:21.75,0:15:22.53,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:15:24.63,0:15:28.31,Default,,0000,0000,0000,,Vậy sau này, cậu dự tính\Nsẽ hoạt động theo hướng nào?
Dialogue: 0,0:15:28.92,0:15:30.34,Default,,0000,0000,0000,,Sau này ấy ạ?
Dialogue: 0,0:15:30.71,0:15:31.41,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:15:31.99,0:15:36.77,Default,,0000,0000,0000,,Qua cuộc chinh phạt này, cậu đã thể hiện\Nsức mạnh đó với cả trong lẫn ngoài nước.
Dialogue: 0,0:15:37.39,0:15:40.12,Default,,0000,0000,0000,,Giờ đây, thế giới\Nsẽ không rời mắt khỏi cậu.
Dialogue: 0,0:15:40.22,0:15:42.12,Default,,0000,0000,0000,,Nhất định sẽ có người tìm đến.
Dialogue: 0,0:15:42.87,0:15:46.51,Default,,0000,0000,0000,,Phía hiệp hội cũng không thể\Nbàng quan trước chuyện đó.
Dialogue: 0,0:15:47.00,0:15:49.24,Default,,0000,0000,0000,,Thế nên tôi muốn hỏi lại một lần nữa.
Dialogue: 0,0:15:49.65,0:15:50.72,Default,,0000,0000,0000,,Hunter Sung.
Dialogue: 0,0:15:51.11,0:15:56.46,Default,,0000,0000,0000,,Từ nay, cậu định dùng sức mạnh đó\Nở đâu và để làm gì?
Dialogue: 0,0:16:02.40,0:16:04.93,Default,,0000,0000,0000,,Tôi đang tính sẽ tự lập bang hội của mình.
Dialogue: 0,0:16:08.05,0:16:10.62,Default,,0000,0000,0000,,Tại sao mỗi hội trưởng nhà mình\Nkhông dự lễ tưởng niệm
Dialogue: 0,0:16:10.62,0:16:12.90,Default,,0000,0000,0000,,mà lại đi làm việc vặt như này vậy!
Dialogue: 0,0:16:13.01,0:16:13.96,Default,,0000,0000,0000,,Đồ ngốc!
Dialogue: 0,0:16:14.11,0:16:16.59,Default,,0000,0000,0000,,Kiểm tra kẻ địch đã chết\Nvà săn lùng lũ tàn dư...
Dialogue: 0,0:16:16.59,0:16:19.34,Default,,0000,0000,0000,,Cùng với đó là thu hồi tài nguyên\Nlà công việc quan trọng.
Dialogue: 0,0:16:19.53,0:16:23.26,Default,,0000,0000,0000,,Được giao phó công việc sau cùng này\Nlà minh chứng của sự tin tưởng.
Dialogue: 0,0:16:23.59,0:16:24.26,Default,,0000,0000,0000,,Nhưng mà...
Dialogue: 0,0:16:24.37,0:16:25.48,Default,,0000,0000,0000,,Còn nữa...
Dialogue: 0,0:16:29.16,0:16:32.57,Default,,0000,0000,0000,,Cứ làm việc một cách đáng tin cậy\Nmà chẳng ai hay như này
Dialogue: 0,0:16:32.57,0:16:34.03,Default,,0000,0000,0000,,mới là đàn ông đích thực.
Dialogue: 0,0:16:34.39,0:16:36.00,Default,,0000,0000,0000,,Không hổ là hội trưởng!
Dialogue: 0,0:16:38.73,0:16:40.11,Default,,0000,0000,0000,,Kẻ nào vậy!?
Dialogue: 0,0:16:40.16,0:16:42.02,Default,,0000,0000,0000,,Đây là khu vực cấm vào!
Dialogue: 0,0:16:42.41,0:16:43.26,Default,,0000,0000,0000,,Sao các người lại...
Dialogue: 0,0:16:43.26,0:16:44.52,Default,,0000,0000,0000,,"Lảm nhảm ồn quá."
Dialogue: 0,0:16:44.80,0:16:46.10,Default,,0000,0000,0000,,"Các ngươi là lũ nào?"
Dialogue: 0,0:16:46.57,0:16:48.14,Default,,0000,0000,0000,,Hả? Cái gì cơ?
Dialogue: 0,0:16:48.36,0:16:51.02,Default,,0000,0000,0000,,Không cần biết các người là ai\Nnhưng không được vào đây!
Dialogue: 0,0:16:55.33,0:16:56.40,Default,,0000,0000,0000,,Ngươi vừa làm gì vậy?
Dialogue: 0,0:16:57.09,0:16:59.06,Default,,0000,0000,0000,,Chúng ồn ào làm ta nhức tai.
Dialogue: 0,0:16:59.08,0:17:00.92,Default,,0000,0000,0000,,Chỉ là tạm thời cho đi ngủ thôi.
Dialogue: 0,0:17:01.68,0:17:03.99,Default,,0000,0000,0000,,Mà ngươi đã kiểm chứng được chưa?
Dialogue: 0,0:17:04.16,0:17:06.38,Default,,0000,0000,0000,,Ừ, chắc chắn là sức mạnh của hắn.
Dialogue: 0,0:17:06.61,0:17:07.85,Default,,0000,0000,0000,,Thật vi diệu.
Dialogue: 0,0:17:08.07,0:17:10.81,Default,,0000,0000,0000,,Ta không nghĩ hắn lại đi\Ngiúp đỡ con người.
Dialogue: 0,0:17:10.94,0:17:13.91,Default,,0000,0000,0000,,Có phải lần đầu\Nhắn có hành động khó hiểu đâu.
Dialogue: 0,0:17:14.11,0:17:15.72,Default,,0000,0000,0000,,Nếu bận tâm sao không đi hỏi hắn đi.
Dialogue: 0,0:17:15.97,0:17:17.66,Default,,0000,0000,0000,,Đấy là nếu gặp được hắn.
Dialogue: 0,0:17:18.01,0:17:20.67,Default,,0000,0000,0000,,Vậy là đã xong việc ở nơi này.
Dialogue: 0,0:17:22.45,0:17:23.85,Default,,0000,0000,0000,,Đi thôi.
Dialogue: 0,0:17:24.47,0:17:26.77,Default,,0000,0000,0000,,Hình như có một trong số chúng đang ở đây?
Dialogue: 0,0:17:27.16,0:17:30.17,Default,,0000,0000,0000,,Nơi này cứ giao cho kẻ đó đi.
Dialogue: 0,0:17:30.44,0:17:32.38,Default,,0000,0000,0000,,Ý ngươi là không muốn dính dáng sao?
Dialogue: 0,0:17:33.41,0:17:35.73,Default,,0000,0000,0000,,Cuộc đi săn sẽ diễn ra đúng như dự tính.
Dialogue: 0,0:17:35.96,0:17:37.26,Default,,0000,0000,0000,,Không có gì thay đổi cả.
Dialogue: 0,0:17:45.61,0:17:49.00,Default,,0000,0000,0000,,Mà thôi, cần gì phải kiếm thêm phiền phức.
Dialogue: 0,0:17:50.89,0:17:52.67,Default,,0000,0000,0000,,Cơ mà nặng mùi thật.
Dialogue: 0,0:17:52.83,0:17:55.31,Default,,0000,0000,0000,,Nếu ả ta mà thấy cảnh này\Nchắc sẽ làm ầm lên.
Dialogue: 0,0:18:07.16,0:18:09.00,Default,,0000,0000,0000,,Không nhúc nhích được tí nào.
Dialogue: 0,0:18:09.82,0:18:12.12,Default,,0000,0000,0000,,Đại ca à, thế còn vụ bang hội...
Dialogue: 0,0:18:12.79,0:18:15.87,Default,,0000,0000,0000,,À, vừa nãy tôi được\NHội trưởng Go chấp thuận rồi.
Dialogue: 0,0:18:15.97,0:18:17.12,Default,,0000,0000,0000,,Thật ạ?
Dialogue: 0,0:18:17.16,0:18:19.16,Default,,0000,0000,0000,,Vậy thì phải mau chóng tìm văn phòng...
Dialogue: 0,0:18:19.17,0:18:19.63,Default,,0000,0000,0000,,A!
Dialogue: 0,0:18:19.67,0:18:20.97,Default,,0000,0000,0000,,Ơ? Đợi đã!
Dialogue: 0,0:18:20.97,0:18:24.06,Default,,0000,0000,0000,,Anh Jinwoo hãy cho em\Ngia nhập bang hội với!
Dialogue: 0,0:18:24.26,0:18:25.73,Default,,0000,0000,0000,,Em nhất định sẽ có ích ạ!
Dialogue: 0,0:18:25.75,0:18:27.75,Default,,0000,0000,0000,,Khoan đã, anh đang bàn chuyện quan trọng.
Dialogue: 0,0:18:27.76,0:18:28.61,Default,,0000,0000,0000,,Tôi tắt máy đây.
Dialogue: 0,0:18:28.61,0:18:29.77,Default,,0000,0000,0000,,Chuyện quan trọng gì chứ?
Dialogue: 0,0:18:32.61,0:18:34.96,Default,,0000,0000,0000,,Cơ mà chẳng nhích lên được chút nào thật.
Dialogue: 0,0:18:38.78,0:18:39.32,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:18:39.77,0:18:40.86,Default,,0000,0000,0000,,Hunter Sung.
Dialogue: 0,0:18:40.86,0:18:41.75,Default,,0000,0000,0000,,Tôi, Go đây.
Dialogue: 0,0:18:42.14,0:18:44.05,Default,,0000,0000,0000,,Có vấn đề gì về vụ bang hội ạ?
Dialogue: 0,0:18:44.52,0:18:46.56,Default,,0000,0000,0000,,À, đây là chuyện khác.
Dialogue: 0,0:18:47.32,0:18:49.08,Default,,0000,0000,0000,,Ở cuối đường cao tốc sao?
Dialogue: 0,0:18:49.34,0:18:51.96,Default,,0000,0000,0000,,Phải, một cổng cấp B đã xuất hiện.
Dialogue: 0,0:18:52.33,0:18:53.39,Default,,0000,0000,0000,,Thảo nào...
Dialogue: 0,0:18:53.84,0:18:55.92,Default,,0000,0000,0000,,Hiện chúng tôi đang bố trí Hunter
Dialogue: 0,0:18:55.92,0:18:58.41,Default,,0000,0000,0000,,nhưng giải quyết vụ này\Ncó lẽ sẽ tốn thời gian.
Dialogue: 0,0:18:58.75,0:19:00.26,Default,,0000,0000,0000,,Nếu được thì cái cổng đó...
Dialogue: 0,0:19:01.45,0:19:03.84,Default,,0000,0000,0000,,Xin hãy từ từ tiến lên từng xe một ạ.
Dialogue: 0,0:19:03.87,0:19:05.66,Default,,0000,0000,0000,,Hunter vẫn chưa đến à?
Dialogue: 0,0:19:06.17,0:19:06.91,Default,,0000,0000,0000,,Hả?
Dialogue: 0,0:19:06.91,0:19:09.02,Default,,0000,0000,0000,,Hunter không đến được vì tắc đường sao?
Dialogue: 0,0:19:09.16,0:19:10.52,Default,,0000,0000,0000,,Nguy to rồi!
Dialogue: 0,0:19:10.53,0:19:12.03,Default,,0000,0000,0000,,Ơ? Khoan!? Này?
Dialogue: 0,0:19:14.06,0:19:15.38,Default,,0000,0000,0000,,Tôi tới để đóng cổng.
Dialogue: 0,0:19:15.49,0:19:15.93,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:19:16.21,0:19:17.99,Default,,0000,0000,0000,,Tôi có nghe Tổ trưởng Woo nói.
Dialogue: 0,0:19:18.01,0:19:21.56,Default,,0000,0000,0000,,Nhưng có vẻ cần thêm một lúc nữa\Ncác Hunter khác mới đến...
Dialogue: 0,0:19:21.56,0:19:22.68,Default,,0000,0000,0000,,Một mình tôi cũng được.
Dialogue: 0,0:19:22.70,0:19:23.75,Default,,0000,0000,0000,,N-Nhưng mà...
Dialogue: 0,0:19:26.05,0:19:27.53,Default,,0000,0000,0000,,Đi mất rồi...
Dialogue: 0,0:19:27.90,0:19:30.04,Default,,0000,0000,0000,,Ây chà, dù nó là cấp B...
Dialogue: 0,0:19:30.80,0:19:31.54,Default,,0000,0000,0000,,A!
Dialogue: 0,0:19:33.98,0:19:34.94,Default,,0000,0000,0000,,Đây là...
Dialogue: 0,0:19:36.27,0:19:37.20,Default,,0000,0000,0000,,Chà, nơi này...
Dialogue: 0,0:19:37.68,0:19:39.68,Default,,0000,0000,0000,,Chắc chắn là cổng đỏ rồi.
Dialogue: 0,0:19:41.33,0:19:43.37,Default,,0000,0000,0000,,Đúng là họa vô đơn chí nhỉ...
Dialogue: 0,0:19:43.88,0:19:47.69,Default,,0000,0000,0000,,Lối ra đã bị đóng,\Ncòn khu rừng thì không biết rộng cỡ nào.
Dialogue: 0,0:19:48.91,0:19:52.22,Default,,0000,0000,0000,,Nếu biết như này thì đáng ra\Nnên bảo với mẹ sẽ về muộn...
Dialogue: 0,0:19:55.95,0:19:56.45,Default,,0000,0000,0000,,Mà thôi.
Dialogue: 0,0:19:57.03,0:20:00.05,Default,,0000,0000,0000,,Nếu cỡ này thì chắc là\Nkhông tốn thời gian lắm đâu.
Dialogue: 0,0:20:23.51,0:20:25.35,Default,,0000,0000,0000,,Dọn dẹp nhanh gọn nào.
Dialogue: 0,0:20:33.23,0:20:34.75,Default,,0000,0000,0000,,Cậu ấy đã tới rồi nhỉ.
Dialogue: 0,0:20:35.77,0:20:38.04,Default,,0000,0000,0000,,Cuộc đột kích này đã khiến tôi nhớ lại.
Dialogue: 0,0:20:38.83,0:20:40.83,Default,,0000,0000,0000,,Bản thân còn non nớt tới mức nào.
Dialogue: 0,0:20:41.51,0:20:44.77,Default,,0000,0000,0000,,Khi đó, tôi chỉ là một người\Ntoàn nhận được giúp đỡ.
Dialogue: 0,0:20:45.76,0:20:48.17,Default,,0000,0000,0000,,Nhưng anh thấy thì khác.
Dialogue: 0,0:20:49.81,0:20:51.72,Default,,0000,0000,0000,,Tôi muốn đuổi theo anh ấy.
Dialogue: 0,0:20:52.51,0:20:54.16,Default,,0000,0000,0000,,Muốn được sánh bước bên anh ấy.
Dialogue: 0,0:20:54.99,0:20:55.82,Default,,0000,0000,0000,,Vì thế...
Dialogue: 0,0:20:58.22,0:20:59.80,Default,,0000,0000,0000,,Tôi muốn mạnh hơn nữa.
Dialogue: 0,0:21:04.86,0:21:07.19,Default,,0000,0000,0000,,Hunter là những kẻ sinh ra để đi săn.
Dialogue: 0,0:21:07.92,0:21:10.20,Default,,0000,0000,0000,,Hầm ngục là thế giới cá lớn nuốt cá bé.
Dialogue: 0,0:21:10.83,0:21:13.23,Default,,0000,0000,0000,,Kẻ đi săn phải chuẩn bị tâm lý\Nsẽ bị biến thành con mồi.
Dialogue: 0,0:21:14.44,0:21:15.05,Default,,0000,0000,0000,,Đúng vậy.
Dialogue: 0,0:21:15.54,0:21:18.40,Default,,0000,0000,0000,,Đó là thế giới mà vị thế\Ncó thể nghịch chuyển bất kỳ lúc nào.
Dialogue: 0,0:21:19.02,0:21:21.43,Default,,0000,0000,0000,,Một thế giới mà cái chết luôn cận kề.
Dialogue: 0,0:21:22.32,0:21:24.81,Default,,0000,0000,0000,,Dẫu vậy, Hunter vẫn sẽ liều mình chiến đấu.
Dialogue: 0,0:21:25.41,0:21:27.29,Default,,0000,0000,0000,,Dù kẻ địch có bao nhiêu,
Dialogue: 0,0:21:27.29,0:21:30.70,Default,,0000,0000,0000,,dù sức mạnh của chúng\Ncó vượt trội cỡ nào...
Dialogue: 0,0:21:31.68,0:21:34.32,Default,,0000,0000,0000,,Mục tiêu chiến đấu\Ncủa mỗi Hunter đều khác nhau.
Dialogue: 0,0:21:35.24,0:21:36.64,Default,,0000,0000,0000,,Vì bảo vệ gia đình...
Dialogue: 0,0:21:37.28,0:21:38.99,Default,,0000,0000,0000,,Vì giữ vững tín niệm...
Dialogue: 0,0:21:39.62,0:21:41.71,Default,,0000,0000,0000,,Vì chứng minh sự tồn tại...
Dialogue: 0,0:21:42.33,0:21:43.81,Default,,0000,0000,0000,,Vì chống lại vận mệnh...
Dialogue: 0,0:21:45.58,0:21:48.52,Default,,0000,0000,0000,,Hunter sẽ luôn đi săn.
Dialogue: 0,0:21:50.00,0:21:53.36,Default,,0000,0000,0000,,Chưa một ai có ý định dừng đi săn.
Dialogue: 0,0:22:14.38,0:22:16.37,Default,,0000,0000,0000,,Con mồi tiếp theo sẽ là gì đây?
