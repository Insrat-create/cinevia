Dialogue: 0,0:00:13.32,0:00:15.16,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لن يقاتل غوتو ريوجي.
Dialogue: 0,0:00:15.16,0:00:19.37,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ومع ذلك، بفضله يمكنني مشاهدة \N‫صيادي الدرجة س وهم يتقاتلون.
Dialogue: 0,0:00:19.77,0:00:20.87,Default,Ma Dongwook,0000,0000,0000,,‫حسناً...
Dialogue: 0,0:00:25.05,0:00:27.01,Default,Ma Dongwook,0000,0000,0000,,‫لنبدأ!
Dialogue: 0,0:02:06.77,0:02:08.27,Default,Tanaka Kenzo,0000,0000,0000,,‫اختبار للقوة؟
Dialogue: 0,0:02:08.74,0:02:10.73,Default,Tanaka Kenzo,0000,0000,0000,,‫أقدّر هذه البساطة!
Dialogue: 0,0:02:10.73,0:02:14.46,Default,Ma Dongwook,0000,0000,0000,,‫لكن من منا أقوى؟!
Dialogue: 0,0:02:22.66,0:02:25.12,DefaultItalics,Lim Tae-gyu,0000,0000,0000,,‫سريع جداً! القتال القريب ليس نقطة قوة لي!
Dialogue: 0,0:02:29.11,0:02:32.38,Default,Lim Tae-gyu,0000,0000,0000,,‫تخصصي هو الهجمات بعيدة المدى!
Dialogue: 0,0:02:34.88,0:02:36.92,Default,Tanaka Kenzo,0000,0000,0000,,‫هوشينو! انتبه!
Dialogue: 0,0:02:36.92,0:02:38.74,Default,Tanaka Kenzo,0000,0000,0000,,‫أسرع واهزمه!
Dialogue: 0,0:02:43.69,0:02:48.95,Default,Choi Jong-in,0000,0000,0000,,‫سيدي الرئيس، عُزّز هذا المبنى بأحجار\N‫سحرة من أعلى جودة، أليس كذلك؟
Dialogue: 0,0:02:48.95,0:02:50.10,Default,Go Gunhee,0000,0000,0000,,‫بالفعل.
Dialogue: 0,0:02:50.10,0:02:53.90,Default,Go Gunhee,0000,0000,0000,,‫ومع ذلك، قد نحتاج إلى إعادة تقييم \N‫مدى متانته الحقيقية.
Dialogue: 0,0:02:54.86,0:02:58.78,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫هؤلاء الرجال هم نخبة النخبة \N‫بين صيادي الدرجة س.
Dialogue: 0,0:02:58.78,0:03:03.41,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫عليّ أن أتحرك وكأنهم يحاولون كسر \N‫معصمي، وليس مجرد الإمساك به!
Dialogue: 0,0:03:07.07,0:03:08.92,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫أظنّ أنّ هذا اسمه كوماموتو أتسوشي.
Dialogue: 0,0:03:09.30,0:03:12.25,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫لا يبدو عدوانياً جداً.
Dialogue: 0,0:03:13.88,0:03:17.34,DefaultItalics,Kumamoto Atsushi,0000,0000,0000,,‫اللعنة. أنا لست مناسباً لهذا على الإطلاق.
Dialogue: 0,0:03:17.34,0:03:19.59,DefaultItalics,Kumamoto Atsushi,0000,0000,0000,,‫أظنني لا أملك الجرأة الكافية لذلك.
Dialogue: 0,0:03:22.06,0:03:26.50,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫قد تكون الفكرة هي استخدامنا لاختباره.
Dialogue: 0,0:03:26.92,0:03:29.27,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫للتأكد من أنه مستعد لمحاربة النمل.
Dialogue: 0,0:03:33.69,0:03:36.19,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫من المفترض أن أكون اختباراً إذًا؟
Dialogue: 0,0:03:36.51,0:03:38.66,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫حان الوقت لمعرفة ما إن كنت ستنجح أو تفشل!
Dialogue: 0,0:03:38.66,0:03:40.68,DefaultItalics,Kumamoto Atsushi,0000,0000,0000,,‫تبًّا! لا أستطيع!
Dialogue: 0,0:03:44.94,0:03:47.08,Default,Park Jongsoo,0000,0000,0000,,‫يا لهم من مجموعة وحوش.
Dialogue: 0,0:03:47.60,0:03:50.15,Default,Park Jongsoo,0000,0000,0000,,‫ما كانت لأملك أي فرصة ودرجتي أ.
Dialogue: 0,0:03:50.15,0:03:51.89,Default,Jung Yoontae,0000,0000,0000,,‫هذا غير صحيح تمامًا!
Dialogue: 0,0:03:51.89,0:03:54.15,Default,Jung Yoontae,0000,0000,0000,,‫أنت قوي بما فيه الكفاية أيها الرئيس!
Dialogue: 0,0:03:56.71,0:03:59.19,Default,Tanaka Kenzo,0000,0000,0000,,‫أعتقد أنني فزت في اختبار القوة.
Dialogue: 0,0:04:00.10,0:04:02.26,Default,Ma Dongwook,0000,0000,0000,,‫لقد أسقطتني أرضًا!
Dialogue: 0,0:04:02.78,0:04:04.60,Default,Ma Dongwook,0000,0000,0000,,‫هذا يحدث لأوّل مرة.
Dialogue: 0,0:04:06.35,0:04:08.31,Default,Hoshino Minoru,0000,0000,0000,,‫يبدو أنني فزت.
Dialogue: 0,0:04:11.32,0:04:13.24,Default,Baek Yoonho,0000,0000,0000,,‫هل ستستمر في الهر—
Dialogue: 0,0:04:16.36,0:04:19.07,Default,Baek Yoonho,0000,0000,0000,,‫هل أبدو أضعف من الصيادة تشا؟
Dialogue: 0,0:04:19.36,0:04:21.20,Default,Baek Yoonho,0000,0000,0000,,‫هذا مهين نوعًا ما...
Dialogue: 0,0:04:22.74,0:04:24.12,DefaultItalics,Tawata Kanae,0000,0000,0000,,‫لا يمكنني التنبؤ بحركتها القادمة!
Dialogue: 0,0:04:24.60,0:04:26.45,DefaultItalics,Tawata Kanae,0000,0000,0000,,‫الراقصة تشا هاي-إن...
Dialogue: 0,0:04:26.94,0:04:31.83,DefaultItalics,Tawata Kanae,0000,0000,0000,,‫رؤيتها تقاتل شخصياً يجعلني \N‫أدرك مدى دقة لقبها!
Dialogue: 0,0:04:35.10,0:04:36.30,Default,Cha Hae-in,0000,0000,0000,,‫لمستك.
Dialogue: 0,0:04:36.77,0:04:38.89,DefaultItalics,Cha Hae-in,0000,0000,0000,,‫من الأفضل أن أساعد الصياد بيك.
Dialogue: 0,0:04:45.51,0:04:46.97,Default,Shimizu Akari,0000,0000,0000,,‫ما كان ذلك؟!
Dialogue: 0,0:04:46.97,0:04:49.98,DefaultItalics,Cha Hae-in,0000,0000,0000,,‫لا، لقد ضربته كردة فعل!
Dialogue: 0,0:04:54.87,0:04:57.19,Default,Shimizu Akari,0000,0000,0000,,‫تبًّا، لقد غضب.
Dialogue: 0,0:04:57.52,0:05:00.90,Default,Fujishima Tatsumi,0000,0000,0000,,‫لا يمكن التنبؤ بما سيفعله الآن.
Dialogue: 0,0:05:00.90,0:05:02.79,Default,Hanekawa,0000,0000,0000,,‫هل نوقفه؟
Dialogue: 0,0:05:03.20,0:05:05.24,Default,Goto Ryuji,0000,0000,0000,,‫فقط إذا بدا أن \N‫شخصًا ما سيتعرض للإصابة.
Dialogue: 0,0:05:09.87,0:05:10.79,DefaultItalics,Cha Hae-in,0000,0000,0000,,‫سريع جداً!
Dialogue: 0,0:05:14.92,0:05:16.34,Default,Shimizu Akari,0000,0000,0000,,‫يبدو الأمر سيئًا!
Dialogue: 0,0:05:22.74,0:05:25.22,Default,Sung Jinwoo,0000,0000,0000,,‫ربما هذا ليس من شأني،
Dialogue: 0,0:05:25.64,0:05:28.68,Default,Sung Jinwoo,0000,0000,0000,,‫لكن لم يعد هذا يبدو كمواجهة ودية.
Dialogue: 0,0:05:28.68,0:05:30.14,Default,Kumamoto Atsushi,0000,0000,0000,,‫من أنت يا هذا؟!
Dialogue: 0,0:05:33.60,0:05:37.11,Default,Shimizu Akari,0000,0000,0000,,‫مستحيل... لقد تمكن من إبعاد \N‫كوماموتو حتى في حالته الهائجة!
Dialogue: 0,0:05:37.39,0:05:40.43,Default,Goto Ryuji,0000,0000,0000,,‫وهذا هو الصياد الذي من المفترض \N‫أنه من نوع السحرة؟
Dialogue: 0,0:05:40.43,0:05:42.32,Default,Hanekawa,0000,0000,0000,,‫نعم، هذا ما سمعت.
Dialogue: 0,0:05:42.63,0:05:45.03,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫يبدو أنني سأضطر إلى معرفة ذلك بنفسي.
Dialogue: 0,0:05:45.42,0:05:48.87,Default,Sung Jinwoo,0000,0000,0000,,‫أيتها الصيادة تشا، أنت مستعدة لتقبل الخسارة، صحيح؟
Dialogue: 0,0:05:49.54,0:05:52.10,Default,Sung Jinwoo,0000,0000,0000,,‫نظرًا لأنّ الصياد بيك يبدو قد انسحب بالفعل.
Dialogue: 0,0:05:52.10,0:05:52.83,Default,Cha Hae-in,0000,0000,0000,,‫نعم.
Dialogue: 0,0:05:54.72,0:05:58.29,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫حتى لو بذلت كلّ ما لدي،\N‫فلن يكون ذلك كافيًا لتتغير النتيجة.
Dialogue: 0,0:06:00.37,0:06:01.88,Default,Hanekawa,0000,0000,0000,,‫أيها الصياد سون.
Dialogue: 0,0:06:02.20,0:06:06.59,Default,Hanekawa,0000,0000,0000,,‫يسألك سيد النقابة غوتو ما إن كنت ترغب في مواجهته.
Dialogue: 0,0:06:06.59,0:06:09.33,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫جسده يشع بالروح القتالية...
Dialogue: 0,0:06:09.33,0:06:11.96,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ربما يريد أن يرى ما لدي.
Dialogue: 0,0:06:13.23,0:06:16.69,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ستكون هذه فرصة جيدة لاختبار القوة \N‫التي اكتسبتها من قلعة الشيطان.
Dialogue: 0,0:06:17.83,0:06:19.84,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫هل ابتسم للتو؟ في وجه فكرة مواجهتي؟
Dialogue: 0,0:06:20.68,0:06:24.19,Default,Hanekawa,0000,0000,0000,,‫قبل الصياد سون تحدّيك يا غوتو-سان.
Dialogue: 0,0:06:24.19,0:06:26.48,Default,Hanekawa,0000,0000,0000,,‫لكن لديه شرط.
Dialogue: 0,0:06:26.48,0:06:27.76,Default,Goto Ryuji,0000,0000,0000,,‫ما هو؟
Dialogue: 0,0:06:27.76,0:06:30.66,Default,Hanekawa,0000,0000,0000,,‫سيوافق على المواجهة شرط ألّا تتهاون.
Dialogue: 0,0:06:33.55,0:06:34.89,Default,Goto Ryuji,0000,0000,0000,,‫مثير للاهتمام.
Dialogue: 0,0:06:35.54,0:06:39.25,DefaultItalicsTop,TV Announcer,0000,0000,0000,,‫الغارة الرابعة على جزيرة جيجو تقترب.
Dialogue: 0,0:06:39.25,0:06:42.23,DefaultItalicsTop,TV Announcer,0000,0000,0000,,‫بعد تشكيل تحالف مع اليابان،
Dialogue: 0,0:06:42.23,0:06:44.84,DefaultItalicsTop,TV Announcer,0000,0000,0000,,‫تجري الآن الاستعدادات لضمان \N‫نتيجة ناجحة.
Dialogue: 0,0:06:43.74,0:06:46.03,Default,Joohee Mom,0000,0000,0000,,‫هل لديك عمل اليوم؟
Dialogue: 0,0:06:46.03,0:06:48.31,Default,Lee Joohee,0000,0000,0000,,‫أنا في إجازة. أخبرتك بالأمس.
Dialogue: 0,0:06:48.31,0:06:49.75,Default,Joohee Mom,0000,0000,0000,,‫حقاً؟
Dialogue: 0,0:06:49.75,0:06:54.93,Default,Joohee Mom,0000,0000,0000,,‫حسناً، الصيادون يعملون بجد، \N‫لذا من الأفضل أن نبذل قصارى جهدنا أيضًا.
Dialogue: 0,0:07:04.62,0:07:07.11,Default,Lee Joohee,0000,0000,0000,,‫مرحبًا. معذرة...
Dialogue: 0,0:07:07.98,0:07:11.43,Default,Lee Joohee,0000,0000,0000,,‫لدي بعض الأسئلة حول \N‫القوات الدفاعية في غارة جيجو.
Dialogue: 0,0:07:12.08,0:07:14.04,Default,Lim Tae-gyu,0000,0000,0000,,‫ما الذي يحدث الآن؟
Dialogue: 0,0:07:14.04,0:07:19.75,Default,Ma Dongwook,0000,0000,0000,,‫هذا هو صياد الدرجة س العاشر الشهير إذًا.\N‫رغبته في مواجهة غوتو تشير إلى أنه مشاكس.
Dialogue: 0,0:07:19.75,0:07:25.68,DefaultItalics,Cha Hae-in,0000,0000,0000,,‫رأيته يقاتل في ديماس من الدرجة أ من قبل،\N‫لكن هل سيكون بخير ضد صياد من الدرجة س؟
Dialogue: 0,0:07:25.68,0:07:29.21,Default,Baek Yoonho,0000,0000,0000,,‫يبدو أنك لا تمانعين التواجد \N‫قرب صيادين آخرين اليوم.
Dialogue: 0,0:07:29.79,0:07:33.08,Default,Cha Hae-in,0000,0000,0000,,‫ليس الأمر وكأنني أستطيع \N‫تغطية أنفي باستمرار في ساحة المعركة.
Dialogue: 0,0:07:33.99,0:07:36.35,Default,Cha Hae-in,0000,0000,0000,,‫أينبغي أن نوقفهما؟
Dialogue: 0,0:07:36.35,0:07:39.94,Default,Baek Yoonho,0000,0000,0000,,‫هذه مواجهة بين صياد اشتباك وساحر في قتال قريب...
Dialogue: 0,0:07:40.31,0:07:42.59,Default,Baek Yoonho,0000,0000,0000,,‫كنت لأفعل عادةً.
Dialogue: 0,0:07:42.59,0:07:45.82,Default,Baek Yoonho,0000,0000,0000,,‫لكنني أفكر في نفس الشيء \N‫الذي تفكرين به أيتها الصيادة تشا.
Dialogue: 0,0:07:47.22,0:07:49.57,Default,Baek Yoonho,0000,0000,0000,,‫لا يسعك سوى أن ترفعي سقف آمالك، أليس كذلك؟
Dialogue: 0,0:07:49.83,0:07:51.72,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫إن كان شكي في محلّه،
Dialogue: 0,0:07:51.72,0:07:55.04,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫وكان الصياد سون مستفاقًا\N‫بقدرة الاستمرار في رفع قوته...
Dialogue: 0,0:07:57.47,0:07:58.54,Default,Sung Jinwoo,0000,0000,0000,,‫حسناً، لنـ—
Dialogue: 0,0:08:03.23,0:08:05.13,Default,Sung Jinwoo,0000,0000,0000,,‫مهلًا يا رجل، لم أكن قد انتهيت بعد.
Dialogue: 0,0:08:05.13,0:08:07.34,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫سرعته ورشاقته...
Dialogue: 0,0:08:07.34,0:08:10.80,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫وهو من نوع السحرة؟ يا لها من مزحة.
Dialogue: 0,0:08:13.35,0:08:15.72,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫لنرَ من تكون حقًّا!
Dialogue: 0,0:08:17.14,0:08:20.80,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫إنّه بالتأكيد متفوق على صيادي الدرجة س الآخرين.
Dialogue: 0,0:08:20.80,0:08:23.86,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لكنه ليس سريعًا لدرجة أني لا أستطيع تفاديه.
Dialogue: 0,0:08:23.86,0:08:25.78,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫يبتسم مجددًا...؟
Dialogue: 0,0:08:25.78,0:08:28.19,Default,Lim Tae-gyu,0000,0000,0000,,‫الهجمات سريعة جدًّا لدرجة أني لا أستطيع متابعتها.
Dialogue: 0,0:08:28.52,0:08:30.40,Default,Ma Dongwook,0000,0000,0000,,‫إنه يقوم بعمل رائع في المراوغة.
Dialogue: 0,0:08:30.40,0:08:33.87,Default,Ma Dongwook,0000,0000,0000,,‫وهذا إنجاز حقيقي \N‫مع هجمات مثل هذه.
Dialogue: 0,0:08:34.14,0:08:36.33,DefaultItalics,Cha Hae-in,0000,0000,0000,,‫إنه لا يراوغ فحسب أيضًا.
Dialogue: 0,0:08:36.88,0:08:38.83,DefaultItalics,Cha Hae-in,0000,0000,0000,,‫إنه يختبر قوة خصمه.
Dialogue: 0,0:08:43.54,0:08:46.38,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫فكرة دورانه حولي تثير أعصابي.
Dialogue: 0,0:08:46.38,0:08:47.79,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫غيرت رأيي.
Dialogue: 0,0:08:48.03,0:08:49.65,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫سأسحقه حقًّا!
Dialogue: 0,0:08:56.72,0:08:58.19,DefaultItalics,Cha Hae-in,0000,0000,0000,,‫أيها الصياد سون!
Dialogue: 0,0:09:03.31,0:09:06.52,Default,Sung Jinwoo,0000,0000,0000,,‫انتبه. كان من الممكن أن يفقد شخص ما عينًا.
Dialogue: 0,0:09:06.52,0:09:09.23,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫لقد أمسك بيدي بدلاً من معصمي.
Dialogue: 0,0:09:09.23,0:09:11.11,Default,Goto Ryuji,0000,0000,0000,,‫هل تلهو معي؟
Dialogue: 0,0:09:11.11,0:09:13.70,Default,Sung Jinwoo,0000,0000,0000,,‫لست متأكدًا مما تقصده، لكن...
Dialogue: 0,0:09:14.38,0:09:16.74,Default,Sung Jinwoo,0000,0000,0000,,‫لو كنت قد أمسكت بمعصمك، \N‫لكان الأمر قد انتهى.
Dialogue: 0,0:09:17.28,0:09:20.08,Default,Sung Jinwoo,0000,0000,0000,,‫وأشك في أن أيًّا منا يريد \N‫أن ينتهي الأمر بهذه السهولة.
Dialogue: 0,0:09:31.55,0:09:33.40,Default,Izawa Ippei,0000,0000,0000,,‫انظرا، بدأ غوتو-سان يصبح جادًّا!
Dialogue: 0,0:09:33.40,0:09:36.55,Default,Baek Yoonho,0000,0000,0000,,‫إن استمرا في هذا، فقد ينتهي\N‫الأمر بإصابة كليهما بإصابات بليغة.
Dialogue: 0,0:09:45.40,0:09:46.65,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫جليد؟
Dialogue: 0,0:09:47.42,0:09:48.69,Default,Baek Yoonho,0000,0000,0000,,‫أيها الصياد سون!
Dialogue: 0,0:09:48.97,0:09:49.90,Default,Runo,0000,0000,0000,,‫غوتو-سان!
Dialogue: 0,0:09:49.90,0:09:54.32,Default,Baek Yoonho,0000,0000,0000,,‫لنوقف الأمر. إذا استمر هذا، \N‫فسيخرج الأمر عن السيطرة!
Dialogue: 0,0:09:54.75,0:09:57.03,Default,Baek Yoonho,0000,0000,0000,,‫أخبره بإيقاف المواجهة!
Dialogue: 0,0:09:57.03,0:09:58.49,Default,Hanekawa,0000,0000,0000,,‫حـ-حسنًا!
Dialogue: 0,0:10:01.03,0:10:02.92,Default,Baek Yoonho,0000,0000,0000,,‫هل أفسدت متعتك؟
Dialogue: 0,0:10:02.92,0:10:03.84,Default,Sung Jinwoo,0000,0000,0000,,‫كلا.
Dialogue: 0,0:10:04.83,0:10:09.34,Default,Ma Dongwook,0000,0000,0000,,‫لقد قاتلت غوتو العظيم، ولم \N‫يكلفك ذلك سوى خدش! أنت جيد جدًّا.
Dialogue: 0,0:10:12.12,0:10:15.68,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لقد شعرت بالحماسة قليلاً. لكن...
Dialogue: 0,0:10:16.34,0:10:19.68,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫أصبحت أعرف الآن مهارات الجميع هنا.
Dialogue: 0,0:10:19.68,0:10:22.90,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫تمكنت أيضًا من إرسال جنود \N‫إلى خمسة من ظلالهم.
Dialogue: 0,0:10:24.89,0:10:29.34,Default,Go Gunhee,0000,0000,0000,,‫سأرسل المعلومات عن الصيادين \N‫المشاركين في الغارة لاحقًا.
Dialogue: 0,0:10:29.34,0:10:32.70,Default,Hanekawa,0000,0000,0000,,‫أرسلها رجاءً إلى نائب سيد نقابتنا أيضًا.
Dialogue: 0,0:10:32.70,0:10:33.86,Default,Go Gunhee,0000,0000,0000,,‫بالطبع.
Dialogue: 0,0:10:38.76,0:10:39.89,Default,Sung Jinwoo,0000,0000,0000,,‫أيها الرئيس غو.
Dialogue: 0,0:10:41.18,0:10:43.75,Default,Go Gunhee,0000,0000,0000,,‫ما الأمر أيها الصياد سون؟
Dialogue: 0,0:10:44.17,0:10:46.25,Default,Sung Jinwoo,0000,0000,0000,,‫بشأن غارة جزيرة جيجو...
Dialogue: 0,0:10:49.17,0:10:53.17,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫ريجي. أحد الصيادين هنا جيد جدًّا.
Dialogue: 0,0:10:54.38,0:10:57.39,Default,Sugimoto Reiji,0000,0000,0000,,‫لكني أشك أنّه يشكّل تحدّيًّا حقيقيًّا\N‫لسيد نقابة السيف المسلول.
Dialogue: 0,0:10:57.39,0:10:58.82,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫أشك في ذلك.
Dialogue: 0,0:10:58.82,0:11:00.41,Default,Sugimoto Reiji,0000,0000,0000,,‫من هو؟
Dialogue: 0,0:11:00.41,0:11:04.68,DefaultItalics,Goto Ryuji,0000,0000,0000,,‫سون جينوو. إنّه مستفاق أصبح من الدرجة س مؤخّرًا.
Dialogue: 0,0:11:05.71,0:11:07.32,Default,Sugimoto Reiji,0000,0000,0000,,‫هذا غريب.
Dialogue: 0,0:11:07.32,0:11:10.92,Default,Sugimoto Reiji,0000,0000,0000,,‫لا أرى اسمه في \N‫قائمة المشاركين في الغارة.
Dialogue: 0,0:11:10.92,0:11:11.77,Default,Goto Ryuji,0000,0000,0000,,‫ماذا؟
Dialogue: 0,0:11:13.73,0:11:17.41,Default,Cha Hae-in,0000,0000,0000,,‫لن يرافقنا الصياد سون في الغارة حسبما أرى.
Dialogue: 0,0:11:17.41,0:11:20.28,Default,Choi Jong-in,0000,0000,0000,,‫أنا متأكد من أن لديه أسبابه.
Dialogue: 0,0:11:20.28,0:11:21.41,Default,Choi Jong-in,0000,0000,0000,,‫ومع ذلك...
Dialogue: 0,0:11:21.67,0:11:24.37,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫اسم بيونغ-غو ليس موجودًا أيضًا.
Dialogue: 0,0:11:24.63,0:11:25.71,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫لكن...
Dialogue: 0,0:11:25.71,0:11:29.92,Default,Choi Jong-in,0000,0000,0000,,‫لدينا بالفعل 15 صيادًا من الدرجة س.
Dialogue: 0,0:11:30.26,0:11:32.13,Default,Choi Jong-in,0000,0000,0000,,‫أنا متأكد أننا هذه المرة...
Dialogue: 0,0:11:36.75,0:11:38.64,Default,Baek Yoonho,0000,0000,0000,,‫سوف ننتصر!
Dialogue: 0,0:11:41.60,0:11:42.48,Default,Sung Jinwoo,0000,0000,0000,,‫لقد عدت.
Dialogue: 0,0:11:42.48,0:11:44.68,Default,Sung Jinah,0000,0000,0000,,‫تأخرت يا أخي!
Dialogue: 0,0:11:45.84,0:11:47.64,Default,Park Kyunghye,0000,0000,0000,,‫أهلًا بعودتك يا جينوو.
Dialogue: 0,0:11:47.64,0:11:49.65,Default,Park Kyunghye,0000,0000,0000,,‫العشاء جاهز.
Dialogue: 0,0:11:51.17,0:11:52.18,Default,Sung Jinwoo,0000,0000,0000,,‫لقد عدت.
Dialogue: 0,0:11:53.67,0:11:58.08,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫استيقظت أميّ من غيبوبة دامت\N‫أربع سنوات. إنها بحاجة لي.
Dialogue: 0,0:11:58.87,0:12:00.28,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ولهذا السبب...
Dialogue: 0,0:12:00.90,0:12:02.74,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫لن أذهب إلى جزيرة جيجو.
Dialogue: 0,0:12:06.70,0:12:10.67,DefaultItalics,Queen Ant,0000,0000,0000,,‫بدؤوا بالتهاب بعضهم بعضًا بسبب نقص الفرائس.
Dialogue: 0,0:12:11.55,0:12:15.95,DefaultItalics,Queen Ant,0000,0000,0000,,‫لا يوجد طعام كافٍ هنا \N‫ليتغذى عليه أتباعي.
Dialogue: 0,0:12:16.83,0:12:18.55,DefaultItalics,Queen Ant,0000,0000,0000,,‫هذا ليس جيّدًا.
Dialogue: 0,0:12:18.93,0:12:20.95,DefaultItalics,Queen Ant,0000,0000,0000,,‫يجب أن نغادر هذه الجزيرة.
Dialogue: 0,0:12:22.01,0:12:24.34,DefaultItalics,Queen Ant,0000,0000,0000,,‫أحتاج إلى مولود أقوى...
Dialogue: 0,0:12:24.34,0:12:29.76,DefaultItalics,Queen Ant,0000,0000,0000,,‫طفل أقوى من أي أحد آخر\N‫قادر على قيادة مملكتنا.
Dialogue: 0,0:13:05.26,0:13:08.22,Default,Queen Ant,0000,0000,0000,,‫كن قويًّا يا بُني.
Dialogue: 0,0:13:15.63,0:13:18.78,DefaultItalics,TV Announcer,0000,0000,0000,,‫كانت وحوش النمل تتطور بمعدّل مقلق.
Dialogue: 0,0:13:19.18,0:13:22.66,DefaultItalics,TV Announcer,0000,0000,0000,,‫مع أنها كانت تزحف على الأرض \N‫خلال الغارة الثالثة على جزيرة جيجو،
Dialogue: 0,0:13:23.04,0:13:26.16,DefaultItalics,TV Announcer,0000,0000,0000,,‫فكما يمكنكم أن تروا في هذا المقطع الذي التُقط مؤخّرًا،
Dialogue: 0,0:13:26.16,0:13:27.96,DefaultItalics,TV Announcer,0000,0000,0000,,‫لقد اتخذت مظهرًا شبيهًا بالبشر أكثر
Dialogue: 0,0:13:27.96,0:13:30.62,DefaultItalics,TV Announcer,0000,0000,0000,,‫بالإضافة إلى نمو \N‫أجنحة ضخمة على ظهورها.
Dialogue: 0,0:13:31.05,0:13:32.98,DefaultItalics,TV Announcer,0000,0000,0000,,‫بدأت جمعية الصيادين في صياغة
Dialogue: 0,0:13:32.98,0:13:35.66,DefaultItalics,TV Announcer,0000,0000,0000,,‫استراتيجية للتعامل مع \N‫هذه الوحوش الجديدة استجابةً لذلك.
Dialogue: 0,0:13:39.38,0:13:40.74,Default,Kid B,0000,0000,0000,,‫ها أنت ذا أيها الوحش!
Dialogue: 0,0:13:40.74,0:13:42.89,Default,Kid B,0000,0000,0000,,‫عليك الآن مواجهة صياد من الدرجة س!
Dialogue: 0,0:13:46.30,0:13:48.47,Default,Yoo Jinho,0000,0000,0000,,‫هذه فكرة سيئة! إنها خطيرة للغاية.
Dialogue: 0,0:13:48.78,0:13:52.23,Default,Han Song-yi,0000,0000,0000,,‫لماذا لا يجب أن أنضم إلى قوة الدفاع؟
Dialogue: 0,0:13:52.23,0:13:55.02,Default,Yoo Jinho,0000,0000,0000,,‫أوّلًا لأنّك من الدرجة هـ يا هان-سان...
Dialogue: 0,0:13:55.69,0:13:58.19,Default,Han Song-yi,0000,0000,0000,,‫هكذا إذًا؟!
Dialogue: 0,0:13:56.78,0:13:59.81,DefaultTop,Yoo Jinho,0000,0000,0000,,‫آه، آه، آه! أنا آسف!
Dialogue: 0,0:13:59.81,0:14:03.79,DefaultItalics,TV Announcer,0000,0000,0000,,‫كإجراء مضاد ضد وصول حتى نملة واحدة \N‫إلى البر الرئيسي،
Dialogue: 0,0:14:03.79,0:14:08.46,DefaultItalics,TV Announcer,0000,0000,0000,,‫يتم تجنيد الصيادين للواجب الدفاعي.
Dialogue: 0,0:14:13.30,0:14:15.25,DefaultItalics,Go Gunhee,0000,0000,0000,,‫غدًا هو يوم...
Dialogue: 0,0:14:15.68,0:14:17.99,DefaultItalics,Go Gunhee,0000,0000,0000,,‫غارة جزيرة جيجو.
Dialogue: 0,0:14:21.73,0:14:23.29,DefaultItalics,Operator A,0000,0000,0000,,‫هنا الأسطول الأول.
Dialogue: 0,0:14:23.29,0:14:25.97,DefaultItalics,Operator A,0000,0000,0000,,‫لقد وصلنا إلى وجهتنا \N‫في محيط جزيرة جيجو.
Dialogue: 0,0:14:26.37,0:14:28.93,DefaultItalics,Operator B,0000,0000,0000,,‫هنا تقرير الأسطول الثاني. لقد وصلنا.
Dialogue: 0,0:14:29.42,0:14:32.82,DefaultItalics,Operator C,0000,0000,0000,,‫هنا الأسطول الثالث. نحن نقترب من المحيط.
Dialogue: 0,0:14:32.82,0:14:37.64,DefaultItalics,Operator D,0000,0000,0000,,‫هنا الأسطول الرابع. نحن في الطريق. \N‫نتوقع الوصول خلال خمس دقائق.
Dialogue: 0,0:14:38.65,0:14:42.55,Default,Jung Yoontae,0000,0000,0000,,‫سيدي، هل تعتقد أننا \N‫أقوياء بما يكفي لمحاربة النمل؟
Dialogue: 0,0:14:42.55,0:14:45.41,Default,Park Jongsoo,0000,0000,0000,,‫لا توجد طريقة لمعرفة ذلك حتى نجرب.
Dialogue: 0,0:14:45.41,0:14:49.30,Default,Park Jongsoo,0000,0000,0000,,‫لكننا أُرسلنا إلى هن في حالة الطوارئ.
Dialogue: 0,0:14:49.30,0:14:51.66,Default,Park Jongsoo,0000,0000,0000,,‫يجب أن نمنع أولئك الزاحفين \N‫المخيفين من الوصول إلى البر الرئيسي.
Dialogue: 0,0:14:51.66,0:14:53.26,Default,Jung Yoontae,0000,0000,0000,,‫أنت رائع يا سيدي!
Dialogue: 0,0:14:53.26,0:14:56.58,Default,Jung Yoontae,0000,0000,0000,,‫سأتبعك لبقية حياتي!
Dialogue: 0,0:14:58.75,0:15:01.34,Default,Ma Dongwook,0000,0000,0000,,‫اعتني بالأمور من أجلي.
Dialogue: 0,0:15:01.70,0:15:03.97,Default,Vice Guildmaster,0000,0000,0000,,‫أشك في أن الأمر سيصل إلى ذلك.
Dialogue: 0,0:15:03.97,0:15:05.91,Default,Vice Guildmaster,0000,0000,0000,,‫ربما سأقضي اليوم سارحة...
Dialogue: 0,0:15:05.91,0:15:08.05,Default,Ma Dongwook,0000,0000,0000,,‫لا يمكن أن نكون متأكدين!
Dialogue: 0,0:15:08.05,0:15:11.16,Default,Ma Dongwook,0000,0000,0000,,‫كما أن استعداد نائبي في النقابة
Dialogue: 0,0:15:11.16,0:15:13.76,Default,Ma Dongwook,0000,0000,0000,,‫يعني أن بإمكاني أن أرتاح عند دخولي للمعركة.
Dialogue: 0,0:15:15.80,0:15:17.46,Default,Vice Guildmaster,0000,0000,0000,,‫كن حذرًا.
Dialogue: 0,0:15:19.15,0:15:22.30,Default,Lim Tae-gyu,0000,0000,0000,,‫لمَ مينسون متمركز في المقدمة هنا؟!
Dialogue: 0,0:15:22.30,0:15:24.44,Default,Lim Tae-gyu,0000,0000,0000,,‫سيكون الأمر سيئاً إذا \N‫تصاعدت الأمور فجأة!
Dialogue: 0,0:15:24.44,0:15:26.41,Default,Lim Tae-gyu,0000,0000,0000,,‫أرسلوه إلى الخلف أكثر!
Dialogue: 0,0:15:43.87,0:15:46.26,Default,Woo Jinchul,0000,0000,0000,,‫توصلت جميع الفرق.
Dialogue: 0,0:15:46.26,0:15:50.43,Default,Woo Jinchul,0000,0000,0000,,‫كل من خفر سواحل البر الرئيسي\N‫وصيادي جزيرة جيجو مستعدون.
Dialogue: 0,0:15:50.86,0:15:54.13,Default,Woo Jinchul,0000,0000,0000,,‫نجحت القوة المشتتة \N‫في الهبوط على الجزيرة.
Dialogue: 0,0:15:56.35,0:16:01.69,Default,Go Gunhee,0000,0000,0000,,‫عدد كبير من الصيادين \N‫استجاب لنداء الواجب هذه المرة.
Dialogue: 0,0:16:02.38,0:16:06.86,DefaultItalics,Go Gunhee,0000,0000,0000,,‫ومن المريح أنه قرر الانضمام أيضًا.
Dialogue: 0,0:16:13.83,0:16:14.98,Default,Baek Yoonho,0000,0000,0000,,‫بيونغ-غو!
Dialogue: 0,0:16:15.80,0:16:18.04,Default,Baek Yoonho,0000,0000,0000,,‫لم أظنّ أنّك ستأتي.
Dialogue: 0,0:16:18.04,0:16:22.50,Default,Min Byung-gu,0000,0000,0000,,‫أدركت أنك ربما ستموت خلال ثوانٍ \N‫بدون معالج يراقب ظهرك.
Dialogue: 0,0:16:22.94,0:16:26.09,Default,Min Byung-gu,0000,0000,0000,,‫فأنت تندفع مباشرة عندما ترى الوحوش كما تعلم.
Dialogue: 0,0:16:26.09,0:16:29.75,Default,Baek Yoonho,0000,0000,0000,,‫فقط لأنّها قد تقتلك إن لم أفعل!
Dialogue: 0,0:16:35.93,0:16:38.39,Default,Goto Ryuji,0000,0000,0000,,‫هذه المدينة في وسط الجزيرة.
Dialogue: 0,0:16:38.39,0:16:41.10,Default,Goto Ryuji,0000,0000,0000,,‫ألفا هنا. إلى جميع الصيادين، استجيبوا.
Dialogue: 0,0:16:41.10,0:16:43.40,Default,Tawata Kanae,0000,0000,0000,,‫برافو هنا، في الموقع.
Dialogue: 0,0:16:43.40,0:16:45.69,Default,Fujishima Tatsumi,0000,0000,0000,,‫تشارلي، في الموقع.
Dialogue: 0,0:16:45.69,0:16:48.24,Default,Izawa Ippei,0000,0000,0000,,‫دلتا، جاهزون.
Dialogue: 0,0:16:50.48,0:16:51.75,Default,Baek Yoonho,0000,0000,0000,,‫بث مباشر؟
Dialogue: 0,0:16:51.75,0:16:55.91,Default,Cameraman,0000,0000,0000,,‫صحيح. حسنًا، مع تأخير عشر دقائق \N‫في حالة وقوع أي حوادث.
Dialogue: 0,0:16:55.91,0:16:58.45,Default,Cameraman,0000,0000,0000,,‫بصفتي مصوراً لقسم \N‫اتصالات الصيادين،
Dialogue: 0,0:16:58.45,0:17:01.45,Default,Cameraman,0000,0000,0000,,‫سأحرص على توثيق \N‫هذه المعركة للناس!
Dialogue: 0,0:17:02.25,0:17:06.60,Default,Ma Dongwook,0000,0000,0000,,‫يمكن للصياد أن يبذل \N‫قصارى جهده عندما يكون لديه شيء يحميه!
Dialogue: 0,0:17:06.60,0:17:09.56,Default,Ma Dongwook,0000,0000,0000,,‫ومع ذلك، سيكون هذا شديد الحدة.
Dialogue: 0,0:17:09.56,0:17:10.59,Default,Ma Dongwook,0000,0000,0000,,‫هل ستكون بخير؟
Dialogue: 0,0:17:10.59,0:17:14.22,Default,Cameraman,0000,0000,0000,,‫لا تقلق. الطريف في الأمي أني من الدرجة أ.
Dialogue: 0,0:17:14.22,0:17:16.10,Default,Cameraman,0000,0000,0000,,‫أنا معتاد على التصوير في الظروف الخطرة.
Dialogue: 0,0:17:16.10,0:17:18.15,Default,Ma Dongwook,0000,0000,0000,,‫من الجيد معرفة ذلك.
Dialogue: 0,0:17:18.67,0:17:23.98,Default,Ma Dongwook,0000,0000,0000,,‫قد تكون هذه آخر فرصة للعامة\N‫لمشاهدة غارة من الدرجة س.
Dialogue: 0,0:17:24.41,0:17:26.69,Default,Ma Dongwook,0000,0000,0000,,‫بل من الأفضل أن تكون كذلك.
Dialogue: 0,0:17:27.28,0:17:29.90,Default,Ma Dongwook,0000,0000,0000,,‫لأننا هذه المرة سننهي الأمر نهائيًّا!
Dialogue: 0,0:17:30.29,0:17:34.87,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫إن لم ننجح في هذا، فقد\N‫تُباد بلادنا بأكملها من على وجه الأرض.
Dialogue: 0,0:17:34.87,0:17:38.45,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫نحن بحاجة إلى بطل.
Dialogue: 0,0:17:39.24,0:17:43.16,Default,Woo Jinchul,0000,0000,0000,,‫فريق الهجوم مستعدّ للتحرك.
Dialogue: 0,0:17:43.59,0:17:48.75,Default,Go Gunhee,0000,0000,0000,,‫حسنًا، فلتبدأ الغارة الرابعة على جزيرة جيجو إذًا!
Dialogue: 0,0:17:48.75,0:17:50.46,Default,Goto Ryuji,0000,0000,0000,,‫إلى جميع الصيادين، أطلقوا كامل قواكم!
Dialogue: 0,0:17:50.46,0:17:51.76,Default,Tawata/Fujishima/Izawa,0000,0000,0000,,‫مفهوم!
Dialogue: 0,0:17:52.42,0:17:55.50,Default,Choi Jong-in,0000,0000,0000,,‫بدأت القوة المشتّتة تتحرك.
Dialogue: 0,0:17:55.50,0:17:57.43,Default,Baek Yoonho,0000,0000,0000,,‫يا لها من قوة سحرية هائلة.
Dialogue: 0,0:17:57.43,0:17:59.52,Default,Baek Yoonho,0000,0000,0000,,‫وها هم النمل.
Dialogue: 0,0:18:00.72,0:18:03.11,Default,Lim Tae-gyu,0000,0000,0000,,‫بعضها يتجه نحونا أيضًا!
Dialogue: 0,0:18:03.11,0:18:04.94,Default,Choi Jong-in,0000,0000,0000,,‫افتح الباب رجاءً.
Dialogue: 0,0:18:04.94,0:18:06.87,Default,Choi Jong-in,0000,0000,0000,,‫سأتعامل معها.
Dialogue: 0,0:18:16.45,0:18:17.57,Default,Min Byung-gu,0000,0000,0000,,‫مذهل...
Dialogue: 0,0:18:18.14,0:18:19.95,Default,Choi Jong-in,0000,0000,0000,,‫هناك عدد كبير.
Dialogue: 0,0:18:21.48,0:18:23.60,Default,Choi Jong-in,0000,0000,0000,,‫أخشى أنني سأحتاج للتعامل بخشونة أكبر.
Dialogue: 0,0:18:31.14,0:18:35.05,DefaultItalics,Choi Jong-in,0000,0000,0000,,‫بعد كل هذا الوقت، عدتُ أخيرًا.
Dialogue: 0,0:18:35.48,0:18:36.76,DefaultItalics,Choi Jong-in,0000,0000,0000,,‫عدت إلى هذه الجزيرة.
Dialogue: 0,0:18:39.64,0:18:42.43,Default,Ma Dongwook,0000,0000,0000,,‫كما هو متوقع من السلاح المطلق! يسعدني وجوده هنا.
Dialogue: 0,0:18:43.00,0:18:45.85,Default,Choi Jong-in,0000,0000,0000,,‫حسنًا يا جماعة، لننزل.
Dialogue: 0,0:18:48.31,0:18:53.15,Default,Ma Dongwook,0000,0000,0000,,‫يجب أن يكون الصيادون اليابانيون قادرين \N‫على تشتيت النمل لمدة ساعة تقريبًا.
Dialogue: 0,0:18:53.48,0:18:57.90,Default,Ma Dongwook,0000,0000,0000,,‫مما يعني أن هذا هو موعدنا النهائي \N‫للقضاء على الملكة.
Dialogue: 0,0:18:57.90,0:18:59.19,Default,Ma Dongwook,0000,0000,0000,,‫هل الجميع مستعدون؟
Dialogue: 0,0:19:00.66,0:19:02.68,Default,Ma Dongwook,0000,0000,0000,,‫يمكننا فعل هذا!
Dialogue: 0,0:19:03.75,0:19:04.91,Default,Ma Dongwook,0000,0000,0000,,‫لنذهب!
Dialogue: 0,0:19:07.29,0:19:11.49,Default,Sugimoto Reiji,0000,0000,0000,,‫نحن مستعدون للبدء أيضًا.\N‫شغلوا إشارة التشويش.
Dialogue: 0,0:19:11.49,0:19:13.26,Default,Navy A,0000,0000,0000,,‫بدء تشويش الإشارة.
Dialogue: 0,0:19:15.47,0:19:20.18,DefaultItalics,Sugimoto Reiji,0000,0000,0000,,‫لن يتمكن النمل الآن من اكتشاف \N‫إشارة استغاثة الملكة.
Dialogue: 0,0:19:22.56,0:19:25.27,Default,Tawata Kanae,0000,0000,0000,,‫كوماموتو! إذا واصلت التردد، \N‫فسوف تموت!
Dialogue: 0,0:19:28.55,0:19:31.09,Default,Shimizu Akari,0000,0000,0000,,‫ألن يكون من الأسرع لنا \N‫أن نقتل جميع النمل
Dialogue: 0,0:19:31.09,0:19:34.57,Default,Shimizu Akari,0000,0000,0000,,‫بدلاً من انتظار الآخرين \N‫للقضاء على الملكة؟
Dialogue: 0,0:19:34.57,0:19:36.75,Default,Fujishima Tatsumi,0000,0000,0000,,‫ربما. أين كينزو؟
Dialogue: 0,0:19:37.39,0:19:40.32,Default,Shimizu Akari,0000,0000,0000,,‫يعبث هناك. إنه مثل طفل صغير.
Dialogue: 0,0:19:40.67,0:19:42.35,Default,KEI,0000,0000,0000,,‫هل رأيت ذلك اللهب؟
Dialogue: 0,0:19:42.35,0:19:44.66,Default,Izawa Ippei,0000,0000,0000,,‫لا بد أنه ذلك الرجل تشوي، أليس كذلك؟
Dialogue: 0,0:19:44.66,0:19:48.33,Default,KEI,0000,0000,0000,,‫هل تظنني سأتمكن من هزيمته إن قاتلته؟
Dialogue: 0,0:19:48.33,0:19:50.83,Default,Izawa Ippei,0000,0000,0000,,‫أشعر بالتردد حيال هذا الموضوع.
Dialogue: 0,0:19:52.79,0:19:57.19,Default,Choi Jong-in,0000,0000,0000,,‫العش تحت السيطرة. يجب أن نستمر \N‫في التقدم بينما يستمر التشتيت في العمل.
Dialogue: 0,0:19:57.19,0:19:59.76,Default,Baek Yoonho,0000,0000,0000,,‫لكن هذه الأنفاق كثيرة للغاية.
Dialogue: 0,0:19:59.76,0:20:03.59,Default,Baek Yoonho,0000,0000,0000,,‫كيف سنجد النفق \N‫الذي يؤدي إلى الملكة؟
Dialogue: 0,0:20:11.74,0:20:13.99,Default,Baek Yoonho,0000,0000,0000,,‫ما كان ذلك؟ كن حذرًا!
Dialogue: 0,0:20:13.99,0:20:17.65,Default,Choi Jong-in,0000,0000,0000,,‫ليس لدينا الوقت للبحث فيها جميعًا.
Dialogue: 0,0:20:18.26,0:20:21.87,Default,Choi Jong-in,0000,0000,0000,,‫نحتاج فقط إلى العثور على النفق \N‫الذي يؤدي إلى أعمق نقطة تحت الأرض، صحيح؟
Dialogue: 0,0:20:22.28,0:20:24.27,Default,Choi Jong-in,0000,0000,0000,,‫أعتقد أنه ذاك.
Dialogue: 0,0:20:30.80,0:20:32.84,Default,Sung Jinwoo,0000,0000,0000,,‫أنهيت المهمة اليومية.
Dialogue: 0,0:20:33.30,0:20:36.00,Default,Sung Jinwoo,0000,0000,0000,,‫لا يوجد أحد هنا اليوم أيضًا.
Dialogue: 0,0:20:37.97,0:20:42.24,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫جميع صيادي الدرجة س في هذه الغارة أقوياء.
Dialogue: 0,0:20:42.70,0:20:45.09,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫ينبغي أن يتمكنوا من تولي الأمر بسهولة.
Dialogue: 0,0:20:45.85,0:20:47.46,DefaultItalics,Sung Jinwoo,0000,0000,0000,,‫حتى من دوني.
Dialogue: 0,0:20:50.85,0:20:53.71,Default,Min Byung-gu,0000,0000,0000,,‫وهل الملكة موجودة هنا حقًّا؟
Dialogue: 0,0:20:53.71,0:20:55.86,Default,Min Byung-gu,0000,0000,0000,,‫ربما تخلّت عنهم وهربت.
Dialogue: 0,0:20:55.86,0:20:58.57,Default,Baek Yoonho,0000,0000,0000,,‫إنها جزيرة. \N‫لا يوجد مكان تذهب إليه.
Dialogue: 0,0:20:58.57,0:21:01.03,Default,Choi Jong-in,0000,0000,0000,,‫رفاق، انظروا إلى هذا.
Dialogue: 0,0:21:04.42,0:21:06.14,Default,Min Byung-gu,0000,0000,0000,,‫إنّها غرفة بيض!
Dialogue: 0,0:21:06.14,0:21:08.66,Default,Choi Jong-in,0000,0000,0000,,‫ينبغي أن تكون غرفة الملكة قريبة.
Dialogue: 0,0:21:09.94,0:21:11.16,Default,Cha Hae-in,0000,0000,0000,,‫انظروا هناك!
Dialogue: 0,0:21:12.05,0:21:13.33,Default,Cha Hae-in,0000,0000,0000,,‫تلك البيضة...
Dialogue: 0,0:21:13.69,0:21:16.73,Default,Min Byung-gu,0000,0000,0000,,‫مستحيل... تلك بيضة نملة؟
Dialogue: 0,0:21:16.73,0:21:18.47,Default,Min Byung-gu,0000,0000,0000,,‫بهذا الحجم؟!
Dialogue: 0,0:21:18.87,0:21:23.47,Default,Baek Yoonho,0000,0000,0000,,‫نحن هنا من أجل الملكة. ركّزوا على ذلك.
Dialogue: 0,0:21:24.09,0:21:26.96,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫لكني لا ألومه على ارتباكه.
Dialogue: 0,0:21:26.96,0:21:29.06,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫يبدو أن لديهم قدرة لا حدود لها \N‫على التطور.
Dialogue: 0,0:21:29.59,0:21:34.31,DefaultItalics,Baek Yoonho,0000,0000,0000,,‫وإن كانت هناك نملة وُلدت من بيضة بذلك الحجم...
Dialogue: 0,0:21:35.59,0:21:36.52,Default,Tanaka Kenzo,0000,0000,0000,,‫تبًّا...
Dialogue: 0,0:21:36.91,0:21:39.99,Default,Tanaka Kenzo,0000,0000,0000,,‫هذه الحشرات قوية. \N‫نالت إحداها من كتفي.
Dialogue: 0,0:21:39.99,0:21:43.59,Default,Shimizu Akari,0000,0000,0000,,‫هل تريدني أن أشفيك؟ \N‫هذا إن افترضت أنّك تستطيع دفع الثمن!
Dialogue: 0,0:21:43.59,0:21:46.74,Default,Tanaka Kenzo,0000,0000,0000,,‫كفي عن العبث واشفيني يا شيميزو.
Dialogue: 0,0:21:46.74,0:21:48.61,Default,Shimizu Akari,0000,0000,0000,,‫لكن هناك شيء أريده.
Dialogue: 0,0:21:48.61,0:21:50.75,Default,Shimizu Akari,0000,0000,0000,,‫وليس المال هذه المرة.
Dialogue: 0,0:21:52.11,0:21:53.74,Default,Tanaka Kenzo,0000,0000,0000,,‫المزيد قادمون...
Dialogue: 0,0:21:54.11,0:21:57.25,Default,Tanaka Kenzo,0000,0000,0000,,‫حسناً. ماذا تريد—
