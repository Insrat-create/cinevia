Dialogue: 0,0:00:13.35,0:00:14.90,Default,,0000,0000,0000,,Goto Ryuji không ra đấu sao.
Dialogue: 0,0:00:15.28,0:00:19.38,Default,,0000,0000,0000,,Mà cũng nhờ vậy có thể quan sát\Ncấp S chiến đấu với nhau.
Dialogue: 0,0:00:19.83,0:00:21.00,Default,,0000,0000,0000,,Giờ thì...
Dialogue: 0,0:00:25.02,0:00:26.69,Default,,0000,0000,0000,,Bắt đầu thôi nhỉ!
Dialogue: 0,0:00:35.66,0:00:39.37,Default,,0000,0000,0000,,SOLO LEVELING PHẦN 2\N-VÙNG LÊN TỪ BÓNG TỐI-
Dialogue: 0,0:02:06.93,0:02:08.30,Default,,0000,0000,0000,,Đọ sức mạnh sao?
Dialogue: 0,0:02:08.84,0:02:10.65,Default,,0000,0000,0000,,Dễ hiểu như này thật đỡ quá!
Dialogue: 0,0:02:10.77,0:02:14.51,Default,,0000,0000,0000,,Nào, để xem ai mạnh hơn!
Dialogue: 0,0:02:22.73,0:02:23.66,Default,,0000,0000,0000,,Nhanh quá!
Dialogue: 0,0:02:23.69,0:02:24.97,Default,,0000,0000,0000,,Cận chiến thì bất lợi!
Dialogue: 0,0:02:29.01,0:02:32.70,Default,,0000,0000,0000,,Sở trường của mình là tấn công tầm xa mà!
Dialogue: 0,0:02:34.91,0:02:35.81,Default,,0000,0000,0000,,Hoshino!
Dialogue: 0,0:02:35.82,0:02:36.85,Default,,0000,0000,0000,,Như vậy nguy hiểm đó!
Dialogue: 0,0:02:36.90,0:02:38.53,Default,,0000,0000,0000,,Mau hạ gục tên đó đi!
Dialogue: 0,0:02:43.76,0:02:48.75,Default,,0000,0000,0000,,Cơ sở này được gia cường bằng đá ma thuật\Nloại cao cấp nhất phải không hội trưởng?
Dialogue: 0,0:02:49.07,0:02:49.76,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:02:50.16,0:02:54.20,Default,,0000,0000,0000,,Nhưng với cường độ này\Ncó vẻ phải xem xét lại rồi.
Dialogue: 0,0:02:55.10,0:02:58.37,Default,,0000,0000,0000,,Đối phương là những Hunter\Nhàng đầu thuộc cấp S.
Dialogue: 0,0:02:58.95,0:03:03.38,Default,,0000,0000,0000,,Phải sẵn sàng tinh thần không chỉ\Nnắm cổ tay mà có khi phải bẻ gãy!
Dialogue: 0,0:03:07.13,0:03:09.14,Default,,0000,0000,0000,,Kumamoto phải không nhỉ?
Dialogue: 0,0:03:09.14,0:03:12.03,Default,,0000,0000,0000,,Có vẻ người này\Nkhông giống kiểu hiếu chiến.
Dialogue: 0,0:03:14.23,0:03:15.17,Default,,0000,0000,0000,,Chết tiệt.
Dialogue: 0,0:03:15.24,0:03:17.12,Default,,0000,0000,0000,,Như này đấu sao lại.
Dialogue: 0,0:03:17.40,0:03:19.61,Default,,0000,0000,0000,,Quả nhiên là tim mình không chịu được!
Dialogue: 0,0:03:22.15,0:03:26.15,Default,,0000,0000,0000,,Có thể Goto muốn dùng người bên mình\Nđể thử sức của cậu ta...
Dialogue: 0,0:03:26.96,0:03:29.09,Default,,0000,0000,0000,,Hoặc dò xem\Ncó quyết tâm chiến đấu hay chưa.
Dialogue: 0,0:03:33.56,0:03:35.87,Default,,0000,0000,0000,,Nếu như mình đã được chọn\Nlàm bài kiểm tra...
Dialogue: 0,0:03:36.63,0:03:38.90,Default,,0000,0000,0000,,Thì cũng nên vui lòng đáp lại vậy!
Dialogue: 0,0:03:38.92,0:03:40.62,Default,,0000,0000,0000,,Nguy rồi, bó tay!
Dialogue: 0,0:03:44.92,0:03:46.86,Default,,0000,0000,0000,,Đúng là tập hợp toàn quái vật.
Dialogue: 0,0:03:47.72,0:03:50.07,Default,,0000,0000,0000,,Cấp A như chúng ta chẳng thể nào so bì.
Dialogue: 0,0:03:50.11,0:03:51.86,Default,,0000,0000,0000,,Không có chuyện đó đâu!
Dialogue: 0,0:03:51.88,0:03:53.82,Default,,0000,0000,0000,,Hội trưởng cũng mạnh lắm ạ!
Dialogue: 0,0:03:56.43,0:03:59.04,Default,,0000,0000,0000,,Đọ sức mạnh thì tôi thắng rồi nhỉ.
Dialogue: 0,0:04:00.05,0:04:02.61,Default,,0000,0000,0000,,Tôi bị quật ngã xuống đất rồi.
Dialogue: 0,0:04:02.85,0:04:04.64,Default,,0000,0000,0000,,Đây là lần đầu đấy.
Dialogue: 0,0:04:06.36,0:04:08.24,Default,,0000,0000,0000,,Phần thắng thuộc về tôi rồi nhỉ.
Dialogue: 0,0:04:11.24,0:04:12.93,Default,,0000,0000,0000,,Định chạy vòng quanh tới khi nào...
Dialogue: 0,0:04:16.36,0:04:18.67,Default,,0000,0000,0000,,Nhận định mình yếu hơn Hunter Cha sao?
Dialogue: 0,0:04:19.07,0:04:20.94,Default,,0000,0000,0000,,Vậy là bị coi thường nhỉ...
Dialogue: 0,0:04:22.51,0:04:24.07,Default,,0000,0000,0000,,Không thể đọc nổi chiêu kế tiếp!
Dialogue: 0,0:04:24.53,0:04:26.27,Default,,0000,0000,0000,,Vũ Cơ Cha Hae-in.
Dialogue: 0,0:04:26.69,0:04:29.07,Default,,0000,0000,0000,,Khi chứng kiến cách chiến đấu\Ntựa như nhảy múa này
Dialogue: 0,0:04:29.07,0:04:31.48,Default,,0000,0000,0000,,dù không muốn cũng phải hiểu\Ný nghĩa của danh hiệu đó!
Dialogue: 0,0:04:34.82,0:04:35.94,Default,,0000,0000,0000,,Chạm!
Dialogue: 0,0:04:36.76,0:04:38.67,Default,,0000,0000,0000,,Phải mau qua ứng cứu Hunter Baek.
Dialogue: 0,0:04:45.68,0:04:46.91,Default,,0000,0000,0000,,Vừa rồi là thế nào vậy?
Dialogue: 0,0:04:47.06,0:04:48.18,Default,,0000,0000,0000,,Chết rồi.
Dialogue: 0,0:04:48.19,0:04:49.86,Default,,0000,0000,0000,,Mình đã ra tay theo phản xạ.
Dialogue: 0,0:04:55.01,0:04:57.24,Default,,0000,0000,0000,,Ây chà, chọc phải tổ kiến lửa rồi.
Dialogue: 0,0:04:57.25,0:05:00.95,Default,,0000,0000,0000,,Cậu ta mà biến thành như vậy\Nthì chẳng biết sẽ làm ra chuyện gì nhỉ.
Dialogue: 0,0:05:01.11,0:05:02.55,Default,,0000,0000,0000,,Có nên ngăn lại không ạ?
Dialogue: 0,0:05:03.11,0:05:05.09,Default,,0000,0000,0000,,Chắc sẽ có người bị thương rồi đây.
Dialogue: 0,0:05:09.83,0:05:10.76,Default,,0000,0000,0000,,Nhanh quá...
Dialogue: 0,0:05:14.83,0:05:16.62,Default,,0000,0000,0000,,Có hơi căng quá không?
Dialogue: 0,0:05:22.71,0:05:24.76,Default,,0000,0000,0000,,Có thể hành động này là thừa thãi...
Dialogue: 0,0:05:25.55,0:05:28.52,Default,,0000,0000,0000,,Nhưng có vẻ chuyện này đang\Nvượt phạm vi thi đấu giao hữu...
Dialogue: 0,0:05:28.82,0:05:30.19,Default,,0000,0000,0000,,Nhà ngươi là ai hả!?
Dialogue: 0,0:05:33.54,0:05:34.59,Default,,0000,0000,0000,,Không thể nào...
Dialogue: 0,0:05:34.59,0:05:37.23,Default,,0000,0000,0000,,Nhanh chóng khống chế\NKumamoto đang nổi điên như vậy sao.
Dialogue: 0,0:05:37.50,0:05:40.22,Default,,0000,0000,0000,,Hunter đó có thật là hệ pháp sư không?
Dialogue: 0,0:05:40.53,0:05:42.11,Default,,0000,0000,0000,,Vâng, không sai ạ.
Dialogue: 0,0:05:42.64,0:05:44.75,Default,,0000,0000,0000,,Chỉ còn cách tự mình xác nhận sao.
Dialogue: 0,0:05:45.56,0:05:48.75,Default,,0000,0000,0000,,Hunter Cha, như này có thể coi\Nchúng ta đã thua được không?
Dialogue: 0,0:05:49.58,0:05:51.86,Default,,0000,0000,0000,,Có vẻ Hunter Baek cũng thua rồi.
Dialogue: 0,0:05:52.21,0:05:52.95,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:05:54.87,0:05:58.40,Default,,0000,0000,0000,,Tình hình này có dốc toàn lực\Ncũng không thắng nổi.
Dialogue: 0,0:06:00.50,0:06:01.51,Default,,0000,0000,0000,,Hunter Sung.
Dialogue: 0,0:06:02.26,0:06:06.15,Default,,0000,0000,0000,,Hội trưởng Goto có nguyện vọng\Nđược giao đấu với anh.
Dialogue: 0,0:06:06.75,0:06:08.99,Default,,0000,0000,0000,,Toàn thân hừng hực đấu chí...
Dialogue: 0,0:06:09.39,0:06:11.78,Default,,0000,0000,0000,,Anh ta muốn thấy thực lực của mình sao.
Dialogue: 0,0:06:13.24,0:06:16.44,Default,,0000,0000,0000,,Quả là cơ hội tốt để thử nghiệm\Nsức mạnh được mài giũa ở Lâu Đài Quỷ.
Dialogue: 0,0:06:17.89,0:06:19.67,Default,,0000,0000,0000,,Cười trước mặt mình sao?
Dialogue: 0,0:06:20.62,0:06:23.76,Default,,0000,0000,0000,,Anh Goto, Hunter Sung đã đồng ý.
Dialogue: 0,0:06:24.33,0:06:26.07,Default,,0000,0000,0000,,Nhưng có điều kiện ạ.
Dialogue: 0,0:06:26.53,0:06:27.32,Default,,0000,0000,0000,,Điều kiện?
Dialogue: 0,0:06:27.78,0:06:30.46,Default,,0000,0000,0000,,Cậu ta nói chỉ đồng ý\Nnếu hai bên dốc toàn lực.
Dialogue: 0,0:06:33.67,0:06:34.61,Default,,0000,0000,0000,,Thú vị lắm.
Dialogue: 0,0:06:35.72,0:06:39.17,Default,,0000,0000,0000,,Cuộc chinh phạt Đảo Jeju lần thứ tư\Nđang ngày một tới gần.
Dialogue: 0,0:06:39.67,0:06:43.89,Default,,0000,0000,0000,,Nước ta và Nhật Bản đang hợp tác,\Ntiến hành chuẩn bị chu toàn...
Dialogue: 0,0:06:43.89,0:06:45.73,Default,,0000,0000,0000,,Hôm nay con không đi làm à?
Dialogue: 0,0:06:46.08,0:06:46.91,Default,,0000,0000,0000,,Được nghỉ ạ.
Dialogue: 0,0:06:46.94,0:06:48.30,Default,,0000,0000,0000,,Hôm qua, con có nói rồi mà.
Dialogue: 0,0:06:48.35,0:06:49.33,Default,,0000,0000,0000,,Vậy à?
Dialogue: 0,0:06:49.89,0:06:51.74,Default,,0000,0000,0000,,Các Hunter đang cố gắng như vậy
Dialogue: 0,0:06:51.74,0:06:54.67,Default,,0000,0000,0000,,thì chúng ta cũng phải cố gắng\Nlàm phần việc của mình nhỉ.
Dialogue: 0,0:07:04.68,0:07:05.57,Default,,0000,0000,0000,,Alô.
Dialogue: 0,0:07:06.51,0:07:07.33,Default,,0000,0000,0000,,Chẳng là...
Dialogue: 0,0:07:07.69,0:07:11.27,Default,,0000,0000,0000,,Tôi muốn trao đổi về chuyện đội phòng vệ\Ncủa chiến dịch chinh phạt Đảo Jeju.
Dialogue: 0,0:07:12.22,0:07:13.81,Default,,0000,0000,0000,,Gì đấy, gì đấy?
Dialogue: 0,0:07:14.32,0:07:16.90,Default,,0000,0000,0000,,Đó là Hunter cấp S thứ mười\Nđược đồn đại à.
Dialogue: 0,0:07:16.91,0:07:19.34,Default,,0000,0000,0000,,Máu chiến thật,\Nđấu với Goto cơ đấy.
Dialogue: 0,0:07:19.88,0:07:22.87,Default,,0000,0000,0000,,Mặc dù từng thấy anh ấy chiến đấu\Nở trong hầm ngục cấp A...
Dialogue: 0,0:07:23.12,0:07:25.40,Default,,0000,0000,0000,,Nhưng đấu với cấp S liệu có ổn không...
Dialogue: 0,0:07:25.74,0:07:29.08,Default,,0000,0000,0000,,Hôm nay ở gần nhiều Hunter như này\Nvẫn ổn chứ hả?
Dialogue: 0,0:07:29.87,0:07:32.91,Default,,0000,0000,0000,,Dù sao cũng không thể cứ bịt mũi\Nkhi ở chiến trường...
Dialogue: 0,0:07:34.06,0:07:36.09,Default,,0000,0000,0000,,Không cần ngăn cản hai người họ sao?
Dialogue: 0,0:07:36.42,0:07:39.90,Default,,0000,0000,0000,,Hunter hệ chiến đấu đánh cận chiến\Nvới Hunter hệ pháp sư...
Dialogue: 0,0:07:40.30,0:07:42.38,Default,,0000,0000,0000,,Bình thường thì đúng là nên ngăn cản.
Dialogue: 0,0:07:42.69,0:07:45.48,Default,,0000,0000,0000,,Nhưng tôi cũng có lý do\Ngiống Hunter Cha thôi.
Dialogue: 0,0:07:47.08,0:07:49.36,Default,,0000,0000,0000,,Thật lạ lùng khi chúng ta\Nmong trận đấu này nhỉ?
Dialogue: 0,0:07:49.92,0:07:51.57,Default,,0000,0000,0000,,Nếu đúng như mình nghĩ...
Dialogue: 0,0:07:51.57,0:07:54.90,Default,,0000,0000,0000,,Hunter Sung là thức tỉnh giả\Ncó khả năng phát triển...
Dialogue: 0,0:07:57.55,0:07:58.67,Default,,0000,0000,0000,,Vậy thì bắt đầu thôi...
Dialogue: 0,0:08:03.17,0:08:04.91,Default,,0000,0000,0000,,Này này, tôi còn chưa nói xong mà.
Dialogue: 0,0:08:05.18,0:08:07.10,Default,,0000,0000,0000,,Tốc độ và cách di chuyển đó...
Dialogue: 0,0:08:07.74,0:08:09.27,Default,,0000,0000,0000,,Đây mà là hệ pháp sư à?
Dialogue: 0,0:08:09.67,0:08:10.71,Default,,0000,0000,0000,,Thật nực cười.
Dialogue: 0,0:08:13.50,0:08:15.64,Default,,0000,0000,0000,,Tôi sẽ lột trần lớp vỏ của cậu.
Dialogue: 0,0:08:17.19,0:08:20.37,Default,,0000,0000,0000,,Quả thật người này khác hẳn\Nvới các cấp S khác.
Dialogue: 0,0:08:20.66,0:08:23.66,Default,,0000,0000,0000,,Nhưng không phải không thể né tránh.
Dialogue: 0,0:08:24.04,0:08:25.17,Default,,0000,0000,0000,,Lại cười nữa!?
Dialogue: 0,0:08:25.71,0:08:28.24,Default,,0000,0000,0000,,Nhanh tới mức\Nkhông thấy được đòn tấn công.
Dialogue: 0,0:08:28.38,0:08:30.40,Default,,0000,0000,0000,,Né đòn tốt đấy nhỉ.
Dialogue: 0,0:08:30.64,0:08:33.69,Default,,0000,0000,0000,,Chỉ cần né được những đòn công đó\Nđã là rất giỏi rồi.
Dialogue: 0,0:08:34.13,0:08:36.21,Default,,0000,0000,0000,,Không đơn thuần chỉ là né đòn...
Dialogue: 0,0:08:36.64,0:08:38.71,Default,,0000,0000,0000,,Mà là đang thử sức đối phương.
Dialogue: 0,0:08:43.42,0:08:46.19,Default,,0000,0000,0000,,Cứ bị né đòn như này đúng là khó chịu.
Dialogue: 0,0:08:46.64,0:08:47.78,Default,,0000,0000,0000,,Đổi ý rồi.
Dialogue: 0,0:08:47.78,0:08:49.75,Default,,0000,0000,0000,,Nghiêm túc nghiền nát cậu ta nào!
Dialogue: 0,0:08:56.83,0:08:58.11,Default,,0000,0000,0000,,Hunter Sung!
Dialogue: 0,0:09:03.51,0:09:06.22,Default,,0000,0000,0000,,Thiếu chút nữa là tôi đã chột mắt.
Dialogue: 0,0:09:06.55,0:09:08.71,Default,,0000,0000,0000,,Không phải cổ tay mà là nắm bàn tay.
Dialogue: 0,0:09:09.25,0:09:10.90,Default,,0000,0000,0000,,Cậu đang đùa với tôi sao?
Dialogue: 0,0:09:11.37,0:09:13.53,Default,,0000,0000,0000,,Mặc dù không hiểu anh đang nói gì...
Dialogue: 0,0:09:14.38,0:09:16.63,Default,,0000,0000,0000,,Nắm vào cổ tay\Nthì trò chơi sẽ kết thúc nhỉ.
Dialogue: 0,0:09:17.19,0:09:20.03,Default,,0000,0000,0000,,Nhất định anh cũng không muốn\Ncứ như này mà kết thúc phải không!
Dialogue: 0,0:09:31.48,0:09:33.39,Default,,0000,0000,0000,,Này, anh Goto nghiêm túc kìa!
Dialogue: 0,0:09:33.44,0:09:36.50,Default,,0000,0000,0000,,Nếu cứ như này mà va chạm thì\Nhai người họ sẽ không thể lành lặn đâu!
Dialogue: 0,0:09:45.14,0:09:46.19,Default,,0000,0000,0000,,Băng?
Dialogue: 0,0:09:47.31,0:09:48.47,Default,,0000,0000,0000,,Hunter Sung!
Dialogue: 0,0:09:48.89,0:09:49.94,Default,,0000,0000,0000,,Anh Goto!
Dialogue: 0,0:09:50.15,0:09:51.27,Default,,0000,0000,0000,,Hãy dừng ở đây đi.
Dialogue: 0,0:09:51.54,0:09:54.29,Default,,0000,0000,0000,,Nhỡ có chuyện xảy ra\Nthì không ai có thể chịu trách nhiệm đâu.
Dialogue: 0,0:09:54.82,0:09:56.90,Default,,0000,0000,0000,,Hãy tuyên bố trận đấu kết thúc đi!
Dialogue: 0,0:09:57.17,0:09:58.53,Default,,0000,0000,0000,,V-Vâng!
Dialogue: 0,0:10:00.91,0:10:02.82,Default,,0000,0000,0000,,Có phải tôi đã làm chuyện dư thừa không?
Dialogue: 0,0:10:02.86,0:10:03.52,Default,,0000,0000,0000,,Không đâu.
Dialogue: 0,0:10:04.73,0:10:09.43,Default,,0000,0000,0000,,Đấu với Goto lừng danh thiên hạ mà chỉ bị\Nmột vết xước ở mặt đã là ghê gớm rồi.
Dialogue: 0,0:10:12.19,0:10:14.19,Default,,0000,0000,0000,,Mình lỡ nóng máu mất rồi.
Dialogue: 0,0:10:14.86,0:10:15.47,Default,,0000,0000,0000,,Nhưng mà...
Dialogue: 0,0:10:16.45,0:10:19.16,Default,,0000,0000,0000,,Mình đã nắm được thực lực\Ncủa tất cả những người ở đây.
Dialogue: 0,0:10:19.75,0:10:22.53,Default,,0000,0000,0000,,Còn có thể để binh sĩ bóng\Nlẩn vào trong bóng của năm người.
Dialogue: 0,0:10:25.12,0:10:29.14,Default,,0000,0000,0000,,Vậy chúng tôi sẽ chia sẻ thông tin\Nvề các Hunter tham gia chinh phạt sau.
Dialogue: 0,0:10:29.45,0:10:32.54,Default,,0000,0000,0000,,Nếu vậy xin hãy liên lạc\Nvới cả phó hội trưởng của chúng tôi.
Dialogue: 0,0:10:32.72,0:10:33.58,Default,,0000,0000,0000,,Dĩ nhiên rồi.
Dialogue: 0,0:10:38.81,0:10:39.63,Default,,0000,0000,0000,,Chủ tịch Go.
Dialogue: 0,0:10:41.33,0:10:43.52,Default,,0000,0000,0000,,Có chuyện gì vậy, Hunter Sung?
Dialogue: 0,0:10:44.22,0:10:46.05,Default,,0000,0000,0000,,Về chuyện chinh phạt Đảo Jeju...
Dialogue: 0,0:10:49.40,0:10:50.06,Default,,0000,0000,0000,,Reiji.
Dialogue: 0,0:10:50.55,0:10:52.87,Default,,0000,0000,0000,,Có vẻ ở đây cũng có Hunter khá ra dáng.
Dialogue: 0,0:10:54.09,0:10:57.35,Default,,0000,0000,0000,,Kể cả như vậy vẫn chưa bằng\NHội trưởng Hội Bạt Kiếm của chúng ta nhỉ.
Dialogue: 0,0:10:57.37,0:10:58.40,Default,,0000,0000,0000,,Cũng chưa chắc.
Dialogue: 0,0:10:58.81,0:11:00.04,Default,,0000,0000,0000,,Đó là Hunter nào ạ?
Dialogue: 0,0:11:00.41,0:11:01.64,Default,,0000,0000,0000,,Sung Jinwoo.
Dialogue: 0,0:11:02.05,0:11:04.58,Default,,0000,0000,0000,,Một tái thức tỉnh giả\Nmới lên cấp S gần đây.
Dialogue: 0,0:11:05.75,0:11:06.83,Default,,0000,0000,0000,,Lạ thật.
Dialogue: 0,0:11:07.35,0:11:10.48,Default,,0000,0000,0000,,Trong danh sách tham gia chinh phạt\Nkhông có cái tên đó.
Dialogue: 0,0:11:11.04,0:11:11.83,Default,,0000,0000,0000,,Cái gì?
Dialogue: 0,0:11:13.80,0:11:17.47,Default,,0000,0000,0000,,Hunter Sung không tham gia\Nchinh phạt Đảo Jeju nhỉ.
Dialogue: 0,0:11:17.65,0:11:20.41,Default,,0000,0000,0000,,Hẳn là cậu ấy có lý do của mình.
Dialogue: 0,0:11:20.44,0:11:21.36,Default,,0000,0000,0000,,Tuy nhiên...
Dialogue: 0,0:11:21.71,0:11:23.87,Default,,0000,0000,0000,,Cũng không có tên của Byung-gu à...
Dialogue: 0,0:11:24.56,0:11:25.36,Default,,0000,0000,0000,,Nhưng mà...
Dialogue: 0,0:11:26.00,0:11:30.02,Default,,0000,0000,0000,,Chúng ta đã có tổng cộng\N15 Hunter cấp S rồi.
Dialogue: 0,0:11:30.30,0:11:32.15,Default,,0000,0000,0000,,Nhất định lần này sẽ làm được.
Dialogue: 0,0:11:36.76,0:11:38.38,Default,,0000,0000,0000,,Chúng ta vẫn chiến thắng!
Dialogue: 0,0:11:41.65,0:11:42.44,Default,,0000,0000,0000,,Con về rồi đây.
Dialogue: 0,0:11:42.55,0:11:43.89,Default,,0000,0000,0000,,Anh về muộn quá.
Dialogue: 0,0:11:45.93,0:11:47.53,Default,,0000,0000,0000,,Mừng con về, Jinwoo.
Dialogue: 0,0:11:47.96,0:11:49.29,Default,,0000,0000,0000,,Cơm tối xong rồi đó.
Dialogue: 0,0:11:51.25,0:11:51.96,Default,,0000,0000,0000,,Con đã về.
Dialogue: 0,0:11:53.78,0:11:57.63,Default,,0000,0000,0000,,Mẹ sau bốn năm mới tỉnh dậy\Nhiện đang cần mình ở bên.
Dialogue: 0,0:11:59.01,0:12:00.15,Default,,0000,0000,0000,,Chính vì thế...
Dialogue: 0,0:12:01.02,0:12:02.53,Default,,0000,0000,0000,,Tôi sẽ không đi Đảo Jeju.
Dialogue: 0,0:12:07.04,0:12:10.34,Default,,0000,0000,0000,,Con mồi đã cạn kiệt,\Nchúng bắt đầu ăn thịt đồng loại.
Dialogue: 0,0:12:11.42,0:12:15.74,Default,,0000,0000,0000,,Vùng đất này không đủ thức ăn\Ncho con dân của vương quốc.
Dialogue: 0,0:12:16.94,0:12:18.32,Default,,0000,0000,0000,,Không thể tiếp tục như thế...
Dialogue: 0,0:12:19.02,0:12:20.55,Default,,0000,0000,0000,,Phải rời khỏi hòn đảo này.
Dialogue: 0,0:12:22.14,0:12:23.82,Default,,0000,0000,0000,,Đứa trẻ mạnh nhất...
Dialogue: 0,0:12:24.40,0:12:26.32,Default,,0000,0000,0000,,Sẽ dẫn dắt con dân...
Dialogue: 0,0:12:26.65,0:12:29.54,Default,,0000,0000,0000,,Ta cần một đứa trẻ mạnh hơn tất cả...
Dialogue: 0,0:13:05.42,0:13:07.72,Default,,0000,0000,0000,,Hãy mạnh hơn nữa, con của ta.
Dialogue: 0,0:13:15.71,0:13:18.94,Default,,0000,0000,0000,,Quái vật dạng kiến đang tiến hóa\Nvới tốc độ đáng sợ.
Dialogue: 0,0:13:19.35,0:13:23.14,Default,,0000,0000,0000,,Trong đợt chinh phạt Đảo Jeju lần thứ ba\Nlũ kiến vẫn còn bò trên mặt đất.
Dialogue: 0,0:13:23.14,0:13:26.16,Default,,0000,0000,0000,,Nhưng đây là hình dạng mới nhất\Nvừa được xác thực vài ngày trước.
Dialogue: 0,0:13:26.25,0:13:30.75,Default,,0000,0000,0000,,Chúng có hình dáng gần giống người,\Nsau lưng mọc cánh lớn.
Dialogue: 0,0:13:30.97,0:13:35.67,Default,,0000,0000,0000,,Hiệp hội Hunter đã đưa ra đối sách\Ncho quái vật dạng kiến này.
Dialogue: 0,0:13:39.37,0:13:40.71,Default,,0000,0000,0000,,Tới rồi hả, quái vật!
Dialogue: 0,0:13:40.77,0:13:42.74,Default,,0000,0000,0000,,Hunter cấp S sẽ là đối thủ của ngươi!
Dialogue: 0,0:13:46.44,0:13:48.44,Default,,0000,0000,0000,,Nguy hiểm lắm nên hãy thôi đi!
Dialogue: 0,0:13:48.62,0:13:51.97,Default,,0000,0000,0000,,Tại sao em không được phép\Ntham gia đội phòng vệ vậy?
Dialogue: 0,0:13:52.34,0:13:54.70,Default,,0000,0000,0000,,Thì tại Han là cấp E mà.
Dialogue: 0,0:13:55.36,0:13:55.98,Default,,0000,0000,0000,,Ơ!?
Dialogue: 0,0:13:56.26,0:13:57.22,Default,,0000,0000,0000,,Anh được lắm!
Dialogue: 0,0:13:57.22,0:13:59.63,Default,,0000,0000,0000,,Đau quá! Xin lỗi!
Dialogue: 0,0:13:59.78,0:14:03.81,Default,,0000,0000,0000,,Để đề phòng có quái vật kiến sống sót\Nđặt chân lên đất liền
Dialogue: 0,0:14:03.81,0:14:08.47,Default,,0000,0000,0000,,chúng tôi rất mong các Hunter\Nsẽ tham gia đội phòng vệ.
Dialogue: 0,0:14:13.36,0:14:15.29,Default,,0000,0000,0000,,Vậy là vào ngày mai...
Dialogue: 0,0:14:15.78,0:14:17.76,Default,,0000,0000,0000,,Cuộc chinh phạt Đảo Jeju sẽ bắt đầu.
Dialogue: 0,0:14:21.83,0:14:23.22,Default,,0000,0000,0000,,Đây là Đệ Nhất Hạm Đội.
Dialogue: 0,0:14:23.32,0:14:25.97,Default,,0000,0000,0000,,Chúng tôi đã tới điểm mục tiêu,\Nvùng biển gần Đảo Jeju.
Dialogue: 0,0:14:26.53,0:14:28.87,Default,,0000,0000,0000,,Đệ Nhị Hạm Đội đã tới điểm mục tiêu.
Dialogue: 0,0:14:29.57,0:14:32.57,Default,,0000,0000,0000,,Đệ Tam Hạm Đội sắp tiến vào\Nvùng biển cảnh giới.
Dialogue: 0,0:14:32.83,0:14:34.86,Default,,0000,0000,0000,,Đệ Tứ Hạm Đội hiện vẫn đang tiến lên.
Dialogue: 0,0:14:34.97,0:14:37.38,Default,,0000,0000,0000,,Dự kiến sau năm phút sẽ tới điểm mục tiêu.
Dialogue: 0,0:14:38.63,0:14:42.50,Default,,0000,0000,0000,,Hội trưởng à, sức của chúng ta\Ncó đủ đấu với lũ kiến không?
Dialogue: 0,0:14:42.59,0:14:45.00,Default,,0000,0000,0000,,Chuyện đó không thử làm sao mà biết được.
Dialogue: 0,0:14:45.47,0:14:49.07,Default,,0000,0000,0000,,Nhưng chúng ta vẫn là đội phòng vệ được\Ntriển khai đề phòng trường hợp xấu nhất.
Dialogue: 0,0:14:49.14,0:14:51.58,Default,,0000,0000,0000,,Phải tiêu diệt lũ kiến\Nđể chúng không mò tới đất liền.
Dialogue: 0,0:14:51.66,0:14:53.17,Default,,0000,0000,0000,,Không hổ là hội trưởng!
Dialogue: 0,0:14:53.18,0:14:56.56,Default,,0000,0000,0000,,Jung Yoontae nguyện cả đời\Nđi theo hội trưởng!
Dialogue: 0,0:14:59.01,0:15:01.28,Default,,0000,0000,0000,,Tới đây nhờ mọi người lo liệu chỗ này.
Dialogue: 0,0:15:01.74,0:15:03.68,Default,,0000,0000,0000,,Chắc sẽ không có dịp thể hiện gì đâu.
Dialogue: 0,0:15:04.17,0:15:05.95,Default,,0000,0000,0000,,Hôm nay, sẽ chỉ ở yên chỗ này mà thôi.
Dialogue: 0,0:15:05.97,0:15:07.80,Default,,0000,0000,0000,,Phải đề phòng mọi khả năng chứ!
Dialogue: 0,0:15:08.34,0:15:13.44,Default,,0000,0000,0000,,Chưa kể có phó hội trưởng như cô\Nthì ta mới yên tâm lên đường.
Dialogue: 0,0:15:15.88,0:15:17.36,Default,,0000,0000,0000,,Xin hãy cẩn thận ạ.
Dialogue: 0,0:15:17.56,0:15:18.12,Default,,0000,0000,0000,,Ừm!
Dialogue: 0,0:15:18.56,0:15:19.10,Default,,0000,0000,0000,,Hả!?
Dialogue: 0,0:15:19.16,0:15:22.35,Default,,0000,0000,0000,,Sao lại bố trí Minsung\Nở cái vị trí như vậy!?
Dialogue: 0,0:15:22.36,0:15:24.51,Default,,0000,0000,0000,,Nhỡ có chuyện gì thì sẽ phiền lắm đấy!
Dialogue: 0,0:15:24.52,0:15:26.08,Default,,0000,0000,0000,,Cho cậu ta về hậu phương đi!
Dialogue: 0,0:15:43.82,0:15:45.98,Default,,0000,0000,0000,,Các đơn vị đã liên lạc về ạ.
Dialogue: 0,0:15:46.60,0:15:50.13,Default,,0000,0000,0000,,Bờ biển trên đất liền và vùng biển\Nquanh Đảo Jeju đã hoàn tất chuẩn bị.
Dialogue: 0,0:15:50.82,0:15:53.72,Default,,0000,0000,0000,,Đội nghi binh cũng thành công\Nxâm nhập lên đảo.
Dialogue: 0,0:15:54.53,0:15:55.32,Default,,0000,0000,0000,,Ừm.
Dialogue: 0,0:15:56.42,0:16:01.63,Default,,0000,0000,0000,,Trong chiến dịch lần này,\Nnhiều Hunter đã đáp lại lời kêu gọi.
Dialogue: 0,0:16:02.40,0:16:06.81,Default,,0000,0000,0000,,Chưa kể quyết định tham gia của cậu ấy\Nđúng là khiến tôi yên tâm.
Dialogue: 0,0:16:13.89,0:16:14.91,Default,,0000,0000,0000,,Byung-gu!?
Dialogue: 0,0:16:15.71,0:16:17.89,Default,,0000,0000,0000,,Tôi không ngờ cậu sẽ đến đó.
Dialogue: 0,0:16:18.04,0:16:22.46,Default,,0000,0000,0000,,Không có Healer như tôi thì\Nanh Yoonho sẽ chết trong vài giây mất.
Dialogue: 0,0:16:22.93,0:16:26.16,Default,,0000,0000,0000,,Cứ thấy quái vật một cái\Nanh sẽ lao đầu vào nó ngay mà.
Dialogue: 0,0:16:26.41,0:16:29.63,Default,,0000,0000,0000,,Nếu cứ thong thả\Nthì cậu sẽ bị giết còn gì.
Dialogue: 0,0:16:36.09,0:16:37.92,Default,,0000,0000,0000,,Đây là khu phố ở trung tâm đảo sao.
Dialogue: 0,0:16:38.54,0:16:39.64,Default,,0000,0000,0000,,Đây là Alpha.
Dialogue: 0,0:16:39.66,0:16:40.92,Default,,0000,0000,0000,,Tất cả hãy trả lời.
Dialogue: 0,0:16:41.40,0:16:43.10,Default,,0000,0000,0000,,Bravo, đã vào vị trí.
Dialogue: 0,0:16:43.60,0:16:45.42,Default,,0000,0000,0000,,Charlie, đã vào vị trí.
Dialogue: 0,0:16:45.85,0:16:47.92,Default,,0000,0000,0000,,Delta, sẵn sàng đợi lệnh.
Dialogue: 0,0:16:50.48,0:16:51.57,Default,,0000,0000,0000,,Truyền hình trực tiếp...
Dialogue: 0,0:16:51.80,0:16:52.30,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:16:52.70,0:16:56.01,Default,,0000,0000,0000,,Mà để đề phòng có sự cố\Nnên sẽ phát chậm 10 phút...
Dialogue: 0,0:16:56.04,0:16:58.56,Default,,0000,0000,0000,,Quay phim thuộc Tổ truyền thông\Ncủa Hiệp hội Hunter này
Dialogue: 0,0:16:58.58,0:17:01.38,Default,,0000,0000,0000,,sẽ nghiêm chỉnh đưa hình ảnh\Ncủa trận chiến này ra thế giới.
Dialogue: 0,0:17:02.53,0:17:06.35,Default,,0000,0000,0000,,Hunter phải có thứ cần bảo vệ\Nthì mới phát huy được bản lĩnh.
Dialogue: 0,0:17:06.70,0:17:09.57,Default,,0000,0000,0000,,Tuy nhiên, đây chắc hẳn sẽ là\Nmột trận ác chiến.
Dialogue: 0,0:17:09.58,0:17:10.54,Default,,0000,0000,0000,,Cậu chịu nổi không?
Dialogue: 0,0:17:10.84,0:17:12.19,Default,,0000,0000,0000,,Xin ngài cứ yên tâm.
Dialogue: 0,0:17:12.53,0:17:14.20,Default,,0000,0000,0000,,Trông như này chứ tôi vẫn là cấp A.
Dialogue: 0,0:17:14.34,0:17:16.12,Default,,0000,0000,0000,,Cũng quen mạo hiểm ghi hình rồi ạ.
Dialogue: 0,0:17:16.40,0:17:17.75,Default,,0000,0000,0000,,Được vậy thì tốt.
Dialogue: 0,0:17:18.50,0:17:24.19,Default,,0000,0000,0000,,Có lẽ đây là lần cuối dân thường\Ncó thể thấy một cuộc chinh phạt cấp S.
Dialogue: 0,0:17:24.43,0:17:26.69,Default,,0000,0000,0000,,Không, nó phải là như vậy.
Dialogue: 0,0:17:27.36,0:17:29.65,Default,,0000,0000,0000,,Lần này nhất định phải thành công nhỉ.
Dialogue: 0,0:17:30.26,0:17:34.49,Default,,0000,0000,0000,,Nếu lần này mà thất bại, đất nước\Ncủa chúng ta sẽ không còn trên bản đồ.
Dialogue: 0,0:17:35.09,0:17:38.24,Default,,0000,0000,0000,,Đất nước này đang cần những anh hùng...
Dialogue: 0,0:17:39.41,0:17:40.67,Default,,0000,0000,0000,,Đội tấn công sẽ xuất phát.
Dialogue: 0,0:17:41.01,0:17:42.99,Default,,0000,0000,0000,,Quá trình chuẩn bị đã hoàn tất.
Dialogue: 0,0:17:43.70,0:17:44.50,Default,,0000,0000,0000,,Tốt lắm.
Dialogue: 0,0:17:44.83,0:17:48.72,Default,,0000,0000,0000,,Vậy thì ngay sau đây, chiến dịch\Nchinh phạt Đảo Jeju lần thứ tư sẽ bắt đầu!
Dialogue: 0,0:17:49.03,0:17:50.45,Default,,0000,0000,0000,,Tất cả giải phóng!
Dialogue: 0,0:17:50.70,0:17:51.35,Default,,0000,0000,0000,,Tuân lệnh.
Dialogue: 0,0:17:52.36,0:17:55.49,Default,,0000,0000,0000,,Đội nghi binh có vẻ\Nđã bắt đầu kế hoạch rồi.
Dialogue: 0,0:17:55.60,0:17:57.36,Default,,0000,0000,0000,,Lượng ma lực thật kinh khủng...
Dialogue: 0,0:17:57.74,0:17:59.25,Default,,0000,0000,0000,,Có vẻ bọn chúng đã có động tĩnh.
Dialogue: 0,0:18:00.76,0:18:03.00,Default,,0000,0000,0000,,Này này, mò tới tận đây kìa!
Dialogue: 0,0:18:03.07,0:18:04.71,Default,,0000,0000,0000,,Hãy cho mở cửa khoang.
Dialogue: 0,0:18:04.98,0:18:06.67,Default,,0000,0000,0000,,Tôi sẽ dọn dẹp chúng.
Dialogue: 0,0:18:16.53,0:18:17.53,Default,,0000,0000,0000,,Ghê thật.
Dialogue: 0,0:18:18.18,0:18:19.84,Default,,0000,0000,0000,,Số lượng đông thật.
Dialogue: 0,0:18:21.40,0:18:23.48,Default,,0000,0000,0000,,Khởi động một chút vậy.
Dialogue: 0,0:18:30.82,0:18:33.64,Default,,0000,0000,0000,,Cuối cùng cũng tới nơi.
Dialogue: 0,0:18:34.00,0:18:36.71,Default,,0000,0000,0000,,Một lần nữa... tại nơi này...
Dialogue: 0,0:18:39.59,0:18:41.28,Default,,0000,0000,0000,,Không hổ là vũ khí tối thượng.
Dialogue: 0,0:18:41.46,0:18:42.54,Default,,0000,0000,0000,,Thật đáng tin cậy.
Dialogue: 0,0:18:43.04,0:18:45.54,Default,,0000,0000,0000,,Giờ thì chúng ta cũng xuống thôi nhỉ.
Dialogue: 0,0:18:48.41,0:18:53.03,Default,,0000,0000,0000,,Hunter của Nhật Bản chỉ có thể\Ndẫn dụ lũ kiến khoảng một tiếng...
Dialogue: 0,0:18:53.50,0:18:57.54,Default,,0000,0000,0000,,Tức là chúng ta phải tiêu diệt kiến chúa\Ntrong khoảng thời gian đó.
Dialogue: 0,0:18:57.89,0:18:59.04,Default,,0000,0000,0000,,Sẵn sàng chưa nào?
Dialogue: 0,0:19:00.58,0:19:02.61,Default,,0000,0000,0000,,Chúng ta nhất định làm được!
Dialogue: 0,0:19:03.82,0:19:04.48,Default,,0000,0000,0000,,Đi thôi!
Dialogue: 0,0:19:07.58,0:19:09.15,Default,,0000,0000,0000,,Chúng ta cũng bắt đầu kế hoạch đi.
Dialogue: 0,0:19:09.77,0:19:11.35,Default,,0000,0000,0000,,Kích hoạt phá sóng.
Dialogue: 0,0:19:11.64,0:19:13.04,Default,,0000,0000,0000,,Kích hoạt phá sóng.
Dialogue: 0,0:19:15.34,0:19:20.04,Default,,0000,0000,0000,,Như này lũ kiến sẽ không thể\Nnhận tín hiệu cầu cứu từ kiến chúa.
Dialogue: 0,0:19:22.85,0:19:25.04,Default,,0000,0000,0000,,Kumamoto! Cứ sợ sệt là sẽ chết đó!
Dialogue: 0,0:19:28.47,0:19:34.34,Default,,0000,0000,0000,,Có khi chúng ta sẽ diệt hết lũ này\Ntrước khi bọn họ giết được kiến chúa nhỉ?
Dialogue: 0,0:19:34.52,0:19:35.56,Default,,0000,0000,0000,,Có lẽ vậy.
Dialogue: 0,0:19:35.68,0:19:36.59,Default,,0000,0000,0000,,Kenzo đâu?
Dialogue: 0,0:19:37.09,0:19:39.07,Default,,0000,0000,0000,,Đang chơi đùa ở bên đó.
Dialogue: 0,0:19:39.14,0:19:40.44,Default,,0000,0000,0000,,Y hệt trẻ con nhỉ.
Dialogue: 0,0:19:40.67,0:19:42.16,Default,,0000,0000,0000,,Có thấy ngọn lửa vừa rồi không?
Dialogue: 0,0:19:42.32,0:19:43.64,Default,,0000,0000,0000,,Choi gì đó à?
Dialogue: 0,0:19:43.66,0:19:44.56,Default,,0000,0000,0000,,Chắc là anh ta nhỉ.
Dialogue: 0,0:19:44.81,0:19:47.95,Default,,0000,0000,0000,,Không biết tôi đấu với anh ta\Nthì sẽ như nào nhỉ.
Dialogue: 0,0:19:48.41,0:19:50.64,Default,,0000,0000,0000,,Sẽ vừa nóng vừa lạnh cho mà xem.
Dialogue: 0,0:19:53.10,0:19:54.36,Default,,0000,0000,0000,,Tôi đã bịt lối vào.
Dialogue: 0,0:19:54.39,0:19:56.88,Default,,0000,0000,0000,,Hãy đi tiếp trong lúc\Nnghi binh còn hiệu quả nào.
Dialogue: 0,0:19:57.17,0:19:59.76,Default,,0000,0000,0000,,Nhưng mà nhiều hang hốc như này...
Dialogue: 0,0:19:59.76,0:20:03.16,Default,,0000,0000,0000,,Tìm đường tới chỗ kiến chúa kiểu gì đây...
Dialogue: 0,0:20:11.70,0:20:12.75,Default,,0000,0000,0000,,Anh làm cái gì đấy!?
Dialogue: 0,0:20:12.76,0:20:13.59,Default,,0000,0000,0000,,Nguy hiểm lắm đó!
Dialogue: 0,0:20:14.05,0:20:17.60,Default,,0000,0000,0000,,Đâu có thời gian để vào kiểm tra\Ntừng cái lỗ một.
Dialogue: 0,0:20:18.14,0:20:21.32,Default,,0000,0000,0000,,Cứ tìm ra cái lỗ\Ndẫn vào sâu bên trong là được mà?
Dialogue: 0,0:20:22.27,0:20:24.18,Default,,0000,0000,0000,,Có vẻ là ở bên đó.
Dialogue: 0,0:20:30.83,0:20:32.96,Default,,0000,0000,0000,,Kết thúc nhiệm vụ hàng ngày.
Dialogue: 0,0:20:33.30,0:20:35.57,Default,,0000,0000,0000,,Hôm nay đúng là\Nkhông có ai ra ngoài đi bộ.
Dialogue: 0,0:20:38.23,0:20:41.90,Default,,0000,0000,0000,,Tất cả Hunter cấp S tham gia\Ncuộc chinh phạt này đều mạnh.
Dialogue: 0,0:20:42.77,0:20:44.73,Default,,0000,0000,0000,,Họ nhất định dư sức hoàn thành mục tiêu.
Dialogue: 0,0:20:45.86,0:20:47.26,Default,,0000,0000,0000,,Cho dù không có mình đi nữa...
Dialogue: 0,0:20:51.08,0:20:53.60,Default,,0000,0000,0000,,Kiến chúa thực sự ở đây à?
Dialogue: 0,0:20:53.70,0:20:55.69,Default,,0000,0000,0000,,Có phải vứt bỏ lũ này mà chạy rồi không?
Dialogue: 0,0:20:55.83,0:20:56.93,Default,,0000,0000,0000,,Đây là một hòn đảo.
Dialogue: 0,0:20:56.99,0:20:58.53,Default,,0000,0000,0000,,Có thể chạy đi đâu được.
Dialogue: 0,0:20:58.78,0:21:01.07,Default,,0000,0000,0000,,Mọi người hãy qua bên này đi.
Dialogue: 0,0:21:02.94,0:21:03.68,Default,,0000,0000,0000,,Ể!?
Dialogue: 0,0:21:04.47,0:21:05.99,Default,,0000,0000,0000,,Khu đẻ trứng.
Dialogue: 0,0:21:06.18,0:21:08.77,Default,,0000,0000,0000,,Nhất định phòng của kiến chúa ở gần đây.
Dialogue: 0,0:21:09.96,0:21:10.71,Default,,0000,0000,0000,,Hãy nhìn bên đó.
Dialogue: 0,0:21:12.13,0:21:13.16,Default,,0000,0000,0000,,Quả trứng đó...
Dialogue: 0,0:21:13.74,0:21:16.56,Default,,0000,0000,0000,,Không lẽ... đó cũng là trứng kiến?
Dialogue: 0,0:21:16.74,0:21:18.19,Default,,0000,0000,0000,,Kích thước thật lố bịch.
Dialogue: 0,0:21:18.80,0:21:21.89,Default,,0000,0000,0000,,Nhiệm vụ của chúng ta là\Ntiêu diệt kiến chúa.
Dialogue: 0,0:21:21.94,0:21:23.22,Default,,0000,0000,0000,,Đừng bận tâm những thứ khác.
Dialogue: 0,0:21:24.06,0:21:26.68,Default,,0000,0000,0000,,Nhưng cảm thấy dao động\Ncũng không có gì lạ.
Dialogue: 0,0:21:26.83,0:21:28.86,Default,,0000,0000,0000,,Sự tiến hóa của lũ kiến\Nvẫn đang là ẩn số...
Dialogue: 0,0:21:29.56,0:21:34.14,Default,,0000,0000,0000,,Nếu như có một con kiến\Nđược sinh ra từ quả trứng đó...
Dialogue: 0,0:21:35.58,0:21:36.32,Default,,0000,0000,0000,,Chết tiệt...
Dialogue: 0,0:21:36.85,0:21:38.23,Default,,0000,0000,0000,,Đúng là lũ phiền phức.
Dialogue: 0,0:21:38.58,0:21:39.94,Default,,0000,0000,0000,,Vai tôi bị thương rồi.
Dialogue: 0,0:21:40.13,0:21:41.67,Default,,0000,0000,0000,,Muốn tôi chữa cho không?
Dialogue: 0,0:21:41.78,0:21:43.23,Default,,0000,0000,0000,,Dĩ nhiên là không phải miễn phí.
Dialogue: 0,0:21:43.54,0:21:46.51,Default,,0000,0000,0000,,Shimizu, đừng đùa nữa, mau chữa đi!
Dialogue: 0,0:21:46.84,0:21:48.35,Default,,0000,0000,0000,,Thứ mà tôi đang muốn ấy.
Dialogue: 0,0:21:48.56,0:21:50.72,Default,,0000,0000,0000,,Lần này không phải tiền nhé.
Dialogue: 0,0:21:51.03,0:21:51.67,Default,,0000,0000,0000,,Ơ?
Dialogue: 0,0:21:52.12,0:21:53.31,Default,,0000,0000,0000,,Lại kéo tới nữa à?
Dialogue: 0,0:21:54.14,0:21:55.60,Default,,0000,0000,0000,,Đành vậy.
Dialogue: 0,0:21:56.16,0:21:57.48,Default,,0000,0000,0000,,Cô muốn gì...
Dialogue: 0,0:22:44.71,0:22:48.21,Default,,0000,0000,0000,,TẬP 22: CHÚNG TA CẦN MỘT ANH HÙNG
Dialogue: 0,0:23:37.64,0:23:40.97,Default,,0000,0000,0000,,TẬP 23: TÌNH HÌNH SẼ CÀNG KHỐC LIỆT HƠN
