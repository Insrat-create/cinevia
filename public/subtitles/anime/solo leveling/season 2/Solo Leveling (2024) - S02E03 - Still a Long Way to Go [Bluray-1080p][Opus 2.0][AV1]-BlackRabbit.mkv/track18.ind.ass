Dialogue: 0,0:00:14.80,0:00:16.64,Default,,0000,0000,0000,,Kakak.
Dialogue: 0,0:00:18.04,0:00:19.48,Default,,0000,0000,0000,,Apa maksud semua benda ini?
Dialogue: 0,0:00:19.96,0:00:20.90,Default,,0000,0000,0000,,Iya.
Dialogue: 0,0:00:21.14,0:00:23.32,Default,,0000,0000,0000,,Aku belum memperlihatkannya padamu, ya.
Dialogue: 0,0:00:24.24,0:00:25.78,Default,,0000,0000,0000,,Ini salah satu keahlianku.
Dialogue: 0,0:00:27.40,0:00:30.98,Default,,0000,0000,0000,,Kau bisa memanggil benda-benda seperti ini\Ndengan keahlian?
Dialogue: 0,0:00:32.02,0:00:34.76,Default,,0000,0000,0000,,Ini agak rumit penjelasannya.
Dialogue: 0,0:00:55.14,0:00:56.22,Default,,0000,0000,0000,,Kakak.
Dialogue: 0,0:00:57.30,0:01:01.04,Default,,0000,0000,0000,,Setidaknya biarkan aku\Nmengumpulkan batu sihirnya.
Dialogue: 0,0:01:05.28,0:01:08.34,Default,,0000,0000,0000,,Terima kasih.
Dialogue: 0,0:01:16.58,0:01:18.30,Default,,0000,0000,0000,,Tidak.
Dialogue: 0,0:01:20.30,0:01:21.34,Default,,0000,0000,0000,,Astaga.
Dialogue: 0,0:01:23.88,0:01:24.78,Default,,0000,0000,0000,,Hei.
Dialogue: 0,0:01:25.12,0:01:26.66,Default,,0000,0000,0000,,Jangan berteriak sekencang itu.
Dialogue: 0,0:01:27.34,0:01:28.42,Default,,0000,0000,0000,,Tenang saja.
Dialogue: 0,0:01:28.42,0:01:30.58,Default,,0000,0000,0000,,Mereka semua hanya pingsan saja.
Dialogue: 0,0:01:31.78,0:01:33.58,Default,,0000,0000,0000,,Iya juga, kau juga tidak mengerti\Napa yang kukatakan.
Dialogue: 0,0:01:34.18,0:01:36.94,Default,,0000,0000,0000,,Bahasa Inggris-ku juga tidak bagus.
Dialogue: 0,0:01:42.92,0:01:44.38,Default,,0000,0000,0000,,Aku manusia.
Dialogue: 0,0:01:44.88,0:01:47.44,Default,,0000,0000,0000,,Aku mau pulang.
Dialogue: 0,0:01:58.67,0:02:02.38,Default,,0000,0000,0000,,(Solo Leveling Season 2\N-Arise from the Shadow-)
Dialogue: 0,0:03:23.01,0:03:23.92,Default,,0000,0000,0000,,Bersulang.
Dialogue: 0,0:03:24.60,0:03:26.44,Default,,0000,0000,0000,,Selamat datang, silakan masuk.
Dialogue: 0,0:03:29.59,0:03:31.97,Default,,0000,0000,0000,,Dengan begini, sembilan belas misi\Nyang dijanjikan sudah selesai.
Dialogue: 0,0:03:32.21,0:03:33.07,Default,,0000,0000,0000,,Iya.
Dialogue: 0,0:03:33.07,0:03:35.77,Default,,0000,0000,0000,,Semua ini berkat Kakak yang telah\Nmembantu menyelesaikannya dengan lancar.
Dialogue: 0,0:03:36.37,0:03:37.69,Default,,0000,0000,0000,,Apa rencanamu selanjutnya?
Dialogue: 0,0:03:38.39,0:03:40.97,Default,,0000,0000,0000,,Pertama-tama aku akan pergi ke asosiasi\Nuntuk mengikuti ujian tertulis.
Dialogue: 0,0:03:40.97,0:03:42.83,Default,,0000,0000,0000,,Untuk mendapatkan\Nlisensi Presiden Asosiasi.
Dialogue: 0,0:03:43.09,0:03:46.15,Default,,0000,0000,0000,,Kemudian gunakan ini sebagai kartu truf\Nuntuk bernegosiasi dengan ayahku.
Dialogue: 0,0:03:46.59,0:03:47.43,Default,,0000,0000,0000,,Begitu ya.
Dialogue: 0,0:03:48.01,0:03:50.21,Default,,0000,0000,0000,,Lalu Kakak? Apa rencanamu?
Dialogue: 0,0:03:54.63,0:03:56.87,Default,,0000,0000,0000,,Kau mungkin tidak bisa menghubungiku\Nuntuk sementara waktu.
Dialogue: 0,0:03:57.45,0:03:59.13,Default,,0000,0000,0000,,Aku akan pergi ke beberapa tempat...
Dialogue: 0,0:04:02.03,0:04:02.91,Default,,0000,0000,0000,,Ada apa?
Dialogue: 0,0:04:06.85,0:04:07.79,Default,,0000,0000,0000,,Kakak.
Dialogue: 0,0:04:08.03,0:04:11.35,Default,,0000,0000,0000,,Jika menurutmu aku menyebalkan,\Nkau bisa bilang terus terang.
Dialogue: 0,0:04:11.75,0:04:14.97,Default,,0000,0000,0000,,Aku tidak akan mengganggumu lagi nanti.
Dialogue: 0,0:04:17.73,0:04:19.29,Default,,0000,0000,0000,,Kau sudah mabuk?
Dialogue: 0,0:04:20.11,0:04:23.29,Default,,0000,0000,0000,,Aku punya seorang kakak laki-laki\Nyang lebih tua sepuluh tahun dariku.
Dialogue: 0,0:04:23.97,0:04:25.79,Default,,0000,0000,0000,,Kakakku tidak menyukaiku
Dialogue: 0,0:04:26.65,0:04:29.57,Default,,0000,0000,0000,,dan kami tidak pernah menghabiskan\Nwaktu bersama sebagai saudara.
Dialogue: 0,0:04:30.45,0:04:31.63,Default,,0000,0000,0000,,Sebagai perbandingan,
Dialogue: 0,0:04:32.29,0:04:34.93,Default,,0000,0000,0000,,Kakak tidak hanya menyelamatkan nyawaku,
Dialogue: 0,0:04:35.39,0:04:36.47,Default,,0000,0000,0000,,juga mengabulkan permintaanku...
Dialogue: 0,0:04:38.11,0:04:42.53,Default,,0000,0000,0000,,Aku benar-benar berharap kau\Nadalah kakakku.
Dialogue: 0,0:05:02.55,0:05:03.57,Default,,0000,0000,0000,,Kalau begitu,
Dialogue: 0,0:05:08.91,0:05:11.69,Default,,0000,0000,0000,,mulai hari ini kau adalah adikku.
Dialogue: 0,0:05:16.50,0:05:18.53,Default,,0000,0000,0000,,Kakak.
Dialogue: 0,0:05:22.81,0:05:23.75,Default,,0000,0000,0000,,Daging.
Dialogue: 0,0:05:23.75,0:05:24.95,Default,,0000,0000,0000,,Makanlah lebih banyak dagingnya.
Dialogue: 0,0:05:25.27,0:05:26.69,Default,,0000,0000,0000,,Akan kubakar semuanya untukmu.
Dialogue: 0,0:05:26.69,0:05:28.69,Default,,0000,0000,0000,,Hei, kau mengambil terlalu banyak.
Dialogue: 0,0:05:28.69,0:05:29.99,Default,,0000,0000,0000,,Kau mau ditambah lemon?
Dialogue: 0,0:05:29.99,0:05:30.91,Default,,0000,0000,0000,,Tidak usah.
Dialogue: 0,0:05:30.91,0:05:32.33,Default,,0000,0000,0000,,Ternyata kau memang mabuk.
Dialogue: 0,0:05:32.97,0:05:34.81,Default,,0000,0000,0000,,Aku sangat sadar sekarang.
Dialogue: 0,0:05:35.49,0:05:36.33,Default,,0000,0000,0000,,Tidak tahan.
Dialogue: 0,0:05:36.83,0:05:38.27,Default,,0000,0000,0000,,Benar-benar orang yang merepotkan.
Dialogue: 0,0:05:43.51,0:05:45.17,Default,,0000,0000,0000,,Sudah diketahui identitasnya?
Dialogue: 0,0:05:45.79,0:05:48.07,Default,,0000,0000,0000,,Dia mengaku sebagai pemburu asing.
Dialogue: 0,0:05:48.51,0:05:51.21,Default,,0000,0000,0000,,Sepuluh tahun lalu terperangkap\Ndi dalam portal,
Dialogue: 0,0:05:51.21,0:05:53.21,Default,,0000,0000,0000,,tidak bisa melarikan diri.
Dialogue: 0,0:05:53.65,0:05:56.93,Default,,0000,0000,0000,,Begitu sadar, baru menyadari dirinya\Nberada di portal yang terhubung ke Amerika.
Dialogue: 0,0:05:57.73,0:05:59.65,Default,,0000,0000,0000,,Ini situasi yang belum pernah\Nterjadi sebelumnya.
Dialogue: 0,0:06:00.09,0:06:01.01,Default,,0000,0000,0000,,Ada lagi?
Dialogue: 0,0:06:01.57,0:06:03.33,Default,,0000,0000,0000,,Dia sepertinya tidak bisa\Nberbahasa Inggris.
Dialogue: 0,0:06:03.71,0:06:05.95,Default,,0000,0000,0000,,Pemeriksaan belum dilakukan\Nbersama penerjemah.
Dialogue: 0,0:06:06.45,0:06:09.11,Default,,0000,0000,0000,,Juga tidak bisa dikesampingkan kemungkinan dia\Nadalah hewan iblis berbentuk manusia.
Dialogue: 0,0:06:09.70,0:06:10.81,Default,,0000,0000,0000,,Adakah cara untuk menanganinya?
Dialogue: 0,0:06:11.71,0:06:17.01,Default,,0000,0000,0000,,Kami sudah meminta bantuan pemburu Level S\Ndi Washington yang satu negara dengan dia.
Dialogue: 0,0:06:18.05,0:06:19.51,Default,,0000,0000,0000,,Pak Hwang?
Dialogue: 0,0:06:20.47,0:06:23.41,Default,,0000,0000,0000,,Setelah dia kembali ke negara,\Npemeriksaan bisa dimulai.
Dialogue: 0,0:06:23.95,0:06:24.31,Default,,0000,0000,0000,,Cih.
Dialogue: 0,0:06:24.71,0:06:25.93,Default,,0000,0000,0000,,Baguslah kalau begitu.
Dialogue: 0,0:06:26.21,0:06:28.31,Default,,0000,0000,0000,,Omong-omong, siapa nama orang ini?
Dialogue: 0,0:06:28.83,0:06:31.17,Default,,0000,0000,0000,,Pengucapannya agak sulit.
Dialogue: 0,0:06:32.61,0:06:35.19,Default,,0000,0000,0000,,Dia bilang namanya Sung Il-hwan.
Dialogue: 0,0:06:41.95,0:06:43.79,Default,,0000,0000,0000,,Aku akan pergi selama seminggu.
Dialogue: 0,0:06:44.29,0:06:46.61,Default,,0000,0000,0000,,Kau baru saja selesai bekerja\Ndan sudah mau pergi berlibur lagi?
Dialogue: 0,0:06:46.87,0:06:48.57,Default,,0000,0000,0000,,Kau benar-benar sibuk, ya.
Dialogue: 0,0:06:48.89,0:06:50.44,Default,,0000,0000,0000,,Karena aku punya banyak hal\Nyang harus dilakukan.
Dialogue: 0,0:06:51.67,0:06:53.83,Default,,0000,0000,0000,,Lalu, kau pergi dengan siapa?
Dialogue: 0,0:06:57.79,0:06:59.59,Default,,0000,0000,0000,,Kubilang dengan teman.
Dialogue: 0,0:06:59.59,0:07:02.01,Default,,0000,0000,0000,,Sejak kapan kau punya pacar?
Dialogue: 0,0:07:09.77,0:07:12.07,Default,,0000,0000,0000,,Saat bertarung dengan Cerberus,
Dialogue: 0,0:07:12.07,0:07:13.69,Default,,0000,0000,0000,,levelku sekitar 20,
Dialogue: 0,0:07:14.47,0:07:16.53,Default,,0000,0000,0000,,dan sekarang levelku\Ntiga kali lipat dari saat itu.
Dialogue: 0,0:07:17.53,0:07:19.89,Default,,0000,0000,0000,,Seharusnya aku bisa bertarung\Ndengan lebih mudah.
Dialogue: 0,0:07:38.99,0:07:40.91,Default,,0000,0000,0000,,Apakah ini berarti aku harus terus maju?
Dialogue: 0,0:07:49.35,0:07:50.21,Default,,0000,0000,0000,,Oh.
Dialogue: 0,0:07:50.21,0:07:51.25,Default,,0000,0000,0000,,Ini misi.
Dialogue: 0,0:07:51.95,0:07:54.77,Default,,0000,0000,0000,,Kastil Iblis dipenuhi iblis.
Dialogue: 0,0:07:54.77,0:07:57.33,Default,,0000,0000,0000,,Silakan kumpulkan jiwa iblis.
Dialogue: 0,0:07:58.01,0:08:00.55,Default,,0000,0000,0000,,Syarat penyelesaian misi adalah\Nmengumpulkan jiwa iblis...
Dialogue: 0,0:08:00.55,0:08:01.89,Default,,0000,0000,0000,,Sepuluh ribu?
Dialogue: 0,0:08:03.29,0:08:04.95,Default,,0000,0000,0000,,Sebanyak itu?
Dialogue: 0,0:08:08.81,0:08:09.61,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:08:09.95,0:08:12.30,Default,,0000,0000,0000,,kali ini aku datang untuk tujuan lain.
Dialogue: 0,0:08:12.30,0:08:14.01,Default,,0000,0000,0000,,CARA PEMBUATAN ELIKSIR KEHIDUPAN
Dialogue: 0,0:08:15.33,0:08:17.71,Default,,0000,0000,0000,,Entah itu sepuluh ribu atau seratus ribu,
Dialogue: 0,0:08:19.99,0:08:21.27,Default,,0000,0000,0000,,akan kutunjukkan padamu\Naku bisa mengalahkannya.
Dialogue: 0,0:08:26.77,0:08:27.98,Default,,0000,0000,0000,,YOO JINHO
Dialogue: 0,0:08:28.17,0:08:30.95,Default,,0000,0000,0000,,Kau bilang ingin aku menyerahkan\Nasosiasi kepadamu, 'kan?
Dialogue: 0,0:08:31.33,0:08:32.11,Default,,0000,0000,0000,,Iya.
Dialogue: 0,0:08:32.43,0:08:33.23,Default,,0000,0000,0000,,Hmm.
Dialogue: 0,0:08:34.99,0:08:39.01,Default,,0000,0000,0000,,Kau tahu rencana Jinsung tetapi masih\Nmengajukan permintaan ini padaku?
Dialogue: 0,0:08:40.29,0:08:43.65,Default,,0000,0000,0000,,Rencana kakakku untuk membiarkan\Norang luar menjadi Presiden Asosiasi,
Dialogue: 0,0:08:43.93,0:08:46.41,Default,,0000,0000,0000,,risikonya terlalu besar\Nbagi perusahaan kita...
Dialogue: 0,0:08:48.21,0:08:51.21,Default,,0000,0000,0000,,Pemburu itu bernama Sung Jinwoo, 'kan?
Dialogue: 0,0:08:51.93,0:08:53.13,Default,,0000,0000,0000,,Terungku ganda,
Dialogue: 0,0:08:53.63,0:08:56.01,Default,,0000,0000,0000,,insiden tewasnya seluruh\Ntim penyerang Hwang Dongsuk
Dialogue: 0,0:08:56.51,0:08:59.45,Default,,0000,0000,0000,,dan insiden Divisi Penyelidik membunuh\Nnarapidana yang menjalani hukuman,
Dialogue: 0,0:09:00.11,0:09:02.83,Default,,0000,0000,0000,,dia menghadapi tiga insiden ini\Ndan tetap selamat.
Dialogue: 0,0:09:05.17,0:09:08.37,Default,,0000,0000,0000,,Dia juga berpartisipasi dalam semua\NMisi Serangan yang kau selenggarakan.
Dialogue: 0,0:09:10.47,0:09:14.29,Default,,0000,0000,0000,,Beberapa hari lalu, portal merah\Nyang dihadapi Asosiasi Macan Putih,
Dialogue: 0,0:09:15.49,0:09:19.13,Default,,0000,0000,0000,,kudengar kabarnya Pemburu Sung juga yang\Nmemimpin para penyintas untuk kabur.
Dialogue: 0,0:09:23.01,0:09:27.37,Default,,0000,0000,0000,,Kau mengandalkannya untuk mendapatkan\Nlisensi Presiden Asosiasi, 'kan?
Dialogue: 0,0:09:28.11,0:09:30.11,Default,,0000,0000,0000,,Dengan begitu, kau masih ingin aku\Nmenyerahkan asosiasi kepadamu?
Dialogue: 0,0:09:34.91,0:09:35.95,Default,,0000,0000,0000,,Meskipun begitu...
Dialogue: 0,0:09:38.77,0:09:39.75,Default,,0000,0000,0000,,Meskipun begitu,
Dialogue: 0,0:09:41.57,0:09:43.81,Default,,0000,0000,0000,,aku tetap memintamu untuk menyerahkan\NAsosiasi Yoojin kepadaku.
Dialogue: 0,0:09:46.37,0:09:48.27,Default,,0000,0000,0000,,Urusan Kakak, nanti pasti akan ku...
Dialogue: 0,0:09:48.27,0:09:49.49,Default,,0000,0000,0000,,Aku mengerti.
Dialogue: 0,0:09:49.49,0:09:51.01,Default,,0000,0000,0000,,Aku bisa membiarkanmu mencoba.
Dialogue: 0,0:09:51.49,0:09:52.11,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:09:52.43,0:09:53.89,Default,,0000,0000,0000,,Namun, ada syaratnya.
Dialogue: 0,0:09:57.15,0:09:58.93,Default,,0000,0000,0000,,Setelah insiden portal merah itu,
Dialogue: 0,0:09:59.35,0:10:03.45,Default,,0000,0000,0000,,kudengar Asosiasi Macan Putih diam-diam\Ningin merekrut Pemburu Sung.
Dialogue: 0,0:10:04.49,0:10:07.39,Default,,0000,0000,0000,,Kau harus merekrutnya\Nke asosiasi kita sebelum itu.
Dialogue: 0,0:10:08.45,0:10:09.33,Default,,0000,0000,0000,,Kau bisa melakukannya?
Dialogue: 0,0:10:11.97,0:10:12.62,Default,,0000,0000,0000,,Aku akan melakukannya.
Dialogue: 0,0:10:16.87,0:10:18.03,Default,,0000,0000,0000,,Aku sangat mendukungmu.
Dialogue: 0,0:10:21.09,0:10:22.47,Default,,0000,0000,0000,,MANA SUDAH TERCEMAR\NTIDAK BISA MELAKUKAN EKSTRAKSI BAYANGAN
Dialogue: 0,0:10:22.85,0:10:26.29,Default,,0000,0000,0000,,Entah kenapa, sepertinya tidak bisa\Nmengekstrak iblis.
Dialogue: 0,0:10:27.13,0:10:29.18,Default,,0000,0000,0000,,Sayang sekali ada begitu banyak di sini.
Dialogue: 0,0:10:31.59,0:10:32.41,Default,,0000,0000,0000,,Oh?
Dialogue: 0,0:10:32.41,0:10:33.39,Default,,0000,0000,0000,,MENDAPATKAN PROP LISENSI MASUK
Dialogue: 0,0:10:37.87,0:10:40.79,Default,,0000,0000,0000,,Lisensi untuk naik ke lantai atas.
Dialogue: 0,0:10:40.79,0:10:43.43,Default,,0000,0000,0000,,LISENSI UNTUK NAIK KE LANTAI 2 KASTIL IBLIS\NHANYA BISA DIGUNAKAN DI FORMASI SIHIR BERGERAK DI LANTAI 1
Dialogue: 0,0:10:43.43,0:10:44.43,Default,,0000,0000,0000,,Begitu rupanya.
Dialogue: 0,0:10:44.79,0:10:46.77,Default,,0000,0000,0000,,Harus digunakan di sana, ya.
Dialogue: 0,0:10:47.67,0:10:49.71,Default,,0000,0000,0000,,Omong-omong,\Nterungku ini benar-benar besar.
Dialogue: 0,0:10:50.15,0:10:53.07,Default,,0000,0000,0000,,Rasanya seperti sebuah kota\Ndimasukkan ke dalam gedung.
Dialogue: 0,0:10:55.23,0:10:57.15,Default,,0000,0000,0000,,Berjalan kaki sangat melelahkan.
Dialogue: 0,0:11:06.81,0:11:08.95,Default,,0000,0000,0000,,Apakah kau pemimpin\Nkelompok Beruang Es itu?
Dialogue: 0,0:11:09.33,0:11:10.53,Default,,0000,0000,0000,,Kau besar sekali.
Dialogue: 0,0:11:11.55,0:11:12.63,Default,,0000,0000,0000,,Baiklah.
Dialogue: 0,0:11:12.85,0:11:14.15,Default,,0000,0000,0000,,Aku akan pergi melihat ke sana.
Dialogue: 0,0:11:15.30,0:11:16.04,Default,,0000,0000,0000,,Ya?
Dialogue: 0,0:11:17.39,0:11:18.31,Default,,0000,0000,0000,,Eh.
Dialogue: 0,0:11:18.55,0:11:19.99,Default,,0000,0000,0000,,Orang yang merepotkan.
Dialogue: 0,0:11:19.99,0:11:20.93,Default,,0000,0000,0000,,Wah.
Dialogue: 0,0:11:23.57,0:11:24.74,Default,,0000,0000,0000,,Eh.
Dialogue: 0,0:11:30.51,0:11:31.49,Default,,0000,0000,0000,,Kau cukup hebat.
Dialogue: 0,0:11:33.45,0:11:35.71,Default,,0000,0000,0000,,Mulai hari ini kau akan dipanggil Tank.
Dialogue: 0,0:11:50.70,0:11:51.45,Default,,0000,0000,0000,,Wah.
Dialogue: 0,0:11:51.45,0:11:52.77,Default,,0000,0000,0000,,Itu Nona Hae-In.
Dialogue: 0,0:11:52.77,0:11:54.51,Default,,0000,0000,0000,,Sungguh jarang bisa bertemu dengannya.
Dialogue: 0,0:11:54.51,0:11:56.57,Default,,0000,0000,0000,,Dia tetap cantik seperti biasanya.
Dialogue: 0,0:11:59.55,0:12:00.69,Default,,0000,0000,0000,,Kenapa?
Dialogue: 0,0:12:01.03,0:12:04.11,Default,,0000,0000,0000,,Mengapa tidak mengumumkan informasi\Ntentang semut bersayap kepada publik
Dialogue: 0,0:12:04.33,0:12:05.71,Default,,0000,0000,0000,,dan hanya memberi tahu\Nsebagian kecil orang?
Dialogue: 0,0:12:06.79,0:12:08.27,Default,,0000,0000,0000,,Ini instruksi dari asosiasi.
Dialogue: 0,0:12:08.65,0:12:12.01,Default,,0000,0000,0000,,Asosiasi menganggap mengumumkan sekarang\Nhanya akan menambah kepanikan masyarakat.
Dialogue: 0,0:12:12.47,0:12:13.20,Default,,0000,0000,0000,,Namun...
Dialogue: 0,0:12:13.67,0:12:14.95,Default,,0000,0000,0000,,Kau tidak perlu khawatir.
Dialogue: 0,0:12:15.37,0:12:17.77,Default,,0000,0000,0000,,Sekarang kita perlu mengumpulkan\Nkekuatan tempur.
Dialogue: 0,0:12:18.37,0:12:23.09,Default,,0000,0000,0000,,Demi menjadi asosiasi terbesar di negara ini\Ndan memikul tanggung jawab yang sesuai.
Dialogue: 0,0:12:26.05,0:12:27.69,Default,,0000,0000,0000,,Saat mendapatkan kunci ini,
Dialogue: 0,0:12:28.05,0:12:30.67,Default,,0000,0000,0000,,aku masih khawatir apakah tempat ini\Nakan menjadi terungku Level S.
Dialogue: 0,0:12:31.71,0:12:33.81,Default,,0000,0000,0000,,Namun, kekuatan iblis di sini\Nkira-kira di awal Level B.
Dialogue: 0,0:12:34.39,0:12:35.02,Default,,0000,0000,0000,,PROP LISENSI MASUK\NLANTAI 6 HINGGA 7
Dialogue: 0,0:12:35.39,0:12:36.49,Default,,0000,0000,0000,,Jumlahnya banyak
Dialogue: 0,0:12:36.91,0:12:39.33,Default,,0000,0000,0000,,dan makin ke atas,\Nkekuatannya makin tinggi.
Dialogue: 0,0:12:39.73,0:12:44.01,Default,,0000,0000,0000,,Namun, selama fokus mengalahkan iblis\Nyang memiliki lisensi,
Dialogue: 0,0:12:44.01,0:12:45.61,Default,,0000,0000,0000,,aku masih bisa naik dengan mudah.
Dialogue: 0,0:12:46.19,0:12:46.82,Default,,0000,0000,0000,,KEAHLIAN TANGAN PENGUASA NAIK KE LEVEL 2
Dialogue: 0,0:12:47.61,0:12:48.53,Default,,0000,0000,0000,,Meskipun begitu,
Dialogue: 0,0:12:48.83,0:12:51.55,Default,,0000,0000,0000,,jika struktur Kastil Iblis\Nsama dengan menara aslinya,
Dialogue: 0,0:12:51.89,0:12:53.93,Default,,0000,0000,0000,,maka tempat ini akan memiliki 100 lantai.
Dialogue: 0,0:12:54.97,0:12:59.15,Default,,0000,0000,0000,,Aku tidak tahu aku akan menjadi\Nseberapa kuat saat mencapai puncak.
Dialogue: 0,0:13:00.12,0:13:00.83,Default,,0000,0000,0000,,MENGUMPULKAN JIWA IBLIS 3.712/10.000
Dialogue: 0,0:13:01.13,0:13:03.05,Default,,0000,0000,0000,,Yang lebih penting adalah aku tidak tahu\Napakah persediaan makananku cukup...
Dialogue: 0,0:13:03.81,0:13:05.39,Default,,0000,0000,0000,,Juga janjiku dengan Jinah.
Dialogue: 0,0:13:05.76,0:13:06.46,Default,,0000,0000,0000,,MENGUMPULKAN JIWA IBLIS 4.059/10.000
Dialogue: 0,0:13:06.75,0:13:07.69,Default,,0000,0000,0000,,Sepertinya
Dialogue: 0,0:13:08.07,0:13:09.99,Default,,0000,0000,0000,,ini akan menjadi pertarungan\Nmelawan waktu.
Dialogue: 0,0:13:11.26,0:13:13.26,Default,,0000,0000,0000,,MENGUMPULKAN JIWA IBLIS
Dialogue: 0,0:13:14.60,0:13:15.85,Default,,0000,0000,0000,,MENGUMPULKAN JIWA IBLIS
Dialogue: 0,0:13:17.18,0:13:19.85,Default,,0000,0000,0000,,MENGUMPULKAN JIWA IBLIS
Dialogue: 0,0:13:19.85,0:13:20.90,Default,,0000,0000,0000,,SELESAI\NMENGUMPULKAN JIWA IBLIS
Dialogue: 0,0:13:24.95,0:13:26.69,Default,,0000,0000,0000,,Aku tidak tahu seberapa tinggi\Naku bisa mendaki...
Dialogue: 0,0:13:41.05,0:13:42.00,Default,,0000,0000,0000,,Apakah itu musuh bernama merah?
Dialogue: 0,0:13:43.42,0:13:44.96,Default,,0000,0000,0000,,PENGUASA LANTAI BAWAH AVARICIOUS VULCAN
Dialogue: 0,0:13:45.67,0:13:47.92,Default,,0000,0000,0000,,LANTAI 49 HINGGA 50
Dialogue: 0,0:13:51.42,0:13:53.80,Default,,0000,0000,0000,,Pemburu Sung sedang tidak di rumah.
Dialogue: 0,0:13:55.02,0:13:56.70,Default,,0000,0000,0000,,Di rumah hanya ada adik perempuannya\Nseorang diri.
Dialogue: 0,0:13:57.02,0:13:59.72,Default,,0000,0000,0000,,Dia juga hanya tahu\Nkakaknya pergi berlibur.
Dialogue: 0,0:14:00.56,0:14:03.06,Default,,0000,0000,0000,,Sudah sampai rumahnya\Ntetapi tetap gagal bertemu.
Dialogue: 0,0:14:03.36,0:14:06.34,Default,,0000,0000,0000,,Beberapa hari ini dia juga\Ntidak mengikuti Misi Serangan
Dialogue: 0,0:14:06.78,0:14:08.74,Default,,0000,0000,0000,,dan tidak ada catatan imigrasi.
Dialogue: 0,0:14:08.74,0:14:11.68,Default,,0000,0000,0000,,Sedangkan posisi terakhir\Nyang dilacak oleh asosiasi
Dialogue: 0,0:14:11.90,0:14:13.34,Default,,0000,0000,0000,,berada tepat di pusat kota.
Dialogue: 0,0:14:13.66,0:14:16.28,Default,,0000,0000,0000,,Eh, kau bahkan bisa\Nmenyelidiki hal seperti ini?
Dialogue: 0,0:14:17.68,0:14:19.00,Default,,0000,0000,0000,,Memang ini pekerjaanku.
Dialogue: 0,0:14:21.76,0:14:24.98,Default,,0000,0000,0000,,Tidak tahu dia sebenarnya\Nada di mana sekarang.
Dialogue: 0,0:14:25.76,0:14:28.12,Default,,0000,0000,0000,,Bos besar itu biar aku yang urus.
Dialogue: 0,0:14:28.64,0:14:30.70,Default,,0000,0000,0000,,Yang lainnya kuserahkan pada kalian.
Dialogue: 0,0:14:45.50,0:14:47.84,Default,,0000,0000,0000,,Berkat peningkatan inteligensi,
Dialogue: 0,0:14:48.18,0:14:51.64,Default,,0000,0000,0000,,jumlah pasukan yang bisa kusimpan dan kekuatan sihir\Nuntuk mempertahankan mereka juga meningkat pesat.
Dialogue: 0,0:14:51.98,0:14:54.10,Default,,0000,0000,0000,,Membuatku lebih leluasa saat bertarung.
Dialogue: 0,0:14:55.02,0:14:56.30,Default,,0000,0000,0000,,Omong-omong,
Dialogue: 0,0:14:56.82,0:14:58.70,Default,,0000,0000,0000,,orang itu berencana duduk sampai kapan?
Dialogue: 0,0:14:59.24,0:15:01.78,Default,,0000,0000,0000,,Jika dia tidak bergerak,\Naku yang akan menyerang duluan...
Dialogue: 0,0:15:08.98,0:15:11.71,Default,,0000,0000,0000,,Apa yang kau lakukan?
Dialogue: 0,0:15:15.94,0:15:16.76,Default,,0000,0000,0000,,Wah...
Dialogue: 0,0:15:16.98,0:15:18.76,Default,,0000,0000,0000,,Aku hanya memukulnya sekali\Ndan jadi begini.
Dialogue: 0,0:15:19.54,0:15:21.08,Default,,0000,0000,0000,,Apakah poin kekuatanku terlalu banyak?
Dialogue: 0,0:15:27.02,0:15:28.56,Default,,0000,0000,0000,,AVARICIOUS VULCAN MENGGUNAKAN AMARAH\NApakah itu jurusnya Cerberus?
Dialogue: 0,0:15:34.22,0:15:34.74,Default,,0000,0000,0000,,Iron.
Dialogue: 0,0:15:45.02,0:15:46.60,Default,,0000,0000,0000,,Serangan beruntun tanpa henti.
Dialogue: 0,0:15:46.84,0:15:48.84,Default,,0000,0000,0000,,Kenapa gerakannya begitu lincah?
Dialogue: 0,0:15:49.44,0:15:50.38,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:15:50.38,0:15:52.46,Default,,0000,0000,0000,,pasti ada celah.
Dialogue: 0,0:15:53.84,0:15:54.80,Default,,0000,0000,0000,,Itu sekarang.
Dialogue: 0,0:15:58.26,0:15:59.18,Default,,0000,0000,0000,,Berhasil.
Dialogue: 0,0:16:01.38,0:16:01.89,Default,,0000,0000,0000,,Astaga...
Dialogue: 0,0:16:01.89,0:16:02.47,Default,,0000,0000,0000,,KEAHLIAN TANGAN PENGUASA NAIK KE LEVEL 2
Dialogue: 0,0:16:02.70,0:16:03.72,Default,,0000,0000,0000,,Ah.
Dialogue: 0,0:16:07.96,0:16:09.00,Default,,0000,0000,0000,,Orang ini
Dialogue: 0,0:16:09.42,0:16:11.42,Default,,0000,0000,0000,,membaca gerakanku?
Dialogue: 0,0:16:12.02,0:16:13.60,Default,,0000,0000,0000,,Titik kerusakan yang bisa kuberikan
Dialogue: 0,0:16:14.04,0:16:16.04,Default,,0000,0000,0000,,hanya di kepala kecil itu?
Dialogue: 0,0:16:20.90,0:16:23.76,Default,,0000,0000,0000,,Pertama-tama harus menghentikan\Ngerakannya yang aneh itu.
Dialogue: 0,0:16:24.66,0:16:25.80,Default,,0000,0000,0000,,Adakah cara?
Dialogue: 0,0:16:27.38,0:16:28.54,Default,,0000,0000,0000,,Itu dia.
Dialogue: 0,0:16:39.52,0:16:41.78,Default,,0000,0000,0000,,Apakah kau tidak bisa\Nmelihat sekeliling karena Amarah?
Dialogue: 0,0:16:59.32,0:17:00.20,Default,,0000,0000,0000,,TERKALAHKAN PENGUASA LANTAI BAWAH\NAVARICIOUS VULCAN
Dialogue: 0,0:17:00.49,0:17:01.87,Default,,0000,0000,0000,,MENDAPATKAN PECAHAN POHON DUNIA\NBAHAN PROP SIHIR TINGKAT ATAS
Dialogue: 0,0:17:03.58,0:17:06.26,Default,,0000,0000,0000,,Tidak kusangka ada hewan iblis\Nyang bisa berbicara.
Dialogue: 0,0:17:08.00,0:17:10.44,Default,,0000,0000,0000,,Sudah kubilang berkali-kali\Naku bukan hewan iblis.
Dialogue: 0,0:17:10.68,0:17:12.52,Default,,0000,0000,0000,,Jika tidak percaya,
Dialogue: 0,0:17:12.52,0:17:15.30,Default,,0000,0000,0000,,tes DNA atau apa pun akan kulakukan.
Dialogue: 0,0:17:15.30,0:17:16.50,Default,,0000,0000,0000,,Diam kau.
Dialogue: 0,0:17:16.86,0:17:19.28,Default,,0000,0000,0000,,Jawab saja pertanyaanku.
Dialogue: 0,0:17:19.90,0:17:23.20,Default,,0000,0000,0000,,Aku sedang kesal karena diganggu.
Dialogue: 0,0:17:23.90,0:17:24.72,Default,,0000,0000,0000,,Dasar.
Dialogue: 0,0:17:25.30,0:17:28.20,Default,,0000,0000,0000,,Kenapa aku diberikan masalah ini?
Dialogue: 0,0:17:28.86,0:17:30.78,Default,,0000,0000,0000,,Hei, bolehkah aku bertanya?
Dialogue: 0,0:17:30.78,0:17:32.48,Default,,0000,0000,0000,,Sudah kubilang diam.
Dialogue: 0,0:17:33.24,0:17:37.22,Default,,0000,0000,0000,,Seberapa banyak yang manusia\Nketahui tentang portal dan hewan iblis?
Dialogue: 0,0:17:37.52,0:17:38.44,Default,,0000,0000,0000,,Apa?
Dialogue: 0,0:17:38.44,0:17:41.86,Default,,0000,0000,0000,,Seberapa banyak yang manusia\Nketahui tentang portal dan hewan iblis?
Dialogue: 0,0:17:42.48,0:17:44.54,Default,,0000,0000,0000,,Apa maksudmu bertanya begitu?
Dialogue: 0,0:17:44.90,0:17:47.16,Default,,0000,0000,0000,,Terungku, portal, hewan iblis.
Dialogue: 0,0:17:47.82,0:17:49.62,Default,,0000,0000,0000,,Itu semua hanyalah pertanda.
Dialogue: 0,0:17:50.12,0:17:54.26,Default,,0000,0000,0000,,Kekuatan bencana terburuk\Nakhirnya bangkit.
Dialogue: 0,0:17:54.50,0:17:55.92,Default,,0000,0000,0000,,Apa itu?
Dialogue: 0,0:17:56.62,0:17:58.22,Default,,0000,0000,0000,,Bencana terburuk.
Dialogue: 0,0:17:58.48,0:18:00.00,Default,,0000,0000,0000,,Hanya itu yang bisa kukatakan.
Dialogue: 0,0:18:01.20,0:18:02.28,Default,,0000,0000,0000,,Jadi?
Dialogue: 0,0:18:04.20,0:18:07.94,Default,,0000,0000,0000,,Tujuanku adalah mencegah\Nbencana itu terjadi.
Dialogue: 0,0:18:09.64,0:18:11.96,Default,,0000,0000,0000,,Jangan bicara omong kosong.
Dialogue: 0,0:18:12.20,0:18:14.82,Default,,0000,0000,0000,,Tahukah kau berapa banyak pemburu\Ndi dunia ini?
Dialogue: 0,0:18:15.12,0:18:16.92,Default,,0000,0000,0000,,Jika kekuatan pemburu dikumpulkan...
Dialogue: 0,0:18:16.92,0:18:20.44,Default,,0000,0000,0000,,Jumlah orang tidak berdaya\Ndi hadapan kekuatan itu.
Dialogue: 0,0:18:20.84,0:18:22.90,Default,,0000,0000,0000,,Hanya akan ditelan dan dimanfaatkan.
Dialogue: 0,0:18:23.30,0:18:25.42,Default,,0000,0000,0000,,Kau terlihat agak kuat...
Dialogue: 0,0:18:25.42,0:18:26.08,Default,,0000,0000,0000,,Apa?
Dialogue: 0,0:18:28.56,0:18:32.40,Default,,0000,0000,0000,,Seekor hewan iblis\Npunya nama seperti manusia.
Dialogue: 0,0:18:32.86,0:18:33.68,Default,,0000,0000,0000,,Bahkan
Dialogue: 0,0:18:34.00,0:18:36.02,Default,,0000,0000,0000,,punya istri dan dua anak.
Dialogue: 0,0:18:39.30,0:18:41.48,Default,,0000,0000,0000,,Kau ingat nama putramu?
Dialogue: 0,0:18:42.38,0:18:43.20,Default,,0000,0000,0000,,Jinwoo.
Dialogue: 0,0:18:45.60,0:18:47.68,Default,,0000,0000,0000,,Apa maksud aura membunuh ini?
Dialogue: 0,0:18:49.32,0:18:52.10,Default,,0000,0000,0000,,Sudah kubilang aku tidak akan\Nmenjawab pertanyaanmu.
Dialogue: 0,0:18:52.10,0:18:52.94,Default,,0000,0000,0000,,Jawab aku.
Dialogue: 0,0:18:52.94,0:18:54.52,Default,,0000,0000,0000,,Tidak, aku tidak akan menjawab.
Dialogue: 0,0:18:55.42,0:18:58.36,Default,,0000,0000,0000,,Namun, aku bisa memberitahumu kabar baik.
Dialogue: 0,0:18:59.42,0:19:01.52,Default,,0000,0000,0000,,Putramu sudah mati.
Dialogue: 0,0:19:02.96,0:19:04.62,Default,,0000,0000,0000,,Jika ada pesan terakhir,
Dialogue: 0,0:19:04.62,0:19:06.95,Default,,0000,0000,0000,,sampaikan saja padanya di neraka.
Dialogue: 0,0:19:22.78,0:19:23.88,Default,,0000,0000,0000,,Apa-apaan ini?
Dialogue: 0,0:19:23.88,0:19:25.28,Default,,0000,0000,0000,,Pertempurannya berat sebelah.
Dialogue: 0,0:19:26.26,0:19:28.06,Default,,0000,0000,0000,,Apakah kalian terkejut\Ndengan kekuatan kami?
Dialogue: 0,0:19:29.06,0:19:30.84,Default,,0000,0000,0000,,Kau tidak menyangka\Nakan seperti ini, 'kan?
Dialogue: 0,0:19:32.10,0:19:34.28,Default,,0000,0000,0000,,Hewan Iblis Abadi juga bisa merasa takut?
Dialogue: 0,0:19:35.08,0:19:35.96,Default,,0000,0000,0000,,Sudahlah.
Dialogue: 0,0:19:46.32,0:19:47.99,Default,,0000,0000,0000,,TERKALAHKAN, PEMANDU MAYAT HIDUP, METUS
Dialogue: 0,0:19:48.16,0:19:50.41,Default,,0000,0000,0000,,NAIK LEVEL
Dialogue: 0,0:19:53.90,0:19:54.92,Default,,0000,0000,0000,,Di sini.
Dialogue: 0,0:19:55.22,0:19:56.34,Default,,0000,0000,0000,,Cepat.
Dialogue: 0,0:19:56.34,0:19:58.66,Default,,0000,0000,0000,,Aku pernah mendengar.
Dialogue: 0,0:19:58.92,0:20:03.06,Default,,0000,0000,0000,,Saat pemburu Level S saling bertarung,\Nbisa merusak daratan dan sekitarnya menjadi reruntuhan.
Dialogue: 0,0:20:03.76,0:20:05.54,Default,,0000,0000,0000,,Jadi kerusakannya hanya segini...
Dialogue: 0,0:20:06.00,0:20:07.88,Default,,0000,0000,0000,,Ya, ini keberuntungan\Ndi tengah kemalangan.
Dialogue: 0,0:20:08.34,0:20:09.32,Default,,0000,0000,0000,,Dalam sekejap.
Dialogue: 0,0:20:09.86,0:20:10.92,Default,,0000,0000,0000,,Hanya dalam sekejap...
Dialogue: 0,0:20:11.40,0:20:13.50,Default,,0000,0000,0000,,Pak Hwang kalah.
Dialogue: 0,0:20:13.86,0:20:16.72,Default,,0000,0000,0000,,Kalah sebelum kerusakannya meluas.
Dialogue: 0,0:20:22.18,0:20:23.88,Default,,0000,0000,0000,,Persediaan makanan habis.
Dialogue: 0,0:20:24.54,0:20:25.90,Default,,0000,0000,0000,,Sepertinya perjalananku\Nhanya sampai di sini.
Dialogue: 0,0:20:27.64,0:20:29.22,Default,,0000,0000,0000,,Sekarang di lantai 75.
Dialogue: 0,0:20:29.52,0:20:31.64,Default,,0000,0000,0000,,Seharusnya masih ada\Nsekitar 25 lantai lagi.
Dialogue: 0,0:20:32.22,0:20:34.08,Default,,0000,0000,0000,,Jalannya masih panjang.
Dialogue: 0,0:20:34.70,0:20:37.26,Default,,0000,0000,0000,,Namun, hasilnya cukup memuaskan.
Dialogue: 0,0:20:38.52,0:20:41.28,Default,,0000,0000,0000,,Anting yang kudapat dari orang besar\Ndi lantai 50.
Dialogue: 0,0:20:42.14,0:20:44.84,Default,,0000,0000,0000,,Kalung yang kudapat dari tengkorak tadi.
Dialogue: 0,0:20:45.76,0:20:47.13,Default,,0000,0000,0000,,EFEK SET\NPerforma masing-masing
Dialogue: 0,0:20:47.13,0:20:48.22,Default,,0000,0000,0000,,NILAI KEMAMPUAN SEMUA +5\Ncukup bagus.
Dialogue: 0,0:20:48.22,0:20:50.18,Default,,0000,0000,0000,,NILAI KEMAMPUAN SEMUA +5\NNamun, efek setnya lebih bagus lagi.
Dialogue: 0,0:20:50.96,0:20:52.52,Default,,0000,0000,0000,,Dari tampilan jendela,
Dialogue: 0,0:20:52.52,0:20:55.64,Default,,0000,0000,0000,,bisa diperkirakan\Nmasih ada satu hewan iblis level Bos lagi.
Dialogue: 0,0:20:57.48,0:20:59.24,Default,,0000,0000,0000,,"Bola Ketamakan" ini juga lumayan bagus.
Dialogue: 0,0:20:59.80,0:21:01.80,Default,,0000,0000,0000,,Meskipun aku sendiri\Ntidak bisa menggunakannya,
Dialogue: 0,0:21:02.18,0:21:04.50,Default,,0000,0000,0000,,untungnya bisa diberikan\Nkepada orang lain.
Dialogue: 0,0:21:04.90,0:21:06.50,Default,,0000,0000,0000,,Jika diberikan kepada prajurit sihir,
Dialogue: 0,0:21:06.50,0:21:08.52,Default,,0000,0000,0000,,kekuatan sihirnya bisa\Nmenjadi dua kali lipat
Dialogue: 0,0:21:09.52,0:21:10.68,Default,,0000,0000,0000,,Dan juga
Dialogue: 0,0:21:11.54,0:21:14.84,Default,,0000,0000,0000,,"peti harta karun acak kutukan"\Nyang kupilih di hadiah misi.
Dialogue: 0,0:21:15.96,0:21:18.90,Default,,0000,0000,0000,,Awalnya kupikir tidak akan ada kesempatan\Nmendapatkannya lagi dan aku agak menyesal.
Dialogue: 0,0:21:20.62,0:21:22.38,Default,,0000,0000,0000,,Meskipun aku sudah menduganya.
Dialogue: 0,0:21:22.38,0:21:24.00,Default,,0000,0000,0000,,Ternyata tetap kunci, ya?
Dialogue: 0,0:21:25.00,0:21:26.60,Default,,0000,0000,0000,,Informasi tidak jelas?
Dialogue: 0,0:21:26.60,0:21:28.34,Default,,0000,0000,0000,,Kapan dan di mana ini akan digunakan?
Dialogue: 0,0:21:28.34,0:21:30.00,Default,,0000,0000,0000,,PROP TIDAK JELAS
Dialogue: 0,0:21:30.00,0:21:32.76,Default,,0000,0000,0000,,Namun, tujuan perjalananku bukan ini.
Dialogue: 0,0:21:35.08,0:21:36.00,Default,,0000,0000,0000,,Di lantai 50,
Dialogue: 0,0:21:36.36,0:21:39.80,Default,,0000,0000,0000,,saat mengalahkan Avaricious Vulcan\Naku mendapatkan "Pecahan Pohon Dunia".
Dialogue: 0,0:21:40.86,0:21:42.14,Default,,0000,0000,0000,,Dan setelah mengalahkan Metus,\NPemandu Mayat Hidup
Dialogue: 0,0:21:42.52,0:21:45.20,Default,,0000,0000,0000,,CARA PEMBUATAN ELIKSIR KEHIDUPAN\Ndi lantai 75,
Dialogue: 0,0:21:45.20,0:21:46.82,Default,,0000,0000,0000,,CARA PEMBUATAN ELIKSIR KEHIDUPAN\Naku mendapat "Air Hutan Gema".
Dialogue: 0,0:21:47.56,0:21:50.00,Default,,0000,0000,0000,,Dari tiga bahan eliksir kehidupan,
Dialogue: 0,0:21:50.00,0:21:51.28,Default,,0000,0000,0000,,aku sudah mendapatkan dua.
Dialogue: 0,0:21:52.42,0:21:53.46,Default,,0000,0000,0000,,Kurang satu lagi.
Dialogue: 0,0:21:54.28,0:21:55.76,Default,,0000,0000,0000,,Jika mendapatkannya satu lagi,\Naku bisa memberikan kepada ibuku…
Dialogue: 0,0:21:58.38,0:21:59.86,Default,,0000,0000,0000,,Kedatanganku selanjutnya,
Dialogue: 0,0:22:00.12,0:22:01.20,Default,,0000,0000,0000,,aku pasti akan mendapatkannya.
Dialogue: 0,0:22:41.96,0:22:44.63,Default,,0000,0000,0000,,(Solo Leveling)
Dialogue: 0,0:22:44.63,0:22:48.13,Default,,0000,0000,0000,,(Episode 15:\NMasih Jauh Jalan yang Harus Ditempuh)
Dialogue: 0,0:23:38.30,0:23:40.89,Default,,0000,0000,0000,,(Episode 16:\NTidak Akan Berpura-pura Lagi)
