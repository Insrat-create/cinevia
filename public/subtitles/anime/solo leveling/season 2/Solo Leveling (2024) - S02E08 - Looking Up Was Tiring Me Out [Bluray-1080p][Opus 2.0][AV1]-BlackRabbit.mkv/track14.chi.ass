Dialogue: 0,0:00:09.54,0:00:10.68,Default,,0000,0000,0000,,Đầu hàng!
Dialogue: 0,0:00:12.23,0:00:13.19,Default,,0000,0000,0000,,Tôi đầu hàng.
Dialogue: 0,0:00:13.19,0:00:14.96,Default,,0000,0000,0000,,Xin ngài hãy tha mạng.
Dialogue: 0,0:00:16.43,0:00:17.32,Default,,0000,0000,0000,,Giọng nói đó...
Dialogue: 0,0:00:17.91,0:00:18.92,Default,,0000,0000,0000,,Không lẽ ngươi...
Dialogue: 0,0:00:28.23,0:00:30.68,Default,,0000,0000,0000,,Xin lỗi, chúng tôi thua rồi!
Dialogue: 0,0:00:30.84,0:00:32.87,Default,,0000,0000,0000,,Mong ngài thủ hạ lưu tình!
Dialogue: 0,0:00:42.68,0:00:46.39,Default,,0000,0000,0000,,SOLO LEVELING PHẦN 2\N-VÙNG LÊN TỪ BÓNG TỐI-
Dialogue: 0,0:02:05.27,0:02:07.75,Default,,0000,0000,0000,,Cô tấn công chúng tôi,\Ngiờ lại xin tha mạng sao?
Dialogue: 0,0:02:08.51,0:02:10.80,Default,,0000,0000,0000,,Trong khi đồng bọn của cô chết cả rồi đấy.
Dialogue: 0,0:02:11.39,0:02:14.35,Default,,0000,0000,0000,,Trách nhiệm của hiệp sĩ\Nlà bảo vệ chủ nhân.
Dialogue: 0,0:02:14.35,0:02:17.43,Default,,0000,0000,0000,,Nên chỉ cần tôi bình an vô sự,\Nhọ sẽ vui lòng mà lên đường.
Dialogue: 0,0:02:19.21,0:02:20.76,Default,,0000,0000,0000,,"Chỉ cần tôi bình an..."
Dialogue: 0,0:02:21.55,0:02:22.32,Default,,0000,0000,0000,,Mà kệ đi.
Dialogue: 0,0:02:28.49,0:02:29.86,Default,,0000,0000,0000,,Có cơ hội!
Dialogue: 0,0:02:34.88,0:02:36.28,Default,,0000,0000,0000,,TUSK ĐÃ SỬ DỤNG KHÚC CA PHÒNG NGỰ
Dialogue: 0,0:02:36.28,0:02:37.08,Default,,0000,0000,0000,,Làm trò gì đấy?
Dialogue: 0,0:02:37.63,0:02:40.80,Default,,0000,0000,0000,,Chỉ cần ngài tha mạng,\Nchuyện gì tôi cũng đáp ứng ạ!
Dialogue: 0,0:02:41.04,0:02:42.55,Default,,0000,0000,0000,,Nên mong ngài rủ lòng thương...
Dialogue: 0,0:02:42.62,0:02:43.74,Default,,0000,0000,0000,,Cái ả này...
Dialogue: 0,0:02:45.16,0:02:48.79,Default,,0000,0000,0000,,Có thể giúp tôi lấy giấy phép lên tầng không?
Dialogue: 0,0:02:48.93,0:02:53.18,Default,,0000,0000,0000,,G-Giấy phép được\Ngia tộc chúng tôi quản lý ạ.
Dialogue: 0,0:02:53.22,0:02:55.84,Default,,0000,0000,0000,,Nếu được tha mạng,\Ntôi nguyện dâng cho ngài ạ!
Dialogue: 0,0:02:56.13,0:02:59.99,Default,,0000,0000,0000,,Tôi cũng nắm rõ vị trí\Ncủa giấy phép các tầng bên trên,
Dialogue: 0,0:02:59.99,0:03:04.59,Default,,0000,0000,0000,,nên nếu được ngài đảm bảo an toàn\Ncho toàn gia tộc thì tôi xin dẫn đường.
Dialogue: 0,0:03:04.95,0:03:07.13,Default,,0000,0000,0000,,Hóa ra các người đang giấu nó à?
Dialogue: 0,0:03:07.46,0:03:10.48,Default,,0000,0000,0000,,Bảo sao diệt hết con này tới con khác\Nvẫn không thấy.
Dialogue: 0,0:03:11.10,0:03:12.08,Default,,0000,0000,0000,,Vấn đề là...
Dialogue: 0,0:03:14.79,0:03:18.21,Default,,0000,0000,0000,,Liệu tôi có thể tin tưởng cô không?
Dialogue: 0,0:03:18.91,0:03:20.92,Default,,0000,0000,0000,,D-Dĩ nhiên là có ạ.
Dialogue: 0,0:03:21.33,0:03:25.04,Default,,0000,0000,0000,,T-Tôi sẽ không nói dối.
Dialogue: 0,0:03:27.84,0:03:28.55,Default,,0000,0000,0000,,Được rồi.
Dialogue: 0,0:03:28.95,0:03:31.55,Default,,0000,0000,0000,,Chỉ cần lấy được giấy phép,\Ntôi sẽ ngừng gây thiệt hại.
Dialogue: 0,0:03:32.68,0:03:35.28,Default,,0000,0000,0000,,C-Cảm ơn ạ.
Dialogue: 0,0:03:36.55,0:03:37.51,Default,,0000,0000,0000,,Mà này...
Dialogue: 0,0:03:38.51,0:03:40.06,Default,,0000,0000,0000,,Đám các cô là thế nào vậy?
Dialogue: 0,0:03:57.47,0:04:00.31,Default,,0000,0000,0000,,Tôi là Esil, trưởng nữ của Gia tộc Radiru.
Dialogue: 0,0:04:00.71,0:04:03.40,Default,,0000,0000,0000,,À, ý tôi không phải thế.
Dialogue: 0,0:04:03.52,0:04:04.41,Default,,0000,0000,0000,,Hở?
Dialogue: 0,0:04:05.35,0:04:06.94,Default,,0000,0000,0000,,Mình đã nghĩ biết đâu...
Dialogue: 0,0:04:06.94,0:04:10.32,Default,,0000,0000,0000,,sẽ kiếm được thông tin về hệ thống\Nchứ không như vụ của Baruka.
Dialogue: 0,0:04:12.00,0:04:16.25,Default,,0000,0000,0000,,Trong đầu các cô có liên tục vang vọng\Ngiọng nói "Hãy giết con người" không?
Dialogue: 0,0:04:16.56,0:04:17.11,Default,,0000,0000,0000,,Ơ?
Dialogue: 0,0:04:17.74,0:04:18.44,Default,,0000,0000,0000,,À...
Dialogue: 0,0:04:19.50,0:04:20.20,Default,,0000,0000,0000,,Không có.
Dialogue: 0,0:04:20.39,0:04:22.59,Default,,0000,0000,0000,,Nhưng có nghe thấy một mệnh lệnh khác.
Dialogue: 0,0:04:22.77,0:04:23.44,Default,,0000,0000,0000,,Là gì?
Dialogue: 0,0:04:24.72,0:04:26.51,Default,,0000,0000,0000,,Hãy bảo vệ nơi đang ở.
Dialogue: 0,0:04:27.64,0:04:28.43,Default,,0000,0000,0000,,Từ bao giờ?
Dialogue: 0,0:04:28.91,0:04:30.60,Default,,0000,0000,0000,,Từ khi chúng tôi tới đây.
Dialogue: 0,0:04:30.96,0:04:32.19,Default,,0000,0000,0000,,Từ khi tới đây sao!?
Dialogue: 0,0:04:33.25,0:04:34.43,Default,,0000,0000,0000,,Trước đó, các cô ở đâu?
Dialogue: 0,0:04:34.74,0:04:35.76,Default,,0000,0000,0000,,Quỷ giới.
Dialogue: 0,0:04:35.95,0:04:39.26,Default,,0000,0000,0000,,Tuy nhiên, một ngày nọ,\Nchúng tôi bỗng nhận ra đã ở đây...
Dialogue: 0,0:04:39.98,0:04:40.96,Default,,0000,0000,0000,,Khi ở quỷ giới...
Dialogue: 0,0:04:41.84,0:04:42.89,Default,,0000,0000,0000,,Các cô đang làm gì?
Dialogue: 0,0:04:45.91,0:04:46.94,Default,,0000,0000,0000,,Chiến tranh.
Dialogue: 0,0:04:47.95,0:04:50.24,Default,,0000,0000,0000,,Chúng tôi đang chuẩn bị cho chiến tranh.
Dialogue: 0,0:04:50.62,0:04:51.66,Default,,0000,0000,0000,,Chiến tranh?
Dialogue: 0,0:04:52.23,0:04:52.90,Default,,0000,0000,0000,,Với ai?
Dialogue: 0,0:04:54.23,0:04:58.43,Default,,0000,0000,0000,,Cường địch cần tới\Ntoàn bộ ác quỷ tập trung để đối phó.
Dialogue: 0,0:04:59.15,0:05:02.22,Default,,0000,0000,0000,,Khi ấy, cuộc chiến với kẻ địch đó\Ndường như sắp xảy ra...
Dialogue: 0,0:05:04.42,0:05:08.25,Default,,0000,0000,0000,,Do vượt quá lượng thông tin cho phép,\Ncuộc hội thoại này sẽ bị dừng lại.
Dialogue: 0,0:05:08.48,0:05:12.23,Default,,0000,0000,0000,,Do vượt quá lượng thông tin cho phép,\Ncuộc hội thoại này sẽ bị dừng lại.
Dialogue: 0,0:05:12.35,0:05:13.50,Default,,0000,0000,0000,,Do vượt quá...
Dialogue: 0,0:05:18.34,0:05:20.37,Default,,0000,0000,0000,,Có vẻ không thể hỏi thêm nữa.
Dialogue: 0,0:05:23.32,0:05:26.63,Default,,0000,0000,0000,,Đây là hồ sơ thảo phạt\Nvà tình hình thiệt hại
Dialogue: 0,0:05:26.63,0:05:30.99,Default,,0000,0000,0000,,ở một đảo biệt lập của Nhật Bản\Nbị quái vật kiến cánh đổ bộ.
Dialogue: 0,0:05:31.68,0:05:33.97,Default,,0000,0000,0000,,Thiệt hại về dân thường là 294 người.
Dialogue: 0,0:05:34.56,0:05:37.26,Default,,0000,0000,0000,,Số lượng Hunter đã triển khai\Nlà 108 người.
Dialogue: 0,0:05:37.83,0:05:42.69,Default,,0000,0000,0000,,Trong lúc chiến đấu đã có\Nbốn cấp E, một cấp C và một cấp B hi sinh.
Dialogue: 0,0:05:44.00,0:05:46.71,Default,,0000,0000,0000,,Chỉ một con mà gây thiệt hại như này sao.
Dialogue: 0,0:05:47.09,0:05:49.06,Default,,0000,0000,0000,,Các Hunter cấp A hội họp sau đó
Dialogue: 0,0:05:49.06,0:05:52.27,Default,,0000,0000,0000,,đã giáng đòn quyết định\Nvà thành công tiêu diệt nó.
Dialogue: 0,0:05:52.68,0:05:56.01,Default,,0000,0000,0000,,Tức là con kiến cánh đó\Ncó phân hạng là cấp A.
Dialogue: 0,0:05:56.87,0:06:01.43,Default,,0000,0000,0000,,Đó cũng là kiến giải của tổ điều tra\Nsau khi giải phẫu xác của nó ạ.
Dialogue: 0,0:06:04.49,0:06:08.54,Default,,0000,0000,0000,,Lần này, hòn đảo chịu thiệt hại\Ncách Đảo Jeju 120km.
Dialogue: 0,0:06:09.33,0:06:12.47,Default,,0000,0000,0000,,Nếu lũ kiến có được năng lực bay
Dialogue: 0,0:06:12.47,0:06:15.01,Default,,0000,0000,0000,,thì phía Nam đất nước\Ncũng nằm trong phạm vi đổ bộ.
Dialogue: 0,0:06:16.07,0:06:18.38,Default,,0000,0000,0000,,Hãy khẩn trương yêu cầu Nhật Bản trợ giúp.
Dialogue: 0,0:06:19.08,0:06:22.79,Default,,0000,0000,0000,,Đồng thời thông báo cho các nước lân cận\Nnâng cao mức độ cảnh giới.
Dialogue: 0,0:06:22.88,0:06:23.51,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:06:23.94,0:06:25.59,Default,,0000,0000,0000,,Chuyện gì phải tới cũng đã tới.
Dialogue: 0,0:06:25.78,0:06:27.12,Default,,0000,0000,0000,,Không còn thời gian nữa rồi.
Dialogue: 0,0:06:27.85,0:06:31.79,Default,,0000,0000,0000,,Thật lòng tôi muốn ra tay\Ntrước khi có người bị hại...
Dialogue: 0,0:06:32.87,0:06:36.52,Default,,0000,0000,0000,,Sau đây, với quyền hạn\Ncủa Hội trưởng Hiệp hội Hunter...
Dialogue: 0,0:06:36.98,0:06:40.24,Default,,0000,0000,0000,,Tôi tuyên bố phát động kế hoạch\NChinh phạt Đảo Jeju lần thứ tư!
Dialogue: 0,0:06:42.42,0:06:43.59,Default,,0000,0000,0000,,Xin lỗi ngài.
Dialogue: 0,0:06:44.14,0:06:47.16,Default,,0000,0000,0000,,Không hiểu tại sao tôi lại bất tỉnh nữa.
Dialogue: 0,0:06:47.74,0:06:49.66,Default,,0000,0000,0000,,À, đừng bận tâm.
Dialogue: 0,0:06:50.09,0:06:51.73,Default,,0000,0000,0000,,Cơ thể cô không sao chứ?
Dialogue: 0,0:06:52.09,0:06:53.59,Default,,0000,0000,0000,,Vâng, bình thường ạ.
Dialogue: 0,0:06:54.11,0:06:56.48,Default,,0000,0000,0000,,Vậy là ngài có lo lắng cho tôi nhỉ.
Dialogue: 0,0:06:56.71,0:06:58.24,Default,,0000,0000,0000,,Ừ, có thể nói là vậy.
Dialogue: 0,0:06:59.75,0:07:02.37,Default,,0000,0000,0000,,Quan trọng hơn là sắp tới điểm đến chưa?
Dialogue: 0,0:07:02.58,0:07:04.04,Default,,0000,0000,0000,,À, vâng!
Dialogue: 0,0:07:04.16,0:07:06.08,Default,,0000,0000,0000,,Kia là lâu đài của Gia tộc Radiru.
Dialogue: 0,0:07:06.48,0:07:08.20,Default,,0000,0000,0000,,Giấy phép đang ở đó ạ.
Dialogue: 0,0:07:09.86,0:07:13.43,Default,,0000,0000,0000,,Rốt cuộc con đã dẫn thứ gì về vậy, Esil?
Dialogue: 0,0:07:13.43,0:07:13.89,Default,,0000,0000,0000,,Ơ?
Dialogue: 0,0:07:14.36,0:07:16.35,Default,,0000,0000,0000,,C-Con không nhìn thấy sao?
Dialogue: 0,0:07:16.36,0:07:19.87,Default,,0000,0000,0000,,Vô số binh sĩ đang\Nnấp trong bóng của gã đó!
Dialogue: 0,0:07:20.34,0:07:22.81,Default,,0000,0000,0000,,Ồ, sắc bén đấy nhỉ.
Dialogue: 0,0:07:22.84,0:07:27.99,Default,,0000,0000,0000,,Nếu ngươi dùng mưu lừa con gái ta\Nđể tới đây thì đừng mong sống sót trở về!
Dialogue: 0,0:07:28.24,0:07:30.59,Default,,0000,0000,0000,,P-Phụ thân à, hãy đợi đã!
Dialogue: 0,0:07:31.10,0:07:32.92,Default,,0000,0000,0000,,Tôi đã hứa với cô ấy.
Dialogue: 0,0:07:33.20,0:07:36.38,Default,,0000,0000,0000,,Nếu lấy được giấy phép\Nthì sẽ không gây thêm thiệt hại.
Dialogue: 0,0:07:38.73,0:07:42.38,Default,,0000,0000,0000,,Nghe nói Vulcan và Metus\Nđã bị tiêu diệt...
Dialogue: 0,0:07:42.38,0:07:46.38,Default,,0000,0000,0000,,Đối thủ như này thì gia tộc của ta\Nkhông thể nào thắng được...
Dialogue: 0,0:07:47.91,0:07:48.98,Default,,0000,0000,0000,,Đành vậy!
Dialogue: 0,0:07:54.28,0:07:56.24,Default,,0000,0000,0000,,GIẤY PHÉP LÊN TẦNG\NCHO PHÉP LÊN TẦNG 81.\NCHỈ CÓ THỂ SỬ DỤNG Ở CỔNG DỊCH CHUYỂN CỦA TẦNG 80.
Dialogue: 0,0:07:57.40,0:07:58.67,Default,,0000,0000,0000,,Đúng là đã được cấp phép.
Dialogue: 0,0:07:59.91,0:08:02.37,Default,,0000,0000,0000,,Vậy thì chuyện này coi như xong...
Dialogue: 0,0:08:02.76,0:08:04.63,Default,,0000,0000,0000,,Ngươi hãy mau rời đi!
Dialogue: 0,0:08:04.75,0:08:05.97,Default,,0000,0000,0000,,Còn một chuyện nữa.
Dialogue: 0,0:08:07.04,0:08:08.64,Default,,0000,0000,0000,,Hãy cho tôi mượn cô gái này.
Dialogue: 0,0:08:08.66,0:08:09.19,Default,,0000,0000,0000,,Hả?
Dialogue: 0,0:08:09.48,0:08:10.39,Default,,0000,0000,0000,,Hả!?
Dialogue: 0,0:08:12.59,0:08:15.12,Default,,0000,0000,0000,,Ấy, hiểu lầm rồi,\Ntôi muốn nhờ cô ấy dẫn đường.
Dialogue: 0,0:08:15.42,0:08:18.33,Default,,0000,0000,0000,,Vì cô ấy bảo là biết\Ngiấy phép của các tầng đang ở đâu.
Dialogue: 0,0:08:20.18,0:08:21.96,Default,,0000,0000,0000,,Thế còn an toàn của con gái ta?
Dialogue: 0,0:08:22.11,0:08:22.93,Default,,0000,0000,0000,,Tôi sẽ bảo đảm.
Dialogue: 0,0:08:26.14,0:08:27.08,Default,,0000,0000,0000,,Đành vậy.
Dialogue: 0,0:08:27.47,0:08:28.45,Default,,0000,0000,0000,,Ta hiểu rồi.
Dialogue: 0,0:08:29.03,0:08:31.58,Default,,0000,0000,0000,,Vậy đấy, nhờ cô nhé, Esil.
Dialogue: 0,0:08:31.91,0:08:32.42,Default,,0000,0000,0000,,Vâng!
Dialogue: 0,0:08:45.28,0:08:46.18,Default,,0000,0000,0000,,Hội trưởng.
Dialogue: 0,0:08:51.25,0:08:54.34,Default,,0000,0000,0000,,BẠN ĐÃ ĐÁNH BẠI HIỆP SĨ QUỶ\NBẠN ĐÃ ĐÁNH BẠI QUÝ TỘC QUỶ
Dialogue: 0,0:08:54.59,0:08:56.71,Default,,0000,0000,0000,,GIẤY PHÉP LÊN TẦNG 90
Dialogue: 0,0:08:57.16,0:08:59.94,Default,,0000,0000,0000,,Tốt, vậy là chinh phục xong tầng 89.
Dialogue: 0,0:09:01.99,0:09:04.90,Default,,0000,0000,0000,,Igris và Tank sau khi lên cấp\Nđã được thăng hạng.
Dialogue: 0,0:09:05.01,0:09:06.68,Default,,0000,0000,0000,,IGRIS ĐÃ THĂNG HẠNG HIỆP SĨ TINH ANH\NTANK ĐÃ THĂNG HẠNG HIỆP SĨ
Dialogue: 0,0:09:06.95,0:09:09.20,Default,,0000,0000,0000,,Phân hạng này ngang với cấp S và cấp A.
Dialogue: 0,0:09:09.54,0:09:11.25,Default,,0000,0000,0000,,Chiến lực lại được bổ sung.
Dialogue: 0,0:09:13.77,0:09:14.62,Default,,0000,0000,0000,,Ôi...
Dialogue: 0,0:09:15.04,0:09:19.91,Default,,0000,0000,0000,,Vậy là quà cáp mang theo để đàm phán\Nlại trở nên vô dụng rồi.
Dialogue: 0,0:09:20.07,0:09:21.88,Default,,0000,0000,0000,,Cô cứ vậy mà mang về luôn đi.
Dialogue: 0,0:09:22.22,0:09:23.64,Default,,0000,0000,0000,,Không được!
Dialogue: 0,0:09:23.86,0:09:27.04,Default,,0000,0000,0000,,Từ tầng 90 trở lên\Nlà do quý tộc thượng cấp cai quản.
Dialogue: 0,0:09:27.75,0:09:30.59,Default,,0000,0000,0000,,Sức mạnh của họ khác hẳn\Nso với những kẻ ngài gặp trước giờ.
Dialogue: 0,0:09:31.13,0:09:34.44,Default,,0000,0000,0000,,Do đó, nên nói chuyện\Nđể có được giấy phép thì hơn...
Dialogue: 0,0:09:34.44,0:09:36.86,Default,,0000,0000,0000,,Nếu tôi yếu hơn các cô...
Dialogue: 0,0:09:37.08,0:09:38.74,Default,,0000,0000,0000,,Thì có được phép nói chuyện không?
Dialogue: 0,0:09:40.05,0:09:41.22,Default,,0000,0000,0000,,Vấn đề là như vậy đấy.
Dialogue: 0,0:09:42.18,0:09:45.29,Default,,0000,0000,0000,,Quý tộc ác quỷ vẫn luôn đánh nhau\Nđể tranh giành thứ hạng đúng không?
Dialogue: 0,0:09:45.96,0:09:49.43,Default,,0000,0000,0000,,Tôi sẽ đưa Gia tộc Radish lên hạng nhất.
Dialogue: 0,0:09:49.83,0:09:51.49,Default,,0000,0000,0000,,Là Radiru mà...
Dialogue: 0,0:09:52.00,0:09:57.15,Default,,0000,0000,0000,,Dạ thưa, tại sao ngài Jinwoo\Nlại tha mạng cho gia tộc chúng tôi ạ?
Dialogue: 0,0:09:58.01,0:09:59.61,Default,,0000,0000,0000,,Vì tôi có cảm tình với cô.
Dialogue: 0,0:09:59.80,0:10:00.54,Default,,0000,0000,0000,,Hả!?
Dialogue: 0,0:10:00.54,0:10:01.83,Default,,0000,0000,0000,,Cái gì!?
Dialogue: 0,0:10:02.27,0:10:03.78,Default,,0000,0000,0000,,Hết Jinho lại tới Esil...
Dialogue: 0,0:10:04.49,0:10:08.28,Default,,0000,0000,0000,,Có vẻ mình hơi bị yếu lòng\Nvới kiểu đàn em lóng ngóng thì phải.
Dialogue: 0,0:10:09.35,0:10:10.72,Default,,0000,0000,0000,,Esil có thể về được rồi.
Dialogue: 0,0:10:10.82,0:10:11.27,Default,,0000,0000,0000,,Hể!?
Dialogue: 0,0:10:11.58,0:10:12.90,Default,,0000,0000,0000,,Ế!?
Dialogue: 0,0:10:13.70,0:10:15.87,Default,,0000,0000,0000,,Kẻ địch tới đây sẽ mạnh hơn mà.
Dialogue: 0,0:10:16.52,0:10:18.53,Default,,0000,0000,0000,,Tôi cũng hứa với cha của cô rồi.
Dialogue: 0,0:10:18.58,0:10:20.67,Default,,0000,0000,0000,,Cô chỉ cần cho tôi biết giấy phép ở đâu.
Dialogue: 0,0:10:20.67,0:10:22.57,Default,,0000,0000,0000,,Chuyện còn lại tôi sẽ tự lo liệu.
Dialogue: 0,0:10:23.21,0:10:26.09,Default,,0000,0000,0000,,Tôi vô dụng tới mức đó ạ?
Dialogue: 0,0:10:26.61,0:10:27.87,Default,,0000,0000,0000,,Không phải thế.
Dialogue: 0,0:10:27.96,0:10:29.23,Default,,0000,0000,0000,,Chỉ là lo cô gặp nguy thôi.
Dialogue: 0,0:10:29.46,0:10:30.76,Default,,0000,0000,0000,,Vất vả rồi.
Dialogue: 0,0:10:31.30,0:10:32.00,Default,,0000,0000,0000,,Cảm ơn nhé.
Dialogue: 0,0:10:33.15,0:10:35.60,Default,,0000,0000,0000,,Tôi sẽ đồng hành tới cùng ạ.
Dialogue: 0,0:10:35.65,0:10:36.78,Default,,0000,0000,0000,,Tôi muốn nhìn thấy ạ.
Dialogue: 0,0:10:37.07,0:10:39.23,Default,,0000,0000,0000,,Liệu ngài Jinwoo sẽ có thành tựu gì?
Dialogue: 0,0:10:41.20,0:10:42.32,Default,,0000,0000,0000,,Hiểu rồi.
Dialogue: 0,0:10:42.60,0:10:43.51,Default,,0000,0000,0000,,Vậy thì đi thôi.
Dialogue: 0,0:10:45.26,0:10:45.99,Default,,0000,0000,0000,,Vâng!
Dialogue: 0,0:10:49.87,0:10:53.82,Default,,0000,0000,0000,,Đúng như Esil nói, kể từ tầng 90,\Nđộ khó đã tăng mạnh.
Dialogue: 0,0:10:54.63,0:10:59.80,Default,,0000,0000,0000,,Sức mạnh và số lượng quái vật thủ thành\Nkhác hẳn so với các tầng dưới.
Dialogue: 0,0:11:00.39,0:11:02.60,Default,,0000,0000,0000,,Dẫu vậy, tôi vẫn có thể
Dialogue: 0,0:11:02.60,0:11:04.50,Default,,0000,0000,0000,,ĐÃ ĐẾN TẦNG 92\Nchinh phục từng tầng một.
Dialogue: 0,0:11:04.51,0:11:05.72,Default,,0000,0000,0000,,ĐÃ ĐẾN TẦNG 95
Dialogue: 0,0:11:06.11,0:11:07.48,Default,,0000,0000,0000,,Nhất định phải lấy được
Dialogue: 0,0:11:07.48,0:11:10.08,Default,,0000,0000,0000,,ĐÃ ĐẾN TẦNG 97\Nnguyên liệu của Thần Dược Sự Sống.
Dialogue: 0,0:11:10.24,0:11:11.15,Default,,0000,0000,0000,,Do đó...
Dialogue: 0,0:11:15.39,0:11:17.16,Default,,0000,0000,0000,,Tôi và Hunter Cha được triệu tập
Dialogue: 0,0:11:17.16,0:11:20.08,Default,,0000,0000,0000,,để tham gia Cuộc chinh phạt\NĐảo Jeju lần thứ tư.
Dialogue: 0,0:11:20.24,0:11:20.70,Default,,0000,0000,0000,,Vâng.
Dialogue: 0,0:11:21.24,0:11:25.10,Default,,0000,0000,0000,,Hình như ngoài chúng ta,\NGiám đốc Baek của Hội Bạch Hổ...
Dialogue: 0,0:11:25.10,0:11:28.88,Default,,0000,0000,0000,,và toàn bộ Hunter cấp S trong nước\Nđều được ngỏ lời.
Dialogue: 0,0:11:29.50,0:11:31.34,Default,,0000,0000,0000,,Vậy là có cả Hunter Sung...
Dialogue: 0,0:11:31.93,0:11:33.36,Default,,0000,0000,0000,,Tuy nhiên, chiến dịch này...
Dialogue: 0,0:11:33.36,0:11:37.59,Default,,0000,0000,0000,,đã được chính thức quyết định\Nsẽ hiệp đồng tác chiến với nước bạn.
Dialogue: 0,0:11:38.16,0:11:39.23,Default,,0000,0000,0000,,Với Nhật Bản ạ?
Dialogue: 0,0:11:39.70,0:11:40.11,Default,,0000,0000,0000,,Phải.
Dialogue: 0,0:11:41.04,0:11:43.32,Default,,0000,0000,0000,,Nếu xét theo khả năng bay của kiến cánh
Dialogue: 0,0:11:43.32,0:11:45.58,Default,,0000,0000,0000,,thì họ cũng nằm trong\Nphạm vi bị tấn công.
Dialogue: 0,0:11:45.92,0:11:47.39,Default,,0000,0000,0000,,Dĩ nhiên sẽ quyết định như thế.
Dialogue: 0,0:11:48.96,0:11:50.11,Default,,0000,0000,0000,,Ai cũng được.
Dialogue: 0,0:11:50.84,0:11:52.98,Default,,0000,0000,0000,,Chỉ cần có thể tiêu diệt bọn chúng...
Dialogue: 0,0:11:54.56,0:11:55.83,Default,,0000,0000,0000,,Ngày nào sẽ chinh phạt ạ?
Dialogue: 0,0:11:56.43,0:11:57.45,Default,,0000,0000,0000,,Vẫn đang sắp xếp.
Dialogue: 0,0:11:57.81,0:12:00.02,Default,,0000,0000,0000,,Nhưng chắc hẳn sẽ sớm được ấn định thôi.
Dialogue: 0,0:12:00.86,0:12:04.26,Default,,0000,0000,0000,,Ngoài ra, để bàn bạc kế hoạch tác chiến,
Dialogue: 0,0:12:04.30,0:12:08.57,Default,,0000,0000,0000,,hôm nay, Hunter của bang hội\Nlớn bậc nhất bên họ sẽ tới đây.
Dialogue: 0,0:12:12.83,0:12:13.21,Default,,0000,0000,0000,,ĐÃ TỚI TẦNG 100
Dialogue: 0,0:12:13.21,0:12:14.74,Default,,0000,0000,0000,,Vậy là đã tới tầng cao nhất sao.
Dialogue: 0,0:12:15.17,0:12:16.88,Default,,0000,0000,0000,,Nhưng không có ai nhỉ.
Dialogue: 0,0:12:32.36,0:12:35.15,Default,,0000,0000,0000,,Kia là chúa tể của tất cả ác quỷ.
Dialogue: 0,0:12:36.14,0:12:36.83,Default,,0000,0000,0000,,Baran!
Dialogue: 0,0:12:42.61,0:12:44.57,Default,,0000,0000,0000,,QUỶ VƯƠNG BARAN
Dialogue: 0,0:12:45.16,0:12:46.72,Default,,0000,0000,0000,,Khí thế kinh hoàng.
Dialogue: 0,0:12:47.07,0:12:48.89,Default,,0000,0000,0000,,Như này liệu mình có thắng nổi không!?
Dialogue: 0,0:12:49.58,0:12:51.99,Default,,0000,0000,0000,,Sát khí dường như cắt nát thân thể...
Dialogue: 0,0:12:53.05,0:12:54.74,Default,,0000,0000,0000,,Đến mức cả Esil cũng cảm nhận được...
Dialogue: 0,0:12:55.68,0:12:56.46,Default,,0000,0000,0000,,Giờ thì...
Dialogue: 0,0:12:57.13,0:12:58.50,Default,,0000,0000,0000,,Nó bay nên sẽ phiền phức đây.
Dialogue: 0,0:12:58.50,0:12:59.42,Default,,0000,0000,0000,,PHI LONG KAISELLIN
Dialogue: 0,0:12:59.87,0:13:00.60,Default,,0000,0000,0000,,Phi long?
Dialogue: 0,0:13:00.87,0:13:02.47,Default,,0000,0000,0000,,Có sinh vật khác ngoài quỷ tộc sao?
Dialogue: 0,0:13:27.95,0:13:29.44,Default,,0000,0000,0000,,Số lượng cũng ghê đấy.
Dialogue: 0,0:13:30.16,0:13:32.15,Default,,0000,0000,0000,,P-Phải làm thế nào đây?
Dialogue: 0,0:13:34.37,0:13:35.25,Default,,0000,0000,0000,,Ngài Jinwoo!
Dialogue: 0,0:13:35.31,0:13:36.46,Default,,0000,0000,0000,,Tôi biết rồi!
Dialogue: 0,0:13:39.75,0:13:40.99,Default,,0000,0000,0000,,KÍCH HOẠT KỸ NĂNG: LÃNH THỔ CỦA VỊ VUA\NMau ra đây!
Dialogue: 0,0:14:01.42,0:14:02.43,Default,,0000,0000,0000,,Ghê thật...
Dialogue: 0,0:14:02.79,0:14:05.72,Default,,0000,0000,0000,,Ngài Jinwoo có thể chiến đấu như này sao?
Dialogue: 0,0:14:06.09,0:14:07.08,Default,,0000,0000,0000,,Nhưng mà...
Dialogue: 0,0:14:07.15,0:14:10.28,Default,,0000,0000,0000,,Vị kia là Quỷ vương Baran,\Nđấng cai trị nơi này.
Dialogue: 0,0:14:10.71,0:14:14.43,Default,,0000,0000,0000,,Ngài Jinwoo chính là kẻ xâm lược,\Nmột đối tượng cần loại bỏ.
Dialogue: 0,0:14:15.80,0:14:19.01,Default,,0000,0000,0000,,Mình... nên đứng về phía nào đây...
Dialogue: 0,0:14:49.10,0:14:50.65,Default,,0000,0000,0000,,Không phải sấm sét bình thường.
Dialogue: 0,0:14:50.90,0:14:53.52,Default,,0000,0000,0000,,Đó là đòn tấn công diện rộng\Nkèm hiệu ứng gây choáng.
Dialogue: 0,0:14:54.16,0:14:56.36,Default,,0000,0000,0000,,Mặc dù có thể hồi sinh đám binh sĩ,
Dialogue: 0,0:14:56.36,0:14:59.44,Default,,0000,0000,0000,,nhưng cứ ăn cái chiêu đó\Nthì chẳng mấy mà cạn mana.
Dialogue: 0,0:14:59.92,0:15:01.31,Default,,0000,0000,0000,,Trước khi chuyện đó xảy ra...
Dialogue: 0,0:15:03.66,0:15:05.21,Default,,0000,0000,0000,,ẨN THÂN
Dialogue: 0,0:15:05.21,0:15:06.80,Default,,0000,0000,0000,,LAO NHANH
Dialogue: 0,0:15:11.23,0:15:12.51,Default,,0000,0000,0000,,Trước tiên là đôi cánh!
Dialogue: 0,0:15:14.63,0:15:16.32,Default,,0000,0000,0000,,Ẩn Thân bị nhìn thấu sao!?
Dialogue: 0,0:15:25.32,0:15:26.96,Default,,0000,0000,0000,,Chiêu này có thể truy kích à!?
Dialogue: 0,0:15:27.06,0:15:28.80,Default,,0000,0000,0000,,Nguy rồi, bị bắt kịp mất!
Dialogue: 0,0:15:29.18,0:15:30.64,Default,,0000,0000,0000,,Tusk! Igris!
Dialogue: 0,0:15:57.62,0:15:58.99,Default,,0000,0000,0000,,Mãi cũng chịu xuống rồi nhỉ.
Dialogue: 0,0:16:00.17,0:16:03.96,Default,,0000,0000,0000,,Cứ nhìn lên trên thì rất mỏi cổ\Nnên đỡ lắm ấy.
Dialogue: 0,0:16:12.35,0:16:13.26,Default,,0000,0000,0000,,Hân hạnh gặp mặt.
Dialogue: 0,0:16:13.73,0:16:16.52,Default,,0000,0000,0000,,Tôi là Hanekawa trực thuộc Hội Bạt Kiếm.
Dialogue: 0,0:16:17.04,0:16:19.15,Default,,0000,0000,0000,,Còn đây là Hội trưởng Goto Ryuji.
Dialogue: 0,0:16:20.25,0:16:23.61,Default,,0000,0000,0000,,Tôi xin phép được phiên dịch\Nthay lời của anh ấy.
Dialogue: 0,0:16:23.86,0:16:25.27,Default,,0000,0000,0000,,Hội Bạt Kiếm.
Dialogue: 0,0:16:25.90,0:16:29.84,Default,,0000,0000,0000,,Bang hội lớn nhất Nhật Bản\Nvới 11 Hunter cấp S.
Dialogue: 0,0:16:30.65,0:16:33.69,Default,,0000,0000,0000,,Quy mô của họ được cho là\Nđứng thứ hai Châu Á.
Dialogue: 0,0:16:34.18,0:16:35.16,Default,,0000,0000,0000,,Và còn...
Dialogue: 0,0:16:35.64,0:16:38.53,Default,,0000,0000,0000,,Hội trưởng Goto Ryuji đứng đầu tổ chức...
Dialogue: 0,0:16:38.65,0:16:41.43,Default,,0000,0000,0000,,Tỏa ra khí chất bất phàm đúng như lời đồn.
Dialogue: 0,0:16:42.30,0:16:47.87,Default,,0000,0000,0000,,Đầu tiên, xin được cảm ơn các vị đã đưa ra\Nđề xuất phối hợp tác chiến cùng tấn công.
Dialogue: 0,0:16:48.34,0:16:51.97,Default,,0000,0000,0000,,À không, chính phía chúng tôi\Nđã đưa ra yêu cầu trợ giúp trước.
Dialogue: 0,0:16:52.50,0:16:54.17,Default,,0000,0000,0000,,Xin cảm ơn các vị đã tán đồng.
Dialogue: 0,0:16:54.88,0:16:59.51,Default,,0000,0000,0000,,Nhờ tài liệu sẵn có,\Nkết quả điều tra kiến cánh của các vị,
Dialogue: 0,0:16:59.54,0:17:02.50,Default,,0000,0000,0000,,cộng với kết quả giải phẫu\Ncá thể kiến cánh vừa bị tiêu diệt...
Dialogue: 0,0:17:02.52,0:17:04.54,Default,,0000,0000,0000,,nhiều chuyện đã được làm sáng tỏ.
Dialogue: 0,0:17:05.61,0:17:09.80,Default,,0000,0000,0000,,Trong đó có hai yếu tố quan trọng\Nvới kế hoạch tác chiến lần này.
Dialogue: 0,0:17:10.22,0:17:11.73,Default,,0000,0000,0000,,Thứ nhất là tuổi thọ.
Dialogue: 0,0:17:12.22,0:17:15.10,Default,,0000,0000,0000,,Lũ kiến sau khi nở từ trứng\Nsẽ cấp tốc trưởng thành,
Dialogue: 0,0:17:15.10,0:17:16.90,Default,,0000,0000,0000,,nhưng tuổi thọ chỉ tầm một năm.
Dialogue: 0,0:17:17.50,0:17:23.35,Default,,0000,0000,0000,,Tức là chỉ cần thảo phạt kiến chúa,\Nsau một năm lũ tàn dư sẽ tự diệt.
Dialogue: 0,0:17:23.96,0:17:26.62,Default,,0000,0000,0000,,Thứ hai là khuôn mẫu hành vi.
Dialogue: 0,0:17:26.92,0:17:29.22,Default,,0000,0000,0000,,Từ hồ sơ của ba lần chinh phạt trước đây,
Dialogue: 0,0:17:29.22,0:17:31.37,Default,,0000,0000,0000,,đã xác minh được chuyện\Nlũ kiến bị thu hút
Dialogue: 0,0:17:31.37,0:17:34.94,Default,,0000,0000,0000,,về phía kẻ địch mạnh hơn,\Ntức là những nguồn ma lực mạnh.
Dialogue: 0,0:17:35.65,0:17:39.53,Default,,0000,0000,0000,,Lần này, chúng tôi đề xuất\Nlợi dụng tập tính đó để lên kế hoạch.
Dialogue: 0,0:17:40.74,0:17:44.18,Default,,0000,0000,0000,,Phía ta cũng có phát hiện dấu hiệu\Ntrong hành vi của lũ kiến...
Dialogue: 0,0:17:44.60,0:17:47.63,Default,,0000,0000,0000,,Nhưng chưa thể phân tích\Ntường tận tới mức này...
Dialogue: 0,0:17:49.02,0:17:50.86,Default,,0000,0000,0000,,Về chiến dịch lần này...
Dialogue: 0,0:17:50.86,0:17:57.87,Default,,0000,0000,0000,,10 trong số 11 Hunter cấp S của\NHội Bạt Kiếm bao gồm cả tôi sẽ tham gia.
Dialogue: 0,0:17:58.98,0:18:00.43,Default,,0000,0000,0000,,10 trong số 11 người sao!?
Dialogue: 0,0:18:01.11,0:18:03.27,Default,,0000,0000,0000,,Chúng tôi sẽ dẫn dụ lũ kiến.
Dialogue: 0,0:18:03.67,0:18:07.43,Default,,0000,0000,0000,,Lực lượng của các vị hãy nhân lúc đó\Ntiêu diệt kiến chúa.
Dialogue: 0,0:18:07.83,0:18:10.40,Default,,0000,0000,0000,,Nhưng như vậy thì hàng ngàn con kiến sẽ...
Dialogue: 0,0:18:11.21,0:18:14.03,Default,,0000,0000,0000,,Nếu chỉ là dẫn dụ\Nthì sẽ không có vấn đề gì đâu.
Dialogue: 0,0:18:14.53,0:18:18.99,Default,,0000,0000,0000,,Ngay cả giả lập của AI cũng đang\Ncho ra tỉ lệ thành công cao nhất.
Dialogue: 0,0:18:20.08,0:18:24.12,Default,,0000,0000,0000,,Quả thật bên ta không thể cử đi\Ntận 10 Hunter cấp S...
Dialogue: 0,0:18:24.56,0:18:25.45,Default,,0000,0000,0000,,Đã vậy thì...
Dialogue: 0,0:18:26.08,0:18:27.24,Default,,0000,0000,0000,,Tôi hiểu rồi.
Dialogue: 0,0:18:27.59,0:18:31.17,Default,,0000,0000,0000,,Vậy chúng ta hãy bàn bạc chi tiết kế hoạch\Ndựa theo phương châm đó.
Dialogue: 0,0:18:40.02,0:18:42.59,Default,,0000,0000,0000,,Không rảnh tay để dùng potion hồi mana...
Dialogue: 0,0:19:01.77,0:19:03.74,Default,,0000,0000,0000,,Cú Đâm Chí Mạng bị cản lại sao!?
Dialogue: 0,0:19:33.35,0:19:34.95,Default,,0000,0000,0000,,Cạn mana rồi sao.
Dialogue: 0,0:20:18.96,0:20:20.15,Default,,0000,0000,0000,,Chết tiệt! Kiếm của mình!
Dialogue: 0,0:20:31.08,0:20:32.95,Default,,0000,0000,0000,,Lực tay kinh thật!
Dialogue: 0,0:20:34.58,0:20:35.50,Default,,0000,0000,0000,,Không phải chứ!?
Dialogue: 0,0:20:37.30,0:20:38.32,Default,,0000,0000,0000,,Không tránh nổi rồi...
Dialogue: 0,0:20:44.80,0:20:45.60,Default,,0000,0000,0000,,Chính lúc này!
Dialogue: 0,0:20:45.79,0:20:47.50,Default,,0000,0000,0000,,Dồn hết lực tay...
Dialogue: 0,0:20:47.70,0:20:50.19,Default,,0000,0000,0000,,Sau đó sử dụng Bàn Tay Kẻ Thống Trị!
Dialogue: 0,0:21:06.94,0:21:11.22,Default,,0000,0000,0000,,Kết thúc rồi!!!
