Dialogue: 0,0:00:07.05,0:00:10.47,Default,,0000,0000,0000,,Seorang pemburu tahap E rela\Njadi porter penjara bawah tanah tahap A.
Dialogue: 0,0:00:11.11,0:00:13.53,Default,,0000,0000,0000,,Dia bukannya takkan mati juga.
Dialogue: 0,0:00:14.45,0:00:15.89,Default,,0000,0000,0000,,Apa sebenarnya yang difikirkannya?
Dialogue: 0,0:00:17.03,0:00:21.61,Default,,0000,0000,0000,,Oh ya, semalam saya nampak dia berdiri\Ndi depan bilik bos sambil pegang senjata.
Dialogue: 0,0:00:22.39,0:00:23.31,Default,,0000,0000,0000,,Sangat mencurigakan.
Dialogue: 0,0:00:24.53,0:00:26.05,Default,,0000,0000,0000,,Saya juga nak masuk untuk lihat.
Dialogue: 0,0:00:26.31,0:00:27.03,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:00:27.25,0:00:29.09,Default,,0000,0000,0000,,Adakah sesuatu berlaku di dalam sana?
Dialogue: 0,0:00:29.31,0:00:30.07,Default,,0000,0000,0000,,Tiada apa-apa.
Dialogue: 0,0:00:30.25,0:00:31.77,Default,,0000,0000,0000,,Cuma urusan peribadi.
Dialogue: 0,0:00:31.93,0:00:33.31,Default,,0000,0000,0000,,Jangan risau.
Dialogue: 0,0:00:34.39,0:00:35.13,Default,,0000,0000,0000,,Ah.
Dialogue: 0,0:00:37.95,0:00:38.79,Default,,0000,0000,0000,,Maaf.
Dialogue: 0,0:00:39.01,0:00:40.89,Default,,0000,0000,0000,,Bolehkah saya pinjam senjata kamu?
Dialogue: 0,0:00:41.37,0:00:42.07,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:00:42.69,0:00:43.65,Default,,0000,0000,0000,,Hm.
Dialogue: 0,0:00:45.29,0:00:46.29,Default,,0000,0000,0000,,Itu...
Dialogue: 0,0:00:46.67,0:00:48.67,Default,,0000,0000,0000,,Selain ini, ada tak yang lain?
Dialogue: 0,0:00:49.01,0:00:50.63,Default,,0000,0000,0000,,Pedang atau lembing.
Dialogue: 0,0:00:50.83,0:00:52.83,Default,,0000,0000,0000,,Kami tiada benda seperti itu.
Dialogue: 0,0:00:52.83,0:00:55.27,Default,,0000,0000,0000,,Cuma ada penyodok atau tuil besi.
Dialogue: 0,0:00:55.27,0:00:56.41,Default,,0000,0000,0000,,Tak perlu.
Dialogue: 0,0:00:56.73,0:00:57.79,Default,,0000,0000,0000,,Saya akan terus masuk.
Dialogue: 0,0:01:00.13,0:01:01.05,Default,,0000,0000,0000,,Pemburu Cha.
Dialogue: 0,0:01:01.19,0:01:03.59,Default,,0000,0000,0000,,Benarkah awak nak masuk tanpa senjata?
Dialogue: 0,0:01:06.85,0:01:10.31,Default,,0000,0000,0000,,Ya, ini lebih baik\Ndaripada pergi tanpa senjata.
Dialogue: 0,0:01:10.87,0:01:11.75,Default,,0000,0000,0000,,Saya minta diri dulu.
Dialogue: 0,0:01:42.66,0:01:46.37,Default,,0000,0000,0000,,(Solo Leveling Season 2\N-Arise from the Shadow-)
Dialogue: 0,0:03:07.95,0:03:09.37,Default,,0000,0000,0000,,Tak sangka ada begitu banyak.
Dialogue: 0,0:03:09.37,0:03:11.95,Default,,0000,0000,0000,,Jika semua orc tahap tinggi ini keluar...
Dialogue: 0,0:03:12.29,0:03:16.03,Default,,0000,0000,0000,,Mereka akan musnahkan\Nsesuatu bandar dengan mudah.
Dialogue: 0,0:03:16.35,0:03:18.05,Default,,0000,0000,0000,,Terutamanya empat orc itu.
Dialogue: 0,0:03:18.39,0:03:20.23,Default,,0000,0000,0000,,Berbanding dengan\Norc tahap tinggi yang lain,
Dialogue: 0,0:03:20.23,0:03:21.46,Default,,0000,0000,0000,,aura mereka berbeza sekali.
Dialogue: 0,0:03:27.81,0:03:30.06,Default,,0000,0000,0000,,Misi kita adalah menutup portal.
Dialogue: 0,0:03:30.65,0:03:33.77,Default,,0000,0000,0000,,Kita mesti mengalahkan\Nbos penjara bawah tanah di sini.
Dialogue: 0,0:03:35.61,0:03:37.79,Default,,0000,0000,0000,,Manusia.
Dialogue: 0,0:03:39.39,0:03:41.31,Default,,0000,0000,0000,,Kamu takut akan saya?
Dialogue: 0,0:03:44.25,0:03:45.57,Default,,0000,0000,0000,,Kenapa begitu?
Dialogue: 0,0:03:45.95,0:03:48.35,Default,,0000,0000,0000,,Kuasa sihirnya amat kuat.
Dialogue: 0,0:03:49.03,0:03:50.33,Default,,0000,0000,0000,,Berbanding dengannya,
Dialogue: 0,0:03:50.33,0:03:53.45,Default,,0000,0000,0000,,saya hanyalah ahli sihir yang lemah.
Dialogue: 0,0:03:54.87,0:03:58.43,Default,,0000,0000,0000,,Kenapa awak membawa kami ke sini?
Dialogue: 0,0:03:58.73,0:04:00.03,Default,,0000,0000,0000,,Kamu hanyalah hiburan.
Dialogue: 0,0:04:00.31,0:04:01.09,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:04:01.77,0:04:04.17,Default,,0000,0000,0000,,Saya akan membunuh kamu satu demi satu,
Dialogue: 0,0:04:04.17,0:04:06.11,Default,,0000,0000,0000,,mendera dan menelan kamu
Dialogue: 0,0:04:06.11,0:04:08.97,Default,,0000,0000,0000,,untuk menghibur askar saya.
Dialogue: 0,0:04:11.21,0:04:12.13,Default,,0000,0000,0000,,Hiburan?
Dialogue: 0,0:04:12.73,0:04:15.41,Default,,0000,0000,0000,,Ketekadan kita cuma hiburannya.
Dialogue: 0,0:04:16.29,0:04:18.27,Default,,0000,0000,0000,,Bagi mereka, nyawa kita
Dialogue: 0,0:04:19.25,0:04:22.73,Default,,0000,0000,0000,,hanya mainan yang dapat\Ndibuang sesuka hati?
Dialogue: 0,0:04:23.35,0:04:24.15,Default,,0000,0000,0000,,Oh.
Dialogue: 0,0:04:24.53,0:04:27.69,Default,,0000,0000,0000,,Ada sesuatu yang aneh\Ndalam kalangan manusia itu.
Dialogue: 0,0:04:28.11,0:04:30.95,Default,,0000,0000,0000,,Namun, bagus juga begini.
Dialogue: 0,0:04:32.25,0:04:33.73,Default,,0000,0000,0000,,Semua, serang!
Dialogue: 0,0:04:46.21,0:04:47.65,Default,,0000,0000,0000,,Lagu Pelindung.
Dialogue: 0,0:04:52.81,0:04:54.01,Default,,0000,0000,0000,,Bodoh.
Dialogue: 0,0:04:54.39,0:04:56.05,Default,,0000,0000,0000,,Sihir Antigraviti.
Dialogue: 0,0:04:59.25,0:05:00.87,Default,,0000,0000,0000,,Pecutan Graviti.
Dialogue: 0,0:05:02.87,0:05:03.65,Default,,0000,0000,0000,,Kapten!
Dialogue: 0,0:05:09.77,0:05:10.77,Default,,0000,0000,0000,,Abang Kihoon.
Dialogue: 0,0:05:20.87,0:05:21.91,Default,,0000,0000,0000,,Kapten Son.
Dialogue: 0,0:05:22.53,0:05:24.39,Default,,0000,0000,0000,,Penjara bawah tanah ini milik Hunters.
Dialogue: 0,0:05:24.89,0:05:26.59,Default,,0000,0000,0000,,Saya tak patut campur tangan.
Dialogue: 0,0:05:27.39,0:05:28.23,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:05:28.53,0:05:30.93,Default,,0000,0000,0000,,sekarang seluruh pasukan penyerang\Ndiancam bahaya.
Dialogue: 0,0:05:33.61,0:05:35.23,Default,,0000,0000,0000,,Saya cuma tanya awak seperkara.
Dialogue: 0,0:05:40.27,0:05:43.86,Default,,0000,0000,0000,,Bolehkah awak serahkan\Nsemua haiwan iblis di sini kepada saya?
Dialogue: 0,0:05:48.53,0:05:51.21,Default,,0000,0000,0000,,Tolonglah.
Dialogue: 0,0:05:53.19,0:05:54.67,Default,,0000,0000,0000,,Angkuh sekali.
Dialogue: 0,0:05:55.15,0:05:57.85,Default,,0000,0000,0000,,Saya sudah mengetahui kekuatan awak.
Dialogue: 0,0:06:03.17,0:06:04.21,Default,,0000,0000,0000,,Memang betul.
Dialogue: 0,0:06:04.45,0:06:07.01,Default,,0000,0000,0000,,Saya tak pernah merasakan aura sekuat ini.
Dialogue: 0,0:06:07.43,0:06:08.71,Default,,0000,0000,0000,,Sudah tentu.
Dialogue: 0,0:06:09.55,0:06:12.69,Default,,0000,0000,0000,,Sayangnya kita dilahirkan\Nuntuk saling bertentangan.
Dialogue: 0,0:06:13.49,0:06:14.41,Default,,0000,0000,0000,,Sudah tentu.
Dialogue: 0,0:06:19.81,0:06:22.39,Default,,0000,0000,0000,,Saya yang akan bunuh awak.
Dialogue: 0,0:06:27.45,0:06:28.33,Default,,0000,0000,0000,,Oh?
Dialogue: 0,0:06:29.01,0:06:30.13,Default,,0000,0000,0000,,Jabatan Penyeliaan?
Dialogue: 0,0:06:30.39,0:06:32.03,Default,,0000,0000,0000,,Kenapa ahli Jabatan Penyeliaan\Nakan datang ke sini?
Dialogue: 0,0:06:32.21,0:06:33.55,Default,,0000,0000,0000,,Mana mungkin saya akan tahu?
Dialogue: 0,0:06:33.79,0:06:35.85,Default,,0000,0000,0000,,Tolong panggil ketua ke sini.
Dialogue: 0,0:06:36.55,0:06:38.77,Default,,0000,0000,0000,,Kenapa dia nak jadi pelombong di sini
Dialogue: 0,0:06:39.03,0:06:40.13,Default,,0000,0000,0000,,selama dua hari berturut-turut?
Dialogue: 0,0:06:40.57,0:06:41.93,Default,,0000,0000,0000,,Ada apa?
Dialogue: 0,0:06:42.55,0:06:44.67,Default,,0000,0000,0000,,Manakah pemburu Sung Jinwoo?
Dialogue: 0,0:06:45.17,0:06:46.73,Default,,0000,0000,0000,,Sung?
Dialogue: 0,0:06:47.01,0:06:48.29,Default,,0000,0000,0000,,Saya dah agak.
Dialogue: 0,0:06:48.59,0:06:50.61,Default,,0000,0000,0000,,Orang itu pasti bermasalah.
Dialogue: 0,0:06:50.61,0:06:54.05,Default,,0000,0000,0000,,Dia menatap saya dengan\Nekspresi yang amat menakutkan.
Dialogue: 0,0:06:54.05,0:06:57.03,Default,,0000,0000,0000,,Saya ingat akan dibunuh olehnya.
Dialogue: 0,0:06:57.03,0:06:58.60,Default,,0000,0000,0000,,Jadi, manakah Pemburu Sung?
Dialogue: 0,0:06:59.21,0:07:00.69,Default,,0000,0000,0000,,Dia ada di dalam portal.
Dialogue: 0,0:07:00.97,0:07:04.01,Default,,0000,0000,0000,,Dia masuk untuk bantu\Nkerana pasukan penyerang tiada porter.
Dialogue: 0,0:07:04.35,0:07:05.33,Default,,0000,0000,0000,,Porter?
Dialogue: 0,0:07:05.53,0:07:06.23,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:07:06.53,0:07:08.19,Default,,0000,0000,0000,,- Menjadi porter cuma alasan.\N- Selepas menjadi pelombong,
Dialogue: 0,0:07:08.19,0:07:09.81,Default,,0000,0000,0000,,- Dia pasti ada sesuatu rancangan.\N- sekarang dia menjadi porter?
Dialogue: 0,0:07:09.81,0:07:11.19,Default,,0000,0000,0000,,- Jangan-jangan dia\N- Selepas menjadi pemburu S,
Dialogue: 0,0:07:11.19,0:07:12.35,Default,,0000,0000,0000,,- bunuh orang di dalam sana?\N- segala tindak-tanduk akan diawasi.
Dialogue: 0,0:07:12.35,0:07:13.93,Default,,0000,0000,0000,,- Dia dapat bunuh orang tanpa rasa bersalah.\N- segala tindak-tanduk akan diawasi.
Dialogue: 0,0:07:13.93,0:07:15.85,Default,,0000,0000,0000,,- Pandangannya benar-benar menakutkan.\N- Saya harap dia hati-hati semasa bertindak.
Dialogue: 0,0:07:15.85,0:07:17.43,Default,,0000,0000,0000,,- Dia pasti pernah membunuh orang.\N- Itu...
Dialogue: 0,0:07:17.43,0:07:19.51,Default,,0000,0000,0000,,Kamu akan tahu selepas nampak berita esok.
Dialogue: 0,0:07:19.51,0:07:20.87,Default,,0000,0000,0000,,Berita?
Dialogue: 0,0:07:20.87,0:07:23.40,Default,,0000,0000,0000,,- Siapa yang kisah tentang berita itu?\N- Namun, tadi Pemburu Cha
Dialogue: 0,0:07:23.40,0:07:25.27,Default,,0000,0000,0000,,- Cepat tangkap dia!\N- juga tanya soalan yang sama.
Dialogue: 0,0:07:25.77,0:07:26.81,Default,,0000,0000,0000,,Pemburu Cha?
Dialogue: 0,0:07:30.21,0:07:33.03,Default,,0000,0000,0000,,Kenapa dengan aura yang aneh itu tadi?
Dialogue: 0,0:07:33.03,0:07:35.29,Default,,0000,0000,0000,,Saya ingat tubuh saya\Nakan dicerah-beraikan.
Dialogue: 0,0:07:35.29,0:07:36.51,Default,,0000,0000,0000,,Cepat lakukan pemeriksaan\Nkuasa sihir lagi.
Dialogue: 0,0:07:37.05,0:07:37.95,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:07:44.53,0:07:45.65,Default,,0000,0000,0000,,Saya harus lebih cepat.
Dialogue: 0,0:07:46.19,0:07:51.17,Default,,0000,0000,0000,,Saya tak tahu cara Kihoon dan yang lain\Nkalahkan begitu banyak orc tahap tinggi,
Dialogue: 0,0:07:52.17,0:07:55.09,Default,,0000,0000,0000,,tapi jika kuasa sihir tadi\Nberasal dari penjara bawah tanah,
Dialogue: 0,0:07:56.63,0:07:58.41,Default,,0000,0000,0000,,maka mereka akan diancam bahaya.
Dialogue: 0,0:08:00.11,0:08:03.81,Default,,0000,0000,0000,,Berani kamu melawan pasukan saya\Ndengan kekuatan sekecil itu.
Dialogue: 0,0:08:03.81,0:08:05.51,Default,,0000,0000,0000,,Naif sekali.
Dialogue: 0,0:08:06.03,0:08:08.61,Default,,0000,0000,0000,,Awak akan menyesal\Njika memandang rendah kami.
Dialogue: 0,0:08:10.51,0:08:12.61,Default,,0000,0000,0000,,Aktifkan kemahiran, Domain Penguasa.
Dialogue: 0,0:08:13.35,0:08:18.05,Default,,0000,0000,0000,,Ini kemahiran khas yang diperoleh\Nselepas capai tahap 70 di Istana Iblis.
Dialogue: 0,0:08:19.03,0:08:23.73,Default,,0000,0000,0000,,Askar Bayangan menjadi lebih kuat\Nselepas pertarungan di Istana Iblis.
Dialogue: 0,0:08:23.73,0:08:25.43,Default,,0000,0000,0000,,Apa yang berlaku?
Dialogue: 0,0:08:25.67,0:08:27.15,Default,,0000,0000,0000,,Biar betul.
Dialogue: 0,0:08:27.15,0:08:29.77,Default,,0000,0000,0000,,Saya cuma dapat menyeru dua ekor.
Dialogue: 0,0:08:30.49,0:08:32.79,Default,,0000,0000,0000,,Tak sangka kuasa sihir mempunyai\Nkuasa sihir yang begitu mengerikan.
Dialogue: 0,0:08:35.45,0:08:36.28,Default,,0000,0000,0000,,Serang.
Dialogue: 0,0:09:05.77,0:09:06.77,Default,,0000,0000,0000,,Gerakannya tadi...
Dialogue: 0,0:09:07.01,0:09:09.17,Default,,0000,0000,0000,,Sama seperti timbalan ketua.
Dialogue: 0,0:09:09.79,0:09:12.48,Default,,0000,0000,0000,,Jika dia begitu kuat,\Nkenapa dia nak jadi porter?
Dialogue: 0,0:09:14.53,0:09:16.63,Default,,0000,0000,0000,,Kekuatan infantri sekitar pemburu tahap B.
Dialogue: 0,0:09:18.03,0:09:21.41,Default,,0000,0000,0000,,Mereka akan mengalami empat hingga lima\Nkemusnahan untuk bunuh satu orc tahap tinggi.
Dialogue: 0,0:09:22.29,0:09:24.11,Default,,0000,0000,0000,,Saya harus mengurangkan bilangan orc.
Dialogue: 0,0:09:24.23,0:09:25.89,Default,,0000,0000,0000,,Lagu Naga Api.
Dialogue: 0,0:09:29.95,0:09:33.23,Default,,0000,0000,0000,,Pasukan awak cuma perhiasan.
Dialogue: 0,0:09:33.23,0:09:34.75,Default,,0000,0000,0000,,Jangan terlalu sombong.
Dialogue: 0,0:09:35.41,0:09:37.67,Default,,0000,0000,0000,,Awak yang terlalu sombong.
Dialogue: 0,0:09:38.43,0:09:41.09,Default,,0000,0000,0000,,Semua askar ini dapat\Nhidup semula tanpa henti.
Dialogue: 0,0:09:41.37,0:09:43.07,Default,,0000,0000,0000,,Lagu Pelindung.
Dialogue: 0,0:09:43.55,0:09:44.71,Default,,0000,0000,0000,,Pecutan.
Dialogue: 0,0:09:48.99,0:09:50.81,Default,,0000,0000,0000,,Pecutan Graviti.
Dialogue: 0,0:09:52.59,0:09:54.29,Default,,0000,0000,0000,,Sihir Antigraviti.
Dialogue: 0,0:09:55.21,0:09:56.17,Default,,0000,0000,0000,,Pecutan.
Dialogue: 0,0:09:59.73,0:10:00.71,Default,,0000,0000,0000,,Jika begitu,
Dialogue: 0,0:10:01.03,0:10:04.25,Default,,0000,0000,0000,,saya akan hancurkan mereka\Nsebelum kuasa sihir awak habis
Dialogue: 0,0:10:04.25,0:10:06.05,Default,,0000,0000,0000,,hingga mereka musnah sepenuhnya.
Dialogue: 0,0:10:06.97,0:10:08.77,Default,,0000,0000,0000,,Lagu Api.
Dialogue: 0,0:10:18.39,0:10:23.07,Default,,0000,0000,0000,,Dia ingin menjauhkan saya melalui\Nkuasa sihir dan sihir jarak jauh?
Dialogue: 0,0:10:23.83,0:10:24.79,Default,,0000,0000,0000,,Baiklah.
Dialogue: 0,0:10:25.07,0:10:27.71,Default,,0000,0000,0000,,Saya tak sabar nak lihat\Nbetapa lama awak dapat tahan.
Dialogue: 0,0:10:29.63,0:10:30.69,Default,,0000,0000,0000,,Hasilnya sudah keluar.
Dialogue: 0,0:10:31.21,0:10:34.45,Default,,0000,0000,0000,,Kekuatan portal tahap A ini\Nsangat dekat dengan tahap S.
Dialogue: 0,0:10:34.75,0:10:36.15,Default,,0000,0000,0000,,Adakah ini ralat pemeriksaan kuasa sihir?
Dialogue: 0,0:10:37.07,0:10:39.11,Default,,0000,0000,0000,,Segera hubungi wakil Hunters.
Dialogue: 0,0:10:39.61,0:10:40.83,Default,,0000,0000,0000,,Kita juga harus bersedia
Dialogue: 0,0:10:41.21,0:10:42.95,Default,,0000,0000,0000,,untuk membantu pasukan penyerang di dalam.
Dialogue: 0,0:10:43.15,0:10:44.33,Default,,0000,0000,0000,,Baik.
Dialogue: 0,0:10:45.83,0:10:46.83,Default,,0000,0000,0000,,Nampaknya
Dialogue: 0,0:10:47.13,0:10:50.84,Default,,0000,0000,0000,,tak kira dari segi bilangan atau kekuatan,\Npasukan saya tetap lebih hebat.
Dialogue: 0,0:10:51.85,0:10:54.75,Default,,0000,0000,0000,,MANA\NKuasa sihir awak pasti akan habis.
Dialogue: 0,0:10:56.89,0:10:58.29,Default,,0000,0000,0000,,Pasti akan habis?
Dialogue: 0,0:10:58.57,0:10:59.75,Default,,0000,0000,0000,,Apa yang awak mengarut?
Dialogue: 0,0:11:04.61,0:11:06.97,Default,,0000,0000,0000,,Kemampuan sebenar Necromancer\Nbaru mula ditunjukkan sekarang.
Dialogue: 0,0:11:08.05,0:11:08.95,Default,,0000,0000,0000,,Bangkitlah.
Dialogue: 0,0:11:09.51,0:11:10.14,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:11:11.19,0:11:13.51,Default,,0000,0000,0000,,Awak mengubah askar saya\Nmenjadi kaum abadi.
Dialogue: 0,0:11:14.97,0:11:17.47,Default,,0000,0000,0000,,Kamu juga akan menjadi\Nbayangan saya tak lama lagi.
Dialogue: 0,0:11:18.07,0:11:19.03,Default,,0000,0000,0000,,Sudah tentu,
Dialogue: 0,0:11:20.57,0:11:21.53,Default,,0000,0000,0000,,termasuk awak juga.
Dialogue: 0,0:11:27.29,0:11:28.49,Default,,0000,0000,0000,,Jangan-jangan...
Dialogue: 0,0:11:29.61,0:11:31.01,Default,,0000,0000,0000,,Itulah...
Dialogue: 0,0:11:32.23,0:11:33.05,Default,,0000,0000,0000,,Peng...
Dialogue: 0,0:11:35.99,0:11:37.27,Default,,0000,0000,0000,,Jika begitu,
Dialogue: 0,0:11:37.51,0:11:38.85,Default,,0000,0000,0000,,kenapa saya
Dialogue: 0,0:11:39.17,0:11:40.79,Default,,0000,0000,0000,,berada di sini?
Dialogue: 0,0:11:41.41,0:11:43.95,Default,,0000,0000,0000,,Apabila saya membuka mata,
Dialogue: 0,0:11:44.21,0:11:48.39,Default,,0000,0000,0000,,arahan yang sama\Nterngiang-ngiang dalam otak saya.
Dialogue: 0,0:11:49.95,0:11:52.19,Default,,0000,0000,0000,,"Memburu manusia".
Dialogue: 0,0:11:55.17,0:11:57.51,Default,,0000,0000,0000,,Alasannya tidak penting.
Dialogue: 0,0:11:57.81,0:12:00.61,Default,,0000,0000,0000,,Hanya perlu bertindak mengikut arahan.
Dialogue: 0,0:12:02.93,0:12:03.90,Default,,0000,0000,0000,,Pergilah.
Dialogue: 0,0:12:04.33,0:12:06.65,Default,,0000,0000,0000,,Hapuskan orang yang menghalang.
Dialogue: 0,0:12:06.65,0:12:09.93,Default,,0000,0000,0000,,Bawa mayat mereka kepada saya.
Dialogue: 0,0:12:12.09,0:12:13.73,Default,,0000,0000,0000,,Setara dengan tahap S?
Dialogue: 0,0:12:14.23,0:12:16.13,Default,,0000,0000,0000,,Jika mengikut hasil pemeriksaan asal,
Dialogue: 0,0:12:16.13,0:12:19.87,Default,,0000,0000,0000,,pasukan pemburu Son Kihoon\Nsepatutnya sudah mampu mengatasinya.
Dialogue: 0,0:12:20.27,0:12:21.63,Default,,0000,0000,0000,,Ini memang tak diduga.
Dialogue: 0,0:12:22.09,0:12:23.45,Default,,0000,0000,0000,,Jika portal terbuka sepenuhnya,
Dialogue: 0,0:12:23.45,0:12:24.99,Default,,0000,0000,0000,,insiden Pulau Jeju akan berulang lagi.
Dialogue: 0,0:12:25.29,0:12:27.21,Default,,0000,0000,0000,,Nasib baik kita masih ada masa.
Dialogue: 0,0:12:27.73,0:12:31.11,Default,,0000,0000,0000,,Segera hantar semua\Nahli Hunters ke portal itu.
Dialogue: 0,0:12:33.45,0:12:37.19,Default,,0000,0000,0000,,Panggilan kecemasan telah dikeluarkan\Nkepada semua pemburu tahap A ke atas.
Dialogue: 0,0:12:37.89,0:12:39.49,Default,,0000,0000,0000,,Dalam keadaan terburuk,
Dialogue: 0,0:12:39.49,0:12:43.43,Default,,0000,0000,0000,,mungkin kita harus minta bantuan\NPersatuan Harimau Putih dan Dewa Maut.
Dialogue: 0,0:12:43.75,0:12:44.98,Default,,0000,0000,0000,,Namun, jika begitu...
Dialogue: 0,0:12:45.51,0:12:48.83,Default,,0000,0000,0000,,Kita cuma dapat berusaha untuk\Nmengelakkan keadaan bertambah buruk.
Dialogue: 0,0:13:20.39,0:13:23.27,Default,,0000,0000,0000,,Nampaknya panglima saya telah menang.
Dialogue: 0,0:13:23.85,0:13:26.05,Default,,0000,0000,0000,,Kenapa begitu?
Dialogue: 0,0:13:26.65,0:13:28.15,Default,,0000,0000,0000,,Kita pergi bantu juga.
Dialogue: 0,0:13:28.39,0:13:29.09,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:13:29.33,0:13:31.91,Default,,0000,0000,0000,,Lagu Penderitaan, Lagu Kebutaan.
Dialogue: 0,0:13:33.11,0:13:36.21,Default,,0000,0000,0000,,Penonton tak boleh\Nnaik pentas sesuka hati.
Dialogue: 0,0:13:37.43,0:13:42.69,Default,,0000,0000,0000,,Saya ingin mendiamkan\Nmulut awak yang sombong itu.
Dialogue: 0,0:13:43.19,0:13:46.17,Default,,0000,0000,0000,,Lagu Tidur, Lagu Kelesuan.
Dialogue: 0,0:13:46.37,0:13:48.19,Default,,0000,0000,0000,,Lagu Kebutaan.
Dialogue: 0,0:13:48.75,0:13:49.63,Default,,0000,0000,0000,,Apa?
Dialogue: 0,0:13:49.87,0:13:50.92,Default,,0000,0000,0000,,KEMAHIRAN PASIF, BERKAT PENYIHIR BESAR KANDIARU,\NKESAN BERPANJANGAN, KESIHATAN DAN LENAJUTAN USIA,\NIMUN TERHADAP SEMUA PENYAKIT, RACUN DAN KEADAAN ABNORMAL
Dialogue: 0,0:13:51.37,0:13:52.49,Default,,0000,0000,0000,,Sayang sekali.
Dialogue: 0,0:13:52.49,0:13:54.63,Default,,0000,0000,0000,,Racun dan kutukan\Ntak berkesan terhadap saya.
Dialogue: 0,0:13:56.33,0:13:57.79,Default,,0000,0000,0000,,Lagu Pelindung.
Dialogue: 0,0:14:00.87,0:14:03.65,Default,,0000,0000,0000,,Saya akan hancurkan\Nperisai awak yang menjengkelkan itu.
Dialogue: 0,0:14:24.09,0:14:25.29,Default,,0000,0000,0000,,Apa yang berlaku?
Dialogue: 0,0:14:26.51,0:14:28.01,Default,,0000,0000,0000,,Adakah dia yang menyeru
Dialogue: 0,0:14:28.51,0:14:30.05,Default,,0000,0000,0000,,semua askar ini?
Dialogue: 0,0:14:30.39,0:14:31.59,Default,,0000,0000,0000,,Timbalan ketua?
Dialogue: 0,0:14:33.45,0:14:34.51,Default,,0000,0000,0000,,Kenapa awak di sini?
Dialogue: 0,0:14:35.03,0:14:35.81,Default,,0000,0000,0000,,Bagaimana keadaannya?
Dialogue: 0,0:14:36.03,0:14:37.33,Default,,0000,0000,0000,,Kapten baik-baik saja.
Dialogue: 0,0:14:37.95,0:14:38.79,Default,,0000,0000,0000,,Baguslah jika begitu.
Dialogue: 0,0:14:40.37,0:14:42.43,Default,,0000,0000,0000,,Kenapa keadaan menjadi begini?
Dialogue: 0,0:14:42.75,0:14:45.09,Default,,0000,0000,0000,,Kami pun tak jelas sebenarnya.
Dialogue: 0,0:14:45.67,0:14:47.83,Default,,0000,0000,0000,,Awak agak hebat.
Dialogue: 0,0:14:47.83,0:14:51.59,Default,,0000,0000,0000,,Lagu Kemarahan,\NLagu Penguatan, Lagu Gergasi.
Dialogue: 0,0:14:52.69,0:14:56.45,Default,,0000,0000,0000,,Saya akan menginjak awak seperti serangga.
Dialogue: 0,0:14:58.91,0:14:59.97,Default,,0000,0000,0000,,Aduhai.
Dialogue: 0,0:15:00.89,0:15:03.25,Default,,0000,0000,0000,,Saya ada kenangan buruk tentang gergasi.
Dialogue: 0,0:15:03.77,0:15:05.33,Default,,0000,0000,0000,,Itu trauma saya.
Dialogue: 0,0:15:05.79,0:15:07.95,Default,,0000,0000,0000,,Lagu Naga Api.
Dialogue: 0,0:15:25.51,0:15:30.37,Default,,0000,0000,0000,,Adakah awak masih rasa mampu melawan saya?
Dialogue: 0,0:15:30.95,0:15:31.81,Default,,0000,0000,0000,,Ya.
Dialogue: 0,0:15:40.21,0:15:43.27,Default,,0000,0000,0000,,Tubuh yang menjadi besar cuma akan\Nmembuat awak lebih mudah diserang.
Dialogue: 0,0:15:44.73,0:15:49.37,Default,,0000,0000,0000,,Tanpa pengawal, penyihir seperti awak\Ntakkan mampu melawan serangan pembunuh.
Dialogue: 0,0:15:51.43,0:15:53.89,Default,,0000,0000,0000,,Lagu Api.
Dialogue: 0,0:16:07.41,0:16:09.09,Default,,0000,0000,0000,,Serangan pisau belati memang tak berkesan.
Dialogue: 0,0:16:10.41,0:16:11.37,Default,,0000,0000,0000,,Jika begitu...
Dialogue: 0,0:16:31.57,0:16:32.65,Default,,0000,0000,0000,,Encik Woo.
Dialogue: 0,0:16:33.53,0:16:35.37,Default,,0000,0000,0000,,Adakah semua orang baik-baik saja?
Dialogue: 0,0:16:35.95,0:16:37.81,Default,,0000,0000,0000,,Saya merasakan kuasa sihir\Nyang amat kuat di luar,
Dialogue: 0,0:16:38.03,0:16:39.73,Default,,0000,0000,0000,,jadi masuk untuk\Nmembantu pasukan penyerang.
Dialogue: 0,0:16:41.23,0:16:43.67,Default,,0000,0000,0000,,Nampaknya saya yang terlalu risau.
Dialogue: 0,0:16:44.61,0:16:46.63,Default,,0000,0000,0000,,Bahkan ketua Jabatan Penyeliaan...
Dialogue: 0,0:16:47.73,0:16:50.45,Default,,0000,0000,0000,,Dia kelihatan seperti\Npemburu tempur kelas tertinggi,
Dialogue: 0,0:16:50.67,0:16:52.33,Default,,0000,0000,0000,,tapi dia mahir menggunakan\Nsihir seruan juga.
Dialogue: 0,0:16:53.79,0:16:54.67,Default,,0000,0000,0000,,Inilah
Dialogue: 0,0:16:55.21,0:16:57.01,Default,,0000,0000,0000,,kekuatan Pemburu Sung.
Dialogue: 0,0:16:57.77,0:16:59.47,Default,,0000,0000,0000,,Siapakah dia sebenarnya?
Dialogue: 0,0:17:00.17,0:17:02.13,Default,,0000,0000,0000,,Awak kenal dia, betul?
Dialogue: 0,0:17:03.13,0:17:04.95,Default,,0000,0000,0000,,Cuma sedikit.
Dialogue: 0,0:17:07.09,0:17:08.37,Default,,0000,0000,0000,,Tak banyak yang saya tahu.
Dialogue: 0,0:17:10.17,0:17:12.15,Default,,0000,0000,0000,,Sejak penyihir kehilangan pengawalnya,
Dialogue: 0,0:17:12.61,0:17:14.35,Default,,0000,0000,0000,,perlawanan sudah tamat.
Dialogue: 0,0:17:14.99,0:17:16.79,Default,,0000,0000,0000,,Tubuh ini...
Dialogue: 0,0:17:17.19,0:17:20.13,Default,,0000,0000,0000,,Tubuh ini takkan musnah.
Dialogue: 0,0:17:20.39,0:17:24.15,Default,,0000,0000,0000,,Pastinya tidak!
Dialogue: 0,0:17:40.06,0:17:40.77,Default,,0000,0000,0000,,PEMILIK PENJARA BAWAH TANAH DIBUNUH
Dialogue: 0,0:17:40.77,0:17:41.98,Default,,0000,0000,0000,,NAIK TAHAP\NPEMILIK PENJARA BAWAH TANAH DIBUNUH
Dialogue: 0,0:17:42.47,0:17:44.15,Default,,0000,0000,0000,,Walaupun bos telah dibunuh,
Dialogue: 0,0:17:44.15,0:17:46.29,Default,,0000,0000,0000,,rasanya tak elok untuk ambil semua item.
Dialogue: 0,0:17:46.81,0:17:47.77,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:17:48.07,0:17:50.53,Default,,0000,0000,0000,,pengekstrakan bayangan\Nsepatutnya tiada masalah.
Dialogue: 0,0:17:51.01,0:17:51.83,Default,,0000,0000,0000,,Bangkitlah.
Dialogue: 0,0:17:58.61,0:18:01.01,Default,,0000,0000,0000,,Awak menjadi lebih jinak\Nselepas menjadi bayangan.
Dialogue: 0,0:18:02.79,0:18:04.51,Default,,0000,0000,0000,,BOLEH BERI NAMA KEPADA KESATERIA ELIT\NNama?
Dialogue: 0,0:18:04.51,0:18:05.17,Default,,0000,0000,0000,,BOLEH BERI NAMA KEPADA KESATERIA ELIT\NSiapakah namanya tadi?
Dialogue: 0,0:18:05.17,0:18:05.87,Default,,0000,0000,0000,,Siapakah namanya tadi?
Dialogue: 0,0:18:06.09,0:18:07.65,Default,,0000,0000,0000,,Kaller...
Dialogue: 0,0:18:08.27,0:18:09.55,Default,,0000,0000,0000,,Maaf, saya dah lupa.
Dialogue: 0,0:18:09.81,0:18:11.05,Default,,0000,0000,0000,,Saya akan beri awak nama.
Dialogue: 0,0:18:11.57,0:18:12.33,Default,,0000,0000,0000,,"Kiba".
Dialogue: 0,0:18:12.69,0:18:13.93,Default,,0000,0000,0000,,Nama awak
Dialogue: 0,0:18:14.15,0:18:15.05,Default,,0000,0000,0000,,Kiba.
Dialogue: 0,0:18:15.22,0:18:15.85,Default,,0000,0000,0000,,KIBA TAHAP 1, KESATERIA ELIT
Dialogue: 0,0:18:16.35,0:18:17.75,Default,,0000,0000,0000,,Kesateria Elit.
Dialogue: 0,0:18:17.99,0:18:19.49,Default,,0000,0000,0000,,Ini kali pertama saya nampak\Ntahap seperti ini.
Dialogue: 0,0:18:20.05,0:18:22.93,Default,,0000,0000,0000,,Ini memang sesuai dengan bayangan\Ndari penjara bawah tanah tahap A.
Dialogue: 0,0:18:24.29,0:18:27.33,Default,,0000,0000,0000,,Mendapatkan pasukan orc tahap tinggi\Njuga dikira keuntungan besar.
Dialogue: 0,0:18:29.29,0:18:30.21,Default,,0000,0000,0000,,Pemburu Sung Jinwoo.
Dialogue: 0,0:18:31.35,0:18:32.45,Default,,0000,0000,0000,,Encik Woo.
Dialogue: 0,0:18:32.79,0:18:35.57,Default,,0000,0000,0000,,Saya terlalu fokus pada pengekstrakan\Nbayangan dan tak sedar kedatangannya.
Dialogue: 0,0:18:35.93,0:18:36.87,Default,,0000,0000,0000,,Encik Sung.
Dialogue: 0,0:18:36.87,0:18:38.41,Default,,0000,0000,0000,,Encik Porter.
Dialogue: 0,0:18:38.41,0:18:39.71,Default,,0000,0000,0000,,Apa yang berlaku tadi?
Dialogue: 0,0:18:40.37,0:18:41.55,Default,,0000,0000,0000,,Itu...
Dialogue: 0,0:18:41.55,0:18:42.87,Default,,0000,0000,0000,,Bagaimana saya nak jelaskan?
Dialogue: 0,0:18:44.37,0:18:46.15,Default,,0000,0000,0000,,Kami ahli Jabatan Penyeliaan\NPersatuan Pemburu.
Dialogue: 0,0:18:46.83,0:18:49.61,Default,,0000,0000,0000,,Pemburu Sung Jinwoo di depan kamu
Dialogue: 0,0:18:49.61,0:18:51.43,Default,,0000,0000,0000,,ialah rahsia tertinggi persatuan kami.
Dialogue: 0,0:18:52.43,0:18:56.31,Default,,0000,0000,0000,,Kami mohon semua orang di sini\Nuntuk menjaga rahsia ini.
Dialogue: 0,0:18:56.95,0:18:58.55,Default,,0000,0000,0000,,Kami akan mengiring awak keluar.
Dialogue: 0,0:18:58.85,0:19:02.09,Default,,0000,0000,0000,,Ini cara terbaik untuk\Nmengelakkan masalah sekarang.
Dialogue: 0,0:19:03.93,0:19:09.83,Default,,0000,0000,0000,,Pemburu Sung telah menunjukkan kekuatan\Nyang setara dengan pemburu S tadi.
Dialogue: 0,0:19:10.31,0:19:13.79,Default,,0000,0000,0000,,Tolong bantu dia pergi\Ndari sini dengan lancar.
Dialogue: 0,0:19:17.73,0:19:18.89,Default,,0000,0000,0000,,Tunggu sebentar.
Dialogue: 0,0:19:20.35,0:19:23.17,Default,,0000,0000,0000,,Awak memiliki kekuatan yang luar biasa.
Dialogue: 0,0:19:23.51,0:19:26.27,Default,,0000,0000,0000,,Saya rasa awak pasti ada alasan sendiri.
Dialogue: 0,0:19:26.93,0:19:29.91,Default,,0000,0000,0000,,Saya takkan tanya sebab\Nawak rela menjadi porter.
Dialogue: 0,0:19:31.31,0:19:32.13,Default,,0000,0000,0000,,Namun,
Dialogue: 0,0:19:32.67,0:19:35.79,Default,,0000,0000,0000,,berkat bantuan awak,
Dialogue: 0,0:19:36.13,0:19:37.55,Default,,0000,0000,0000,,kami semua terselamat.
Dialogue: 0,0:19:38.23,0:19:41.33,Default,,0000,0000,0000,,Saya mewakili pasukan penyerang\Nuntuk ucapkan terima kasih.
Dialogue: 0,0:19:46.33,0:19:47.47,Default,,0000,0000,0000,,Oh ya.
Dialogue: 0,0:19:48.65,0:19:50.05,Default,,0000,0000,0000,,Ini surat wasiat awak.
Dialogue: 0,0:19:50.35,0:19:51.15,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:19:53.25,0:19:54.75,Default,,0000,0000,0000,,Mari kita pergi.
Dialogue: 0,0:19:57.81,0:19:59.93,Default,,0000,0000,0000,,- Ah.\N- Timbalan ketua.
Dialogue: 0,0:20:00.21,0:20:00.99,Default,,0000,0000,0000,,Ya?
Dialogue: 0,0:20:01.45,0:20:03.69,Default,,0000,0000,0000,,Kenapa awak pegang palu?
Dialogue: 0,0:20:03.97,0:20:04.79,Default,,0000,0000,0000,,Eh?
Dialogue: 0,0:20:06.35,0:20:09.11,Default,,0000,0000,0000,,Adakah dia rasa saya pelik?
Dialogue: 0,0:20:09.27,0:20:10.31,Default,,0000,0000,0000,,Awak merujuk siapa?
Dialogue: 0,0:20:10.65,0:20:11.71,Default,,0000,0000,0000,,Ah, tiada apa-apa.
Dialogue: 0,0:20:11.99,0:20:13.43,Default,,0000,0000,0000,,Saya tak merujuk sesiapa.
Dialogue: 0,0:20:16.25,0:20:19.40,Default,,0000,0000,0000,,Nasib baik semua orang\Nkembali dengan selamat.
Dialogue: 0,0:20:20.09,0:20:20.93,Default,,0000,0000,0000,,Biarpun begitu,
Dialogue: 0,0:20:21.15,0:20:25.93,Default,,0000,0000,0000,,selepas Persatuan Harimau Putih,\Nkita juga mendapat bantuannya.
Dialogue: 0,0:20:26.73,0:20:28.71,Default,,0000,0000,0000,,Mampu menyeru banyak askar,
Dialogue: 0,0:20:28.97,0:20:30.65,Default,,0000,0000,0000,,kelajuan yang setanding pembunuh,
Dialogue: 0,0:20:31.09,0:20:33.35,Default,,0000,0000,0000,,bahkan mampu mengawal\Nhaiwan iblis yang sudah mati.
Dialogue: 0,0:20:33.97,0:20:35.71,Default,,0000,0000,0000,,Ini memang sukar dipercayai.
Dialogue: 0,0:20:37.39,0:20:39.97,Default,,0000,0000,0000,,Pemburu Son, awak rasa antara\Nsaya dengan Pemburu Sung Jinwoo,
Dialogue: 0,0:20:40.21,0:20:41.99,Default,,0000,0000,0000,,siapa yang lebih kuat?
Dialogue: 0,0:20:46.03,0:20:50.97,Default,,0000,0000,0000,,Misi serangan biasanya dilakukan oleh\Npemburu dengan tugas masing-masing,
Dialogue: 0,0:20:50.97,0:20:53.39,Default,,0000,0000,0000,,saling melengkapi\Nkekurangan satu sama lain.
Dialogue: 0,0:20:53.63,0:20:55.77,Default,,0000,0000,0000,,Ini pengetahuan umum.
Dialogue: 0,0:20:57.25,0:21:01.25,Default,,0000,0000,0000,,Adakah awak mampu mengatasi\Npenjara bawah tanah tahap A
Dialogue: 0,0:21:01.63,0:21:03.97,Default,,0000,0000,0000,,yang paling susah secara bersendirian?
Dialogue: 0,0:21:06.07,0:21:07.27,Default,,0000,0000,0000,,Tidak mampu.
Dialogue: 0,0:21:07.71,0:21:11.97,Default,,0000,0000,0000,,Nampaknya gelaran saya sebagai\N"Senjata Terakhir" dah jadi bahan jenaka.
Dialogue: 0,0:21:13.71,0:21:14.59,Default,,0000,0000,0000,,Ketua.
Dialogue: 0,0:21:15.59,0:21:16.73,Default,,0000,0000,0000,,Saya faham.
Dialogue: 0,0:21:17.03,0:21:18.45,Default,,0000,0000,0000,,Awak mesti...
Dialogue: 0,0:21:19.13,0:21:20.77,Default,,0000,0000,0000,,Saya akan cuba yang terbaik.
Dialogue: 0,0:21:23.33,0:21:24.83,Default,,0000,0000,0000,,CAFE PENE
Dialogue: 0,0:21:26.39,0:21:27.45,Default,,0000,0000,0000,,Abang.
Dialogue: 0,0:21:30.59,0:21:32.01,Default,,0000,0000,0000,,Maaf saya datang lambat.
Dialogue: 0,0:21:32.71,0:21:33.57,Default,,0000,0000,0000,,Jadi, bagaimana dengan urusan
Dialogue: 0,0:21:33.89,0:21:35.07,Default,,0000,0000,0000,,tentang ketua persatuan?
Dialogue: 0,0:21:35.93,0:21:37.45,Default,,0000,0000,0000,,Awak sepatutnya sudah\Nbincang dengan ayah awak, betul?
Dialogue: 0,0:21:39.03,0:21:39.95,Default,,0000,0000,0000,,Abang.
Dialogue: 0,0:21:40.79,0:21:41.57,Default,,0000,0000,0000,,Secara jujurnya,
Dialogue: 0,0:21:41.93,0:21:43.45,Default,,0000,0000,0000,,mengenai hal itu...
Dialogue: 0,0:21:44.57,0:21:47.45,Default,,0000,0000,0000,,- Kita berada di luar Persatuan Pemburu.\N- Boleh tahan.
Dialogue: 0,0:21:47.45,0:21:51.61,Default,,0000,0000,0000,,- Pelakon Lee Minsung telah bangkit dengan kekuatan pemburu.\N- Semua orang ini datang mewawancara saya.
Dialogue: 0,0:21:52.71,0:21:55.83,Default,,0000,0000,0000,,Lelaki yang memiliki segalanya,\NLee Minsung.
Dialogue: 0,0:21:56.05,0:21:59.79,Default,,0000,0000,0000,,Dia telah memperoleh kekuatan\Nyang melampaui manusia?
Dialogue: 0,0:22:00.71,0:22:01.67,Default,,0000,0000,0000,,Ah.
Dialogue: 0,0:22:02.45,0:22:03.61,Default,,0000,0000,0000,,Rasanya boleh tahan.
Dialogue: 0,0:22:42.00,0:22:44.67,Default,,0000,0000,0000,,(Solo Leveling)
Dialogue: 0,0:22:44.67,0:22:48.17,Default,,0000,0000,0000,,(Episod 18: Jangan Pandang Rendah Mereka)
Dialogue: 0,0:23:38.35,0:23:40.93,Default,,0000,0000,0000,,(Episod 19: Pemburu Tahap S Ke-10)
